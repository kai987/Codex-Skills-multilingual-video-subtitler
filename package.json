{
  "name": "multilingual-video-learning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.18.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "build": "tsc -b && npm run build -w @mvl/grammar-learning-site-template",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "generate:fixtures": "tsx scripts/generate-fixtures.ts",
    "generate:schemas": "tsx scripts/generate-schemas.ts",
    "replay:arbitration": "tsx scripts/replay-transcription-arbitration.ts",
    "replay:c3-top-score": "tsx scripts/replay-c3-top-score.ts",
    "targeted:c3-large-v3": "tsx scripts/run-c3-targeted-asr.ts",
    "replay:c4-coverage": "tsx scripts/replay-c4-coverage-recovery.ts",
    "replay:c4-1-presentation": "tsx scripts/replay-c4-1-presentation-integrity.ts",
    "replay:c5-14-presentation": "tsx scripts/replay-c5-14-presentation.ts",
    "replay:c5-15-overlap": "tsx scripts/replay-c5-15-overlap.ts",
    "replay:c5-15-1-timestamp-integrity": "tsx scripts/replay-c5-15-overlap.ts",
    "audit:c5-15-token-timestamps": "tsx scripts/audit-c5-15-token-timestamps.ts",
    "validate:c5-15-1-runs": "tsx scripts/validate-c5-15-1-runs.ts",
    "verify:whisper-runtime-patch": "tsx scripts/verify-whisper-runtime-patch.ts",
    "build:whisper-runtime": "tsx scripts/build-whisper-runtime.ts",
    "replay:c5-16-mapped-vad": "tsx scripts/replay-c5-16-mapped-vad.ts",
    "compare:c5-16-whisper-runtimes": "tsx scripts/compare-c5-16-whisper-runtimes.ts",
    "validate:c5-16-runs": "tsx scripts/validate-c5-16-runs.ts",
    "replay:c5-16-1-runtime-stabilization": "tsx scripts/replay-c5-16-1-runtime-stabilization.ts",
    "replay:c5-16-1-offline-evidence": "tsx scripts/replay-c5-16-1-offline-evidence.ts",
    "emit:c5-16-1-shareable-artifacts": "tsx scripts/emit-c5-16-1-shareable-artifacts.ts",
    "verify:c5-16-1-worker-state-isolation": "tsx scripts/verify-c5-16-1-worker-state-isolation.ts",
    "audit:shareable-artifacts": "tsx scripts/audit-shareable-artifacts.ts",
    "validate:c5-16-1-runs": "tsx scripts/validate-c5-16-1-runs.ts",
    "targeted:c4-coverage": "tsx scripts/run-c4-coverage-recovery-asr.ts",
    "verify:c4-persistent-worker": "tsx scripts/verify-c4-persistent-worker.ts",
    "validate:c4-real-runs": "tsx scripts/validate-c4-real-runs.ts",
    "rebuild:final-review-queue": "tsx scripts/rebuild-final-review-queue.ts",
    "rebuild:final-subtitle-integrity": "tsx scripts/rebuild-final-subtitle-integrity.ts",
    "parity:asr-segmentation": "tsx scripts/asr-segmentation-parity.ts",
    "subtitle": "tsx apps/cli/src/index.ts subtitle",
    "subtitle-finalize": "tsx apps/cli/src/index.ts subtitle-finalize",
    "subtitle-review": "tsx apps/cli/src/index.ts subtitle-review",
    "grammar-report": "tsx apps/cli/src/index.ts grammar-report",
    "build-learning-site": "tsx apps/cli/src/index.ts build-learning-site",
    "pipeline": "tsx apps/cli/src/index.ts pipeline"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "commander": "15.0.0",
    "openai": "6.48.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.7.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
