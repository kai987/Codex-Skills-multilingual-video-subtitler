# Local transcription is preferred. Set a model file or model directory;
# whisper-cli is discovered on PATH unless WHISPER_CPP_PATH overrides it.
WHISPER_CPP_PATH=whisper-cli
WHISPER_MODEL_PATH=
# Preferred model-directory variable for adaptive discovery.
WHISPER_MODEL_DIR=
# Backward-compatible directory variable.
WHISPER_MODEL_DIRECTORY=
WHISPER_VAD_MODEL_PATH=

# Optional public subtitle providers. Never commit real credentials.
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USER_AGENT="MultilingualVideoLearning v0.1.0"
# Optional authenticated download quota; an API key alone also works.
OPENSUBTITLES_BEARER_TOKEN=
ASSRT_TOKEN=
ASSRT_USER_AGENT="MultilingualVideoLearning/0.1.0"
# Set to 0 to disable rate-limited public-page lookup when a provider token is absent.
SUBTITLE_WEB_FALLBACK=1

# Optional override for the pinned SudachiPy virtual-environment interpreter.
SUDACHI_PYTHON=

# Required for grammar analysis only after --analysis-provider openai is
# explicitly selected; it may also be used by explicitly configured
# transcription or transcription auto fallback.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_GRAMMAR_MODEL=gpt-5.6-sol

# Optional executable overrides. Commands are always invoked with argument arrays.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
