index 0000000..5af57f9
--- /dev/null
+++ b/sherpa-onnx/csrc/c601182-trace.h
@@ -0,0 +1,71 @@
+// Opt-in, single-stream diagnostic observation only. No model calls here.
+#ifndef SHERPA_ONNX_CSRC_C601182_TRACE_H_
+#define SHERPA_ONNX_CSRC_C601182_TRACE_H_
+#include <CommonCrypto/CommonDigest.h>
+#include <cmath>
+#include <cstdint>
+#include <fstream>
+#include <iomanip>
+#include <sstream>
+#include <stdexcept>
+#include <nlohmann/json.hpp>
+#include "onnxruntime_cxx_api.h"
+namespace sherpa_onnx { namespace c601182 {
+using J = nlohmann::json;
+inline constexpr const char *build = "c601182-native-probe-v1-1cb484af";
+struct State { bool active=false; bool overflow=false; J binding; J events=J::array(); std::string file; };
+extern thread_local State state;
+inline std::string Hash(const void *p, size_t n) {
+  unsigned char digest[CC_SHA256_DIGEST_LENGTH]; CC_SHA256(p, static_cast<CC_LONG>(n), digest);
+  std::ostringstream os; for(auto b:digest) os<<std::hex<<std::setw(2)<<std::setfill('0')<<int(b); return os.str();
+}
+inline void Event(const char *kind, J fields, const char *source) {
+  if(!state.active)return;
+  if(state.events.size()>=4096){state.overflow=true;return;}
+  J row=state.binding; row["kind"]=kind; row["source"]=source;
+  row["eventSequence"]=state.events.size(); row["observed"]=std::move(fields);
+  state.events.push_back(std::move(row));
+}
+inline void Begin(const std::string &binding, const std::string &file) {
+  if(state.active)throw std::runtime_error("TRACE_REQUEST_ALREADY_ACTIVE");
+  state=State{}; state.binding=J::parse(binding); state.file=file; state.active=true;
+  state.binding["runtimeBuildId"]=build; state.binding["probeSchema"]="c601182-v1";
+  Event("request-start",{{"native",true}},"c601182-trace.h:Begin");
+}
+inline void End(bool success) {
+  if(!state.active)return;
+  Event("request-end",{{"success",success},{"overflow",state.overflow}},"c601182-trace.h:End");
+  std::ofstream f(state.file,std::ios::out|std::ios::binary);
+  if(!f)throw std::runtime_error("TRACE_FLUSH_FAILED");
+  f<<J({{"schema","c601182-v1"},{"runtimeBuildId",build},{"overflow",state.overflow},{"events",state.events}}).dump(2);
+  f.flush(); if(!f)throw std::runtime_error("TRACE_FLUSH_FAILED"); state.active=false;
+}
+inline J Summary(const float *p, size_t frames, size_t dim) {
+  J thirds=J::array(); size_t finite=0,nan=0,inf=0;
+  for(int section=0;section<3;++section){
+    size_t a=frames*section/3,b=frames*(section+1)/3,count=0,zero=0;
+    double sum=0,sq=0,lo=INFINITY,hi=-INFINITY;
+    for(size_t i=a*dim;i<b*dim;++i){double v=p[i];if(std::isnan(v)){++nan;continue;}if(!std::isfinite(v)){++inf;continue;}
+      ++finite;++count;if(v==0)++zero;sum+=v;sq+=v*v;lo=std::min(lo,v);hi=std::max(hi,v);}
+    J s={{"startFrame",a},{"endFrameExclusive",b},{"finite",count},{"zeroCount",zero}};
+    if(count){double mean=sum/count;s["min"]=lo;s["max"]=hi;s["mean"]=mean;s["std"]=std::sqrt(std::max(0.0,sq/count-mean*mean));s["zeroRatio"]=double(zero)/count;}
+    thirds.push_back(s);
+  }
+  return {{"frames",frames},{"dim",dim},{"elements",frames*dim},{"dtype","float32"},{"byteOrder","little-endian"},{"sha256",Hash(p,frames*dim*sizeof(float))},{"finite",finite},{"nan",nan},{"inf",inf},{"thirds",thirds}};
+}
+inline J Tensor(const Ort::Value &v) {
+  auto info=v.GetTensorTypeAndShapeInfo();auto type=info.GetElementType();J j={{"shape",info.GetShape()},{"dtype",int(type)},{"elements",info.GetElementCount()}};
+  if(type==ONNX_TENSOR_ELEMENT_DATA_TYPE_INT64)j["values"]=std::vector<int64_t>(v.GetTensorData<int64_t>(),v.GetTensorData<int64_t>()+info.GetElementCount());
+  if(type==ONNX_TENSOR_ELEMENT_DATA_TYPE_INT32)j["values"]=std::vector<int32_t>(v.GetTensorData<int32_t>(),v.GetTensorData<int32_t>()+info.GetElementCount());
+  if(type==ONNX_TENSOR_ELEMENT_DATA_TYPE_FLOAT)j["sha256"]=Hash(v.GetTensorData<float>(),info.GetElementCount()*4);
+  return j;
+}
+inline J Ptr(const void *p){std::ostringstream s;s<<p;return s.str();}
+inline J Graph(const Ort::Session &session){
+  Ort::AllocatorWithDefaultOptions a;J j={{"inputs",J::array()},{"outputs",J::array()},{"metadata",J::object()}};
+  for(size_t i=0;i<session.GetInputCount();++i){auto ti=session.GetInputTypeInfo(i);auto t=ti.GetTensorTypeAndShapeInfo();j["inputs"].push_back({{"name",session.GetInputNameAllocated(i,a).get()},{"shape",t.GetShape()},{"dtype",int(t.GetElementType())}});}
+  for(size_t i=0;i<session.GetOutputCount();++i){auto ti=session.GetOutputTypeInfo(i);auto t=ti.GetTensorTypeAndShapeInfo();j["outputs"].push_back({{"name",session.GetOutputNameAllocated(i,a).get()},{"shape",t.GetShape()},{"dtype",int(t.GetElementType())}});}
+  auto m=session.GetModelMetadata();for(auto &key:m.GetCustomMetadataMapKeysAllocated(a)){auto value=m.LookupCustomMetadataMapAllocated(key.get(),a);j["metadata"][key.get()]=value.get();}return j;
+}
+}}
+#endif
