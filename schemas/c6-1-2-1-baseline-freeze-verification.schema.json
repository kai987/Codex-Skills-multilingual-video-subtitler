{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-1-2-1-baseline-freeze-verification.schema.json",
  "title": "c6-1-2-1-baseline-freeze-verification",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "c6-1-2-1-baseline-freeze-verification"
    },
    "policyVersion": {
      "type": "string",
      "const": "c6.1.2.1-gold-isolated-supergroup-evaluation-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "machineFrozenAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "machineFreezeHashes": {
      "minItems": 2,
      "maxItems": 2,
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "rerankingFreezeHashes": {
      "minItems": 2,
      "maxItems": 2,
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "sourceIdentity": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generationSourceCommit": { "type": "string", "minLength": 1 },
    "baselineCommit": { "type": "string", "minLength": 1 },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "semanticHash": {
            "anyOf": [
              { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              { "type": "null" }
            ]
          },
          "mtimeMs": { "type": "number" },
          "inode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "role",
          "path",
          "bytes",
          "sha256",
          "semanticHash",
          "mtimeMs",
          "inode"
        ],
        "additionalProperties": false
      }
    },
    "inputAggregateHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "productionTextHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "productionTimingHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "observed": { "type": "string" },
          "expected": { "type": "string" }
        },
        "required": ["name", "passed", "observed", "expected"],
        "additionalProperties": false
      }
    },
    "passed": { "type": "boolean" },
    "rawGoldReadCount": { "type": "number", "const": 0 },
    "modelExecutionCount": { "type": "number", "const": 0 },
    "networkUsed": { "type": "boolean", "const": false }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "policyVersion",
    "policyHash",
    "semanticHash",
    "machineFrozenAt",
    "machineFreezeHashes",
    "rerankingFreezeHashes",
    "sourceIdentity",
    "generationSourceCommit",
    "baselineCommit",
    "files",
    "inputAggregateHash",
    "productionTextHash",
    "productionTimingHash",
    "checks",
    "passed",
    "rawGoldReadCount",
    "modelExecutionCount",
    "networkUsed"
  ],
  "additionalProperties": false
}
