{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-14-3-route-decision.schema.json",
  "title": "c6-0-1-14-3-route-decision",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14.3-cross-stage-monotonic-safety-selection-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "sourceTimebase": {
      "type": "string",
      "const": "SOURCE_GLOBAL_NATIVE_SAMPLES"
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "visibility": { "type": "string", "const": "LOCAL_ONLY" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": { "type": "string", "const": "c6-0-1-14-3-route-decision" },
    "primaryDecision": {
      "type": "string",
      "enum": [
        "GO_C6_0_1_15_REGION_RANKER_RECALIBRATION",
        "HOLD_FOR_CROSS_STAGE_COVERAGE_REGRESSION",
        "HOLD_FOR_HIERARCHICAL_TARGET_SELECTION_REPAIR",
        "HOLD_FOR_SAFETY_BUDGET_MODEL_REDESIGN",
        "HOLD_FOR_PLANNER_SEARCH_COMPLETENESS",
        "HOLD_FOR_REVIEW_AUDIO_COVERAGE_REPAIR",
        "HOLD_FOR_EVALUATION_INTEGRITY_REPAIR",
        "HOLD_FOR_ENGINEERING_REPAIR"
      ]
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "engineeringGatePassed": { "type": "boolean" },
    "evaluationIntegrityGatePassed": { "type": "boolean" },
    "phaseAObligationCoverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "phaseARegressionCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "missingPlaybackAudible": {
      "type": "object",
      "properties": {
        "covered": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["covered", "total"],
      "additionalProperties": false
    },
    "hallucinationPlaybackAudible": {
      "type": "object",
      "properties": {
        "covered": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["covered", "total"],
      "additionalProperties": false
    },
    "audioRequiredTargetCoveragePassed": { "type": "boolean" },
    "playbackTargetCoveragePassed": { "type": "boolean" },
    "targetBudgetPassed": { "type": "boolean" },
    "coreBudgetPassed": { "type": "boolean" },
    "fullQueueBurdenPassed": { "type": "boolean" },
    "wholeEpisodeCatchAllCount": { "type": "number", "const": 0 },
    "datasetHardcodingCount": { "type": "number", "const": 0 },
    "detectorInferenceCount": { "type": "number", "const": 0 },
    "asrInferenceCount": { "type": "number", "const": 0 },
    "canonicalTextMutationCount": { "type": "number", "const": 0 },
    "canonicalTimingMutationCount": { "type": "number", "const": 0 },
    "finalABParity": { "type": "boolean" },
    "productionStatus": { "type": "string", "const": "needs-review" },
    "finalizationMethod": { "type": "string", "const": "none" },
    "c602Status": { "type": "string", "const": "HOLD" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "policyHash",
    "sourceIdentity",
    "sourceTimebase",
    "runtimeGoldInputCount",
    "visibility",
    "semanticHash",
    "artifactType",
    "primaryDecision",
    "blockers",
    "engineeringGatePassed",
    "evaluationIntegrityGatePassed",
    "phaseAObligationCoverage",
    "phaseARegressionCount",
    "missingPlaybackAudible",
    "hallucinationPlaybackAudible",
    "audioRequiredTargetCoveragePassed",
    "playbackTargetCoveragePassed",
    "targetBudgetPassed",
    "coreBudgetPassed",
    "fullQueueBurdenPassed",
    "wholeEpisodeCatchAllCount",
    "datasetHardcodingCount",
    "detectorInferenceCount",
    "asrInferenceCount",
    "canonicalTextMutationCount",
    "canonicalTimingMutationCount",
    "finalABParity",
    "productionStatus",
    "finalizationMethod",
    "c602Status"
  ],
  "additionalProperties": false
}
