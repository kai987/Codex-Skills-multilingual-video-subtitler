{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-14-2-dsp-request.schema.json",
  "title": "c6-0-1-14-2-dsp-request",
  "type": "object",
  "properties": {
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "viewId": { "type": "string", "minLength": 1 },
          "role": {
            "type": "string",
            "enum": [
              "NATIVE_MONO",
              "LEFT",
              "RIGHT",
              "CENTER_OR_MID",
              "VOICE_BAND_CENTER",
              "DIALOGUE_COMPRESSED_MID_V2",
              "PREEMPHASIS_VOICE_BAND_V1",
              "LIGHT_DENOISED_CENTER_V1"
            ]
          },
          "pcmSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "path": { "type": "string", "minLength": 1 }
        },
        "required": ["viewId", "role", "pcmSha256", "path"],
        "additionalProperties": false
      }
    },
    "nativeSampleRate": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "outputDirectory": { "type": "string", "minLength": 1 }
  },
  "required": ["views", "nativeSampleRate", "outputDirectory"],
  "additionalProperties": false
}
