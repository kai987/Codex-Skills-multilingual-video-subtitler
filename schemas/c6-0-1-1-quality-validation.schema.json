{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-1-quality-validation.schema.json",
  "title": "c6-0-1-1-quality-validation",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.1-machine-quality-recovery-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "c6-0-1-1-quality-validation"
    },
    "baselineSchemaCount": { "type": "number", "const": 149 },
    "generatedSchemaCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "passed": { "type": "boolean" },
          "details": { "type": "string" }
        },
        "required": ["id", "passed", "details"],
        "additionalProperties": false
      }
    },
    "milestonePassed": { "type": "boolean" },
    "finalAAndBReproducible": { "type": "boolean" },
    "goldRuntimeIsolationPassed": { "type": "boolean" },
    "safetyRegressionCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "machineOnlyReleaseAuthorized": { "type": "boolean", "const": false },
    "productionStatus": { "type": "string", "const": "needs-review" },
    "finalizationMethod": { "type": "string", "const": "none" },
    "nextStep": { "type": "string", "enum": ["GO_C6_0_2", "HOLD_C6_0_2"] }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "baselineSchemaCount",
    "generatedSchemaCount",
    "checks",
    "milestonePassed",
    "finalAAndBReproducible",
    "goldRuntimeIsolationPassed",
    "safetyRegressionCount",
    "machineOnlyReleaseAuthorized",
    "productionStatus",
    "finalizationMethod",
    "nextStep"
  ],
  "additionalProperties": false
}
