{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-candidate-association-ledger.schema.json",
  "title": "machine-candidate-association-ledger",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.3-candidate-association-canonical-assembly-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "machine-candidate-association-ledger"
    },
    "mode": { "type": "string", "enum": ["off", "observe", "enforce"] },
    "sourceCandidateSemanticHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "atomicClusterSemanticHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "familySemanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidateId": { "type": "string", "minLength": 1 },
          "sourceCueId": { "type": "string", "minLength": 1 },
          "interval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "normalizedTextHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "familyIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "compatibleClusterIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "assignedClusterId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "assignedEventId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "selectedAsTextVariant": { "type": "boolean" },
          "disposition": {
            "type": "string",
            "enum": [
              "ASSIGNED",
              "QUARANTINED",
              "SUPERSEDED",
              "DUPLICATE",
              "AMBIGUOUS",
              "REJECTED"
            ]
          },
          "primaryReason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "NO_COMPATIBLE_CLUSTER",
                  "ASSOCIATION_SCORE_TOO_LOW",
                  "TEMPORAL_CONFLICT",
                  "TEXT_CONFLICT",
                  "ACOUSTIC_EVENT_CONFLICT",
                  "SPEAKER_CONFLICT",
                  "WINDOW_EDGE_ONLY",
                  "BROAD_WINDOW_ONLY",
                  "PREFIX_SHADOWED",
                  "SUFFIX_SHADOWED",
                  "DUPLICATE_EVENT",
                  "CORRELATED_RETRY",
                  "NONCOMPETITIVE_VARIANT",
                  "MISSING_GLOBAL_TIMELINE",
                  "AMBIGUOUS_TIME_BASE",
                  "MULTIPLE_VALID_CLUSTERS",
                  "WEAK_ACOUSTIC_SUPPORT",
                  "HALLUCINATION_RISK",
                  "UNKNOWN"
                ]
              },
              { "type": "null" }
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "NO_COMPATIBLE_CLUSTER",
                "ASSOCIATION_SCORE_TOO_LOW",
                "TEMPORAL_CONFLICT",
                "TEXT_CONFLICT",
                "ACOUSTIC_EVENT_CONFLICT",
                "SPEAKER_CONFLICT",
                "WINDOW_EDGE_ONLY",
                "BROAD_WINDOW_ONLY",
                "PREFIX_SHADOWED",
                "SUFFIX_SHADOWED",
                "DUPLICATE_EVENT",
                "CORRELATED_RETRY",
                "NONCOMPETITIVE_VARIANT",
                "MISSING_GLOBAL_TIMELINE",
                "AMBIGUOUS_TIME_BASE",
                "MULTIPLE_VALID_CLUSTERS",
                "WEAK_ACOUSTIC_SUPPORT",
                "HALLUCINATION_RISK",
                "UNKNOWN"
              ]
            }
          },
          "hardIncompatibilities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "NO_COMPATIBLE_CLUSTER",
                "ASSOCIATION_SCORE_TOO_LOW",
                "TEMPORAL_CONFLICT",
                "TEXT_CONFLICT",
                "ACOUSTIC_EVENT_CONFLICT",
                "SPEAKER_CONFLICT",
                "WINDOW_EDGE_ONLY",
                "BROAD_WINDOW_ONLY",
                "PREFIX_SHADOWED",
                "SUFFIX_SHADOWED",
                "DUPLICATE_EVENT",
                "CORRELATED_RETRY",
                "NONCOMPETITIVE_VARIANT",
                "MISSING_GLOBAL_TIMELINE",
                "AMBIGUOUS_TIME_BASE",
                "MULTIPLE_VALID_CLUSTERS",
                "WEAK_ACOUSTIC_SUPPORT",
                "HALLUCINATION_RISK",
                "UNKNOWN"
              ]
            }
          },
          "score": {
            "type": "object",
            "properties": {
              "temporalCompatibility": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "textCompatibility": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "acousticCompatibility": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "speakerCompatibility": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "timelineTrust": { "type": "number", "minimum": 0, "maximum": 1 },
              "evidenceStrength": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "tieBreakScore": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "required": [
              "temporalCompatibility",
              "textCompatibility",
              "acousticCompatibility",
              "speakerCompatibility",
              "timelineTrust",
              "evidenceStrength",
              "tieBreakScore"
            ],
            "additionalProperties": false
          },
          "competingAssignments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "clusterId": { "type": "string", "minLength": 1 },
                "score": { "type": "number", "minimum": 0, "maximum": 1 },
                "hardCompatible": { "type": "boolean" },
                "reasons": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "NO_COMPATIBLE_CLUSTER",
                      "ASSOCIATION_SCORE_TOO_LOW",
                      "TEMPORAL_CONFLICT",
                      "TEXT_CONFLICT",
                      "ACOUSTIC_EVENT_CONFLICT",
                      "SPEAKER_CONFLICT",
                      "WINDOW_EDGE_ONLY",
                      "BROAD_WINDOW_ONLY",
                      "PREFIX_SHADOWED",
                      "SUFFIX_SHADOWED",
                      "DUPLICATE_EVENT",
                      "CORRELATED_RETRY",
                      "NONCOMPETITIVE_VARIANT",
                      "MISSING_GLOBAL_TIMELINE",
                      "AMBIGUOUS_TIME_BASE",
                      "MULTIPLE_VALID_CLUSTERS",
                      "WEAK_ACOUSTIC_SUPPORT",
                      "HALLUCINATION_RISK",
                      "UNKNOWN"
                    ]
                  }
                }
              },
              "required": ["clusterId", "score", "hardCompatible", "reasons"],
              "additionalProperties": false
            }
          },
          "lineageIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "candidateId",
          "sourceCueId",
          "interval",
          "normalizedTextHash",
          "familyIds",
          "compatibleClusterIds",
          "assignedClusterId",
          "assignedEventId",
          "selectedAsTextVariant",
          "disposition",
          "primaryReason",
          "reasons",
          "hardIncompatibilities",
          "score",
          "competingAssignments",
          "lineageIds"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "sourceCandidateCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "atomicClusterCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ledgerRecordCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "assignedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "quarantinedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "supersededCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "duplicateCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ambiguousCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rejectedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "groupedCandidateCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unaccountedCandidateCount": { "type": "number", "const": 0 },
        "unknownReasonCount": { "type": "number", "const": 0 },
        "multiAssignedCandidateCount": { "type": "number", "const": 0 },
        "candidateConservationPassed": { "type": "boolean", "const": true }
      },
      "required": [
        "sourceCandidateCount",
        "atomicClusterCount",
        "ledgerRecordCount",
        "assignedCount",
        "quarantinedCount",
        "supersededCount",
        "duplicateCount",
        "ambiguousCount",
        "rejectedCount",
        "groupedCandidateCount",
        "unaccountedCandidateCount",
        "unknownReasonCount",
        "multiAssignedCandidateCount",
        "candidateConservationPassed"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "mode",
    "sourceCandidateSemanticHash",
    "atomicClusterSemanticHash",
    "familySemanticHash",
    "records",
    "summary",
    "semanticHash"
  ],
  "additionalProperties": false
}
