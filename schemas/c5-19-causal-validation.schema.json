{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c5-19-causal-validation.schema.json",
  "title": "c5-19-causal-validation",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": { "type": "string", "const": "c5-19-causal-validation" },
    "validationVersion": { "type": "string", "const": "C5.19" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "seriesKey": { "type": "string", "minLength": 1 },
    "cueOrder": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "retrievalEvents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cueId": { "type": "string", "minLength": 1 },
          "cueStart": { "type": "number", "minimum": 0 },
          "retrievedOccurrenceIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "learnedOccurrenceIdsAfterEvaluation": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "matchedEntryIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "cueId",
          "cueStart",
          "retrievedOccurrenceIds",
          "learnedOccurrenceIdsAfterEvaluation",
          "matchedEntryIds"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "causalMemoryMatchCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "futureCueMemoryLeakCount": { "type": "number", "const": 0 },
        "sameCueMemoryLeakCount": { "type": "number", "const": 0 },
        "crossSeriesMemoryLeakCount": { "type": "number", "const": 0 }
      },
      "required": [
        "causalMemoryMatchCount",
        "futureCueMemoryLeakCount",
        "sameCueMemoryLeakCount",
        "crossSeriesMemoryLeakCount"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "validationVersion",
    "generatedAt",
    "seriesKey",
    "cueOrder",
    "retrievalEvents",
    "summary",
    "semanticHash"
  ],
  "additionalProperties": false
}
