{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-14-2-detector-run.schema.json",
  "title": "c6-0-1-14-2-detector-run",
  "type": "object",
  "properties": {
    "runId": { "type": "string", "minLength": 1 },
    "cacheKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "jobHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "family": { "type": "string", "enum": ["SILERO", "PYANNOTE", "WEBRTC"] },
    "runtimeIdentityHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "viewId": { "type": "string", "minLength": 1 },
    "pcmSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "FAILED",
        "DETECTOR_RUNTIME_UNAVAILABLE",
        "INFERENCE_CONSUMED_RESULT_NOT_PERSISTED"
      ]
    },
    "inferenceConsumed": { "type": "boolean" },
    "resultPersisted": { "type": "boolean" },
    "modelLoadCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "providerProcessStartCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rawResultHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rawIntervals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "exclusiveMinimum": 0 }
        },
        "required": ["start", "end"],
        "additionalProperties": false
      }
    },
    "exclusiveRawIntervals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "exclusiveMinimum": 0 }
        },
        "required": ["start", "end"],
        "additionalProperties": false
      }
    },
    "nativeIntervals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "startSample": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "endSample": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["startSample", "endSample"],
        "additionalProperties": false
      }
    },
    "scoreTrack": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "runId": { "type": "string", "minLength": 1 },
            "family": {
              "type": "string",
              "enum": ["SILERO", "PYANNOTE", "WEBRTC"]
            },
            "viewId": { "type": "string", "minLength": 1 },
            "pcmSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "scoreKind": {
              "type": "string",
              "enum": ["PROBABILITY", "BINARY_DECISION"]
            },
            "relativePath": { "type": "string", "minLength": 1 },
            "scoreSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "dtype": { "type": "string", "const": "FLOAT32_LITTLE_ENDIAN" },
            "frameCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "frameHopSamples16k": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "frameWindowSamples16k": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "frameOffsetSamples16k": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "timeMapping": {
              "type": "object",
              "properties": {
                "sourceStartSample": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "sourceSampleRate": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "outputSampleRate": { "type": "number", "const": 16000 },
                "numerator": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "denominator": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "outputStartSample": { "type": "number", "const": 0 },
                "mappingStatus": {
                  "type": "string",
                  "const": "VERIFIED_INTEGER_RATIONAL"
                },
                "measuredImpulsePeakDelaySamples": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "syntheticValidationHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "sourceStartSample",
                "sourceSampleRate",
                "outputSampleRate",
                "numerator",
                "denominator",
                "outputStartSample",
                "mappingStatus",
                "measuredImpulsePeakDelaySamples",
                "syntheticValidationHash"
              ],
              "additionalProperties": false
            },
            "maximumNativeSample": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "mainThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
            "auditThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
            "statistics": {
              "type": "object",
              "properties": {
                "minimum": { "type": "number", "minimum": 0, "maximum": 1 },
                "maximum": { "type": "number", "minimum": 0, "maximum": 1 },
                "mean": { "type": "number", "minimum": 0, "maximum": 1 },
                "q05": { "type": "number", "minimum": 0, "maximum": 1 },
                "q25": { "type": "number", "minimum": 0, "maximum": 1 },
                "q50": { "type": "number", "minimum": 0, "maximum": 1 },
                "q75": { "type": "number", "minimum": 0, "maximum": 1 },
                "q95": { "type": "number", "minimum": 0, "maximum": 1 },
                "q99": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "required": [
                "minimum",
                "maximum",
                "mean",
                "q05",
                "q25",
                "q50",
                "q75",
                "q95",
                "q99"
              ],
              "additionalProperties": false
            },
            "mainCrossingNativeIntervals": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "startSample": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "endSample": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": ["startSample", "endSample"],
                "additionalProperties": false
              }
            },
            "subthresholdPeakNativeIntervals": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "startSample": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "endSample": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": ["startSample", "endSample"],
                "additionalProperties": false
              }
            },
            "originalChunkScores": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "relativePath": { "type": "string", "minLength": 1 },
                    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                    "shape": {
                      "minItems": 2,
                      "maxItems": 2,
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "chunkStepSamples16k": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "frameHopSamples16k": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "frameWindowSamples16k": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "frameOffsetSamples16k": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "anonymousReduction": {
                      "type": "string",
                      "const": "ONE_MINUS_EMPTY_POWERSET_PROBABILITY"
                    },
                    "aggregation": {
                      "type": "string",
                      "const": "MEAN_OVERLAP_CELL_PROJECTION_10MS"
                    }
                  },
                  "required": [
                    "relativePath",
                    "sha256",
                    "shape",
                    "chunkStepSamples16k",
                    "frameHopSamples16k",
                    "frameWindowSamples16k",
                    "frameOffsetSamples16k",
                    "anonymousReduction",
                    "aggregation"
                  ],
                  "additionalProperties": false
                },
                { "type": "null" }
              ]
            },
            "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          },
          "required": [
            "runId",
            "family",
            "viewId",
            "pcmSha256",
            "scoreKind",
            "relativePath",
            "scoreSha256",
            "dtype",
            "frameCount",
            "frameHopSamples16k",
            "frameWindowSamples16k",
            "frameOffsetSamples16k",
            "timeMapping",
            "maximumNativeSample",
            "mainThreshold",
            "auditThreshold",
            "statistics",
            "mainCrossingNativeIntervals",
            "subthresholdPeakNativeIntervals",
            "originalChunkScores",
            "semanticHash"
          ],
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "errorCode": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "runId",
    "cacheKey",
    "jobHash",
    "family",
    "runtimeIdentityHash",
    "viewId",
    "pcmSha256",
    "status",
    "inferenceConsumed",
    "resultPersisted",
    "modelLoadCount",
    "providerProcessStartCount",
    "rawResultHash",
    "rawIntervals",
    "exclusiveRawIntervals",
    "nativeIntervals",
    "scoreTrack",
    "errorCode",
    "semanticHash"
  ],
  "additionalProperties": false
}
