{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-review-regions-v9.schema.json",
  "title": "machine-review-regions-v9",
  "type": "object",
  "properties": {
    "targetsHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "itemsHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "compatibilityRegionsHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "regionId": { "type": "string", "minLength": 1 },
          "reviewTargetIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "reviewItemIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "sourceIntervals": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": { "type": "number", "minimum": 0 },
                "end": { "type": "number", "exclusiveMinimum": 0 }
              },
              "required": ["start", "end"],
              "additionalProperties": false
            }
          },
          "contextIntervals": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": { "type": "number", "minimum": 0 },
                "end": { "type": "number", "exclusiveMinimum": 0 }
              },
              "required": ["start", "end"],
              "additionalProperties": false
            }
          },
          "playbackIntervals": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": { "type": "number", "minimum": 0 },
                "end": { "type": "number", "exclusiveMinimum": 0 }
              },
              "required": ["start", "end"],
              "additionalProperties": false
            }
          },
          "targetCoverageChecks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "reviewTargetId": { "type": "string", "minLength": 1 },
                "mandatoryForAudio": { "type": "boolean" },
                "audioRequired": { "type": "boolean" },
                "coverageRatio": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "fullyCovered": { "type": "boolean" }
              },
              "required": [
                "reviewTargetId",
                "mandatoryForAudio",
                "coverageRatio",
                "fullyCovered"
              ],
              "additionalProperties": false
            }
          },
          "requiredLevel": {
            "type": "string",
            "enum": ["REQUIRED", "RECOMMENDED", "INFORMATIONAL"]
          },
          "priorityMetadata": {
            "type": "object",
            "properties": {
              "rankerStatus": {
                "type": "string",
                "const": "RANKER_NOT_RECALIBRATED_IN_C6_0_1_14"
              },
              "rankPosition": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "inheritedItemScore": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "safetyClass": {
                "type": "string",
                "enum": ["REQUIRED", "RECOMMENDED", "INFORMATIONAL"]
              },
              "legacyItemRank": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "r3PolicyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "r3EvidenceFamiliesHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "r3Ranker": {
                "type": "string",
                "const": "REGION_RISK_DENSITY_V3"
              },
              "inputDerivation": {
                "type": "string",
                "const": "EXISTING_R3_EVIDENCE_GRAPH_AND_ATOMIC_TARGET_REGION_PROJECTION"
              },
              "scoreMeaning": {
                "type": "string",
                "const": "EXPLAINABLE_RANKING_SCORE_NOT_PROBABILITY"
              },
              "utility": { "type": "number", "minimum": 0 },
              "uniqueAudioCostSeconds": { "type": "number", "minimum": 0 },
              "reviewCostSeconds": { "type": "number", "exclusiveMinimum": 0 },
              "rankScore": { "type": "number", "minimum": 0 },
              "riskCoverageKeys": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "actionableCoverageKeys": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "mandatoryReasons": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "priorityVector": {
                "type": "object",
                "properties": {
                  "mandatorySafetyClass": {
                    "type": "string",
                    "enum": [
                      "NONE",
                      "STRONG_HALLUCINATION",
                      "STRONG_MISSING",
                      "STRONG_TIMING",
                      "STRONG_OVERLAP",
                      "STRUCTURAL_CORRUPTION"
                    ]
                  },
                  "positiveEvidenceStrength": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "independentEvidenceFamilyCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "errorTypeSeverity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "crossModelConflictStrength": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "hallucinationStrength": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "missingStrength": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "timingStrength": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "candidateActionability": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "localizationQuality": {
                    "anyOf": [
                      { "type": "number", "minimum": 0, "maximum": 1 },
                      { "type": "null" }
                    ]
                  },
                  "estimatedReviewCost": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "sourceTime": { "type": "number", "minimum": 0 }
                },
                "required": [
                  "mandatorySafetyClass",
                  "positiveEvidenceStrength",
                  "independentEvidenceFamilyCount",
                  "errorTypeSeverity",
                  "crossModelConflictStrength",
                  "hallucinationStrength",
                  "missingStrength",
                  "timingStrength",
                  "candidateActionability",
                  "localizationQuality",
                  "estimatedReviewCost",
                  "sourceTime"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "rankerStatus",
              "rankPosition",
              "inheritedItemScore",
              "safetyClass",
              "legacyItemRank",
              "r3PolicyHash",
              "r3EvidenceFamiliesHash",
              "r3Ranker",
              "inputDerivation",
              "scoreMeaning",
              "utility",
              "uniqueAudioCostSeconds",
              "reviewCostSeconds",
              "rankScore",
              "riskCoverageKeys",
              "actionableCoverageKeys",
              "mandatoryReasons",
              "priorityVector"
            ],
            "additionalProperties": false
          },
          "sourceIdentity": {
            "type": "object",
            "properties": {
              "sourceMediaSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
              "sampleRate": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "audioStreamIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "audioTimebase": {
                "type": "string",
                "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
              },
              "sourceTimebase": {
                "type": "string",
                "const": "SOURCE_GLOBAL_SECONDS"
              }
            },
            "required": [
              "sourceMediaSha256",
              "durationSeconds",
              "sampleRate",
              "audioStreamIndex",
              "audioTimebase",
              "sourceTimebase"
            ],
            "additionalProperties": false
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "reviewLayer": {
            "type": "string",
            "enum": [
              "PRESERVED_BASELINE",
              "STRONG_SPEECH_INVENTORY",
              "MISSING_SAFETY_RESERVE"
            ]
          },
          "nativeSourceIntervals": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "startSample": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "endSample": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["startSample", "endSample"],
              "additionalProperties": false
            }
          },
          "baselineSemanticHash": {
            "anyOf": [
              { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              { "type": "null" }
            ]
          },
          "safetyClusterIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "bundleIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "childUnitIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "childNativeCoreUnion": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "startSample": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "endSample": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["startSample", "endSample"],
              "additionalProperties": false
            }
          },
          "utilityTargetHashes": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          },
          "coverageUnitIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "contractTypes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "TARGET_CORE_LOCALIZATION_CONTRACT_V1",
                "MACHINE_ANCHORED_PLAYBACK_AUDIBILITY_CONTRACT_V1"
              ]
            }
          },
          "fullCoverageUnitIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "inheritedRealizationIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "unitBindingLedgerIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "productBindingStatus": { "type": "string", "minLength": 1 }
        },
        "required": [
          "regionId",
          "reviewTargetIds",
          "reviewItemIds",
          "sourceIntervals",
          "contextIntervals",
          "playbackIntervals",
          "targetCoverageChecks",
          "requiredLevel",
          "priorityMetadata",
          "sourceIdentity",
          "semanticHash",
          "reviewLayer",
          "nativeSourceIntervals",
          "baselineSemanticHash",
          "safetyClusterIds",
          "bundleIds",
          "childUnitIds",
          "childNativeCoreUnion",
          "utilityTargetHashes",
          "coverageUnitIds",
          "contractTypes",
          "fullCoverageUnitIds",
          "inheritedRealizationIds",
          "unitBindingLedgerIds",
          "productBindingStatus"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "regionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "targetCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mappedTargetCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "disjointItemCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "disjointRegionSplitCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "requiredRegionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "targetCoverageRatio": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": [
        "regionCount",
        "targetCount",
        "mappedTargetCount",
        "disjointItemCount",
        "disjointRegionSplitCount",
        "requiredRegionCount",
        "targetCoverageRatio"
      ],
      "additionalProperties": false
    },
    "orderingPolicy": {
      "type": "string",
      "const": "PRESERVE_BASELINE_R3_ORDER_APPEND_FROZEN_R3_SAFETY_LAYER"
    },
    "rankerRetrained": { "type": "boolean", "const": false },
    "newOofRun": { "type": "boolean", "const": false },
    "sourceArtifactHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "utilityItemsHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "sourceTimebase": {
      "type": "string",
      "const": "SOURCE_GLOBAL_NATIVE_SAMPLES"
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "visibility": { "type": "string", "const": "LOCAL_ONLY" },
    "coverageItemsHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14.5.1-full-unit-registry-review-binding-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": { "type": "string", "const": "machine-review-regions-v9" },
    "bindingHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "targetsHash",
    "itemsHash",
    "compatibilityRegionsHash",
    "regions",
    "summary",
    "orderingPolicy",
    "rankerRetrained",
    "newOofRun",
    "sourceArtifactHash",
    "utilityItemsHash",
    "schemaVersion",
    "sourceIdentity",
    "sourceTimebase",
    "runtimeGoldInputCount",
    "visibility",
    "coverageItemsHash",
    "policyVersion",
    "policyHash",
    "artifactType",
    "bindingHash",
    "semanticHash"
  ],
  "additionalProperties": false
}
