{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-safety-target-clusters-v2.schema.json",
  "title": "machine-safety-target-clusters-v2",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14.2-safety-selection-detector-ceiling-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "sourceTimebase": {
      "type": "string",
      "const": "SOURCE_GLOBAL_NATIVE_SAMPLES"
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "visibility": { "type": "string", "const": "LOCAL_ONLY" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": {
      "type": "string",
      "const": "machine-safety-target-clusters-v2"
    },
    "uncoveredHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "oldSafetyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "boundaryHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "speechUnionHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "clusterId": { "type": "string", "minLength": 1 },
          "memberCandidateIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "parentIslandIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "atomicNativeIntervals": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "startSample": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "endSample": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["startSample", "endSample"],
              "additionalProperties": false
            }
          },
          "atomicSourceIntervals": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": { "type": "number", "minimum": 0 },
                "end": { "type": "number", "exclusiveMinimum": 0 }
              },
              "required": ["start", "end"],
              "additionalProperties": false
            }
          },
          "targetCoreUnion": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "startSample": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "endSample": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["startSample", "endSample"],
              "additionalProperties": false
            }
          },
          "reviewEnvelope": {
            "type": "object",
            "properties": {
              "startSample": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "endSample": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["startSample", "endSample"],
            "additionalProperties": false
          },
          "observationIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "evidenceIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "requestIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "detectorFamilies": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "SILERO",
                "PYANNOTE",
                "WEBRTC",
                "LEGACY_FINGERPRINT",
                "EXISTING_VERIFIED",
                "LOCALIZED_LEXICAL"
              ]
            }
          },
          "independentFamilies": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "independentFamilyCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "evidenceStrata": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "MULTI_DETECTOR",
                "PYANNOTE_EXCLUSIVE",
                "SILERO_EXCLUSIVE",
                "WEBRTC_EXCLUSIVE",
                "LEGACY_FINGERPRINT_EXCLUSIVE",
                "MULTI_VIEW_SAME_DETECTOR",
                "EXISTING_VERIFIED",
                "MASKED_SUBTHRESHOLD",
                "AUDIT_ONLY"
              ]
            }
          },
          "distinctPcmViewIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "diversityBins": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "sceneIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "uncoveredSpeechSeconds": { "type": "number", "exclusiveMinimum": 0 },
          "internalSilenceSeconds": { "type": "number", "minimum": 0 },
          "crossesCueBoundary": { "type": "boolean", "const": false },
          "crossesExistingTarget": { "type": "boolean", "const": false },
          "crossesSceneBoundary": { "type": "boolean", "const": false },
          "crossesSpeakerBoundary": { "type": "boolean", "const": false },
          "verifiedTimebase": { "type": "boolean" },
          "strongContradiction": { "type": "boolean" },
          "eligible": { "type": "boolean" },
          "eligibilityReasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "evidenceStrength": { "type": "number" },
          "oldTargetIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "maskedEvidenceIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "clusterId",
          "memberCandidateIds",
          "parentIslandIds",
          "atomicNativeIntervals",
          "atomicSourceIntervals",
          "targetCoreUnion",
          "reviewEnvelope",
          "observationIds",
          "evidenceIds",
          "requestIds",
          "detectorFamilies",
          "independentFamilies",
          "independentFamilyCount",
          "evidenceStrata",
          "distinctPcmViewIds",
          "diversityBins",
          "sceneIds",
          "uncoveredSpeechSeconds",
          "internalSilenceSeconds",
          "crossesCueBoundary",
          "crossesExistingTarget",
          "crossesSceneBoundary",
          "crossesSpeakerBoundary",
          "verifiedTimebase",
          "strongContradiction",
          "eligible",
          "eligibilityReasons",
          "evidenceStrength",
          "oldTargetIds",
          "maskedEvidenceIds",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "atomicCandidateCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "clusterCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "eligibleClusterCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mergedCandidateCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "largestClusterMemberCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "speechCoreUnionSeconds": { "type": "number", "minimum": 0 },
        "envelopeAsSpeechCount": { "type": "number", "const": 0 }
      },
      "required": [
        "atomicCandidateCount",
        "clusterCount",
        "eligibleClusterCount",
        "mergedCandidateCount",
        "largestClusterMemberCount",
        "speechCoreUnionSeconds",
        "envelopeAsSpeechCount"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "policyHash",
    "sourceIdentity",
    "sourceTimebase",
    "runtimeGoldInputCount",
    "visibility",
    "semanticHash",
    "artifactType",
    "uncoveredHash",
    "oldSafetyHash",
    "boundaryHash",
    "speechUnionHash",
    "clusters",
    "summary"
  ],
  "additionalProperties": false
}
