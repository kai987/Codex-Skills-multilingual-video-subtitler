{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/final-text-integrity.schema.json",
  "title": "final-text-integrity",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "inputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "configuration": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["off", "observe", "enforce"] },
        "ordinaryHardMinimumDurationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ordinaryWarningMinimumDurationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "singleCharacterMinimumDurationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "mode",
        "ordinaryHardMinimumDurationSeconds",
        "ordinaryWarningMinimumDurationSeconds",
        "singleCharacterMinimumDurationSeconds"
      ],
      "additionalProperties": false
    },
    "validationStatus": {
      "type": "string",
      "enum": ["passed", "needs-review"]
    },
    "candidateCueCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "finalCueCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "quarantinedCueIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "code": {
            "type": "string",
            "enum": [
              "FINAL_SINGLE_CHARACTER_FRAGMENT",
              "FINAL_EXTREME_SHORT_DURATION",
              "FINAL_INCOMPLETE_MORPHEME",
              "FINAL_INCOMPLETE_CLAUSE",
              "FINAL_TEXT_BOUNDARY_BREAK",
              "FINAL_COMPETING_HYPOTHESES",
              "FINAL_NEAR_DUPLICATE_SEMANTIC_CUE",
              "FINAL_UNSUPPORTED_CONTENT_WORD",
              "FINAL_INVALID_JAPANESE_FRAGMENT",
              "FINAL_LYRICS_HALLUCINATION",
              "FINAL_LYRICS_INCOMPLETE_LINE",
              "FINAL_REFERENCE_SEMANTIC_CONFLICT",
              "FINAL_VISUAL_LINE_WORD_BREAK",
              "SEGMENTATION_UNRESOLVED"
            ]
          },
          "severity": { "type": "string", "enum": ["hard", "warning"] },
          "category": {
            "type": "string",
            "enum": [
              "fragment",
              "text",
              "hypothesis",
              "lyrics",
              "segmentation",
              "semantic",
              "presentation"
            ]
          },
          "interval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "cueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "sourceCueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "sourceRequestIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "referenceAnchorIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "reasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "id",
          "code",
          "severity",
          "category",
          "interval",
          "cueIds",
          "sourceCueIds",
          "sourceRequestIds",
          "referenceAnchorIds",
          "reasons"
        ],
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "singleCharacterFragmentCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "extremeShortDurationCueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "incompleteMorphemeCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "incompleteClauseCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "boundarySplitCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "competingHypothesesFinalCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "nearDuplicateSemanticCueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lyricsHallucinationCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lyricsIncompleteLineCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "segmentationUnresolvedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "singleCharacterFragmentCount",
        "extremeShortDurationCueCount",
        "incompleteMorphemeCount",
        "incompleteClauseCount",
        "boundarySplitCount",
        "competingHypothesesFinalCount",
        "nearDuplicateSemanticCueCount",
        "lyricsHallucinationCount",
        "lyricsIncompleteLineCount",
        "segmentationUnresolvedCount"
      ],
      "additionalProperties": false
    },
    "fallback": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "inputHash",
    "configuration",
    "validationStatus",
    "candidateCueCount",
    "finalCueCount",
    "quarantinedCueIds",
    "findings",
    "metrics",
    "fallback"
  ],
  "additionalProperties": false
}
