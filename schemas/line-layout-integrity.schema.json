{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/line-layout-integrity.schema.json",
  "title": "line-layout-integrity",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "inputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "findings": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "code": {
                "type": "string",
                "const": "FINAL_VISUAL_LINE_WORD_BREAK"
              },
              "cueId": { "type": "string", "minLength": 1 },
              "lineBoundaryIndex": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "left": { "type": "string" },
              "right": { "type": "string" },
              "reasons": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "required": [
              "id",
              "code",
              "cueId",
              "lineBoundaryIndex",
              "left",
              "right",
              "reasons"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "code": {
                "type": "string",
                "enum": [
                  "FINAL_LINE_EXCEEDS_CHARACTER_LIMIT",
                  "FINAL_CUE_EXCEEDS_TWO_LINES",
                  "FINAL_UNRESOLVED_PRESENTATION_CAPACITY"
                ]
              },
              "cueId": { "type": "string", "minLength": 1 },
              "lineIndex": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  { "type": "null" }
                ]
              },
              "observed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "maximum": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "reasons": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "required": [
              "id",
              "code",
              "cueId",
              "lineIndex",
              "observed",
              "maximum",
              "reasons"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "visualLineWordBreakCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "lineTooLongCount": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tooManyLinesCount": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "unresolvedCapacityCount": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "validationStatus": { "type": "string", "enum": ["passed", "needs-review"] }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "inputHash",
    "findings",
    "visualLineWordBreakCount",
    "lineTooLongCount",
    "tooManyLinesCount",
    "unresolvedCapacityCount",
    "validationStatus"
  ],
  "additionalProperties": false
}
