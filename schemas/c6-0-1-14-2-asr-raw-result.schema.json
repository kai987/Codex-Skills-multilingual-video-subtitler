{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-14-2-asr-raw-result.schema.json",
  "title": "c6-0-1-14-2-asr-raw-result",
  "type": "object",
  "properties": {
    "inferenceExecuted": { "type": "boolean" },
    "status": {
      "type": "string",
      "enum": ["SUCCESS", "EMPTY_OUTPUT", "PROVIDER_ERROR"]
    },
    "text": { "type": "string" },
    "rawOutput": {
      "anyOf": [{ "$ref": "#/$defs/__schema0" }, { "type": "null" }]
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": { "type": "string" },
          "sourceInterval": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "start": { "type": "number", "minimum": 0 },
                  "end": { "type": "number", "exclusiveMinimum": 0 }
                },
                "required": ["start", "end"],
                "additionalProperties": false
              },
              { "type": "null" }
            ]
          },
          "trusted": { "type": "boolean" },
          "probability": {
            "anyOf": [
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "null" }
            ]
          },
          "reason": { "type": "string" }
        },
        "required": [
          "text",
          "sourceInterval",
          "trusted",
          "probability",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "decoder": {
      "type": "object",
      "properties": {
        "averageLogProbability": {
          "anyOf": [{ "type": "number" }, { "type": "null" }]
        },
        "noSpeechProbability": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "null" }
          ]
        },
        "temperature": { "anyOf": [{ "type": "number" }, { "type": "null" }] }
      },
      "required": [
        "averageLogProbability",
        "noSpeechProbability",
        "temperature"
      ],
      "additionalProperties": false
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "wallClockSeconds": { "type": "number", "minimum": 0 }
  },
  "required": [
    "status",
    "text",
    "rawOutput",
    "tokens",
    "decoder",
    "warnings",
    "wallClockSeconds"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/__schema0" } },
        {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": { "$ref": "#/$defs/__schema0" }
        }
      ]
    }
  }
}
