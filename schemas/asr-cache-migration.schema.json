{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/asr-cache-migration.schema.json",
  "title": "asr-cache-migration",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "importedRoots": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requestId": { "type": "string", "minLength": 1 },
          "legacyKey": { "type": "string", "minLength": 1 },
          "legacyPath": { "type": "string", "minLength": 1 },
          "currentKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "status": {
            "type": "string",
            "enum": ["migrated", "rejected", "corrupt", "not-found"]
          },
          "checks": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "requestId",
          "legacyKey",
          "legacyPath",
          "currentKey",
          "status",
          "checks"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "migratedEntryCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rejectedEntryCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "corruptEntryCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "migratedEntryCount",
        "rejectedEntryCount",
        "corruptEntryCount"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "importedRoots",
    "entries",
    "summary"
  ],
  "additionalProperties": false
}
