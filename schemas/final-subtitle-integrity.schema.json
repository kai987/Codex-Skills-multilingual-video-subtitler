              "FINAL_INVALID_JAPANESE_FRAGMENT",
              "FINAL_LYRICS_HALLUCINATION",
              "FINAL_LYRICS_INCOMPLETE_LINE",
              "FINAL_REFERENCE_SEMANTIC_CONFLICT",
              "FINAL_VISUAL_LINE_WORD_BREAK",
              "FINAL_INTRA_CUE_HYPOTHESIS_REPETITION",
              "FINAL_UNNATURAL_JAPANESE_SPACING",
              "FINAL_LINE_EXCEEDS_CHARACTER_LIMIT",
              "FINAL_CUE_EXCEEDS_TWO_LINES",
              "FINAL_UNRESOLVED_PRESENTATION_CAPACITY",
              "SEGMENTATION_UNRESOLVED"
            ]
          },
          "severity": { "type": "string", "enum": ["hard", "warning"] },
          "category": {
            "type": "string",
            "enum": [
              "repetition",
              "coverage",
              "timing",
              "fragment",
              "text",
              "hypothesis",
              "lyrics",
              "segmentation",
              "semantic",
              "presentation"
            ]
          },
          "interval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "cueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "sourceCueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "sourceRequestIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "referenceAnchorIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "vocalRegionIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "sceneIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "repetitionEvidence": {
            "type": "object",
            "properties": {
              "normalizedCorePhrase": { "type": "string", "minLength": 1 },
              "occurrences": {
                "type": "integer",
                "minimum": 2,
                "maximum": 9007199254740991
              },
              "contributingSegmentIds": {
                "minItems": 1,
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "suffixVariants": {
                "type": "array",
                "items": { "type": "string" }
              },
              "repeatedCharacterRatio": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "normalizedCorePhrase",
              "occurrences",
              "contributingSegmentIds",
              "suffixVariants",
              "repeatedCharacterRatio"
            ],
            "additionalProperties": false
          },
          "reasons": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "id",
          "code",
          "severity",
          "category",
          "interval",
          "cueIds",
          "reasons"
        ],
        "additionalProperties": false
      }
    },
    "vocalRegions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "interval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "type": {
            "type": "string",
            "enum": [
              "dialogue",
              "singing",
              "music-with-possible-vocals",
              "instrumental",
              "unknown"
            ]
          },
          "vocalEvidence": { "type": "boolean" },
          "vocalEvidenceConfidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reasons": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "sourceRecoveryUnitIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "sourceSceneIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "finalCueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "coverageRatio": { "type": "number", "minimum": 0, "maximum": 1 },
          "missingLyrics": { "type": "boolean" }
        },
        "required": [
          "id",
          "interval",
          "type",
          "vocalEvidence",
          "vocalEvidenceConfidence",
          "reasons",
          "finalCueIds",
          "coverageRatio",
          "missingLyrics"
        ],
        "additionalProperties": false
      }
    },
    "vocalCoverage": {
      "type": "object",
      "properties": {
        "regionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "highConfidenceRegionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "totalVocalDurationSeconds": { "type": "number", "minimum": 0 },
        "subtitleCoveredVocalDurationSeconds": {
          "type": "number",
          "minimum": 0
        },
        "explicitReviewVocalDurationSeconds": {
          "type": "number",
          "minimum": 0
        },
        "uncoveredVocalDurationSeconds": { "type": "number", "minimum": 0 },
        "subtitleCoverageRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "regionCount",
        "highConfidenceRegionCount",
        "totalVocalDurationSeconds",
        "subtitleCoveredVocalDurationSeconds",
        "explicitReviewVocalDurationSeconds",
        "uncoveredVocalDurationSeconds",
        "subtitleCoverageRatio"
      ],
      "additionalProperties": false
    },
    "gateFailures": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
