  "required": [
    "schemaVersion",
    "generatedAt",
    "validationStatus",
    "candidateCueCount",
    "finalCueCount",
    "quarantinedCueIds",
    "candidateMetrics",
    "metrics",
    "findings",
    "vocalRegions",
    "vocalCoverage",
    "gateFailures"
  ],
