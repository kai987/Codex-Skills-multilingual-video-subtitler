{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/final-subtitle-integrity.schema.json",
  "title": "final-subtitle-integrity",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "validationStatus": {
      "type": "string",
      "enum": ["passed", "needs-review"]
    },
    "candidateCueCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "finalCueCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "quarantinedCueIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "candidateMetrics": {
      "type": "object",
      "properties": {
        "singleCueDuplicateLineCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "crossCueExactDuplicateCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "crossCueSentenceLoopCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "crossCueLongPhraseLoopCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "missingLyricsRegionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "uncoveredVocalRegionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "invalidTimestampCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outOfOrderCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "overlapCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unsupportedLongCueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "intraCueHypothesisRepetitionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unnaturalJapaneseSpacingCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lineExceedsCharacterLimitCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cueExceedsTwoLinesCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unresolvedPresentationCapacityCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "uniqueNormalizedCueRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "singleCueDuplicateLineCount",
        "crossCueExactDuplicateCount",
        "crossCueSentenceLoopCount",
        "crossCueLongPhraseLoopCount",
        "missingLyricsRegionCount",
        "uncoveredVocalRegionCount",
        "invalidTimestampCount",
        "outOfOrderCount",
        "overlapCount",
        "unsupportedLongCueCount",
        "uniqueNormalizedCueRatio"
      ],
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "singleCueDuplicateLineCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "crossCueExactDuplicateCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "crossCueSentenceLoopCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "crossCueLongPhraseLoopCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "missingLyricsRegionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "uncoveredVocalRegionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "invalidTimestampCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outOfOrderCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "overlapCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unsupportedLongCueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "intraCueHypothesisRepetitionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unnaturalJapaneseSpacingCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lineExceedsCharacterLimitCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cueExceedsTwoLinesCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unresolvedPresentationCapacityCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "uniqueNormalizedCueRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "singleCueDuplicateLineCount",
        "crossCueExactDuplicateCount",
        "crossCueSentenceLoopCount",
        "crossCueLongPhraseLoopCount",
