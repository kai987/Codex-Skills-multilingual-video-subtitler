{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-12-ideal-review-upper-bound.schema.json",
  "title": "c6-0-1-12-ideal-review-upper-bound",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.12-multi-asr-review-assistance-v2"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "c6-0-1-12-ideal-review-upper-bound"
    },
    "simulationType": {
      "type": "string",
      "const": "IDEAL_REVIEWER_SIMULATION"
    },
    "simulationMethod": {
      "type": "string",
      "const": "GLOBAL_TEXT_RECOMPUTATION_WITH_SELECTED_GOLD_ALIGNMENTS"
    },
    "reviewPackageFreezeHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "qualityEvaluationHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reviewPackageFreezeVerifiedBeforeGoldRead": {
      "type": "boolean",
      "const": true
    },
    "evaluatorGoldInputCount": { "type": "number", "const": 1 },
    "budgetResults": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "budget": {
            "type": "string",
            "enum": [
              "TOP_10_PERCENT",
              "TOP_20_PERCENT",
              "TOP_30_PERCENT",
              "TOP_40_PERCENT",
              "TOP_50_PERCENT",
              "ALL_REQUIRED"
            ]
          },
          "selectedReviewItems": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "selectedRegions": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "audioSeconds": { "type": "number", "minimum": 0 },
          "residualExactCer": { "type": "number", "minimum": 0 },
          "residualNormalizedCer": { "type": "number", "minimum": 0 },
          "residualMaterialErrors": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "residualSevereTiming": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "residualMissing": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "residualHallucination": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "budget",
          "selectedReviewItems",
          "selectedRegions",
          "audioSeconds",
          "residualExactCer",
          "residualNormalizedCer",
          "residualMaterialErrors",
          "residualSevereTiming",
          "residualMissing",
          "residualHallucination"
        ],
        "additionalProperties": false
      }
    },
    "humanReviewSessionCreated": { "type": "boolean", "const": false },
    "humanCorrectionLogCreated": { "type": "boolean", "const": false },
    "humanReviewedProductionOutputCreated": {
      "type": "boolean",
      "const": false
    },
    "machineFinalMutated": { "type": "boolean", "const": false },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "simulationType",
    "simulationMethod",
    "reviewPackageFreezeHash",
    "qualityEvaluationHash",
    "reviewPackageFreezeVerifiedBeforeGoldRead",
    "evaluatorGoldInputCount",
    "budgetResults",
    "humanReviewSessionCreated",
    "humanCorrectionLogCreated",
    "humanReviewedProductionOutputCreated",
    "machineFinalMutated",
    "semanticHash"
  ],
  "additionalProperties": false
}
