{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-1-2-reranker-profile-freeze.schema.json",
  "title": "c6-1-2-reranker-profile-freeze",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "c6-1-2-reranker-profile-freeze"
    },
    "policyVersion": {
      "type": "string",
      "const": "c6.1.2-top-k-reranking-acoustic-completeness-v1"
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "profileHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "algorithm": {
            "type": "string",
            "enum": ["PAIRWISE_LOGISTIC", "LISTWISE_SOFTMAX", "FIXED_BASELINE"]
          },
          "retrieval": {
            "anyOf": [
              { "type": "number", "const": 0 },
              { "type": "number", "const": 1 },
              { "type": "number", "const": 3 }
            ]
          },
          "enabled": { "type": "array", "items": { "type": "boolean" } },
          "completenessGate": { "type": "boolean" },
          "contractionGate": { "type": "boolean" },
          "correlationBalanced": { "type": "boolean" },
          "abstention": { "type": "boolean" }
        },
        "required": [
          "id",
          "algorithm",
          "retrieval",
          "enabled",
          "completenessGate",
          "contractionGate",
          "correlationBalanced",
          "abstention"
        ],
        "additionalProperties": false
      }
    },
    "primaryProfile": { "type": "string", "const": "L6" },
    "supervisedModelsFitAfterTrainLabels": { "type": "boolean", "const": true }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "policyVersion",
    "semanticHash",
    "profileHash",
    "policyHash",
    "profiles",
    "primaryProfile",
    "supervisedModelsFitAfterTrainLabels"
  ],
  "additionalProperties": false
}
