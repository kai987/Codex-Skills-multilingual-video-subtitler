{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-14-acceptance-probe-audit.schema.json",
  "title": "c6-0-1-14-acceptance-probe-audit",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["fresh", "exact-cache-only", "completion-inherited-fresh"]
    },
    "plannedRequests": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "requestRecordCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "recordedFreshInferences": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "consumedFreshInferences": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "persistedResultCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "persistedSuccessfulResults": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "persistedEmptyOutputResults": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "verifiedCacheResults": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "replayCacheHits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "historicalLostSuccessfulResults": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "unpersistedPlannedRequests": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "defaultRequestLimit": { "type": "number", "const": 64 },
    "authorizedAdditionalInferences": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "budgetPassed": { "type": "boolean" },
    "persistencePassed": { "type": "boolean" },
    "accountingPassed": { "type": "boolean" },
    "passed": { "type": "boolean" }
  },
  "required": [
    "mode",
    "plannedRequests",
    "requestRecordCount",
    "recordedFreshInferences",
    "consumedFreshInferences",
    "persistedResultCount",
    "persistedSuccessfulResults",
    "persistedEmptyOutputResults",
    "verifiedCacheResults",
    "replayCacheHits",
    "historicalLostSuccessfulResults",
    "unpersistedPlannedRequests",
    "defaultRequestLimit",
    "authorizedAdditionalInferences",
    "budgetPassed",
    "persistencePassed",
    "accountingPassed",
    "passed"
  ],
  "additionalProperties": false
}
