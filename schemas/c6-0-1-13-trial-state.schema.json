{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-13-trial-state.schema.json",
  "title": "c6-0-1-13-trial-state",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "trialId": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["INITIALIZED", "ACTIVE", "PAUSED", "COMPLETED"]
    },
    "eventCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "lastEventHash": {
      "anyOf": [
        { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        { "type": "null" }
      ]
    },
    "metrics": {
      "type": "object",
      "properties": {
        "totalElapsedSeconds": { "type": "number", "minimum": 0 },
        "activeReviewSeconds": { "type": "number", "minimum": 0 },
        "audioPlaybackSeconds": { "type": "number", "minimum": 0 },
        "uniqueAudioPlayedSeconds": { "type": "number", "minimum": 0 },
        "repeatedAudioSeconds": { "type": "number", "minimum": 0 },
        "regionOpenCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "decisionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "candidateClickCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "candidateBaseEditCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "manualEditCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "manualCharactersEntered": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "timingEditCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "newCueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "falsePositiveCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unresolvedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "requiredCompletionRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "playedSourceIntervals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "minimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "totalElapsedSeconds",
        "activeReviewSeconds",
        "audioPlaybackSeconds",
        "uniqueAudioPlayedSeconds",
        "repeatedAudioSeconds",
        "regionOpenCount",
        "decisionCount",
        "candidateClickCount",
        "candidateBaseEditCount",
        "manualEditCount",
        "manualCharactersEntered",
        "timingEditCount",
        "newCueCount",
        "falsePositiveCount",
        "unresolvedCount",
        "requiredCompletionRate",
        "playedSourceIntervals"
      ],
      "additionalProperties": false
    },
    "realHumanSessionExecuted": { "type": "boolean" },
    "humanReviewTimeMeasured": { "type": "boolean" }
  },
  "required": [
    "schemaVersion",
    "trialId",
    "status",
    "eventCount",
    "lastEventHash",
    "metrics",
    "realHumanSessionExecuted",
    "humanReviewTimeMeasured"
  ],
  "additionalProperties": false
}
