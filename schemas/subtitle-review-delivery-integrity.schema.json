{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/subtitle-review-delivery-integrity.schema.json",
  "title": "subtitle-review-delivery-integrity",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "subtitle-review-delivery-integrity"
    },
    "deliveryVersion": { "type": "string", "const": "C5.17.2" },
    "policyVersion": {
      "type": "string",
      "const": "c5.17.2-review-delivery-integrity-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "sourceTaskIdentity": {
      "type": "object",
      "properties": {
        "taskName": { "type": "string", "minLength": 1 },
        "sourceReviewPackageHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceFinalizationReportHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "taskName",
        "sourceReviewPackageHash",
        "sourceFinalizationReportHash"
      ],
      "additionalProperties": false
    },
    "baseCueHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "baseTimingHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reviewPackageHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "finalizationReportHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidenceReconciliationHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reviewId": { "type": "string", "minLength": 1 },
          "componentId": { "type": "string", "minLength": 1 },
          "cueIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "componentUnionInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "audioClipPath": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!\\/)(?![A-Za-z]:[\\\\/])(?!\\\\\\\\).+"
              },
              { "type": "null" }
            ]
          },
          "audioIncludedInShareable": { "default": false, "type": "boolean" },
          "audioFileName": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "audioDurationSeconds": {
            "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
          },
          "audioFileExists": { "type": "boolean" },
          "audioPathIsRelative": { "type": "boolean" },
          "audioPathWithinTaskRoot": { "type": "boolean" },
          "audioHashExpected": {
            "anyOf": [
              { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              { "type": "null" }
            ]
          },
          "audioHashActual": {
            "anyOf": [
              { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              { "type": "null" }
            ]
          },
          "audioHashMatches": { "type": "boolean" },
          "audioMetadataValid": { "type": "boolean" },
          "audioFullyCoversComponent": { "type": "boolean" },
          "rootReviewPackageMatchesReviewDataCopy": { "type": "boolean" },
          "mappedTokenEvidenceResolved": { "type": "boolean" },
          "rawVadEvidenceResolved": { "type": "boolean" },
          "decodedSegmentEvidenceResolved": { "type": "boolean" },
          "mfaEvidenceResolved": { "type": "boolean" },
          "evidenceDpResolved": { "type": "boolean" },
          "legacyProjectionConsistent": { "type": "boolean" },
          "reviewPageAudioResolvable": { "type": "boolean" },
          "reviewPageEvidenceResolvable": { "type": "boolean" },
          "deliveryPassed": { "type": "boolean" },
          "failures": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "reviewId",
          "componentId",
          "cueIds",
          "componentUnionInterval",
          "audioClipPath",
          "audioIncludedInShareable",
          "audioFileName",
          "audioDurationSeconds",
          "audioFileExists",
          "audioPathIsRelative",
          "audioPathWithinTaskRoot",
          "audioHashExpected",
          "audioHashActual",
          "audioHashMatches",
          "audioMetadataValid",
          "audioFullyCoversComponent",
          "rootReviewPackageMatchesReviewDataCopy",
          "mappedTokenEvidenceResolved",
          "rawVadEvidenceResolved",
          "decodedSegmentEvidenceResolved",
          "mfaEvidenceResolved",
          "evidenceDpResolved",
          "legacyProjectionConsistent",
          "reviewPageAudioResolvable",
          "reviewPageEvidenceResolvable",
          "deliveryPassed",
          "failures"
        ],
        "additionalProperties": false
      }
    },
    "crossArtifactChecks": {
      "type": "object",
      "properties": {
        "rootReviewPackageMatchesReviewDataCopy": { "type": "boolean" },
        "reviewSummaryMatchesItems": { "type": "boolean" },
        "finalizationMetricsMatchReviewSummary": { "type": "boolean" },
        "reviewPageAssetsPresent": { "type": "boolean" },
        "reviewPageAudioReferencesResolvable": { "type": "boolean" },
        "reviewPageEvidenceReferencesResolvable": { "type": "boolean" },
        "shareableContainsNoAudio": { "type": "boolean" },
        "shareableContainsNoBrokenAudioReference": { "type": "boolean" },
        "canonicalCueHashUnchanged": { "type": "boolean" },
        "canonicalTimingHashUnchanged": { "type": "boolean" }
      },
      "required": [
        "rootReviewPackageMatchesReviewDataCopy",
        "reviewSummaryMatchesItems",
        "finalizationMetricsMatchReviewSummary",
        "reviewPageAssetsPresent",
        "reviewPageAudioReferencesResolvable",
        "reviewPageEvidenceReferencesResolvable",
        "shareableContainsNoAudio",
        "shareableContainsNoBrokenAudioReference",
        "canonicalCueHashUnchanged",
        "canonicalTimingHashUnchanged"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "itemCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "passedItemCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failedItemCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reviewAudioPhysicalFileCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reviewAudioReferencedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reviewAudioPlayableCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reviewAudioReusedExistingCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reviewAudioReusedOverlapCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reviewAudioGeneratedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reviewAudioHashMismatchCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reviewAudioCoverageFailureCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reviewAudioMetadataFailureCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mappedTokenEvidenceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rawVadEvidenceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "decodedSegmentEvidenceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mappedTokenBoundaryCopiedFromEvidenceDpCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "decodedSegmentMislabelledAsRawVadCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unresolvedEvidenceReferenceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rootReviewDataMismatchCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "finalizationReviewMetricMismatchCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reviewPageBrokenAudioReferenceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reviewDeliveryIntegrityPassed": { "type": "boolean" }
      },
      "required": [
        "itemCount",
        "passedItemCount",
        "failedItemCount",
        "reviewAudioPhysicalFileCount",
        "reviewAudioReferencedCount",
        "reviewAudioPlayableCount",
        "reviewAudioReusedExistingCount",
        "reviewAudioReusedOverlapCount",
        "reviewAudioGeneratedCount",
        "reviewAudioHashMismatchCount",
        "reviewAudioCoverageFailureCount",
        "reviewAudioMetadataFailureCount",
        "mappedTokenEvidenceCount",
        "rawVadEvidenceCount",
        "decodedSegmentEvidenceCount",
        "mappedTokenBoundaryCopiedFromEvidenceDpCount",
        "decodedSegmentMislabelledAsRawVadCount",
        "unresolvedEvidenceReferenceCount",
        "rootReviewDataMismatchCount",
        "finalizationReviewMetricMismatchCount",
        "reviewPageBrokenAudioReferenceCount",
        "reviewDeliveryIntegrityPassed"
      ],
      "additionalProperties": false
    },
    "failures": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "deliveryVersion",
    "policyVersion",
    "generatedAt",
    "sourceTaskIdentity",
    "baseCueHash",
    "baseTimingHash",
    "reviewPackageHash",
    "finalizationReportHash",
    "evidenceReconciliationHash",
    "items",
    "crossArtifactChecks",
    "summary",
    "failures",
    "semanticHash"
  ],
  "additionalProperties": false
}
