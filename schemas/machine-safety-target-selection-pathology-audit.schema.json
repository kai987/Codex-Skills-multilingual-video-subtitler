{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-safety-target-selection-pathology-audit.schema.json",
  "title": "machine-safety-target-selection-pathology-audit",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14.2-safety-selection-detector-ceiling-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "sourceTimebase": {
      "type": "string",
      "const": "SOURCE_GLOBAL_NATIVE_SAMPLES"
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "visibility": { "type": "string", "const": "LOCAL_ONLY" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": {
      "type": "string",
      "const": "machine-safety-target-selection-pathology-audit"
    },
    "oldSafetyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "uncoveredHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "clustersHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "counts": {
      "type": "object",
      "properties": {
        "candidates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "eligible": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "selected": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "overflow": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "auditOnly": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "slotsMaximum": { "type": "number", "const": 24 },
        "secondsMaximum": { "type": "number", "const": 60 },
        "selectedUnionSeconds": { "type": "number", "minimum": 0 },
        "slotUtilization": { "type": "number", "minimum": 0, "maximum": 1 },
        "durationUtilization": { "type": "number", "minimum": 0, "maximum": 1 },
        "largestClusterMemberCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "adjacentSelectedFragmentCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maximumRollingDensity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "exclusiveOverflowCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "exclusiveSelectedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "candidates",
        "eligible",
        "selected",
        "overflow",
        "auditOnly",
        "slotsMaximum",
        "secondsMaximum",
        "selectedUnionSeconds",
        "slotUtilization",
        "durationUtilization",
        "largestClusterMemberCount",
        "adjacentSelectedFragmentCount",
        "maximumRollingDensity",
        "exclusiveOverflowCount",
        "exclusiveSelectedCount"
      ],
      "additionalProperties": false
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dimension": {
            "type": "string",
            "enum": ["STRATUM", "DETECTOR", "TIME_BIN"]
          },
          "key": { "type": "string", "minLength": 1 },
          "eligible": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "selected": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "overflow": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "auditOnly": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "selectedSeconds": { "type": "number", "minimum": 0 }
        },
        "required": [
          "dimension",
          "key",
          "eligible",
          "selected",
          "overflow",
          "auditOnly",
          "selectedSeconds"
        ],
        "additionalProperties": false
      }
    },
    "exclusiveStarvation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stratum": {
            "type": "string",
            "enum": [
              "MULTI_DETECTOR",
              "PYANNOTE_EXCLUSIVE",
              "SILERO_EXCLUSIVE",
              "WEBRTC_EXCLUSIVE",
              "LEGACY_FINGERPRINT_EXCLUSIVE",
              "MULTI_VIEW_SAME_DETECTOR",
              "EXISTING_VERIFIED",
              "MASKED_SUBTHRESHOLD",
              "AUDIT_ONLY"
            ]
          },
          "eligible": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "selected": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "overflow": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "starved": { "type": "boolean" }
        },
        "required": ["stratum", "eligible", "selected", "overflow", "starved"],
        "additionalProperties": false
      }
    },
    "diagnosis": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "inferenceCount": { "type": "number", "const": 0 },
    "modelLoadCount": { "type": "number", "const": 0 },
    "providerProcessStartCount": { "type": "number", "const": 0 }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "policyHash",
    "sourceIdentity",
    "sourceTimebase",
    "runtimeGoldInputCount",
    "visibility",
    "semanticHash",
    "artifactType",
    "oldSafetyHash",
    "uncoveredHash",
    "clustersHash",
    "counts",
    "groups",
    "exclusiveStarvation",
    "diagnosis",
    "inferenceCount",
    "modelLoadCount",
    "providerProcessStartCount"
  ],
  "additionalProperties": false
}
