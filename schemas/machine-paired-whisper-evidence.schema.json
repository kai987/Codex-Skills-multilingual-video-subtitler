{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-paired-whisper-evidence.schema.json",
  "title": "machine-paired-whisper-evidence",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.11-paired-evidence-independent-discriminator-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "machine-paired-whisper-evidence"
    },
    "corpusSemanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "contextPolicy": {
      "type": "string",
      "const": "symmetric-one-second-source-context-v1"
    },
    "promptPolicy": {
      "type": "string",
      "const": "null-prompt-no-candidate-no-gold-v1"
    },
    "modelIdentity": {
      "type": "object",
      "properties": {
        "modelId": { "type": "string", "const": "whisper.cpp/large-v3" },
        "modelSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "runtimeId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "runtimeBinarySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "runtimePatchSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "device": { "type": "string", "enum": ["metal", "cpu"] },
        "precision": { "type": "string", "minLength": 1 }
      },
      "required": [
        "modelId",
        "modelSha256",
        "runtimeId",
        "runtimeBinarySha256",
        "runtimePatchSha256",
        "device",
        "precision"
      ],
      "additionalProperties": false
    },
    "requests": {
      "type": "object",
      "properties": {
        "coreExactPlannedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "coreExactActualCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "coreExactFreshInferenceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "coreExactCacheReplayCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "coreContextPlannedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "coreContextActualCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "coreContextFreshInferenceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "coreContextCacheReplayCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "modelLoadCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "processStartCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "coreExactPlannedCount",
        "coreExactActualCount",
        "coreExactFreshInferenceCount",
        "coreExactCacheReplayCount",
        "coreContextPlannedCount",
        "coreContextActualCount",
        "coreContextFreshInferenceCount",
        "coreContextCacheReplayCount",
        "failedCount",
        "modelLoadCount",
        "processStartCount"
      ],
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eventId": { "type": "string", "minLength": 1 },
          "whisperCurrentCandidate": {
            "type": "object",
            "properties": {
              "candidateId": { "type": "string", "minLength": 1 },
              "displayText": { "type": "string" },
              "normalizedText": { "type": "string" },
              "pronunciationText": { "type": "string" },
              "hallucinationRisk": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            },
            "required": [
              "candidateId",
              "displayText",
              "normalizedText",
              "pronunciationText",
              "hallucinationRisk",
              "semanticHash"
            ],
            "additionalProperties": false
          },
          "whisperCoreExact": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "candidateId": { "type": "string", "minLength": 1 },
                  "displayText": { "type": "string" },
                  "normalizedText": { "type": "string" },
                  "pronunciationText": { "type": "string" },
                  "hallucinationRisk": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "semanticHash": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "requestId": { "type": "string", "minLength": 1 },
                  "windowType": {
                    "type": "string",
                    "enum": ["CORE_EXACT", "CORE_CONTEXT"]
                  },
                  "sourceInterval": {
                    "type": "object",
                    "properties": {
                      "start": { "type": "number", "minimum": 0 },
                      "end": { "type": "number", "exclusiveMinimum": 0 }
                    },
                    "required": ["start", "end"],
                    "additionalProperties": false
                  },
                  "audioSha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "cacheKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  "execution": {
                    "type": "string",
                    "enum": ["FRESH_INFERENCE", "VERIFIED_EXACT_REPLAY"]
                  },
                  "decoderEvidence": {
                    "type": "object",
                    "properties": {
                      "averageLogProbability": {
                        "anyOf": [{ "type": "number" }, { "type": "null" }]
                      },
                      "noSpeechProbability": {
                        "anyOf": [
                          { "type": "number", "minimum": 0, "maximum": 1 },
                          { "type": "null" }
                        ]
                      },
                      "compressionRatio": {
                        "anyOf": [
                          { "type": "number", "minimum": 0 },
                          { "type": "null" }
                        ]
                      },
                      "temperature": {
                        "anyOf": [
                          { "type": "number", "minimum": 0 },
                          { "type": "null" }
                        ]
                      },
                      "fallbackCount": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          { "type": "null" }
                        ]
                      },
                      "tokenTimestampAvailable": { "type": "boolean" },
                      "decoderSegmentCount": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "averageLogProbability",
                      "noSpeechProbability",
                      "compressionRatio",
                      "temperature",
                      "fallbackCount",
                      "tokenTimestampAvailable",
                      "decoderSegmentCount"
                    ],
                    "additionalProperties": false
                  },
                  "tokenEvidenceAvailable": { "type": "boolean" }
                },
                "required": [
                  "candidateId",
                  "displayText",
                  "normalizedText",
                  "pronunciationText",
                  "hallucinationRisk",
                  "semanticHash",
                  "requestId",
                  "windowType",
                  "sourceInterval",
                  "audioSha256",
                  "cacheKey",
                  "execution",
                  "decoderEvidence",
                  "tokenEvidenceAvailable"
                ],
                "additionalProperties": false
              },
              { "type": "null" }
            ]
          },
          "whisperCoreContext": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "candidateId": { "type": "string", "minLength": 1 },
                  "displayText": { "type": "string" },
                  "normalizedText": { "type": "string" },
                  "pronunciationText": { "type": "string" },
                  "hallucinationRisk": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "semanticHash": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "requestId": { "type": "string", "minLength": 1 },
                  "windowType": {
                    "type": "string",
                    "enum": ["CORE_EXACT", "CORE_CONTEXT"]
                  },
                  "sourceInterval": {
                    "type": "object",
                    "properties": {
                      "start": { "type": "number", "minimum": 0 },
                      "end": { "type": "number", "exclusiveMinimum": 0 }
                    },
                    "required": ["start", "end"],
                    "additionalProperties": false
                  },
                  "audioSha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "cacheKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  "execution": {
                    "type": "string",
                    "enum": ["FRESH_INFERENCE", "VERIFIED_EXACT_REPLAY"]
                  },
                  "decoderEvidence": {
                    "type": "object",
                    "properties": {
                      "averageLogProbability": {
                        "anyOf": [{ "type": "number" }, { "type": "null" }]
                      },
                      "noSpeechProbability": {
                        "anyOf": [
                          { "type": "number", "minimum": 0, "maximum": 1 },
                          { "type": "null" }
                        ]
                      },
                      "compressionRatio": {
                        "anyOf": [
                          { "type": "number", "minimum": 0 },
                          { "type": "null" }
                        ]
                      },
                      "temperature": {
                        "anyOf": [
                          { "type": "number", "minimum": 0 },
                          { "type": "null" }
                        ]
                      },
                      "fallbackCount": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          { "type": "null" }
                        ]
                      },
                      "tokenTimestampAvailable": { "type": "boolean" },
                      "decoderSegmentCount": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "averageLogProbability",
                      "noSpeechProbability",
                      "compressionRatio",
                      "temperature",
                      "fallbackCount",
                      "tokenTimestampAvailable",
                      "decoderSegmentCount"
                    ],
                    "additionalProperties": false
                  },
                  "tokenEvidenceAvailable": { "type": "boolean" }
                },
                "required": [
                  "candidateId",
                  "displayText",
                  "normalizedText",
                  "pronunciationText",
                  "hallucinationRisk",
                  "semanticHash",
                  "requestId",
                  "windowType",
                  "sourceInterval",
                  "audioSha256",
                  "cacheKey",
                  "execution",
                  "decoderEvidence",
                  "tokenEvidenceAvailable"
                ],
                "additionalProperties": false
              },
              { "type": "null" }
            ]
          },
          "stabilityClass": {
            "type": "string",
            "enum": [
              "WHISPER_CORE_STABLE",
              "WHISPER_CONTEXT_EXTENSION_ONLY",
              "WHISPER_LEXICALLY_UNSTABLE",
              "WHISPER_HALLUCINATION_UNSTABLE",
              "WHISPER_EMPTY_UNSTABLE",
              "WHISPER_PARTIAL_AGREEMENT",
              "WHISPER_UNCOMPARABLE"
            ]
          },
          "exactAudioSha256": {
            "anyOf": [
              { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              { "type": "null" }
            ]
          },
          "contextAudioSha256": {
            "anyOf": [
              { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              { "type": "null" }
            ]
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "eventId",
          "whisperCurrentCandidate",
          "whisperCoreExact",
          "whisperCoreContext",
          "stabilityClass",
          "exactAudioSha256",
          "contextAudioSha256",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "requiredEventCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pairedEvidenceAvailableCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "exactOnlyCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "contextMissingCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "uncomparableCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "stabilityCounts": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "WHISPER_CORE_STABLE",
              "WHISPER_CONTEXT_EXTENSION_ONLY",
              "WHISPER_LEXICALLY_UNSTABLE",
              "WHISPER_HALLUCINATION_UNSTABLE",
              "WHISPER_EMPTY_UNSTABLE",
              "WHISPER_PARTIAL_AGREEMENT",
              "WHISPER_UNCOMPARABLE"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "required": [
            "WHISPER_CORE_STABLE",
            "WHISPER_CONTEXT_EXTENSION_ONLY",
            "WHISPER_LEXICALLY_UNSTABLE",
            "WHISPER_HALLUCINATION_UNSTABLE",
            "WHISPER_EMPTY_UNSTABLE",
            "WHISPER_PARTIAL_AGREEMENT",
            "WHISPER_UNCOMPARABLE"
          ]
        },
        "runtimeGoldInputCount": { "type": "number", "const": 0 },
        "networkUsed": { "type": "boolean", "const": false }
      },
      "required": [
        "requiredEventCount",
        "pairedEvidenceAvailableCount",
        "exactOnlyCount",
        "contextMissingCount",
        "uncomparableCount",
        "coverage",
        "stabilityCounts",
        "runtimeGoldInputCount",
        "networkUsed"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "corpusSemanticHash",
    "sourceMediaSha256",
    "contextPolicy",
    "promptPolicy",
    "modelIdentity",
    "requests",
    "events",
    "summary",
    "semanticHash"
  ],
  "additionalProperties": false
}
