{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/ctc-model-manifest.schema.json",
  "title": "ctc-model-manifest",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": { "type": "string", "const": "ctc-model-manifest" },
    "modelVersion": { "type": "string", "const": "C5.18.1" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "modelRepo": {
      "type": "string",
      "const": "reazon-research/japanese-wav2vec2-large-rs35kh"
    },
    "requestedRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "resolvedRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "snapshotDirectory": { "type": "string", "minLength": 1 },
    "modelSnapshotHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "modelFiles": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relativePath": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!\\/)(?![A-Za-z]:[\\\\/])(?!\\\\\\\\).+"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": ["relativePath", "size", "sha256"],
        "additionalProperties": false
      }
    },
    "architecture": { "type": "string", "const": "Wav2Vec2ForCTC" },
    "language": { "type": "string", "const": "ja" },
    "license": { "type": "string", "const": "Apache-2.0" },
    "trustRemoteCode": { "type": "boolean", "const": false },
    "networkUsedDuringPreparation": { "type": "boolean" },
    "hfTokenStored": { "type": "boolean", "const": false },
    "separationModel": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "modelRepo": {
              "type": "string",
              "const": "speechbrain/sepformer-whamr16k"
            },
            "requestedRevision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "resolvedRevision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "snapshotDirectory": { "type": "string", "minLength": 1 },
            "modelSnapshotHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "modelFiles": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "relativePath": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!\\/)(?![A-Za-z]:[\\\\/])(?!\\\\\\\\).+"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                },
                "required": ["relativePath", "size", "sha256"],
                "additionalProperties": false
              }
            },
            "license": { "type": "string", "minLength": 1 },
            "domain": {
              "type": "string",
              "const": "WHAMR 16 kHz English mixtures"
            },
            "targetDomainCompatibility": {
              "type": "string",
              "const": "cross-domain-experimental"
            }
          },
          "required": [
            "modelRepo",
            "requestedRevision",
            "resolvedRevision",
            "snapshotDirectory",
            "modelSnapshotHash",
            "modelFiles",
            "license",
            "domain",
            "targetDomainCompatibility"
          ],
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "modelVersion",
    "generatedAt",
    "modelRepo",
    "requestedRevision",
    "resolvedRevision",
    "snapshotDirectory",
    "modelSnapshotHash",
    "modelFiles",
    "architecture",
    "language",
    "license",
    "trustRemoteCode",
    "networkUsedDuringPreparation",
    "hfTokenStored",
    "separationModel"
  ],
  "additionalProperties": false
}
