{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-9-validation.schema.json",
  "title": "c6-0-1-9-validation",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.9-independent-asr-complementarity-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": { "type": "string", "const": "c6-0-1-9-validation" },
    "branch": {
      "type": "string",
      "const": "codex/c6-0-1-9-independent-asr-complementarity"
    },
    "repositoryCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "goldSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["id", "passed", "evidence"],
        "additionalProperties": false
      }
    },
    "finalABParity": {
      "type": "object",
      "properties": {
        "diagnosticSet": { "type": "boolean" },
        "candidates": { "type": "boolean" },
        "stability": { "type": "boolean" },
        "comparison": { "type": "boolean" },
        "ctcArbitration": { "type": "boolean" },
        "routeDecision": { "type": "boolean" },
        "productionText": { "type": "boolean" },
        "productionTiming": { "type": "boolean" }
      },
      "required": [
        "diagnosticSet",
        "candidates",
        "stability",
        "comparison",
        "ctcArbitration",
        "routeDecision",
        "productionText",
        "productionTiming"
      ],
      "additionalProperties": false
    },
    "productionHashes": {
      "type": "object",
      "properties": {
        "canonicalText": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "canonicalTiming": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "presentation": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "ass": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "srt": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "vtt": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "required": [
        "canonicalText",
        "canonicalTiming",
        "presentation",
        "ass",
        "srt",
        "vtt"
      ],
      "additionalProperties": false
    },
    "sourceReadOnlyVerified": { "type": "boolean" },
    "goldReadOnlyVerified": { "type": "boolean" },
    "networkUsedDuringAcceptance": { "type": "boolean", "const": false },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "datasetHardcodingFindingCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "canonicalTextMutationCount": { "type": "number", "const": 0 },
    "canonicalTimingMutationCount": { "type": "number", "const": 0 },
    "productionStatus": { "type": "string", "const": "needs-review" },
    "finalizationMethod": { "type": "string", "const": "none" },
    "machineReleaseAuthorized": { "type": "boolean", "const": false },
    "engineeringPassed": { "type": "boolean" },
    "diagnosticPassed": { "type": "boolean" },
    "strictC602QualityGatePassed": { "type": "boolean", "const": false },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "branch",
    "repositoryCommit",
    "sourceMediaSha256",
    "goldSha256",
    "checks",
    "finalABParity",
    "productionHashes",
    "sourceReadOnlyVerified",
    "goldReadOnlyVerified",
    "networkUsedDuringAcceptance",
    "runtimeGoldInputCount",
    "datasetHardcodingFindingCount",
    "canonicalTextMutationCount",
    "canonicalTimingMutationCount",
    "productionStatus",
    "finalizationMethod",
    "machineReleaseAuthorized",
    "engineeringPassed",
    "diagnosticPassed",
    "strictC602QualityGatePassed",
    "semanticHash"
  ],
  "additionalProperties": false
}
