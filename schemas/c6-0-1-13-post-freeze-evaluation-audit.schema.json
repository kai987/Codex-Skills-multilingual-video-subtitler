{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-13-post-freeze-evaluation-audit.schema.json",
  "title": "c6-0-1-13-post-freeze-evaluation-audit",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.13-region-burden-calibration-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "c6-0-1-13-post-freeze-evaluation-audit"
    },
    "machineFreezeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ablationFreezeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "machineFeaturesHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "foldsHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "firstGoldReadAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "frozenMachineFilesVerifiedBeforeGoldRead": {
      "type": "boolean",
      "const": true
    },
    "frozenMachineFileCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "frozenMachineFilesUnchanged": { "type": "boolean" },
    "sourceIdentityBefore": {
      "type": "object",
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mtimeMs": { "type": "number", "minimum": 0 },
        "inode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["sha256", "size", "mtimeMs", "inode"],
      "additionalProperties": false
    },
    "sourceIdentityAfter": {
      "type": "object",
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mtimeMs": { "type": "number", "minimum": 0 },
        "inode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["sha256", "size", "mtimeMs", "inode"],
      "additionalProperties": false
    },
    "goldIdentityBefore": {
      "type": "object",
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mtimeMs": { "type": "number", "minimum": 0 },
        "inode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["sha256", "size", "mtimeMs", "inode"],
      "additionalProperties": false
    },
    "goldIdentityAfter": {
      "type": "object",
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mtimeMs": { "type": "number", "minimum": 0 },
        "inode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["sha256", "size", "mtimeMs", "inode"],
      "additionalProperties": false
    },
    "qualityEvaluationSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "goldEvaluationSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "upstreamEvaluationFilesUnchanged": { "type": "boolean" },
    "sourceReadOnly": { "type": "boolean" },
    "goldReadOnly": { "type": "boolean" },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "evaluatorGoldInputCount": { "type": "number", "const": 1 },
    "asrInferenceCount": { "type": "number", "const": 0 },
    "networkUsed": { "type": "boolean", "const": false },
    "candidateFixabilityReevaluated": { "type": "boolean", "const": false },
    "evaluatedStages": {
      "minItems": 8,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["A0", "A1", "A2", "A3", "A4", "A5", "A6", "A7"]
      }
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "machineFreezeHash",
    "ablationFreezeHash",
    "machineFeaturesHash",
    "foldsHash",
    "firstGoldReadAt",
    "frozenMachineFilesVerifiedBeforeGoldRead",
    "frozenMachineFileCount",
    "frozenMachineFilesUnchanged",
    "sourceIdentityBefore",
    "sourceIdentityAfter",
    "goldIdentityBefore",
    "goldIdentityAfter",
    "qualityEvaluationSha256",
    "goldEvaluationSha256",
    "upstreamEvaluationFilesUnchanged",
    "sourceReadOnly",
    "goldReadOnly",
    "runtimeGoldInputCount",
    "evaluatorGoldInputCount",
    "asrInferenceCount",
    "networkUsed",
    "candidateFixabilityReevaluated",
    "evaluatedStages",
    "semanticHash"
  ],
  "additionalProperties": false
}
