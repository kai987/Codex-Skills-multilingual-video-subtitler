{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-10-holdout-gold-evaluation.schema.json",
  "title": "c6-0-1-10-holdout-gold-evaluation",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.10-cross-model-arbitration-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "c6-0-1-10-holdout-gold-evaluation"
    },
    "evaluationPhase": {
      "type": "string",
      "const": "post-final-freeze-gold-isolated"
    },
    "machineFreezeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "goldIdentityHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "goldTextIncluded": { "type": "boolean", "const": false },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eventId": { "type": "string", "minLength": 1 },
          "evaluationStatus": {
            "type": "string",
            "enum": ["EVALUABLE_LOCAL", "UNEVALUABLE_NO_GOLD_OVERLAP"]
          },
          "matchedGoldCueCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "matchedGoldTextHash": {
            "anyOf": [
              { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              { "type": "null" }
            ]
          },
          "baselineWhisperPoolError": {
            "anyOf": [
              { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              { "type": "null" }
            ]
          },
          "reazonCoreExactError": {
            "anyOf": [
              { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              { "type": "null" }
            ]
          },
          "finalArbitrationError": {
            "anyOf": [
              { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              { "type": "null" }
            ]
          },
          "arbitrationDecision": {
            "type": "string",
            "enum": [
              "AGREEMENT_NO_CHANGE",
              "KEEP_CURRENT_WHISPER",
              "SELECT_REAZON",
              "ABSTAIN_REVIEW",
              "BLOCKED_NOT_LOCALIZABLE",
              "BLOCKED_NO_SAFE_SPAN",
              "BLOCKED_REAZON_UNSTABLE",
              "BLOCKED_CONFLICTING_EVIDENCE"
            ]
          },
          "switchOutcome": {
            "type": "string",
            "enum": [
              "NO_SWITCH",
              "CORRECT_SWITCH",
              "WRONG_SWITCH",
              "NEUTRAL_SWITCH"
            ]
          },
          "oracleGain": {
            "anyOf": [
              { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              { "type": "null" }
            ]
          },
          "realizedGain": {
            "anyOf": [{ "type": "number" }, { "type": "null" }]
          },
          "avoidedRegression": { "type": "boolean" },
          "abstentionAvoidedWrongMutation": { "type": "boolean" },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "eventId",
          "evaluationStatus",
          "matchedGoldCueCount",
          "matchedGoldTextHash",
          "baselineWhisperPoolError",
          "reazonCoreExactError",
          "finalArbitrationError",
          "arbitrationDecision",
          "switchOutcome",
          "oracleGain",
          "realizedGain",
          "avoidedRegression",
          "abstentionAvoidedWrongMutation",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "holdoutEventCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "evaluableEventCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "evaluableSwitchCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "correctSwitchCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "wrongSwitchCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "neutralSwitchCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "avoidedRegressionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "abstentionUtilityCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "availableOracleGain": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "realizedArbitrationGain": { "type": "number" }
      },
      "required": [
        "holdoutEventCount",
        "evaluableEventCount",
        "evaluableSwitchCount",
        "correctSwitchCount",
        "wrongSwitchCount",
        "neutralSwitchCount",
        "avoidedRegressionCount",
        "abstentionUtilityCount",
        "availableOracleGain",
        "realizedArbitrationGain"
      ],
      "additionalProperties": false
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "evaluationPhase",
    "machineFreezeHash",
    "goldIdentityHash",
    "goldTextIncluded",
    "events",
    "summary",
    "runtimeGoldInputCount",
    "semanticHash"
  ],
  "additionalProperties": false
}
