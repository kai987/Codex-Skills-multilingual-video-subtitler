{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/series-language-memory.schema.json",
  "title": "series-language-memory",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": { "type": "string", "const": "series-language-memory" },
    "memoryVersion": { "type": "string", "const": "C5.19" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "seriesIdentity": {
      "type": "object",
      "properties": {
        "seriesKey": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "normalizedTitle": { "type": "string", "minLength": 1 },
        "year": {
          "anyOf": [
            { "type": "integer", "minimum": 1800, "maximum": 2200 },
            { "type": "null" }
          ]
        },
        "season": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            { "type": "null" }
          ]
        },
        "mediaType": {
          "type": "string",
          "enum": ["series", "movie", "special", "unknown"]
        },
        "identitySource": {
          "type": "string",
          "enum": [
            "subtitle-package-media-identity",
            "explicit-series-task",
            "curated-memory"
          ]
        },
        "identityStatus": {
          "type": "string",
          "enum": ["verified", "provisional", "insufficient"]
        },
        "identityEvidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "memoryScope": {
          "type": "string",
          "enum": ["episode", "season", "series"]
        }
      },
      "required": [
        "seriesKey",
        "title",
        "normalizedTitle",
        "year",
        "season",
        "mediaType",
        "identitySource",
        "identityStatus",
        "identityEvidence",
        "memoryScope"
      ],
      "additionalProperties": false
    },
    "parentMemoryHash": {
      "anyOf": [
        { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        { "type": "null" }
      ]
    },
    "memoryHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "revisionId": { "type": "string", "minLength": 1 },
    "memoryRevisionId": { "type": "string", "minLength": 1 },
    "appliedDeltaHash": {
      "anyOf": [
        { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        { "type": "null" }
      ]
    },
    "sourceEpisodeIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "configuration": {
      "type": "object",
      "properties": {
        "maximumEntryCount": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "memoryTieBreakMargin": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "globalReplacementEnabled": { "type": "boolean", "const": false },
        "finalizationAuthorityEnabled": { "type": "boolean", "const": false },
        "networkUsed": { "type": "boolean", "const": false }
      },
      "required": [
        "maximumEntryCount",
        "memoryTieBreakMargin",
        "globalReplacementEnabled",
        "finalizationAuthorityEnabled",
        "networkUsed"
      ],
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entryId": { "type": "string", "minLength": 1 },
          "seriesKey": { "type": "string", "minLength": 1 },
          "entryType": {
            "type": "string",
            "enum": [
              "proper-noun",
              "person-name",
              "place-name",
              "organization-name",
              "title-name",
              "terminology",
              "regional-term",
              "domain-term",
              "dialect-form",
              "fixed-expression",
              "pronunciation-only",
              "orthographic-variant",
              "correction-pair"
            ]
          },
          "canonicalSurface": { "type": "string", "minLength": 1 },
          "canonicalSurfaceNfc": { "type": "string", "minLength": 1 },
          "lookupKeyNfkc": { "type": "string", "minLength": 1 },
          "readingHiragana": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "readingKatakana": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "pronunciationPhones": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "dictionaryForm": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "normalizedForm": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "partOfSpeech": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "variants": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "orthographicVariants": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "acousticAliases": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "acousticAliasProvenance": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "alias": { "type": "string", "minLength": 1 },
                "aliasType": {
                  "type": "string",
                  "enum": [
                    "reading",
                    "orthographic-reading",
                    "human-correction-reading"
                  ]
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "sudachi-reading",
                    "mfa-dictionary-reading",
                    "g2p-reading",
                    "manual-reading",
                    "human-correction-reading"
                  ]
                },
                "sourceArtifactHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "sourceEntryId": { "type": "string", "minLength": 1 },
                "sourceEvidenceIds": {
                  "minItems": 1,
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "trustLevel": {
                  "type": "string",
                  "enum": [
                    "human-corrected",
                    "human-reviewed",
                    "validated-series",
                    "repeated-verified",
                    "single-observation",
                    "candidate-only"
                  ]
                },
                "verified": { "type": "boolean" }
              },
              "required": [
                "alias",
                "aliasType",
                "source",
                "sourceArtifactHash",
                "sourceEntryId",
                "sourceEvidenceIds",
                "trustLevel",
                "verified"
              ],
              "additionalProperties": false
            }
          },
          "observedWrongForms": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "dialectMetadata": {
            "type": "object",
            "properties": {
              "isDialectCandidate": { "type": "boolean" },
              "status": {
                "type": "string",
                "enum": ["not-dialect", "candidate", "verified"]
              },
              "region": { "type": "string", "minLength": 1 },
              "surfaceForm": {
                "anyOf": [
                  { "type": "string", "minLength": 1 },
                  { "type": "null" }
                ]
              },
              "dialectPattern": {
                "anyOf": [
                  { "type": "string", "minLength": 1 },
                  { "type": "null" }
                ]
              },
              "standardEquivalent": {
                "anyOf": [
                  { "type": "string", "minLength": 1 },
                  { "type": "null" }
                ]
              },
              "equivalenceSource": {
                "anyOf": [
                  { "type": "string", "minLength": 1 },
                  { "type": "null" }
                ]
              },
              "markerType": {
                "anyOf": [
                  { "type": "string", "minLength": 1 },
                  { "type": "null" }
                ]
              },
              "preserveSurface": { "type": "boolean" },
              "preservationRequired": { "type": "boolean" }
            },
            "required": [
              "isDialectCandidate",
              "status",
              "region",
              "surfaceForm",
              "dialectPattern",
              "standardEquivalent",
              "equivalenceSource",
              "markerType",
              "preserveSurface",
              "preservationRequired"
            ],
            "additionalProperties": false
          },
          "preservationPolicy": {
            "type": "string",
            "enum": [
              "preserve-canonical-surface",
              "preserve-dialect-surface",
              "ranking-only",
              "pronunciation-projection-only"
            ]
          },
          "status": {
            "type": "string",
            "enum": ["active", "quarantined", "deprecated"]
          },
          "trustLevel": {
            "type": "string",
            "enum": [
              "human-corrected",
              "human-reviewed",
              "validated-series",
              "repeated-verified",
              "single-observation",
              "candidate-only"
            ]
          },
          "applicationEligibility": {
            "type": "string",
            "enum": [
              "ranking-and-pronunciation",
              "ranking-only",
              "pronunciation-only",
              "suggestion-only",
              "none"
            ]
          },
          "sourceEpisodes": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "firstSeen": { "type": "number", "minimum": 0 },
          "lastSeen": { "type": "number", "minimum": 0 },
          "occurrenceIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "evidenceId": { "type": "string", "minLength": 1 },
                "evidenceLineageId": { "type": "string", "minLength": 1 },
                "episodeId": { "type": "string", "minLength": 1 },
                "cueId": { "type": "string", "minLength": 1 },
                "sourceType": {
                  "type": "string",
                  "enum": [
                    "human-reviewed-canonical",
                    "human-correction",
                    "validated-final-canonical",
                    "reference-consensus",
                    "sudachi-dictionary",
                    "mfa-dictionary",
                    "g2p",
                    "ctc-projection",
                    "asr-candidate",
                    "manual-memory-entry"
                  ]
                },
                "sourceArtifactHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "occurrenceId": { "type": "string", "minLength": 1 },
                "observedAtSeconds": { "type": "number", "minimum": 0 },
                "surface": { "type": "string", "minLength": 1 },
                "reading": {
                  "anyOf": [
                    { "type": "string", "minLength": 1 },
                    { "type": "null" }
                  ]
                },
                "semanticHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "evidenceId",
                "evidenceLineageId",
                "episodeId",
                "cueId",
                "sourceType",
                "sourceArtifactHash",
                "occurrenceId",
                "observedAtSeconds",
                "surface",
                "reading",
                "semanticHash"
              ],
              "additionalProperties": false
            }
          },
          "conflicts": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "entryId",
          "seriesKey",
          "entryType",
          "canonicalSurface",
          "canonicalSurfaceNfc",
          "lookupKeyNfkc",
          "readingHiragana",
          "readingKatakana",
          "pronunciationPhones",
          "dictionaryForm",
          "normalizedForm",
          "partOfSpeech",
          "variants",
          "orthographicVariants",
          "acousticAliases",
          "acousticAliasProvenance",
          "observedWrongForms",
          "dialectMetadata",
          "preservationPolicy",
          "status",
          "trustLevel",
          "applicationEligibility",
          "sourceEpisodes",
          "firstSeen",
          "lastSeen",
          "occurrenceIds",
          "evidence",
          "conflicts",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "conflictId": { "type": "string", "minLength": 1 },
          "conflictType": {
            "type": "string",
            "enum": [
              "reading-conflict",
              "alias-conflict",
              "homograph-conflict",
              "series-identity-conflict"
            ]
          },
          "lookupKeyNfkc": { "type": "string", "minLength": 1 },
          "entryIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "values": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "resolution": {
            "type": "string",
            "enum": ["quarantined", "manual-required", "resolved"]
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "conflictId",
          "conflictType",
          "lookupKeyNfkc",
          "entryIds",
          "values",
          "resolution",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "statistics": {
      "type": "object",
      "properties": {
        "entryCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "properNounEntryCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "terminologyEntryCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dialectEntryCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "correctionEntryCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pronunciationEntryCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "acousticAliasCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ambiguousMemoryAliasCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "conflictedReadingCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "duplicateMemoryEvidenceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "memoryEvidenceDoubleCountPreventedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "entryCount",
        "properNounEntryCount",
        "terminologyEntryCount",
        "dialectEntryCount",
        "correctionEntryCount",
        "pronunciationEntryCount",
        "acousticAliasCount",
        "ambiguousMemoryAliasCount",
        "conflictedReadingCount",
        "duplicateMemoryEvidenceCount",
        "memoryEvidenceDoubleCountPreventedCount"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "memoryVersion",
    "generatedAt",
    "seriesIdentity",
    "parentMemoryHash",
    "memoryHash",
    "revisionId",
    "memoryRevisionId",
    "appliedDeltaHash",
    "sourceEpisodeIds",
    "configuration",
    "entries",
    "conflicts",
    "statistics",
    "semanticHash"
  ],
  "additionalProperties": false
}
