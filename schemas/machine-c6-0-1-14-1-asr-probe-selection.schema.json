{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-c6-0-1-14-1-asr-probe-selection.schema.json",
  "title": "machine-c6-0-1-14-1-asr-probe-selection",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14.1-multiview-speech-inventory-v1"
    },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "sourceTimebase": {
      "type": "string",
      "const": "SOURCE_GLOBAL_NATIVE_SAMPLES"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": {
      "type": "string",
      "const": "machine-c6-0-1-14-1-asr-probe-selection"
    },
    "safetyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "targets": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "islandId": { "type": "string", "minLength": 1 },
          "nativeInterval": {
            "type": "object",
            "properties": {
              "startSample": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "endSample": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["startSample", "endSample"],
            "additionalProperties": false
          },
          "sourceInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "observationIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "evidenceIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "requestIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "independentFamilies": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "independentFamilyCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "distinctPcmViewIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "evidenceClass": {
            "type": "string",
            "enum": [
              "MULTI_DETECTOR_CONFIRMED",
              "LEGACY_FINGERPRINT_CONFIRMED",
              "EXISTING_VERIFIED_SPEECH",
              "MULTI_VIEW_SPEECH_POSITIVE",
              "PYANNOTE_ONLY_SPEECH_POSITIVE",
              "SINGLE_DETECTOR_HIGH_RECALL",
              "DETECTOR_DISAGREEMENT",
              "LOW_SUPPORT_VIEW_SPECIFIC",
              "STRONG_CONTRADICTION",
              "TIMEBASE_UNVERIFIED"
            ]
          },
          "verifiedTimebase": { "type": "boolean" },
          "strongContradiction": { "type": "boolean" },
          "reliableLexical": { "type": "boolean" },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "candidateId": { "type": "string", "minLength": 1 },
          "parentIslandId": { "type": "string", "minLength": 1 },
          "uncoveredRatio": { "type": "number", "minimum": 0, "maximum": 1 },
          "partialCueOverlap": { "type": "boolean" },
          "partialExistingTargetOverlap": { "type": "boolean" },
          "priority": { "type": "number" },
          "diversityBin": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "targetId": { "type": "string", "minLength": 1 },
          "targetType": {
            "type": "string",
            "enum": [
              "SPEECH_INVENTORY_STRONG_UNCOVERED",
              "SPEECH_INVENTORY_POSSIBLE_UNCOVERED"
            ]
          },
          "requiredLevel": { "type": "string", "const": "RECOMMENDED" },
          "canonicalInsertAllowed": { "type": "boolean", "const": false }
        },
        "required": [
          "islandId",
          "nativeInterval",
          "sourceInterval",
          "observationIds",
          "evidenceIds",
          "requestIds",
          "independentFamilies",
          "independentFamilyCount",
          "distinctPcmViewIds",
          "evidenceClass",
          "verifiedTimebase",
          "strongContradiction",
          "reliableLexical",
          "semanticHash",
          "candidateId",
          "parentIslandId",
          "uncoveredRatio",
          "partialCueOverlap",
          "partialExistingTargetOverlap",
          "priority",
          "diversityBin",
          "targetId",
          "targetType",
          "requiredLevel",
          "canonicalInsertAllowed"
        ],
        "additionalProperties": false
      }
    },
    "contextEligibleTargetIds": {
      "maxItems": 4,
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "maximumAuthorizedRequests": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32
    },
    "selectionFrozenAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "targetBackfillAllowed": { "type": "boolean", "const": false },
    "goldBlind": { "type": "boolean", "const": true }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "sourceIdentity",
    "sourceTimebase",
    "policyHash",
    "runtimeGoldInputCount",
    "semanticHash",
    "artifactType",
    "safetyHash",
    "targets",
    "contextEligibleTargetIds",
    "maximumAuthorizedRequests",
    "selectionFrozenAt",
    "targetBackfillAllowed",
    "goldBlind"
  ],
  "additionalProperties": false
}
