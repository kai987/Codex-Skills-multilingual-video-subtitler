{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-14-3-1-nested-semantic-integrity-preflight.schema.json",
  "title": "c6-0-1-14-3-1-nested-semantic-integrity-preflight",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14.3.1-projection-hash-integrity-v1"
    },
    "visibility": { "type": "string", "const": "LOCAL_ONLY" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": {
      "type": "string",
      "const": "c6-0-1-14-3-1-nested-semantic-integrity-preflight"
    },
    "scope": { "type": "string", "const": "PRE_GOLD_MACHINE_FREEZE" },
    "projectionSetHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "projectionVariantCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "inspectedOuterHashCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "validOuterHashCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "projectedAudioRowCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "validProjectedAudioHashCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "playbackRowCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "validPlaybackHashCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "unknownHashableRowCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "SOURCE_ROW_HASH_INVALID",
              "PROJECTED_ROW_HASH_STALE",
              "PROJECTED_ROW_HASH_MISSING",
              "PROJECTED_ROW_SCHEMA_INVALID",
              "NESTED_ROW_HASH_INVALID",
              "OUTER_HASH_VALID_NESTED_HASH_INVALID",
              "HASH_DOMAIN_NOT_REBOUND",
              "UNKNOWN_HASHABLE_ROW_TYPE"
            ]
          },
          "path": { "type": "string", "minLength": 1 },
          "domain": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "SOURCE_WORKSPACE_AUDIO_ROW",
                  "STRICT_C601143_COVERAGE_AUDIO_PROJECTION_ROW",
                  "STRICT_C601143_COVERAGE_PLAYBACK_PROJECTION_ROW",
                  "C601143_PROJECTION_VARIANT",
                  "C601143_PROJECTION_SET"
                ]
              },
              { "type": "null" }
            ]
          },
          "expectedHash": {
            "anyOf": [
              { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              { "type": "null" }
            ]
          },
          "actualHash": {
            "anyOf": [
              { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              { "type": "null" }
            ]
          }
        },
        "required": ["code", "path", "domain", "expectedHash", "actualHash"],
        "additionalProperties": false
      }
    },
    "integrityPassed": { "type": "boolean" },
    "goldReadAttempted": { "type": "boolean", "const": false },
    "inferenceCount": { "type": "number", "const": 0 }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "visibility",
    "semanticHash",
    "artifactType",
    "scope",
    "projectionSetHash",
    "sourceIdentity",
    "projectionVariantCount",
    "inspectedOuterHashCount",
    "validOuterHashCount",
    "projectedAudioRowCount",
    "validProjectedAudioHashCount",
    "playbackRowCount",
    "validPlaybackHashCount",
    "unknownHashableRowCount",
    "failures",
    "integrityPassed",
    "goldReadAttempted",
    "inferenceCount"
  ],
  "additionalProperties": false
}
