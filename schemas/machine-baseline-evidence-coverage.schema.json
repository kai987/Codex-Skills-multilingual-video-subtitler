{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-baseline-evidence-coverage.schema.json",
  "title": "machine-baseline-evidence-coverage",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "machine-baseline-evidence-coverage"
    },
    "coverageVersion": {
      "type": "string",
      "const": "c6.0.1-machine-evidence-coverage-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "generationRunId": { "type": "string", "minLength": 1 },
    "inputManifestHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "machinePackageHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "dimensions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dimensionId": { "type": "string", "minLength": 1 },
          "requiredForFinalCandidate": { "type": "boolean" },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "unknown", "not-applicable"]
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!\\/)(?![A-Za-z]:[\\\\/])(?!\\\\\\\\).+"
            }
          },
          "reasonCodes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "dimensionId",
          "requiredForFinalCandidate",
          "status",
          "evidenceRefs",
          "reasonCodes"
        ],
        "additionalProperties": false
      }
    },
    "modelRuntimeIdentities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "runtimeId": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "executableFileName": { "type": "string", "minLength": 1 },
          "device": { "type": "string", "minLength": 1 },
          "genericResource": { "type": "boolean", "const": true }
        },
        "required": [
          "runtimeId",
          "name",
          "version",
          "executableFileName",
          "device",
          "genericResource"
        ],
        "additionalProperties": false
      }
    },
    "modelExecutionCounts": {
      "type": "object",
      "properties": {
        "whisper": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mfa": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "ctc": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "speaker": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "separation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sudachi": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "openai": { "type": "number", "const": 0 },
        "onlineSubtitleSearch": { "type": "number", "const": 0 },
        "modelLoadCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "modelInferenceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "whisper",
        "mfa",
        "ctc",
        "speaker",
        "separation",
        "sudachi",
        "openai",
        "onlineSubtitleSearch",
        "modelLoadCount",
        "modelInferenceCount"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "requiredDimensionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "passedRequiredDimensionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failedRequiredDimensionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unknownRequiredDimensionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "criticalEvidenceCoveragePassed": { "type": "boolean" },
        "unresolvedHighRiskRegionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unknownSignalCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "requiredDimensionCount",
        "passedRequiredDimensionCount",
        "failedRequiredDimensionCount",
        "unknownRequiredDimensionCount",
        "criticalEvidenceCoveragePassed",
        "unresolvedHighRiskRegionCount",
        "unknownSignalCount"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "coverageVersion",
    "generatedAt",
    "generationRunId",
    "inputManifestHash",
    "machinePackageHash",
    "dimensions",
    "modelRuntimeIdentities",
    "modelExecutionCounts",
    "summary",
    "semanticHash"
  ],
  "additionalProperties": false
}
