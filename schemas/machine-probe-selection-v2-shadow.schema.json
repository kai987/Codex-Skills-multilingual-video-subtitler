{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-probe-selection-v2-shadow.schema.json",
  "title": "machine-probe-selection-v2-shadow",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14-missing-localization-playback-integrity-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "artifactType": {
      "type": "string",
      "const": "machine-missing-dialogue-probe-selection-v2-shadow"
    },
    "completionPolicyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "originalSelectionHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "executedTargetIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "proposedTargetIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "addedTargetIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "removedTargetIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "highValueBudgetExhaustedTargetIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "targetId": { "type": "string", "minLength": 1 },
          "sourceIslandId": { "type": "string", "minLength": 1 },
          "sourceInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "evidenceIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "familyCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "independentSourceCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "speechStrength": { "type": "number", "minimum": 0, "maximum": 1 },
          "uncoveredRatio": { "type": "number", "minimum": 0, "maximum": 1 },
          "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
          "mappingQuality": { "type": "number", "minimum": 0, "maximum": 1 },
          "lexicalAbsence": { "type": "boolean" },
          "parentOrGlobalOrigin": {
            "type": "string",
            "enum": ["CHILD", "GLOBAL", "ORPHAN"]
          },
          "timelineBin": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "selected": { "type": "boolean" },
          "score": { "type": "number" },
          "reasonCodes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "executionStatus": {
            "type": "string",
            "const": "PROBE_NOT_RUN_AUTHORIZATION_EXHAUSTED"
          }
        },
        "required": [
          "targetId",
          "sourceIslandId",
          "sourceInterval",
          "evidenceIds",
          "familyCount",
          "independentSourceCount",
          "speechStrength",
          "uncoveredRatio",
          "durationSeconds",
          "mappingQuality",
          "lexicalAbsence",
          "parentOrGlobalOrigin",
          "timelineBin",
          "selected",
          "score",
          "reasonCodes",
          "executionStatus"
        ],
        "additionalProperties": false
      }
    },
    "context": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "targetId": { "type": "string", "minLength": 1 },
          "score": { "type": "number" },
          "selected": { "type": "boolean" },
          "previouslySelected": { "type": "boolean" },
          "timelineBin": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "reasonCodes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "executionStatus": {
            "type": "string",
            "const": "PROBE_NOT_RUN_AUTHORIZATION_EXHAUSTED"
          }
        },
        "required": [
          "targetId",
          "score",
          "selected",
          "previouslySelected",
          "timelineBin",
          "reasonCodes",
          "executionStatus"
        ],
        "additionalProperties": false
      }
    },
    "newInferenceCount": { "type": "number", "const": 0 },
    "goldUsed": { "type": "boolean", "const": false },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "policyHash",
    "sourceIdentity",
    "sourceTimebase",
    "runtimeGoldInputCount",
    "artifactType",
    "completionPolicyHash",
    "originalSelectionHash",
    "executedTargetIds",
    "proposedTargetIds",
    "addedTargetIds",
    "removedTargetIds",
    "highValueBudgetExhaustedTargetIds",
    "targets",
    "context",
    "newInferenceCount",
    "goldUsed",
    "semanticHash"
  ],
  "additionalProperties": false
}
