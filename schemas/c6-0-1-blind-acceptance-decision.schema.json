{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-blind-acceptance-decision.schema.json",
  "title": "c6-0-1-blind-acceptance-decision",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "c6-0-1-blind-acceptance-decision"
    },
    "decisionVersion": {
      "type": "string",
      "const": "c6.0.1-blind-acceptance-decision-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "benchmarkStatus": {
      "type": "string",
      "const": "development-known-runtime-blind"
    },
    "goldIsolationPassed": { "type": "boolean" },
    "machineGenerationPassed": { "type": "boolean" },
    "outputFreezePassed": { "type": "boolean" },
    "goldEvaluationPassed": { "type": "boolean" },
    "reproducibilityPassed": { "type": "boolean" },
    "shadowPolicyEvaluated": { "type": "boolean" },
    "unsafeFinalizationEscapeTaskCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "unsafeFinalizationEscapeDefectCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "unnecessaryReviewTaskCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "machinePolicySafetyPassed": { "type": "boolean" },
    "runtimeBlindAcceptancePassed": { "type": "boolean" },
    "unseenGeneralizationPassed": { "type": "boolean", "const": false },
    "c6_0_2Required": { "type": "boolean", "const": true },
    "machineOnlyReleaseAuthorized": { "type": "boolean", "const": false },
    "finalRecommendation": {
      "type": "string",
      "enum": ["GO_C6_0_2", "NO_GO_C6_0_2"]
    },
    "reasonCodes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "decisionVersion",
    "generatedAt",
    "benchmarkStatus",
    "goldIsolationPassed",
    "machineGenerationPassed",
    "outputFreezePassed",
    "goldEvaluationPassed",
    "reproducibilityPassed",
    "shadowPolicyEvaluated",
    "unsafeFinalizationEscapeTaskCount",
    "unsafeFinalizationEscapeDefectCount",
    "unnecessaryReviewTaskCount",
    "machinePolicySafetyPassed",
    "runtimeBlindAcceptancePassed",
    "unseenGeneralizationPassed",
    "c6_0_2Required",
    "machineOnlyReleaseAuthorized",
    "finalRecommendation",
    "reasonCodes",
    "semanticHash"
  ],
  "additionalProperties": false
}
