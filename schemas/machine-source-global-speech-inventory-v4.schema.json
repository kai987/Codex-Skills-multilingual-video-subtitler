{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-source-global-speech-inventory-v4.schema.json",
  "title": "machine-source-global-speech-inventory-v4",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14.1-multiview-speech-inventory-v1"
    },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "sourceTimebase": {
      "type": "string",
      "const": "SOURCE_GLOBAL_NATIVE_SAMPLES"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": {
      "type": "string",
      "const": "machine-source-global-speech-inventory-v4"
    },
    "viewsHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "fingerprintHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sweepsEvidenceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "previousIslandsHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "observationId": { "type": "string", "minLength": 1 },
          "nativeInterval": {
            "type": "object",
            "properties": {
              "startSample": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "endSample": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["startSample", "endSample"],
            "additionalProperties": false
          },
          "family": {
            "type": "string",
            "enum": [
              "SILERO",
              "PYANNOTE",
              "LEGACY_FINGERPRINT",
              "EXISTING_VERIFIED",
              "LOCALIZED_LEXICAL"
            ]
          },
          "correlationGroup": { "type": "string", "minLength": 1 },
          "viewId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "profileId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "evidenceIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "requestIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "verifiedTimebase": { "type": "boolean" },
          "speechPositive": { "type": "boolean" },
          "strongContradiction": { "type": "boolean" },
          "reliableLexical": { "type": "boolean" }
        },
        "required": [
          "observationId",
          "nativeInterval",
          "family",
          "correlationGroup",
          "viewId",
          "profileId",
          "evidenceIds",
          "requestIds",
          "verifiedTimebase",
          "speechPositive",
          "strongContradiction",
          "reliableLexical"
        ],
        "additionalProperties": false
      }
    },
    "islands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "islandId": { "type": "string", "minLength": 1 },
          "nativeInterval": {
            "type": "object",
            "properties": {
              "startSample": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "endSample": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["startSample", "endSample"],
            "additionalProperties": false
          },
          "sourceInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "observationIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "evidenceIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "requestIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "independentFamilies": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "independentFamilyCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "distinctPcmViewIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "evidenceClass": {
            "type": "string",
            "enum": [
              "MULTI_DETECTOR_CONFIRMED",
              "LEGACY_FINGERPRINT_CONFIRMED",
              "EXISTING_VERIFIED_SPEECH",
              "MULTI_VIEW_SPEECH_POSITIVE",
              "PYANNOTE_ONLY_SPEECH_POSITIVE",
              "SINGLE_DETECTOR_HIGH_RECALL",
              "DETECTOR_DISAGREEMENT",
              "LOW_SUPPORT_VIEW_SPECIFIC",
              "STRONG_CONTRADICTION",
              "TIMEBASE_UNVERIFIED"
            ]
          },
          "verifiedTimebase": { "type": "boolean" },
          "strongContradiction": { "type": "boolean" },
          "reliableLexical": { "type": "boolean" },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "islandId",
          "nativeInterval",
          "sourceInterval",
          "observationIds",
          "evidenceIds",
          "requestIds",
          "independentFamilies",
          "independentFamilyCount",
          "distinctPcmViewIds",
          "evidenceClass",
          "verifiedTimebase",
          "strongContradiction",
          "reliableLexical",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "observationCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "islandCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "multiDetectorCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "nativeUnionSeconds": { "type": "number", "minimum": 0 },
        "unresolvedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "parentEnvelopeAsSpeechCount": { "type": "number", "const": 0 },
        "correlationInflationCount": { "type": "number", "const": 0 }
      },
      "required": [
        "observationCount",
        "islandCount",
        "multiDetectorCount",
        "nativeUnionSeconds",
        "unresolvedCount",
        "parentEnvelopeAsSpeechCount",
        "correlationInflationCount"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "sourceIdentity",
    "sourceTimebase",
    "policyHash",
    "runtimeGoldInputCount",
    "semanticHash",
    "artifactType",
    "viewsHash",
    "fingerprintHash",
    "sweepsEvidenceHash",
    "previousIslandsHash",
    "observations",
    "islands",
    "summary"
  ],
  "additionalProperties": false
}
