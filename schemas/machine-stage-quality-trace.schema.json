{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-stage-quality-trace.schema.json",
  "title": "machine-stage-quality-trace",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.3-candidate-association-canonical-assembly-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "machine-stage-quality-trace"
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "Raw ASR",
              "Normalized",
              "Candidate",
              "Acoustic Family",
              "Event Assignment",
              "Cluster",
              "Winner",
              "Dedup",
              "Fragment Repair",
              "Canonical Assembly",
              "Segmentation",
              "Final Integrity",
              "Final Machine"
            ]
          },
          "unitCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "textCharacterCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "temporalCoverageSeconds": { "type": "number", "minimum": 0 },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "qualityMetrics": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "goldCoverage": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "normalizedCer": { "type": "number", "minimum": 0 },
                  "materialErrorCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "severeTimingErrorCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "overlapPairCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "goldCoverage",
                  "normalizedCer",
                  "materialErrorCount",
                  "severeTimingErrorCount",
                  "overlapPairCount"
                ],
                "additionalProperties": false
              },
              { "type": "null" }
            ]
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "stage",
          "unitCount",
          "textCharacterCount",
          "temporalCoverageSeconds",
          "semanticHash",
          "qualityMetrics",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "runtimeGoldInputCount",
    "stages",
    "semanticHash"
  ],
  "additionalProperties": false
}
