{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-canonical-assembly.schema.json",
  "title": "machine-canonical-assembly",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.3-candidate-association-canonical-assembly-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": { "type": "string", "const": "machine-canonical-assembly" },
    "mode": { "type": "string", "enum": ["off", "observe", "enforce"] },
    "eventSemanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "operationId": { "type": "string", "minLength": 1 },
          "eventId": { "type": "string", "minLength": 1 },
          "inputCandidateIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "selectedCandidateId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "previousWinnerCandidateId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "outputCueId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "operation": {
            "type": "string",
            "enum": [
              "PRESERVE_WINNER",
              "SELECT_LONG_SUPPORTED_VARIANT",
              "QUARANTINE_EVENT",
              "REJECT_SYNTHETIC_JOIN"
            ]
          },
          "textSource": {
            "type": "string",
            "enum": ["single-real-candidate", "none"]
          },
          "tokenProvenanceComplete": { "type": "boolean" },
          "syntheticTextJoin": { "type": "boolean", "const": false },
          "beforeInterval": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "start": { "type": "number", "minimum": 0 },
                  "end": { "type": "number", "exclusiveMinimum": 0 }
                },
                "required": ["start", "end"],
                "additionalProperties": false
              },
              { "type": "null" }
            ]
          },
          "afterInterval": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "start": { "type": "number", "minimum": 0 },
                  "end": { "type": "number", "exclusiveMinimum": 0 }
                },
                "required": ["start", "end"],
                "additionalProperties": false
              },
              { "type": "null" }
            ]
          },
          "reasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "operationId",
          "eventId",
          "inputCandidateIds",
          "selectedCandidateId",
          "previousWinnerCandidateId",
          "outputCueId",
          "operation",
          "textSource",
          "tokenProvenanceComplete",
          "syntheticTextJoin",
          "beforeInterval",
          "afterInterval",
          "reasons"
        ],
        "additionalProperties": false
      }
    },
    "outputCues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cueId": { "type": "string", "minLength": 1 },
          "eventId": { "type": "string", "minLength": 1 },
          "sourceCandidateId": { "type": "string", "minLength": 1 },
          "interval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "textHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "cueId",
          "eventId",
          "sourceCandidateId",
          "interval",
          "textHash"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "eventCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputCueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "preservedWinnerCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "longVariantSelectionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "quarantinedEventCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "syntheticJoinCount": { "type": "number", "const": 0 },
        "textMutationCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "timingMutationCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "eventCount",
        "outputCueCount",
        "preservedWinnerCount",
        "longVariantSelectionCount",
        "quarantinedEventCount",
        "syntheticJoinCount",
        "textMutationCount",
        "timingMutationCount"
      ],
      "additionalProperties": false
    },
    "inputCueSemanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "outputCueSemanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "mode",
    "eventSemanticHash",
    "operations",
    "outputCues",
    "summary",
    "inputCueSemanticHash",
    "outputCueSemanticHash",
    "semanticHash"
  ],
  "additionalProperties": false
}
