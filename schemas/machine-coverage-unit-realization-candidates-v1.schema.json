{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-coverage-unit-realization-candidates-v1.schema.json",
  "title": "machine-coverage-unit-realization-candidates-v1",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14.5-safety-coverage-unit-contract-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "sourceTimebase": {
      "type": "string",
      "const": "SOURCE_GLOBAL_NATIVE_SAMPLES"
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "visibility": { "type": "string", "const": "LOCAL_ONLY" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": {
      "type": "string",
      "const": "machine-coverage-unit-realization-candidates-v1"
    },
    "coverageUnitsHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "contractPolicyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "bundleCandidatesHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "realizationId": { "type": "string", "minLength": 1 },
          "coverageUnitId": { "type": "string", "minLength": 1 },
          "contractType": {
            "type": "string",
            "enum": [
              "TARGET_CORE_LOCALIZATION_CONTRACT_V1",
              "MACHINE_ANCHORED_PLAYBACK_AUDIBILITY_CONTRACT_V1"
            ]
          },
          "realizationType": {
            "type": "string",
            "enum": [
              "CORE_COMPLETE_REALIZATION",
              "MACHINE_ANCHORED_PLAYBACK_REALIZATION"
            ]
          },
          "childUnitIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "bundleIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "atomicTargetCoreIntervals": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "startSample": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "endSample": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["startSample", "endSample"],
              "additionalProperties": false
            }
          },
          "targetCoreCoverageOfUnit": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "anchorOverlapSamples": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "anchorCoverageRatio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reviewEnvelope": {
            "type": "object",
            "properties": {
              "startSample": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "endSample": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["startSample", "endSample"],
            "additionalProperties": false
          },
          "predictedPlaybackCoverageOfUnit": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "leftContextSeconds": { "type": "number", "minimum": 0 },
          "rightContextSeconds": { "type": "number", "minimum": 0 },
          "targetSlotCost": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "speechCoreCostSamples": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "predictedAudioCostSamples": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "internalSilenceCostSamples": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "obligationCoverage": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "sourceIdentity": {
            "type": "object",
            "properties": {
              "sourceMediaSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
              "sampleRate": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "audioStreamIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "audioTimebase": {
                "type": "string",
                "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
              },
              "sourceTimebase": {
                "type": "string",
                "const": "SOURCE_GLOBAL_SECONDS"
              }
            },
            "required": [
              "sourceMediaSha256",
              "durationSeconds",
              "sampleRate",
              "audioStreamIndex",
              "audioTimebase",
              "sourceTimebase"
            ],
            "additionalProperties": false
          },
          "eligibility": { "type": "boolean" },
          "rejectionReasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "realizationId",
          "coverageUnitId",
          "contractType",
          "realizationType",
          "childUnitIds",
          "bundleIds",
          "atomicTargetCoreIntervals",
          "targetCoreCoverageOfUnit",
          "anchorOverlapSamples",
          "anchorCoverageRatio",
          "reviewEnvelope",
          "predictedPlaybackCoverageOfUnit",
          "leftContextSeconds",
          "rightContextSeconds",
          "targetSlotCost",
          "speechCoreCostSamples",
          "predictedAudioCostSamples",
          "internalSilenceCostSamples",
          "obligationCoverage",
          "sourceIdentity",
          "eligibility",
          "rejectionReasons",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "candidateCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "eligibleCandidateCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "coreCompleteCandidateCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "anchoredPlaybackCandidateCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "unitWithoutCoreCompleteRealizationCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "unitWithoutAnchoredPlaybackRealizationCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "policyHash",
    "sourceIdentity",
    "sourceTimebase",
    "runtimeGoldInputCount",
    "visibility",
    "semanticHash",
    "artifactType",
    "coverageUnitsHash",
    "contractPolicyHash",
    "bundleCandidatesHash",
    "candidates",
    "candidateCount",
    "eligibleCandidateCount",
    "coreCompleteCandidateCount",
    "anchoredPlaybackCandidateCount",
    "unitWithoutCoreCompleteRealizationCount",
    "unitWithoutAnchoredPlaybackRealizationCount"
  ],
  "additionalProperties": false
}
