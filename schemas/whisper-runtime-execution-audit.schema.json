{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/whisper-runtime-execution-audit.schema.json",
  "title": "whisper-runtime-execution-audit",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.1-machine-quality-recovery-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "mode": { "type": "string", "enum": ["off", "observe", "enforce"] },
    "profile": {
      "type": "string",
      "enum": ["legacy", "diagnostics", "coverage", "timing", "full"]
    },
    "run": {
      "type": "object",
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "repositoryCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "goldRuntimeInputCount": { "type": "number", "const": 0 }
      },
      "required": [
        "runId",
        "repositoryCommit",
        "sourceMediaSha256",
        "goldRuntimeInputCount"
      ],
      "additionalProperties": false
    },
    "artifactType": {
      "type": "string",
      "const": "whisper-runtime-execution-audit"
    },
    "runtime": {
      "type": "object",
      "properties": {
        "intendedVersion": { "type": "string" },
        "actualVersion": { "type": "string" },
        "whisperCppVersion": { "type": "string" },
        "modelName": { "type": "string" },
        "modelSha256": {
          "anyOf": [
            { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            { "type": "null" }
          ]
        },
        "binarySha256": {
          "anyOf": [
            { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            { "type": "null" }
          ]
        },
        "runtimeManifest": { "type": "string" },
        "compatibilityReason": { "type": "string" },
        "device": { "type": "string" },
        "requestedMode": { "type": "string" },
        "actualMode": { "type": "string" }
      },
      "required": [
        "intendedVersion",
        "actualVersion",
        "whisperCppVersion",
        "modelName",
        "modelSha256",
        "binarySha256",
        "runtimeManifest",
        "compatibilityReason",
        "device",
        "requestedMode",
        "actualMode"
      ],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "asrRequestCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cacheHitCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inferenceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "processCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "workerStartCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "modelLoadCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "transcriptionSeconds": { "type": "number", "minimum": 0 },
        "fallbackProcessCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "uniqueAudioIntervalCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "duplicateIntervalCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "narrowRequestCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "broadRequestCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "recoveryRequestCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "primaryGenerationRequestCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "averageAudioSeconds": { "type": "number", "minimum": 0 },
        "totalAudioSecondsProcessed": { "type": "number", "minimum": 0 },
        "duplicateAudioSecondsProcessed": { "type": "number", "minimum": 0 }
      },
      "required": [
        "asrRequestCount",
        "cacheHitCount",
        "inferenceCount",
        "processCount",
        "workerStartCount",
        "modelLoadCount",
        "transcriptionSeconds",
        "fallbackProcessCount",
        "uniqueAudioIntervalCount",
        "duplicateIntervalCount",
        "narrowRequestCount",
        "broadRequestCount",
        "recoveryRequestCount",
        "primaryGenerationRequestCount",
        "averageAudioSeconds",
        "totalAudioSecondsProcessed",
        "duplicateAudioSecondsProcessed"
      ],
      "additionalProperties": false
    },
    "evidenceQuality": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["verified", "partial", "unavailable", "rejected"]
        },
        "inspectedArtifactCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "schemaValidatedArtifactCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "semanticEvidenceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reasons": { "type": "array", "items": { "type": "string" } }
      },
      "required": [
        "status",
        "inspectedArtifactCount",
        "schemaValidatedArtifactCount",
        "semanticEvidenceCount",
        "reasons"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "mode",
    "profile",
    "run",
    "artifactType",
    "runtime",
    "execution",
    "evidenceQuality"
  ],
  "additionalProperties": false
}
