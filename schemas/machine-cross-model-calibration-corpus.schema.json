{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-cross-model-calibration-corpus.schema.json",
  "title": "machine-cross-model-calibration-corpus",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.11-paired-evidence-independent-discriminator-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "machine-cross-model-calibration-corpus"
    },
    "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "baselineEvidenceSemanticHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inclusionPolicy": {
      "type": "string",
      "const": "machine-localizable-disagreements-plus-deterministic-low-risk-controls-v1"
    },
    "controlSelectionPolicy": {
      "type": "string",
      "const": "relation-stratified-stable-hash-first-without-gold-v1"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eventId": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "enum": ["DISAGREEMENT", "CONTROL"] },
          "sourceInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "coreInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "crossModelRelation": {
            "type": "string",
            "enum": [
              "EXACT_AGREEMENT",
              "NORMALIZED_AGREEMENT",
              "PRONUNCIATION_AGREEMENT",
              "ORTHOGRAPHY_ONLY_DIFFERENCE",
              "LEXICAL_DISAGREEMENT",
              "WHISPER_HALLUCINATION_RISK",
              "REAZON_HALLUCINATION_RISK",
              "BOTH_LOW_SUPPORT",
              "REAZON_EMPTY",
              "WHISPER_EMPTY",
              "UNCOMPARABLE"
            ]
          },
          "selectionReasons": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "audioGroupId": { "type": "string", "minLength": 1 },
          "goldSeenAtSelection": { "type": "boolean", "const": false },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "eventId",
          "role",
          "sourceInterval",
          "coreInterval",
          "crossModelRelation",
          "selectionReasons",
          "audioGroupId",
          "goldSeenAtSelection",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "eventCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "disagreementCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "controlCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "machineLocalizableCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reconstructableAudioCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "runtimeGoldInputCount": { "type": "number", "const": 0 }
      },
      "required": [
        "eventCount",
        "disagreementCount",
        "controlCount",
        "machineLocalizableCount",
        "reconstructableAudioCount",
        "runtimeGoldInputCount"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "sourceMediaSha256",
    "baselineEvidenceSemanticHash",
    "inclusionPolicy",
    "controlSelectionPolicy",
    "events",
    "summary",
    "semanticHash"
  ],
  "additionalProperties": false
}
