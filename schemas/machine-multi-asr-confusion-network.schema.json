{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-multi-asr-confusion-network.schema.json",
  "title": "machine-multi-asr-confusion-network",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.1-consensus-investigation-v1"
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": {
      "type": "string",
      "const": "machine-multi-asr-confusion-network"
    },
    "networks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eventId": { "type": "string", "minLength": 1 },
          "latticeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "slots": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "slotId": { "type": "string", "minLength": 1 },
                "eventId": { "type": "string", "minLength": 1 },
                "position": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "alternatives": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "nodeId": { "type": "string", "minLength": 1 },
                      "displaySurface": {
                        "anyOf": [{ "type": "string" }, { "type": "null" }]
                      },
                      "normalizedForm": {
                        "anyOf": [{ "type": "string" }, { "type": "null" }]
                      },
                      "pronunciationForm": {
                        "anyOf": [{ "type": "string" }, { "type": "null" }]
                      },
                      "candidateIds": {
                        "type": "array",
                        "items": { "type": "string", "minLength": 1 }
                      },
                      "providerFamilies": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": ["WHISPER", "REAZON", "CURRENT"]
                        }
                      },
                      "correlationGroupIds": {
                        "type": "array",
                        "items": { "type": "string", "minLength": 1 }
                      },
                      "incomingEdges": {
                        "type": "array",
                        "items": { "type": "string", "minLength": 1 }
                      },
                      "outgoingEdges": {
                        "type": "array",
                        "items": { "type": "string", "minLength": 1 }
                      }
                    },
                    "required": [
                      "nodeId",
                      "displaySurface",
                      "normalizedForm",
                      "pronunciationForm",
                      "candidateIds",
                      "providerFamilies",
                      "correlationGroupIds",
                      "incomingEdges",
                      "outgoingEdges"
                    ],
                    "additionalProperties": false
                  }
                },
                "epsilonAlternative": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "nodeId": { "type": "string", "minLength": 1 },
                        "displaySurface": {
                          "anyOf": [{ "type": "string" }, { "type": "null" }]
                        },
                        "normalizedForm": {
                          "anyOf": [{ "type": "string" }, { "type": "null" }]
                        },
                        "pronunciationForm": {
                          "anyOf": [{ "type": "string" }, { "type": "null" }]
                        },
                        "candidateIds": {
                          "type": "array",
                          "items": { "type": "string", "minLength": 1 }
                        },
                        "providerFamilies": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": ["WHISPER", "REAZON", "CURRENT"]
                          }
                        },
                        "correlationGroupIds": {
                          "type": "array",
                          "items": { "type": "string", "minLength": 1 }
                        },
                        "incomingEdges": {
                          "type": "array",
                          "items": { "type": "string", "minLength": 1 }
                        },
                        "outgoingEdges": {
                          "type": "array",
                          "items": { "type": "string", "minLength": 1 }
                        }
                      },
                      "required": [
                        "nodeId",
                        "displaySurface",
                        "normalizedForm",
                        "pronunciationForm",
                        "candidateIds",
                        "providerFamilies",
                        "correlationGroupIds",
                        "incomingEdges",
                        "outgoingEdges"
                      ],
                      "additionalProperties": false
                    },
                    { "type": "null" }
                  ]
                },
                "candidateSupportCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "providerSupportCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "correlationGroupSupportCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "surfaceVariants": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "pronunciationVariants": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "acousticEvidence": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "stabilityEvidence": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "normalizedEntropy": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "ambiguityStatus": {
                  "type": "string",
                  "enum": [
                    "EXACT_AGREEMENT",
                    "NORMALIZED_AGREEMENT",
                    "PRONUNCIATION_EQUIVALENT",
                    "LEXICAL_DISAGREEMENT"
                  ]
                },
                "semanticHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "slotId",
                "eventId",
                "position",
                "alternatives",
                "epsilonAlternative",
                "candidateSupportCount",
                "providerSupportCount",
                "correlationGroupSupportCount",
                "surfaceVariants",
                "pronunciationVariants",
                "acousticEvidence",
                "stabilityEvidence",
                "normalizedEntropy",
                "ambiguityStatus",
                "semanticHash"
              ],
              "additionalProperties": false
            }
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": ["eventId", "latticeHash", "slots", "semanticHash"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "semanticHash",
    "artifactType",
    "networks"
  ],
  "additionalProperties": false
}
