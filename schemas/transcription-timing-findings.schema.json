              "finalCueId",
              "finalText",
              "rawAsrText",
              "repairedText",
              "normalizedText",
              "winnerScore",
              "runnerUpCueId",
              "runnerUpScore",
              "scoreGap",
              "replacementCount",
              "timingDonorCueId",
              "deduplicationActions",
              "reviewReasons"
            ],
            "additionalProperties": false
