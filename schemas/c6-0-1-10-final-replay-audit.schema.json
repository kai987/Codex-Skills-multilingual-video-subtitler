{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-10-final-replay-audit.schema.json",
  "title": "c6-0-1-10-final-replay-audit",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.10-cross-model-arbitration-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "c6-0-1-10-final-replay-audit"
    },
    "runLabel": { "type": "string", "const": "final-b" },
    "repositoryCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "executionKind": { "type": "string", "const": "FROZEN_EXACT_CACHE_REPLAY" },
    "resultCache": {
      "type": "object",
      "properties": {
        "plannedRequestCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "actualRequestCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cacheHitCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inferenceCount": { "type": "number", "const": 0 },
        "modelLoadCount": { "type": "number", "const": 0 },
        "processStartCount": { "type": "number", "const": 0 },
        "networkUsed": { "type": "boolean", "const": false },
        "runtimeGoldInputCount": { "type": "number", "const": 0 }
      },
      "required": [
        "plannedRequestCount",
        "actualRequestCount",
        "cacheHitCount",
        "inferenceCount",
        "modelLoadCount",
        "processStartCount",
        "networkUsed",
        "runtimeGoldInputCount"
      ],
      "additionalProperties": false
    },
    "parity": {
      "type": "object",
      "properties": {
        "evidenceBundles": { "type": "boolean", "const": true },
        "decisions": { "type": "boolean", "const": true },
        "mutationProposals": { "type": "boolean", "const": true },
        "appliedMutations": { "type": "boolean", "const": true },
        "finalText": { "type": "boolean", "const": true },
        "finalTiming": { "type": "boolean", "const": true },
        "ass": { "type": "boolean", "const": true },
        "srt": { "type": "boolean", "const": true },
        "vtt": { "type": "boolean", "const": true },
        "productionStatus": { "type": "boolean", "const": true },
        "routeDecision": { "type": "boolean", "const": true }
      },
      "required": [
        "evidenceBundles",
        "decisions",
        "mutationProposals",
        "appliedMutations",
        "finalText",
        "finalTiming",
        "ass",
        "srt",
        "vtt",
        "productionStatus",
        "routeDecision"
      ],
      "additionalProperties": false
    },
    "machineSemanticPayloadHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "productionHashes": {
      "type": "object",
      "properties": {
        "canonicalText": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "canonicalTiming": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "presentation": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "ass": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "srt": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "vtt": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "required": [
        "canonicalText",
        "canonicalTiming",
        "presentation",
        "ass",
        "srt",
        "vtt"
      ],
      "additionalProperties": false
    },
    "canonicalTextMutationCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "canonicalTimingMutationCount": { "type": "number", "const": 0 },
    "productionStatus": { "type": "string", "const": "needs-review" },
    "finalizationMethod": { "type": "string", "const": "none" },
    "machineReleaseAuthorized": { "type": "boolean", "const": false },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "runLabel",
    "repositoryCommit",
    "sourceMediaSha256",
    "executionKind",
    "resultCache",
    "parity",
    "machineSemanticPayloadHash",
    "productionHashes",
    "canonicalTextMutationCount",
    "canonicalTimingMutationCount",
    "productionStatus",
    "finalizationMethod",
    "machineReleaseAuthorized",
    "semanticHash"
  ],
  "additionalProperties": false
}
