{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-timing-non-degradation.schema.json",
  "title": "machine-timing-non-degradation",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.2-candidate-precision-global-timeline-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "machine-timing-non-degradation"
    },
    "mode": { "type": "string", "enum": ["off", "observe", "enforce"] },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cueId": { "type": "string", "minLength": 1 },
          "before": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "proposed": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "result": {
            "type": "string",
            "enum": ["unchanged", "accepted", "rejected"]
          },
          "trustedTokenIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "overlapSecondsBefore": { "type": "number", "minimum": 0 },
          "overlapSecondsAfter": { "type": "number", "minimum": 0 },
          "reasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "cueId",
          "before",
          "proposed",
          "result",
          "trustedTokenIds",
          "overlapSecondsBefore",
          "overlapSecondsAfter",
          "reasons"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "evaluatedCueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "acceptedMutationCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rejectedMutationCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unchangedCueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "timingRegressionCount": { "type": "number", "const": 0 },
        "proposedMutationCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expansionRejectedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "weakEvidenceRejectedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "trustedTokenAppliedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mfaAppliedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ctcAppliedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "netBoundaryShiftSeconds": { "type": "number", "minimum": 0 }
      },
      "required": [
        "evaluatedCueCount",
        "acceptedMutationCount",
        "rejectedMutationCount",
        "unchangedCueCount",
        "timingRegressionCount",
        "proposedMutationCount",
        "expansionRejectedCount",
        "weakEvidenceRejectedCount",
        "trustedTokenAppliedCount",
        "mfaAppliedCount",
        "ctcAppliedCount",
        "netBoundaryShiftSeconds"
      ],
      "additionalProperties": false
    },
    "beforeTimingHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "afterTimingHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "mode",
    "decisions",
    "summary",
    "beforeTimingHash",
    "afterTimingHash"
  ],
  "additionalProperties": false
}
