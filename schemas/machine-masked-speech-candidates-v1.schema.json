{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-masked-speech-candidates-v1.schema.json",
  "title": "machine-masked-speech-candidates-v1",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14.2-safety-selection-detector-ceiling-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "sourceTimebase": {
      "type": "string",
      "const": "SOURCE_GLOBAL_NATIVE_SAMPLES"
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "visibility": { "type": "string", "const": "LOCAL_ONLY" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": {
      "type": "string",
      "const": "machine-masked-speech-candidates-v1"
    },
    "scoreTracksHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidateId": { "type": "string", "minLength": 1 },
          "nativeInterval": {
            "type": "object",
            "properties": {
              "startSample": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "endSample": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["startSample", "endSample"],
            "additionalProperties": false
          },
          "sourceInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "evidenceClass": {
            "type": "string",
            "enum": [
              "VERIFIED_INDEPENDENT_DETECTOR_SPEECH",
              "WEBRTC_EXCLUSIVE_SPEECH_CANDIDATE",
              "SUBTHRESHOLD_MULTI_VIEW_CANDIDATE",
              "CROSS_DETECTOR_SUBTHRESHOLD_CANDIDATE",
              "MASKED_SPEECH_SAFETY_CANDIDATE",
              "ENERGY_ONLY_UNSUPPORTED",
              "MUSIC_DOMINATED_UNRESOLVED",
              "NO_SPEECH_SUPPORT"
            ]
          },
          "mainRunIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "auditRunIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "detectorFamilies": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "SILERO",
                "PYANNOTE",
                "WEBRTC",
                "LEGACY_FINGERPRINT",
                "EXISTING_VERIFIED",
                "LOCALIZED_LEXICAL"
              ]
            }
          },
          "distinctPcmViewIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "independentFamilyCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "scoreTrackHashes": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          },
          "acousticFeatures": {
            "type": "object",
            "properties": {
              "rms": { "type": "number", "minimum": 0 },
              "levelDbfsProxy": { "type": "number" },
              "dynamicRangeDb": { "type": "number", "minimum": 0 },
              "voiceBandRatio": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "lowBandRatio": { "type": "number", "minimum": 0, "maximum": 1 },
              "highBandRatio": { "type": "number", "minimum": 0, "maximum": 1 },
              "spectralFlatness": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "modulation2To16HzRatio": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "harmonicityProxy": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "pitchContinuityProxy": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "onsetDensityPerSecond": { "type": "number", "minimum": 0 },
              "centerSideEnergyRatio": {
                "anyOf": [
                  { "type": "number", "minimum": 0 },
                  { "type": "null" }
                ]
              }
            },
            "required": [
              "rms",
              "levelDbfsProxy",
              "dynamicRangeDb",
              "voiceBandRatio",
              "lowBandRatio",
              "highBandRatio",
              "spectralFlatness",
              "modulation2To16HzRatio",
              "harmonicityProxy",
              "pitchContinuityProxy",
              "onsetDensityPerSecond",
              "centerSideEnergyRatio"
            ],
            "additionalProperties": false
          },
          "acousticSupport": { "type": "boolean" },
          "acousticContradiction": { "type": "boolean" },
          "eligibleSafetyCandidate": { "type": "boolean" },
          "transcriptTruthVerified": { "type": "boolean", "const": false },
          "reasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "candidateId",
          "nativeInterval",
          "sourceInterval",
          "evidenceClass",
          "mainRunIds",
          "auditRunIds",
          "detectorFamilies",
          "distinctPcmViewIds",
          "independentFamilyCount",
          "scoreTrackHashes",
          "acousticFeatures",
          "acousticSupport",
          "acousticContradiction",
          "eligibleSafetyCandidate",
          "transcriptTruthVerified",
          "reasons",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "featureSourcePcmHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "summary": {
      "type": "object",
      "properties": {
        "candidateCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "eligibleCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mainSupportedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "subthresholdOnlyCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "independentCrossDetectorCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "musicUnresolvedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "energyOnlyPromotedCount": { "type": "number", "const": 0 },
        "sameFamilyVoteInflationCount": { "type": "number", "const": 0 }
      },
      "required": [
        "candidateCount",
        "eligibleCount",
        "mainSupportedCount",
        "subthresholdOnlyCount",
        "independentCrossDetectorCount",
        "musicUnresolvedCount",
        "energyOnlyPromotedCount",
        "sameFamilyVoteInflationCount"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "policyHash",
    "sourceIdentity",
    "sourceTimebase",
    "runtimeGoldInputCount",
    "visibility",
    "semanticHash",
    "artifactType",
    "scoreTracksHash",
    "candidates",
    "featureSourcePcmHash",
    "summary"
  ],
  "additionalProperties": false
}
