{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/forced-alignment-runtime-capability.schema.json",
  "title": "forced-alignment-runtime-capability",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "forced-alignment-runtime-capability"
    },
    "runtimeVersion": { "type": "string", "const": "C5.17" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "backend": { "type": "string", "const": "mfa-japanese" },
    "mfaVersion": { "type": "string", "const": "3.4.2" },
    "pythonVersion": { "type": "string", "minLength": 1 },
    "kalpyVersion": { "type": "string", "minLength": 1 },
    "kaldiVersion": { "type": "string", "minLength": 1 },
    "pyniniVersion": { "type": "string", "minLength": 1 },
    "sudachiVersion": { "type": "string", "minLength": 1 },
    "praatioVersion": { "type": "string", "minLength": 1 },
    "commandCapabilities": {
      "type": "object",
      "properties": {
        "alignOneCommand": {
          "type": "string",
          "enum": ["align_one", "align_one_legacy"]
        },
        "outputFormats": {
          "minItems": 1,
          "type": "array",
          "items": { "type": "string", "enum": ["json", "long_textgrid"] }
        },
        "selectedOutputFormat": {
          "type": "string",
          "enum": ["json", "long_textgrid"]
        },
        "jsonHasWordTier": { "type": "boolean" },
        "jsonHasPhoneTier": { "type": "boolean" },
        "g2pSupported": { "type": "boolean" },
        "originalTextSupported": { "type": "boolean" },
        "tokenizationMode": {
          "type": "string",
          "enum": ["sudachi", "mfa-default-japanese"]
        },
        "speakerAdaptationSkipped": { "type": "boolean", "const": true }
      },
      "required": [
        "alignOneCommand",
        "outputFormats",
        "selectedOutputFormat",
        "jsonHasWordTier",
        "jsonHasPhoneTier",
        "g2pSupported",
        "originalTextSupported",
        "tokenizationMode",
        "speakerAdaptationSkipped"
      ],
      "additionalProperties": false
    },
    "acousticModel": {
      "type": "object",
      "properties": {
        "modelType": {
          "type": "string",
          "enum": ["acoustic", "dictionary", "g2p"]
        },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "fileBasename": { "type": "string", "minLength": 1 },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "license": { "type": "string", "minLength": 1 },
        "citation": { "type": "string", "minLength": 1 },
        "metadataSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "officialSource": { "type": "string", "const": "MontrealCorpusTools" }
      },
      "required": [
        "modelType",
        "name",
        "version",
        "fileBasename",
        "size",
        "sha256",
        "license",
        "citation",
        "metadataSha256",
        "officialSource"
      ],
      "additionalProperties": false
    },
    "dictionaryModel": {
      "type": "object",
      "properties": {
        "modelType": {
          "type": "string",
          "enum": ["acoustic", "dictionary", "g2p"]
        },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "fileBasename": { "type": "string", "minLength": 1 },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "license": { "type": "string", "minLength": 1 },
        "citation": { "type": "string", "minLength": 1 },
        "metadataSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "officialSource": { "type": "string", "const": "MontrealCorpusTools" }
      },
      "required": [
        "modelType",
        "name",
        "version",
        "fileBasename",
        "size",
        "sha256",
        "license",
        "citation",
        "metadataSha256",
        "officialSource"
      ],
      "additionalProperties": false
    },
    "g2pModel": {
      "type": "object",
      "properties": {
        "modelType": {
          "type": "string",
          "enum": ["acoustic", "dictionary", "g2p"]
        },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "fileBasename": { "type": "string", "minLength": 1 },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "license": { "type": "string", "minLength": 1 },
        "citation": { "type": "string", "minLength": 1 },
        "metadataSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "officialSource": { "type": "string", "const": "MontrealCorpusTools" }
      },
      "required": [
        "modelType",
        "name",
        "version",
        "fileBasename",
        "size",
        "sha256",
        "license",
        "citation",
        "metadataSha256",
        "officialSource"
      ],
      "additionalProperties": false
    },
    "environmentExplicitSpecSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtimeIdentityHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "platform": { "type": "string", "minLength": 1 },
    "architecture": { "type": "string", "minLength": 1 },
    "networkUsedDuringPreparation": { "type": "boolean" },
    "networkUsedDuringAlignment": { "type": "boolean", "const": false },
    "shareable": { "type": "boolean", "const": true }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "runtimeVersion",
    "generatedAt",
    "backend",
    "mfaVersion",
    "pythonVersion",
    "kalpyVersion",
    "kaldiVersion",
    "pyniniVersion",
    "sudachiVersion",
    "praatioVersion",
    "commandCapabilities",
    "acousticModel",
    "dictionaryModel",
    "g2pModel",
    "environmentExplicitSpecSha256",
    "runtimeIdentityHash",
    "platform",
    "architecture",
    "networkUsedDuringPreparation",
    "networkUsedDuringAlignment",
    "shareable"
  ],
  "additionalProperties": false
}
