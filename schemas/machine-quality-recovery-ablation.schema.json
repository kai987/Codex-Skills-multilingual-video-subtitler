{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-quality-recovery-ablation.schema.json",
  "title": "machine-quality-recovery-ablation",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.1-machine-quality-recovery-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "mode": { "type": "string", "enum": ["off", "observe", "enforce"] },
    "profile": {
      "type": "string",
      "enum": ["legacy", "diagnostics", "coverage", "timing", "full"]
    },
    "run": {
      "type": "object",
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "repositoryCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "goldRuntimeInputCount": { "type": "number", "const": 0 }
      },
      "required": [
        "runId",
        "repositoryCommit",
        "sourceMediaSha256",
        "goldRuntimeInputCount"
      ],
      "additionalProperties": false
    },
    "artifactType": {
      "type": "string",
      "const": "machine-quality-recovery-ablation"
    },
    "configurationHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "enabledStrategies": { "type": "array", "items": { "type": "string" } },
    "rejectedStrategies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "strategy": { "type": "string" },
          "reason": { "type": "string" }
        },
        "required": ["strategy", "reason"],
        "additionalProperties": false
      }
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "evaluationOnly": { "type": "boolean" },
    "goldEvaluationAttached": { "type": "boolean" },
    "machineMetrics": {
      "type": "object",
      "properties": {
        "cueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "exactCharacterCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "normalizedCharacterCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "overlapCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "asrRequestCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inferenceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "modelLoadCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "transcriptionSeconds": { "type": "number", "minimum": 0 }
      },
      "required": [
        "cueCount",
        "exactCharacterCount",
        "normalizedCharacterCount",
        "overlapCount",
        "asrRequestCount",
        "inferenceCount",
        "modelLoadCount",
        "transcriptionSeconds"
      ],
      "additionalProperties": false
    },
    "goldMetrics": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "cueCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "normalizedCer": { "type": "number", "minimum": 0 },
            "speechCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
            "missingDialogueCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "materialTextDefectCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "severeTimingDefectCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "startMaeSeconds": { "type": "number", "minimum": 0 },
            "endMaeSeconds": { "type": "number", "minimum": 0 },
            "p95BoundaryErrorSeconds": { "type": "number", "minimum": 0 },
            "hallucinationCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "p1DefectCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "cueCount",
            "normalizedCer",
            "speechCoverage",
            "missingDialogueCount",
            "materialTextDefectCount",
            "severeTimingDefectCount",
            "startMaeSeconds",
            "endMaeSeconds",
            "p95BoundaryErrorSeconds",
            "hallucinationCount",
            "p1DefectCount"
          ],
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "canonicalCueHash": {
      "anyOf": [
        { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        { "type": "null" }
      ]
    },
    "timingHash": {
      "anyOf": [
        { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        { "type": "null" }
      ]
    },
    "presentationHash": {
      "anyOf": [
        { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        { "type": "null" }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "mode",
    "profile",
    "run",
    "artifactType",
    "configurationHash",
    "enabledStrategies",
    "rejectedStrategies",
    "runtimeGoldInputCount",
    "evaluationOnly",
    "goldEvaluationAttached",
    "machineMetrics",
    "goldMetrics",
    "canonicalCueHash",
    "timingHash",
    "presentationHash"
  ],
  "additionalProperties": false
}
