{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-1-2-1-1-whole-component-diagnostic-evaluation.schema.json",
  "title": "c6-1-2-1-1-whole-component-diagnostic-evaluation",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "c6-1-2-1-1-whole-component-diagnostic-evaluation"
    },
    "policyVersion": {
      "type": "string",
      "const": "c6.1.2.1.1-constrained-monotonic-partition-reachable-evaluation-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evaluator": {
      "type": "string",
      "const": "E4_WHOLE_COMPONENT_PROFILE_SCORE_ONLY"
    },
    "partitionMapHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "profileId": { "type": "string", "minLength": 1 },
          "track": {
            "type": "string",
            "enum": [
              "FROZEN_DECISION_REEVALUATION",
              "SAME_FEATURE_SAME_PROFILE_OOF_RETRAIN"
            ]
          },
          "parentE2SupergroupId": { "type": "string", "minLength": 1 },
          "fullyEvaluatedPartition": { "type": "boolean" },
          "partitionBlockIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "whole": {
            "type": "object",
            "properties": {
              "supergroupId": { "type": "string", "minLength": 1 },
              "machineGroupIds": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "goldCueIds": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "foldId": {
                "anyOf": [
                  { "type": "string", "minLength": 1 },
                  { "type": "null" }
                ]
              },
              "changed": { "type": "boolean" },
              "evaluated": { "type": "boolean" },
              "exactError": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  { "type": "null" }
                ]
              },
              "normalizedError": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  { "type": "null" }
                ]
              },
              "exactGain": {
                "anyOf": [{ "type": "number" }, { "type": "null" }]
              },
              "normalizedGain": {
                "anyOf": [{ "type": "number" }, { "type": "null" }]
              },
              "materialDelta": {
                "anyOf": [{ "type": "number" }, { "type": "null" }]
              },
              "legacyMaterialDelta": {
                "anyOf": [{ "type": "number" }, { "type": "null" }]
              },
              "catastrophicDeletion": {
                "anyOf": [{ "type": "boolean" }, { "type": "null" }]
              },
              "baselineMaterial": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  { "type": "null" }
                ]
              },
              "baselineExactError": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  { "type": "null" }
                ]
              },
              "baselineNormalizedError": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  { "type": "null" }
                ]
              },
              "goldCharacterCount": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  { "type": "null" }
                ]
              },
              "classification": {
                "type": "string",
                "enum": ["IMPROVED", "REGRESSED", "NEUTRAL", "UNEVALUABLE"]
              },
              "reasons": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "required": [
              "supergroupId",
              "machineGroupIds",
              "goldCueIds",
              "foldId",
              "changed",
              "evaluated",
              "exactError",
              "normalizedError",
              "exactGain",
              "normalizedGain",
              "materialDelta",
              "legacyMaterialDelta",
              "catastrophicDeletion",
              "baselineMaterial",
              "baselineExactError",
              "baselineNormalizedError",
              "goldCharacterCount",
              "classification",
              "reasons"
            ],
            "additionalProperties": false
          },
          "partitionExactGain": {
            "anyOf": [{ "type": "number" }, { "type": "null" }]
          },
          "partitionNormalizedGain": {
            "anyOf": [{ "type": "number" }, { "type": "null" }]
          },
          "partitionMaterialDelta": {
            "anyOf": [{ "type": "number" }, { "type": "null" }]
          },
          "partitionCatastrophic": {
            "anyOf": [{ "type": "boolean" }, { "type": "null" }]
          },
          "normalizedDirectionAgreement": {
            "anyOf": [{ "type": "boolean" }, { "type": "null" }]
          },
          "exactDirectionAgreement": {
            "anyOf": [{ "type": "boolean" }, { "type": "null" }]
          },
          "materialDirectionAgreement": {
            "anyOf": [{ "type": "boolean" }, { "type": "null" }]
          },
          "catastrophicAgreement": {
            "anyOf": [{ "type": "boolean" }, { "type": "null" }]
          }
        },
        "required": [
          "profileId",
          "track",
          "parentE2SupergroupId",
          "fullyEvaluatedPartition",
          "partitionBlockIds",
          "whole",
          "partitionExactGain",
          "partitionNormalizedGain",
          "partitionMaterialDelta",
          "partitionCatastrophic",
          "normalizedDirectionAgreement",
          "exactDirectionAgreement",
          "materialDirectionAgreement",
          "catastrophicAgreement"
        ],
        "additionalProperties": false
      }
    },
    "eligibleForTraining": { "type": "boolean", "const": false },
    "eligibleForSafeProfile": { "type": "boolean", "const": false },
    "eligibleForRoute": { "type": "boolean", "const": false },
    "globalQuality": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "profileId": { "type": "string", "minLength": 1 },
          "track": {
            "type": "string",
            "enum": [
              "FROZEN_DECISION_REEVALUATION",
              "SAME_FEATURE_SAME_PROFILE_OOF_RETRAIN"
            ]
          },
          "goldCueCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "normalizedGoldCharacters": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "exactError": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "normalizedError": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "normalizedCer": { "type": "number", "minimum": 0 },
          "goldOnlyMissingCharacters": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "profileId",
          "track",
          "goldCueCount",
          "normalizedGoldCharacters",
          "exactError",
          "normalizedError",
          "normalizedCer",
          "goldOnlyMissingCharacters"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "policyVersion",
    "policyHash",
    "semanticHash",
    "evaluator",
    "partitionMapHash",
    "rows",
    "eligibleForTraining",
    "eligibleForSafeProfile",
    "eligibleForRoute",
    "globalQuality"
  ],
  "additionalProperties": false
}
