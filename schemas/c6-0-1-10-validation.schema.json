{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-10-validation.schema.json",
  "title": "c6-0-1-10-validation",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.10-cross-model-arbitration-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": { "type": "string", "const": "c6-0-1-10-validation" },
    "branch": {
      "type": "string",
      "const": "codex/c6-0-1-10-cross-model-arbitration"
    },
    "repositoryCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sourceMediaSha256Before": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceMediaSha256After": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "goldSha256Before": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "goldSha256After": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "arbitrationPolicyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["id", "passed", "evidence"],
        "additionalProperties": false
      }
    },
    "finalABParity": {
      "type": "object",
      "properties": {
        "evidenceBundles": { "type": "boolean" },
        "decisions": { "type": "boolean" },
        "mutationProposals": { "type": "boolean" },
        "appliedMutations": { "type": "boolean" },
        "finalText": { "type": "boolean" },
        "finalTiming": { "type": "boolean" },
        "ass": { "type": "boolean" },
        "srt": { "type": "boolean" },
        "vtt": { "type": "boolean" },
        "productionStatus": { "type": "boolean" },
        "routeDecision": { "type": "boolean" }
      },
      "required": [
        "evidenceBundles",
        "decisions",
        "mutationProposals",
        "appliedMutations",
        "finalText",
        "finalTiming",
        "ass",
        "srt",
        "vtt",
        "productionStatus",
        "routeDecision"
      ],
      "additionalProperties": false
    },
    "baselineQuality": {
      "type": "object",
      "properties": {
        "finalCueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "exactCer": { "type": "number", "minimum": 0 },
        "normalizedCer": { "type": "number", "minimum": 0 },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "missingCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hallucinationCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "materialErrorCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "severeTimingCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "startMaeSeconds": { "type": "number", "minimum": 0 },
        "endMaeSeconds": { "type": "number", "minimum": 0 },
        "p95TimingErrorSeconds": { "type": "number", "minimum": 0 },
        "medianIou": { "type": "number", "minimum": 0, "maximum": 1 },
        "overlapCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "finalCueCount",
        "exactCer",
        "normalizedCer",
        "coverage",
        "missingCount",
        "hallucinationCount",
        "materialErrorCount",
        "severeTimingCount",
        "startMaeSeconds",
        "endMaeSeconds",
        "p95TimingErrorSeconds",
        "medianIou",
        "overlapCount"
      ],
      "additionalProperties": false
    },
    "finalQuality": {
      "type": "object",
      "properties": {
        "finalCueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "exactCer": { "type": "number", "minimum": 0 },
        "normalizedCer": { "type": "number", "minimum": 0 },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "missingCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hallucinationCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "materialErrorCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "severeTimingCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "startMaeSeconds": { "type": "number", "minimum": 0 },
        "endMaeSeconds": { "type": "number", "minimum": 0 },
        "p95TimingErrorSeconds": { "type": "number", "minimum": 0 },
        "medianIou": { "type": "number", "minimum": 0, "maximum": 1 },
        "overlapCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "finalCueCount",
        "exactCer",
        "normalizedCer",
        "coverage",
        "missingCount",
        "hallucinationCount",
        "materialErrorCount",
        "severeTimingCount",
        "startMaeSeconds",
        "endMaeSeconds",
        "p95TimingErrorSeconds",
        "medianIou",
        "overlapCount"
      ],
      "additionalProperties": false
    },
    "productionHashes": {
      "type": "object",
      "properties": {
        "canonicalText": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "canonicalTiming": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "presentation": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "ass": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "srt": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "vtt": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "required": [
        "canonicalText",
        "canonicalTiming",
        "presentation",
        "ass",
        "srt",
        "vtt"
      ],
      "additionalProperties": false
    },
    "canonicalTextMutationCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "canonicalTimingMutationCount": { "type": "number", "const": 0 },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "datasetHardcodingFindingCount": { "type": "number", "const": 0 },
    "unsafeFinalizationEscapeCount": { "type": "number", "const": 0 },
    "networkUsedDuringAcceptance": { "type": "boolean", "const": false },
    "sourceReadOnlyVerified": { "type": "boolean", "const": true },
    "goldReadOnlyVerified": { "type": "boolean", "const": true },
    "engineeringGatePassed": { "type": "boolean" },
    "arbitrationSafetyGatePassed": { "type": "boolean" },
    "crossModelSafeGainConfirmed": { "type": "boolean" },
    "strictC602GatePassed": { "type": "boolean" },
    "routeDecision": {
      "type": "string",
      "enum": [
        "GO_C6_0_2",
        "HOLD_FOR_TIMING_QUALITY_RECOVERY",
        "HOLD_FOR_ARBITRATION_EVIDENCE_REDESIGN",
        "DISABLE_AUTOMATIC_REAZON_ENFORCEMENT",
        "ARBITRATION_TOO_CONSERVATIVE_OR_EVIDENCE_INSUFFICIENT",
        "CROSS_MODEL_ARBITRATION_SAFE_GAIN_CONFIRMED"
      ]
    },
    "productionStatus": { "type": "string", "const": "needs-review" },
    "finalizationMethod": { "type": "string", "const": "none" },
    "machineOnlyReleaseAuthorized": { "type": "boolean", "const": false },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "branch",
    "repositoryCommit",
    "sourceMediaSha256Before",
    "sourceMediaSha256After",
    "goldSha256Before",
    "goldSha256After",
    "arbitrationPolicyHash",
    "checks",
    "finalABParity",
    "baselineQuality",
    "finalQuality",
    "productionHashes",
    "canonicalTextMutationCount",
    "canonicalTimingMutationCount",
    "runtimeGoldInputCount",
    "datasetHardcodingFindingCount",
    "unsafeFinalizationEscapeCount",
    "networkUsedDuringAcceptance",
    "sourceReadOnlyVerified",
    "goldReadOnlyVerified",
    "engineeringGatePassed",
    "arbitrationSafetyGatePassed",
    "crossModelSafeGainConfirmed",
    "strictC602GatePassed",
    "routeDecision",
    "productionStatus",
    "finalizationMethod",
    "machineOnlyReleaseAuthorized",
    "semanticHash"
  ],
  "additionalProperties": false
}
