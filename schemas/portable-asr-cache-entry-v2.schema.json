{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/portable-asr-cache-entry-v2.schema.json",
  "title": "portable-asr-cache-entry-v2",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "2.0.0" },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "cacheKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "identity": {
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "string", "const": "2.0.0" },
        "audioContentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "extractedIntervalMilliseconds": {
          "type": "object",
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "end": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["start", "end"],
          "additionalProperties": false
        },
        "extraction": {
          "type": "object",
          "properties": {
            "sampleRate": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "channels": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "codec": { "type": "string", "minLength": 1 }
          },
          "required": ["sampleRate", "channels", "codec"],
          "additionalProperties": false
        },
        "adapterId": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "modelHash": {
          "anyOf": [
            { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            { "type": "null" }
          ]
        },
        "modelFamily": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "coreML": { "anyOf": [{ "type": "boolean" }, { "type": "null" }] },
        "whisperCppVersion": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "language": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["zh", "zh-Hans", "zh-Hant", "ja", "en", "mixed", "und"]
            },
            { "type": "null" }
          ]
        },
        "vadMode": { "type": "string", "minLength": 1 },
        "timestampStrategy": { "type": "string", "minLength": 1 },
        "tokenTimestamps": { "type": "boolean" },
        "timestampMappingVersion": { "type": "string", "minLength": 1 },
        "timestampCoordinateSystem": { "type": "string", "minLength": 1 },
        "tokenHealthPolicyVersion": { "type": "string", "minLength": 1 },
        "runtimeTimestampCapabilityHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "promptSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "decodeConfigurationSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schemaVersion",
        "audioContentSha256",
        "extractedIntervalMilliseconds",
        "extraction",
        "adapterId",
        "model",
        "modelHash",
        "modelFamily",
        "coreML",
        "whisperCppVersion",
        "language",
        "vadMode",
        "timestampStrategy",
        "tokenTimestamps",
        "promptSha256",
        "decodeConfigurationSha256"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 },
              "text": { "type": "string", "minLength": 1 },
              "speaker": {
                "anyOf": [
                  { "type": "string", "minLength": 1 },
                  { "type": "null" }
                ]
              },
              "confidence": {
                "anyOf": [
                  { "type": "number", "minimum": 0, "maximum": 1 },
                  { "type": "null" }
                ]
              },
              "tokens": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": { "type": "string" },
                    "start": { "type": "number", "minimum": 0 },
                    "end": { "type": "number", "minimum": 0 },
                    "probability": {
                      "anyOf": [
                        { "type": "number", "minimum": 0, "maximum": 1 },
                        { "type": "null" }
                      ]
                    }
                  },
                  "required": ["text", "start", "end"],
                  "additionalProperties": false
                }
              },
              "metrics": {
                "type": "object",
                "properties": {
                  "averageLogProbability": {
                    "anyOf": [{ "type": "number" }, { "type": "null" }]
                  },
                  "noSpeechProbability": {
                    "anyOf": [
                      { "type": "number", "minimum": 0, "maximum": 1 },
                      { "type": "null" }
                    ]
                  },
                  "tokenProbability": {
                    "anyOf": [
                      { "type": "number", "minimum": 0, "maximum": 1 },
                      { "type": "null" }
                    ]
                  },
                  "entropy": {
                    "anyOf": [
                      { "type": "number", "minimum": 0 },
                      { "type": "null" }
                    ]
                  },
                  "decoderFallback": {
                    "anyOf": [{ "type": "boolean" }, { "type": "null" }]
                  },
                  "detectedLanguage": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "zh",
                          "zh-Hans",
                          "zh-Hant",
                          "ja",
                          "en",
                          "mixed",
                          "und"
                        ]
                      },
                      { "type": "null" }
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "required": ["start", "end", "text", "speaker", "confidence"],
            "additionalProperties": false
          }
        },
        "raw": {}
      },
      "required": ["text", "segments", "raw"],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "requestType": {
          "type": "string",
          "enum": [
            "baseline",
            "refinement",
            "recovery",
            "lyrics",
            "coverage-recovery",
            "overlap-evidence"
          ]
        },
        "sourceOutputDirectory": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "migratedFromLegacyKey": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "migratedFromPath": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        }
      },
      "required": [
        "requestType",
        "sourceOutputDirectory",
        "migratedFromLegacyKey",
        "migratedFromPath"
      ],
      "additionalProperties": false
    },
    "resultSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "createdAt",
    "cacheKey",
    "identity",
    "result",
    "provenance",
    "resultSha256"
  ],
  "additionalProperties": false
}
