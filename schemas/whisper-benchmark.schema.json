{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/whisper-benchmark.schema.json",
  "title": "whisper-benchmark",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "status": { "type": "string", "enum": ["executed", "reused", "skipped"] },
    "skipReason": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "deviceFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sampleAudioSeconds": { "type": "number", "exclusiveMinimum": 0 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "capabilityId": { "type": "string", "minLength": 1 },
          "modelHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "whisperCppVersion": { "type": "string", "minLength": 1 },
          "coreML": { "type": "boolean" },
          "encoderPath": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "encoderFingerprint": {
            "anyOf": [
              { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              { "type": "null" }
            ]
          },
          "audioSeconds": { "type": "number", "exclusiveMinimum": 0 },
          "processingSeconds": { "type": "number", "minimum": 0 },
          "rtf": { "type": "number", "minimum": 0 }
        },
        "required": [
          "capabilityId",
          "modelHash",
          "whisperCppVersion",
          "coreML",
          "audioSeconds",
          "processingSeconds",
          "rtf"
        ],
        "additionalProperties": false
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "capabilityId": { "type": "string", "minLength": 1 },
          "modelHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "whisperCppVersion": { "type": "string", "minLength": 1 },
          "coreML": { "type": "boolean" },
          "encoderPath": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "encoderFingerprint": {
            "anyOf": [
              { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              { "type": "null" }
            ]
          },
          "message": { "type": "string", "minLength": 1 }
        },
        "required": [
          "capabilityId",
          "modelHash",
          "whisperCppVersion",
          "coreML",
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "skipReason",
    "createdAt",
    "expiresAt",
    "deviceFingerprint",
    "sampleAudioSeconds",
    "entries",
    "errors"
  ],
  "additionalProperties": false
}
