{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-12-review-session.schema.json",
  "title": "c6-0-1-12-review-session",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "sessionId": { "type": "string", "minLength": 1 },
    "sourceMediaIdentity": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": {}
    },
    "machineDraftIdentity": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": {}
    },
    "machineDraftHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reviewPolicyVersion": {
      "type": "string",
      "const": "c6.0.1.12-multi-asr-review-assistance-v2"
    },
    "reviewPackageSemanticHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "itemStates": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "recordId": { "type": "string", "minLength": 1 },
          "decisionId": { "type": "string", "minLength": 1 },
          "decisionType": {
            "type": "string",
            "enum": [
              "KEEP_CURRENT",
              "USE_REAZON",
              "USE_WHISPER_ALTERNATE",
              "MANUAL_EDIT",
              "TIMING_EDIT",
              "ADD_NEW_CUE",
              "MARK_FALSE_POSITIVE",
              "UNRESOLVED",
              "WAIVE_REVIEW"
            ]
          },
          "selectedCandidateId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "afterText": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "afterStart": {
            "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
          },
          "afterEnd": {
            "anyOf": [
              { "type": "number", "exclusiveMinimum": 0 },
              { "type": "null" }
            ]
          },
          "reviewerNote": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          }
        },
        "required": [
          "recordId",
          "decisionId",
          "decisionType",
          "selectedCandidateId",
          "afterText",
          "afterStart",
          "afterEnd",
          "reviewerNote",
          "updatedAt"
        ],
        "additionalProperties": false
      }
    },
    "regionStates": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "requiredItemCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "completedRequiredCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "unresolvedRequiredCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "complete": { "type": "boolean" }
        },
        "required": [
          "requiredItemCount",
          "completedRequiredCount",
          "unresolvedRequiredCount",
          "complete"
        ],
        "additionalProperties": false
      }
    },
    "completedRequiredCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "unresolvedRequiredCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reviewComplete": { "type": "boolean" }
  },
  "required": [
    "schemaVersion",
    "sessionId",
    "sourceMediaIdentity",
    "machineDraftIdentity",
    "machineDraftHash",
    "reviewPolicyVersion",
    "reviewPackageSemanticHash",
    "createdAt",
    "updatedAt",
    "itemStates",
    "regionStates",
    "completedRequiredCount",
    "unresolvedRequiredCount",
    "reviewComplete"
  ],
  "additionalProperties": false
}
