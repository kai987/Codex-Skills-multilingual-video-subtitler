{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/subtitle-review-effective-disposition.schema.json",
  "title": "subtitle-review-effective-disposition",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "subtitle-review-effective-disposition"
    },
    "policyVersion": {
      "type": "string",
      "const": "c6.0-protected-finalization-risk-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reviewId": { "type": "string", "minLength": 1 },
          "componentId": { "type": "string", "minLength": 1 },
          "legacyRequiresHumanReview": { "type": "boolean" },
          "protectedDisposition": {
            "type": "string",
            "enum": ["mandatory", "advisory", "preservation-supported"]
          },
          "protectedMandatory": { "type": "boolean" },
          "advisory": { "type": "boolean" },
          "preservationSupported": { "type": "boolean" },
          "reasonCodes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "riskEvidenceIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "reviewId",
          "componentId",
          "legacyRequiresHumanReview",
          "protectedDisposition",
          "protectedMandatory",
          "advisory",
          "preservationSupported",
          "reasonCodes",
          "riskEvidenceIds"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "legacyReviewItemCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "protectedReviewArtifactItemCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "effectiveMandatoryReviewCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "effectiveAdvisoryReviewCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "preservationSupportedReviewCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "legacyReviewItemCount",
        "protectedReviewArtifactItemCount",
        "effectiveMandatoryReviewCount",
        "effectiveAdvisoryReviewCount",
        "preservationSupportedReviewCount"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "policyVersion",
    "generatedAt",
    "items",
    "summary",
    "semanticHash"
  ],
  "additionalProperties": false
}
