{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-source-audio-views-v1.schema.json",
  "title": "machine-source-audio-views-v1",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14.1-multiview-speech-inventory-v1"
    },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "sourceTimebase": {
      "type": "string",
      "const": "SOURCE_GLOBAL_NATIVE_SAMPLES"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": {
      "type": "string",
      "const": "machine-source-audio-views-v1"
    },
    "views": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "viewId": { "type": "string", "minLength": 1 },
          "role": {
            "type": "string",
            "enum": [
              "NATIVE_MONO",
              "LEFT",
              "RIGHT",
              "CENTER_OR_MID",
              "VOICE_BAND_CENTER"
            ]
          },
          "sourceAudioStreamIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "nativeSampleRate": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "nativeChannelLayout": { "type": "string", "minLength": 1 },
          "sourcePtsStartSeconds": { "type": "number" },
          "filterGraph": { "type": "string", "minLength": 1 },
          "decodeCommandIdentity": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "ffmpegIdentity": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "relativePath": { "type": "string", "minLength": 1 },
          "sampleRate": { "type": "number", "const": 16000 },
          "channels": { "type": "number", "const": 1 },
          "bitDepth": { "type": "number", "const": 16 },
          "frameCount": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
          "audioSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "pcmSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "timeMapping": {
            "type": "object",
            "properties": {
              "sourceStartSample": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "sourceSampleRate": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "outputSampleRate": { "type": "number", "const": 16000 },
              "numerator": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "denominator": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "outputStartSample": { "type": "number", "const": 0 },
              "mappingStatus": {
                "type": "string",
                "const": "VERIFIED_INTEGER_RATIONAL"
              },
              "measuredImpulsePeakDelaySamples": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "syntheticValidationHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "sourceStartSample",
              "sourceSampleRate",
              "outputSampleRate",
              "numerator",
              "denominator",
              "outputStartSample",
              "mappingStatus",
              "measuredImpulsePeakDelaySamples",
              "syntheticValidationHash"
            ],
            "additionalProperties": false
          },
          "duplicateOfViewId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "detectorEligible": { "type": "boolean" },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "viewId",
          "role",
          "sourceAudioStreamIndex",
          "nativeSampleRate",
          "nativeChannelLayout",
          "sourcePtsStartSeconds",
          "filterGraph",
          "decodeCommandIdentity",
          "ffmpegIdentity",
          "relativePath",
          "sampleRate",
          "channels",
          "bitDepth",
          "frameCount",
          "durationSeconds",
          "audioSha256",
          "pcmSha256",
          "timeMapping",
          "duplicateOfViewId",
          "detectorEligible",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "viewCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "uniquePcmViewCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rejectedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["viewCount", "uniquePcmViewCount", "rejectedCount"],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "sourceIdentity",
    "sourceTimebase",
    "policyHash",
    "runtimeGoldInputCount",
    "semanticHash",
    "artifactType",
    "views",
    "summary"
  ],
  "additionalProperties": false
}
