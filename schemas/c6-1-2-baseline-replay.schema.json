{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-1-2-baseline-replay.schema.json",
  "title": "c6-1-2-baseline-replay",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": { "type": "string", "const": "c6-1-2-baseline-replay" },
    "policyVersion": {
      "type": "string",
      "const": "c6.1.2-top-k-reranking-acoustic-completeness-v1"
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "acceptanceCommit": { "type": "string", "minLength": 1 },
    "baselineBranch": { "type": "string", "minLength": 1 },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "observed": { "type": "string" },
          "expected": { "type": "string" }
        },
        "required": ["name", "passed", "observed", "expected"],
        "additionalProperties": false
      }
    },
    "passed": { "type": "boolean" },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "proposalHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "fixedMappingHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "featureHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "foldHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "oofHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "universeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "canonicalTextHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "canonicalTimingHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "productionFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relativePath": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["relativePath", "sha256", "size"],
        "additionalProperties": false
      }
    },
    "inputFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relativePath": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["relativePath", "sha256", "size"],
        "additionalProperties": false
      }
    },
    "cueCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "eventCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "eligibleEventCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "inputCandidateCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "includedAsrCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "whisperCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reazonCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "strongContractionCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "newAsrInferenceCount": { "type": "number", "const": 0 },
    "networkUsed": { "type": "boolean", "const": false }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "policyVersion",
    "semanticHash",
    "acceptanceCommit",
    "baselineBranch",
    "checks",
    "passed",
    "policyHash",
    "proposalHash",
    "fixedMappingHash",
    "featureHash",
    "foldHash",
    "oofHash",
    "universeHash",
    "canonicalTextHash",
    "canonicalTimingHash",
    "productionFiles",
    "inputFiles",
    "cueCount",
    "eventCount",
    "eligibleEventCount",
    "inputCandidateCount",
    "includedAsrCount",
    "whisperCount",
    "reazonCount",
    "strongContractionCount",
    "runtimeGoldInputCount",
    "newAsrInferenceCount",
    "networkUsed"
  ],
  "additionalProperties": false
}
