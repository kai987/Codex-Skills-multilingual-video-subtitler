{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-7-ablation.schema.json",
  "title": "c6-0-1-7-ablation",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.7-fresh-targeted-reasr-asr-ceiling-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": { "type": "string", "const": "c6-0-1-7-ablation" },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "V0",
              "V1",
              "V2",
              "V3",
              "V4",
              "V5",
              "V6",
              "final-a",
              "final-b"
            ]
          },
          "label": { "type": "string", "minLength": 1 },
          "outputPath": { "type": "string", "minLength": 1 },
          "outputFreezeHash": {
            "anyOf": [
              { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              { "type": "null" }
            ]
          },
          "metrics": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "cueCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "exactCer": { "type": "number", "minimum": 0 },
                  "normalizedCer": { "type": "number", "minimum": 0 },
                  "goldCoverage": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "missingCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "hallucinationCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "materialErrorCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "severeTimingErrorCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "startMaeSeconds": { "type": "number", "minimum": 0 },
                  "endMaeSeconds": { "type": "number", "minimum": 0 },
                  "p95BoundaryErrorSeconds": { "type": "number", "minimum": 0 },
                  "medianTemporalIou": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "overlapPairCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "trustedMappedTokenCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "ambiguousTimeBaseTokenCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "rawAsrOriginErrorCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "associationErrorCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "eventFinalLineageCoverage": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "unsupportedMutationCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "freshSelectedEventCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "freshInferenceCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "freshCandidateCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "freshReplacementAppliedCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "cueCount",
                  "exactCer",
                  "normalizedCer",
                  "goldCoverage",
                  "missingCount",
                  "hallucinationCount",
                  "materialErrorCount",
                  "severeTimingErrorCount",
                  "startMaeSeconds",
                  "endMaeSeconds",
                  "p95BoundaryErrorSeconds",
                  "medianTemporalIou",
                  "overlapPairCount",
                  "trustedMappedTokenCount",
                  "ambiguousTimeBaseTokenCount",
                  "rawAsrOriginErrorCount",
                  "associationErrorCount",
                  "eventFinalLineageCoverage",
                  "unsupportedMutationCount",
                  "freshSelectedEventCount",
                  "freshInferenceCount",
                  "freshCandidateCount",
                  "freshReplacementAppliedCount"
                ],
                "additionalProperties": false
              },
              { "type": "null" }
            ]
          },
          "status": {
            "type": "string",
            "enum": ["completed", "not-run", "failed"]
          },
          "generationKind": {
            "type": "string",
            "enum": ["NO_MODEL", "FRESH_INFERENCE", "FROZEN_EXACT_CACHE_REPLAY"]
          },
          "modelExecutionHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "label",
          "outputPath",
          "outputFreezeHash",
          "metrics",
          "status",
          "generationKind",
          "modelExecutionHash"
        ],
        "additionalProperties": false
      }
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "stages",
    "semanticHash"
  ],
  "additionalProperties": false
}
