{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "subtitle-tool-v1"
    },
    "taskId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "input": {
      "type": "string"
    },
    "inputHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "config": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "default": "ja",
          "type": "string",
          "enum": ["ja", "en", "zh"]
        },
        "profile": {
          "default": "primary-minimal",
          "type": "string",
          "enum": ["primary-minimal", "g11"]
        },
        "threads": {
          "default": 4,
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "ffmpeg": {
          "default": "ffmpeg",
          "type": "string"
        },
        "ffprobe": {
          "default": "ffprobe",
          "type": "string"
        }
      },
      "required": [
        "model",
        "runtime",
        "language",
        "profile",
        "threads",
        "ffmpeg",
        "ffprobe"
      ],
      "additionalProperties": false
    },
    "configHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "modelHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtimeHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ffmpegHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ffprobeHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "track": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "origin": {
      "type": "number"
    },
    "audioOffset": {
      "type": "number",
      "minimum": 0
    },
    "executionStatus": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "cancelled",
        "partial"
      ]
    },
    "phase": {
      "type": "string"
    },
    "artifactIntegrity": {
      "type": "string",
      "enum": ["pending", "passed", "failed"]
    },
    "qualityStatus": {
      "type": "string",
      "const": "needs-review"
    },
    "contentQuality": {
      "type": "string",
      "const": "NOT_MEASURED"
    },
    "finalizationMethod": {
      "type": "string",
      "const": "none"
    },
    "humanValidated": {
      "type": "boolean",
      "const": false
    },
    "machineOnlyReleaseAuthorized": {
      "type": "boolean",
      "const": false
    },
    "audioHash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "rawHash": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidenceHash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "startedAt": {
            "type": "string"
          },
          "endedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "reservedAudioSeconds": {
            "type": "number"
          },
          "state": {
            "type": "string",
            "enum": ["running", "completed", "failed", "cancelled"]
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "startedAt",
          "endedAt",
          "reservedAudioSeconds",
          "state",
          "error"
        ],
        "additionalProperties": false
      }
    },
    "budgetSeconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "cacheHits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rawCheckpointHits": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "modelLoads": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "outputs": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "ownedFiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "version",
    "taskId",
    "createdAt",
    "updatedAt",
    "input",
    "inputHash",
    "config",
    "configHash",
    "modelHash",
    "runtimeHash",
    "ffmpegHash",
    "ffprobeHash",
    "track",
    "duration",
    "origin",
    "audioOffset",
    "executionStatus",
    "phase",
    "artifactIntegrity",
    "qualityStatus",
    "contentQuality",
    "finalizationMethod",
    "humanValidated",
    "machineOnlyReleaseAuthorized",
    "audioHash",
    "rawHash",
    "evidenceHash",
    "warnings",
    "attempts",
    "budgetSeconds",
    "cacheHits",
    "rawCheckpointHits",
    "modelLoads",
    "outputs",
    "ownedFiles",
    "error"
  ],
  "additionalProperties": false
}
