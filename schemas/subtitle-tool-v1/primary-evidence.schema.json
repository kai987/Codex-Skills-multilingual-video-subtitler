{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "subtitle-tool-primary-v1"
    },
    "identity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rawHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timebase": {
      "type": "string",
      "const": "source-global-relative-to-container-origin"
    },
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "language": {
            "type": "string",
            "enum": ["zh", "zh-Hans", "zh-Hant", "ja", "en", "mixed", "und"]
          },
          "languages": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["zh", "zh-Hans", "zh-Hant", "ja", "en", "mixed", "und"]
            }
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "style": {
            "type": "string",
            "enum": ["default", "thought", "music"]
          },
          "textSource": {
            "type": "string",
            "enum": [
              "audio-asr",
              "reference-original-language",
              "embedded",
              "online"
            ]
          },
          "speaker": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "provenance": {
            "type": "object",
            "properties": {
              "sourceLayer": {
                "type": "string",
                "enum": [
                  "baseline-vad",
                  "scene-extra-sensitive-vad",
                  "no-vad",
                  "large-v3-refinement",
                  "recovery",
                  "lyrics-asr",
                  "reference-original-language",
                  "embedded",
                  "online"
                ]
              },
              "sourceRequestIds": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "sourceProfileIds": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "referenceAnchorIds": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "referenceUnitIds": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "recoveryUnitId": {
                "default": null,
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sceneId": {
                "default": null,
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sceneLabel": {
                "default": null,
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "independentSupportCount": {
                "default": 0,
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "qualityScore": {
                "default": null,
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "sourceLayer",
              "sourceRequestIds",
              "sourceProfileIds",
              "referenceAnchorIds",
              "referenceUnitIds",
              "recoveryUnitId",
              "sceneId",
              "sceneLabel",
              "independentSupportCount",
              "qualityScore"
            ],
            "additionalProperties": false
          },
          "textAudit": {
            "type": "object",
            "properties": {
              "rawAsrText": {
                "type": "string"
              },
              "repairedText": {
                "type": "string"
              },
              "normalizedText": {
                "type": "string"
              },
              "winnerClusterIds": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "sourceWinnerCueIds": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "winnerScore": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "runnerUpCueId": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "runnerUpScore": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "scoreGap": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "replacements": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "original": {
                      "type": "string",
                      "minLength": 1
                    },
                    "replacement": {
                      "type": "string",
                      "minLength": 1
                    },
                    "category": {
                      "type": "string",
                      "minLength": 1
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
                    "original",
                    "replacement",
                    "category",
                    "confidence",
                    "evidence"
                  ],
                  "additionalProperties": false
                }
              },
              "deduplicationActions": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "repairType": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "timingDonorCueId": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "timingRepairMethod": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reviewRecommended": {
                "type": "boolean"
              },
              "reviewReasons": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "rawAsrText",
              "repairedText",
              "normalizedText",
              "winnerClusterIds",
              "sourceWinnerCueIds",
              "replacements",
              "deduplicationActions",
              "reviewRecommended",
              "reviewReasons"
            ],
            "additionalProperties": false
          },
          "transcriptionMetrics": {
            "type": "object",
            "properties": {
              "averageLogProbability": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "noSpeechProbability": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "tokenProbability": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "entropy": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "decoderFallback": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "detectedLanguage": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "zh",
                      "zh-Hans",
                      "zh-Hant",
                      "ja",
                      "en",
                      "mixed",
                      "und"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "timingEvidence": {
            "type": "object",
            "properties": {
              "sourceTrusted": {
                "default": false,
                "type": "boolean"
              },
              "speechStart": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "speechEnd": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "tokenTimestampsAvailable": {
                "default": false,
                "type": "boolean"
              },
              "tokenTimestampsUsed": {
                "default": false,
                "type": "boolean"
              },
              "tokens": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "start": {
                      "type": "number",
                      "minimum": 0
                    },
                    "end": {
                      "type": "number",
                      "minimum": 0
                    },
                    "probability": {
                      "anyOf": [
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": ["text", "start", "end"],
                  "additionalProperties": false
                }
              },
              "alignmentSource": {
                "type": "string",
                "enum": [
                  "source",
                  "token",
                  "speech",
                  "vad",
                  "segment",
                  "pause",
                  "semantic",
                  "character-ratio"
                ]
              },
              "presentationTimingMethod": {
                "default": null,
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "preserved-source",
                      "token",
                      "speech-boundary",
                      "pause",
                      "semantic",
                      "vad",
                      "character-ratio"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "chunkBoundaryConflict": {
                "type": "boolean"
              },
              "speechIntervals": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "number",
                      "minimum": 0
                    },
                    "end": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": ["start", "end"],
                  "additionalProperties": false
                }
              },
              "speechBoundarySource": {
                "type": "string",
                "enum": ["silence", "vad", "segment"]
              }
            },
            "required": [
              "sourceTrusted",
              "speechStart",
              "speechEnd",
              "tokenTimestampsAvailable",
              "tokenTimestampsUsed",
              "tokens",
              "alignmentSource",
              "presentationTimingMethod"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "start",
          "end",
          "language",
          "languages",
          "text",
          "speaker",
          "confidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "identity", "rawHash", "timebase", "cues"],
  "additionalProperties": false
}
