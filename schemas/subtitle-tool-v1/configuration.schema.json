{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "default": "ja",
      "type": "string",
      "enum": ["ja", "en", "zh"]
    },
    "profile": {
      "default": "primary-minimal",
      "type": "string",
      "enum": ["primary-minimal", "g11"]
    },
    "threads": {
      "default": 4,
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "ffmpeg": {
      "default": "ffmpeg",
      "type": "string"
    },
    "ffprobe": {
      "default": "ffprobe",
      "type": "string"
    }
  },
  "required": [
    "model",
    "runtime",
    "language",
    "profile",
    "threads",
    "ffmpeg",
    "ffprobe"
  ],
  "additionalProperties": false
}
