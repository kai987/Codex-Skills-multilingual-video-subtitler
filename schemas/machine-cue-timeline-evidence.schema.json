{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-cue-timeline-evidence.schema.json",
  "title": "machine-cue-timeline-evidence",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.2-candidate-precision-global-timeline-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "machine-cue-timeline-evidence"
    },
    "mode": { "type": "string", "enum": ["off", "observe", "enforce"] },
    "tokenTimelineSemanticHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cueId": { "type": "string", "minLength": 1 },
          "currentInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "trustedTokenIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "trustedTokenInterval": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "start": { "type": "number", "minimum": 0 },
                  "end": { "type": "number", "exclusiveMinimum": 0 }
                },
                "required": ["start", "end"],
                "additionalProperties": false
              },
              { "type": "null" }
            ]
          },
          "lexicalCoverageRatio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "timingEligible": { "type": "boolean" },
          "evidencePriority": {
            "type": "string",
            "enum": [
              "trusted-mapped-token",
              "stable-mfa-ctc-consensus",
              "verified-asr-segment",
              "speech-vad",
              "coarse-source-window",
              "unavailable"
            ]
          },
          "blockers": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "cueId",
          "currentInterval",
          "trustedTokenIds",
          "trustedTokenInterval",
          "lexicalCoverageRatio",
          "timingEligible",
          "evidencePriority",
          "blockers"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "cueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cueWithTrustedTokenCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "timingEligibleCueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "eligibleCueCoverageRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "cueCount",
        "cueWithTrustedTokenCount",
        "timingEligibleCueCount",
        "eligibleCueCoverageRatio"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "mode",
    "tokenTimelineSemanticHash",
    "cues",
    "summary",
    "semanticHash"
  ],
  "additionalProperties": false
}
