{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-14-2-validation.schema.json",
  "title": "c6-0-1-14-2-validation",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": { "type": "string", "const": "c6-0-1-14-2-validation" },
    "visibility": { "type": "string", "const": "LOCAL_ONLY" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "checks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "detail": { "type": "string" }
        },
        "required": ["id", "passed", "detail"],
        "additionalProperties": false
      }
    },
    "schemaResults": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relativePath": { "type": "string", "minLength": 1 },
          "schemaId": { "type": "string", "minLength": 1 },
          "valid": { "type": "boolean" },
          "errorCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["relativePath", "schemaId", "valid", "errorCount"],
        "additionalProperties": false
      }
    },
    "schemaCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "checkedArtifactCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "engineeringPassed": { "type": "boolean" },
    "evaluationIntegrityPassed": { "type": "boolean" },
    "allChecksPassed": { "type": "boolean" },
    "route": {
      "type": "object",
      "properties": {
        "primaryDecision": {
          "type": "string",
          "enum": [
            "GO_C6_0_1_15_REGION_RANKER_RECALIBRATION",
            "HOLD_FOR_ENGINEERING_REPAIR",
            "HOLD_FOR_EVALUATION_INTEGRITY_REPAIR",
            "HOLD_FOR_SAFETY_TARGET_SELECTION_REPAIR",
            "HOLD_FOR_INDEPENDENT_DETECTOR_RUNTIME",
            "HOLD_FOR_MASKED_SPEECH_DETECTOR_CEILING",
            "HOLD_FOR_DIALOGUE_ENHANCEMENT_SOURCE_SEPARATION_INVESTIGATION",
            "HOLD_FOR_REVIEW_AUDIO_COVERAGE_REPAIR"
          ]
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "diagnosis": { "type": "string", "minLength": 1 },
              "errorComponentIds": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "reasons": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "required": ["diagnosis", "errorComponentIds", "reasons"],
            "additionalProperties": false
          }
        },
        "advisories": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "fullQueueGatePassed": { "type": "boolean" },
        "targetBudgetPassed": { "type": "boolean" },
        "fullQueueBurdenPassed": { "type": "boolean" },
        "engineeringPassed": { "type": "boolean" },
        "evaluationIntegrityPassed": { "type": "boolean" },
        "mandatorySubsetRecallIsBlocking": {
          "type": "boolean",
          "const": false
        },
        "lexicalIncompleteWhenAudibleIsBlocking": {
          "type": "boolean",
          "const": false
        },
        "finalizationMethod": { "type": "string", "const": "none" },
        "productionStatus": { "type": "string", "const": "needs-review" },
        "c602Status": { "type": "string", "const": "HOLD" },
        "machineOnlyReleaseAuthorized": { "type": "boolean", "const": false },
        "rankerRetrained": { "type": "boolean", "const": false },
        "humanTrialStarted": { "type": "boolean", "const": false },
        "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "required": [
        "primaryDecision",
        "blockers",
        "advisories",
        "fullQueueGatePassed",
        "targetBudgetPassed",
        "fullQueueBurdenPassed",
        "engineeringPassed",
        "evaluationIntegrityPassed",
        "mandatorySubsetRecallIsBlocking",
        "lexicalIncompleteWhenAudibleIsBlocking",
        "finalizationMethod",
        "productionStatus",
        "c602Status",
        "machineOnlyReleaseAuthorized",
        "rankerRetrained",
        "humanTrialStarted",
        "semanticHash"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "visibility",
    "generatedAt",
    "checks",
    "schemaResults",
    "schemaCount",
    "checkedArtifactCount",
    "engineeringPassed",
    "evaluationIntegrityPassed",
    "allChecksPassed",
    "route",
    "semanticHash"
  ],
  "additionalProperties": false
}
