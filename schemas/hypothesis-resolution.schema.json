{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/hypothesis-resolution.schema.json",
  "title": "hypothesis-resolution",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "inputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "configuration": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["top-score", "conservative", "balanced"]
        },
        "runtimeMode": { "type": "string", "const": "top-score" },
        "selectionMargin": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "null" }
          ]
        },
        "scoreGapReviewThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": ["mode", "selectionMargin"],
      "additionalProperties": false
    },
    "resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "clusterId": { "type": "string", "minLength": 1 },
          "candidateCueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "selectedCueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "rejectedCueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "decision": {
            "type": "string",
            "enum": [
              "accept-one",
              "merge-compatible-parts",
              "refine-again",
              "review-unresolved"
            ]
          },
          "winningMargin": {
            "anyOf": [
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "null" }
            ]
          },
          "winnerCueId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "winnerScore": {
            "anyOf": [
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "null" }
            ]
          },
          "runnerUpCueId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "runnerUpScore": {
            "anyOf": [
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "null" }
            ]
          },
          "scoreGap": {
            "anyOf": [
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "null" }
            ]
          },
          "reviewRecommended": { "type": "boolean" },
          "reviewReasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "tieBreakApplied": { "type": "boolean" },
          "tieBreakReasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "reasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "clusterId",
          "candidateCueIds",
          "selectedCueIds",
          "rejectedCueIds",
          "decision",
          "winningMargin",
          "reasons"
        ],
        "additionalProperties": false
      }
    },
    "unresolvedIntervals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "exclusiveMinimum": 0 },
          "clusterId": { "type": "string", "minLength": 1 },
          "candidateCueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "reasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": ["start", "end", "clusterId", "candidateCueIds", "reasons"],
        "additionalProperties": false
      }
    },
    "fallback": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "inputHash",
    "configuration",
    "resolutions",
    "unresolvedIntervals",
    "fallback"
  ],
  "additionalProperties": false
}
