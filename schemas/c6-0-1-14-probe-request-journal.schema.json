{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-14-probe-request-journal.schema.json",
  "title": "c6-0-1-14-probe-request-journal",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "c6-0-1-14-probe-request-journal"
    },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "requestId": { "type": "string", "minLength": 1 },
    "sourceIdentityHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "selectionHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "phase": {
      "type": "string",
      "enum": [
        "PROVIDER_RAW",
        "NORMALIZED_RESULT",
        "INFERENCE_DISPATCH",
        "FINAL_REQUEST"
      ]
    },
    "request": {
      "type": "object",
      "properties": {
        "requestId": { "type": "string", "minLength": 1 },
        "targetId": { "type": "string", "minLength": 1 },
        "provider": {
          "type": "string",
          "enum": ["whisper-large-v3", "reazonspeech-k2-v2"]
        },
        "windowType": {
          "type": "string",
          "enum": ["CORE_EXACT", "CORE_CONTEXT"]
        },
        "coreInterval": {
          "type": "object",
          "properties": {
            "start": { "type": "number", "minimum": 0 },
            "end": { "type": "number", "exclusiveMinimum": 0 }
          },
          "required": ["start", "end"],
          "additionalProperties": false
        },
        "extractionInterval": {
          "type": "object",
          "properties": {
            "start": { "type": "number", "minimum": 0 },
            "end": { "type": "number", "exclusiveMinimum": 0 }
          },
          "required": ["start", "end"],
          "additionalProperties": false
        },
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sourceIdentityHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "selectionHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "audioSha256": {
          "anyOf": [
            { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            { "type": "null" }
          ]
        },
        "sampleCount": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            { "type": "null" }
          ]
        },
        "extractionIdentityHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "cacheKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "runtimeIdentityHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "modelIdentityHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "prompt": { "type": "string", "const": "" },
        "vadEnabled": { "type": "boolean", "const": false },
        "status": {
          "type": "string",
          "enum": [
            "SUCCESS",
            "EMPTY_OUTPUT",
            "PROVIDER_ERROR",
            "EXTRACTION_ERROR",
            "CACHE_MISS",
            "CACHE_INVALID"
          ]
        },
        "execution": {
          "type": "string",
          "enum": [
            "FRESH_INFERENCE",
            "FRESH_ATTEMPT_FAILED",
            "VERIFIED_EXACT_REPLAY",
            "NOT_EXECUTED"
          ]
        },
        "rawText": { "type": "string" },
        "rawOutput": {
          "anyOf": [{ "$ref": "#/$defs/__schema0" }, { "type": "null" }]
        },
        "rawOutputHash": {
          "anyOf": [
            { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            { "type": "null" }
          ]
        },
        "tokens": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": { "type": "string" },
              "sourceInterval": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "start": { "type": "number", "minimum": 0 },
                      "end": { "type": "number", "exclusiveMinimum": 0 }
                    },
                    "required": ["start", "end"],
                    "additionalProperties": false
                  },
                  { "type": "null" }
                ]
              },
              "trusted": { "type": "boolean" },
              "probability": {
                "anyOf": [
                  { "type": "number", "minimum": 0, "maximum": 1 },
                  { "type": "null" }
                ]
              },
              "reason": { "type": "string" }
            },
            "required": [
              "text",
              "sourceInterval",
              "trusted",
              "probability",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "decoder": {
          "type": "object",
          "properties": {
            "averageLogProbability": {
              "anyOf": [{ "type": "number" }, { "type": "null" }]
            },
            "noSpeechProbability": {
              "anyOf": [
                { "type": "number", "minimum": 0, "maximum": 1 },
                { "type": "null" }
              ]
            },
            "temperature": {
              "anyOf": [{ "type": "number" }, { "type": "null" }]
            }
          },
          "required": [
            "averageLogProbability",
            "noSpeechProbability",
            "temperature"
          ],
          "additionalProperties": false
        },
        "localization": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "CORE_EXACT_ISLAND_LOCALIZED",
                "TRUSTED_GLOBAL_TOKEN_PROJECTION",
                "CONTEXT_TEXT_UNPROJECTABLE",
                "CORE_GUARD_OR_NEIGHBOR_UNRESOLVED",
                "EMPTY",
                "FAILED"
              ]
            },
            "localizedText": {
              "anyOf": [{ "type": "string" }, { "type": "null" }]
            },
            "guardSeconds": { "type": "number", "minimum": 0 },
            "guardNeighborOverlapSeconds": { "type": "number", "minimum": 0 },
            "coreNeighborOverlapSeconds": { "type": "number", "minimum": 0 },
            "completeness": {
              "type": "string",
              "enum": [
                "WHOLE_EXACT_ISLAND",
                "TOKEN_CHAIN_COMPLETE",
                "PARTIAL",
                "UNKNOWN",
                "EMPTY"
              ]
            },
            "projectionTokenCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "reasons": { "type": "array", "items": { "type": "string" } }
          },
          "required": [
            "status",
            "localizedText",
            "guardSeconds",
            "guardNeighborOverlapSeconds",
            "coreNeighborOverlapSeconds",
            "completeness",
            "projectionTokenCount",
            "reasons"
          ],
          "additionalProperties": false
        },
        "hallucinationRisk": { "type": "number", "minimum": 0, "maximum": 1 },
        "errorCode": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "wallClockSeconds": { "type": "number", "minimum": 0 },
        "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "required": [
        "requestId",
        "targetId",
        "provider",
        "windowType",
        "coreInterval",
        "extractionInterval",
        "sourceMediaSha256",
        "sourceIdentityHash",
        "policyHash",
        "selectionHash",
        "audioSha256",
        "sampleCount",
        "extractionIdentityHash",
        "cacheKey",
        "runtimeIdentityHash",
        "modelIdentityHash",
        "prompt",
        "vadEnabled",
        "status",
        "execution",
        "rawText",
        "rawOutput",
        "rawOutputHash",
        "tokens",
        "decoder",
        "localization",
        "hallucinationRisk",
        "errorCode",
        "warnings",
        "wallClockSeconds",
        "semanticHash"
      ],
      "additionalProperties": false
    },
    "payload": { "$ref": "#/$defs/__schema1" },
    "journalHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "sourceIdentity",
    "sourceTimebase",
    "runtimeGoldInputCount",
    "requestId",
    "sourceIdentityHash",
    "sourceMediaSha256",
    "policyHash",
    "selectionHash",
    "phase",
    "request",
    "payload",
    "journalHash"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/__schema0" } },
        {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": { "$ref": "#/$defs/__schema0" }
        }
      ]
    },
    "__schema1": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/__schema1" } },
        {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": { "$ref": "#/$defs/__schema1" }
        }
      ]
    }
  }
}
