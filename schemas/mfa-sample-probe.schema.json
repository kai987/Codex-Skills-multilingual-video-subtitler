{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/mfa-sample-probe.schema.json",
  "title": "mfa-sample-probe",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": { "type": "string", "const": "mfa-sample-probe" },
    "probeVersion": { "type": "string", "const": "C5.17.1" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "componentId": { "type": "string", "minLength": 1 },
    "cueId": { "type": "string", "minLength": 1 },
    "runtimeIdentityHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "acousticModelIdentityHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dictionaryModelIdentityHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "g2pModelIdentityHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "command": { "type": "string", "enum": ["align_one", "align_one_legacy"] },
    "g2pCommand": { "type": "string", "enum": ["g2p", "g2p_one"] },
    "outputFormat": { "type": "string", "enum": ["json", "long_textgrid"] },
    "wordTierObserved": { "type": "boolean" },
    "phoneTierObserved": { "type": "boolean" },
    "fileInterval": {
      "type": "object",
      "properties": {
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "exclusiveMinimum": 0 }
      },
      "required": ["start", "end"],
      "additionalProperties": false
    },
    "lexicalUtteranceInterval": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "start": { "type": "number", "minimum": 0 },
            "end": { "type": "number", "exclusiveMinimum": 0 }
          },
          "required": ["start", "end"],
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "phoneUtteranceInterval": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "start": { "type": "number", "minimum": 0 },
            "end": { "type": "number", "exclusiveMinimum": 0 }
          },
          "required": ["start", "end"],
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "selectedUtteranceInterval": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "start": { "type": "number", "minimum": 0 },
            "end": { "type": "number", "exclusiveMinimum": 0 }
          },
          "required": ["start", "end"],
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "selectedBoundarySource": {
      "type": "string",
      "enum": ["lexical-word-tier", "phone-tier-fallback", "none"]
    },
    "wordCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "phoneCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "oovCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "timeUnit": { "type": "string", "const": "seconds" },
    "parserVersion": { "type": "string", "minLength": 1 },
    "alignmentSucceeded": { "type": "boolean" },
    "failure": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "probeVersion",
    "generatedAt",
    "componentId",
    "cueId",
    "runtimeIdentityHash",
    "acousticModelIdentityHash",
    "dictionaryModelIdentityHash",
    "g2pModelIdentityHash",
    "command",
    "g2pCommand",
    "outputFormat",
    "wordTierObserved",
    "phoneTierObserved",
    "fileInterval",
    "lexicalUtteranceInterval",
    "phoneUtteranceInterval",
    "selectedUtteranceInterval",
    "selectedBoundarySource",
    "wordCount",
    "phoneCount",
    "oovCount",
    "timeUnit",
    "parserVersion",
    "alignmentSucceeded",
    "failure"
  ],
  "additionalProperties": false
}
