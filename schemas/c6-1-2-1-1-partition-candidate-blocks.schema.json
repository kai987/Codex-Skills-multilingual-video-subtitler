{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-1-2-1-1-partition-candidate-blocks.schema.json",
  "title": "c6-1-2-1-1-partition-candidate-blocks",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "c6-1-2-1-1-partition-candidate-blocks"
    },
    "policyVersion": {
      "type": "string",
      "const": "c6.1.2.1.1-constrained-monotonic-partition-reachable-evaluation-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "mode": {
      "type": "string",
      "enum": [
        "D0_NO_CUT",
        "D1_CONSERVATIVE_MONOTONIC",
        "D2_RELAXED_DIAGNOSTIC_ONLY"
      ]
    },
    "inventoryHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "block": {
            "type": "object",
            "properties": {
              "machineGroupIds": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "machineCueIds": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "machineEventIds": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "goldCueIds": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "edgeIds": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "foldId": {
                "anyOf": [
                  { "type": "string", "minLength": 1 },
                  { "type": "null" }
                ]
              },
              "frozenFoldIds": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "machineSourceInterval": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "start": { "type": "number" },
                      "end": { "type": "number" }
                    },
                    "required": ["start", "end"],
                    "additionalProperties": false
                  },
                  { "type": "null" }
                ]
              },
              "goldSourceInterval": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "start": { "type": "number" },
                      "end": { "type": "number" }
                    },
                    "required": ["start", "end"],
                    "additionalProperties": false
                  },
                  { "type": "null" }
                ]
              },
              "totalSourceInterval": {
                "type": "object",
                "properties": {
                  "start": { "type": "number" },
                  "end": { "type": "number" }
                },
                "required": ["start", "end"],
                "additionalProperties": false
              },
              "machineCoveredRatio": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "goldCoveredRatio": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "machineCueCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "goldCueCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "machineGroupCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "maximumMachineGapSeconds": { "type": "number", "minimum": 0 },
              "maximumGoldGapSeconds": { "type": "number", "minimum": 0 },
              "durationSeconds": { "type": "number", "minimum": 0 },
              "shadowEvaluationEligible": { "type": "boolean" },
              "candidateLabelEligible": { "type": "boolean" },
              "oofTrainingEligible": { "type": "boolean" },
              "candidateEligibleEventIds": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "candidateAmbiguousEventIds": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "reasons": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "partitionBlockId": { "type": "string", "minLength": 1 },
              "parentE2SupergroupId": { "type": "string", "minLength": 1 },
              "machineIndexRange": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "start": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "end": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": ["start", "end"],
                    "additionalProperties": false
                  },
                  { "type": "null" }
                ]
              },
              "goldIndexRange": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "start": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "end": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": ["start", "end"],
                    "additionalProperties": false
                  },
                  { "type": "null" }
                ]
              },
              "retainedEdgeIds": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "cutEdgeIds": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "minimumNodeRetainedOverlapRatio": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "discardedOverlapSeconds": { "type": "number", "minimum": 0 },
              "componentDiscardedOverlapRatio": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "structuralStatus": {
                "type": "string",
                "enum": [
                  "STRUCTURALLY_VALID",
                  "STRUCTURE_INCOMPATIBLE",
                  "RESIDUAL_UNPARTITIONED",
                  "GOLD_ONLY_UNREACHABLE",
                  "MACHINE_ONLY_NO_GOLD_BINDING"
                ]
              },
              "assignmentCategory": {
                "type": "string",
                "enum": [
                  "PARTITIONED_EVALUABLE_BLOCK",
                  "PARTITIONED_CANDIDATE_LABEL_INELIGIBLE_BLOCK",
                  "RESIDUAL_UNPARTITIONED",
                  "GOLD_ONLY",
                  "MACHINE_ONLY"
                ]
              },
              "nodeRetainedOverlap": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "nodeId": { "type": "string", "minLength": 1 },
                    "side": { "type": "string", "enum": ["MACHINE", "GOLD"] },
                    "retainedSeconds": { "type": "number", "minimum": 0 },
                    "originalSeconds": { "type": "number", "minimum": 0 },
                    "ratio": { "type": "number", "minimum": 0, "maximum": 1 }
                  },
                  "required": [
                    "nodeId",
                    "side",
                    "retainedSeconds",
                    "originalSeconds",
                    "ratio"
                  ],
                  "additionalProperties": false
                }
              },
              "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            },
            "required": [
              "machineGroupIds",
              "machineCueIds",
              "machineEventIds",
              "goldCueIds",
              "edgeIds",
              "foldId",
              "frozenFoldIds",
              "machineSourceInterval",
              "goldSourceInterval",
              "totalSourceInterval",
              "machineCoveredRatio",
              "goldCoveredRatio",
              "machineCueCount",
              "goldCueCount",
              "machineGroupCount",
              "maximumMachineGapSeconds",
              "maximumGoldGapSeconds",
              "durationSeconds",
              "shadowEvaluationEligible",
              "candidateLabelEligible",
              "oofTrainingEligible",
              "candidateEligibleEventIds",
              "candidateAmbiguousEventIds",
              "reasons",
              "partitionBlockId",
              "parentE2SupergroupId",
              "machineIndexRange",
              "goldIndexRange",
              "retainedEdgeIds",
              "cutEdgeIds",
              "minimumNodeRetainedOverlapRatio",
              "discardedOverlapSeconds",
              "componentDiscardedOverlapRatio",
              "structuralStatus",
              "assignmentCategory",
              "nodeRetainedOverlap",
              "semanticHash"
            ],
            "additionalProperties": false
          },
          "valid": { "type": "boolean" },
          "rejectionReasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": ["block", "valid", "rejectionReasons"],
        "additionalProperties": false
      }
    },
    "candidateBlockCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "validCandidateBlockCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "goldTextUsedForPartitionCount": { "type": "number", "const": 0 }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "policyVersion",
    "policyHash",
    "semanticHash",
    "mode",
    "inventoryHash",
    "rows",
    "candidateBlockCount",
    "validCandidateBlockCount",
    "goldTextUsedForPartitionCount"
  ],
  "additionalProperties": false
}
