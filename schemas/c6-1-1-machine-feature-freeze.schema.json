{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-1-1-machine-feature-freeze.schema.json",
  "title": "c6-1-1-machine-feature-freeze",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.1.1-fixed-alignment-selective-existing-mbr-v1"
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": {
      "type": "string",
      "const": "c6-1-1-machine-feature-freeze"
    },
    "runtimeNodeVersion": { "type": "string", "pattern": "^v?24\\." },
    "sharedSourceEntry": {
      "type": "string",
      "const": "packages/shared/src/index.ts"
    },
    "runtimeSourceExecutionVerified": { "type": "boolean", "const": true },
    "frozenAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "proposalHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "featureSchemaHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "featureTableHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidateUniverseHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "correlationPolicyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "riskPolicyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "foldHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "baselineHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "machineFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relativePath": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["relativePath", "sha256", "size"],
        "additionalProperties": false
      }
    },
    "machineAggregateHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceCodeFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relativePath": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["relativePath", "sha256", "size"],
        "additionalProperties": false
      }
    },
    "sourceCodeAggregateHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inputHashes": {
      "type": "object",
      "propertyNames": { "type": "string" },
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "frozenBeforeGold": { "type": "boolean", "const": true },
    "aBMachineParity": { "type": "boolean", "const": true },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "newAsrInferenceCount": { "type": "number", "const": 0 },
    "networkUsed": { "type": "boolean", "const": false }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "semanticHash",
    "artifactType",
    "runtimeNodeVersion",
    "sharedSourceEntry",
    "runtimeSourceExecutionVerified",
    "frozenAt",
    "proposalHash",
    "featureSchemaHash",
    "featureTableHash",
    "candidateUniverseHash",
    "correlationPolicyHash",
    "riskPolicyHash",
    "foldHash",
    "policyHash",
    "baselineHash",
    "machineFiles",
    "machineAggregateHash",
    "sourceCodeFiles",
    "sourceCodeAggregateHash",
    "inputHashes",
    "frozenBeforeGold",
    "aBMachineParity",
    "runtimeGoldInputCount",
    "newAsrInferenceCount",
    "networkUsed"
  ],
  "additionalProperties": false
}
