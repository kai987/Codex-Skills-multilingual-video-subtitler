            "required": ["start", "end"],
            "additionalProperties": false
          },
          "overlapSeconds": { "type": "number", "exclusiveMinimum": 0 },
          "currentText": { "type": "string", "minLength": 1 },
          "currentBlockers": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "effectiveBlockersAfterFreshness": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
