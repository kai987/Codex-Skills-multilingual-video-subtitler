                "type": "object",
                "properties": {
                  "source": { "type": "string", "minLength": 1 },
                  "status": { "type": "string", "minLength": 1 },
                  "result": { "type": "string", "minLength": 1 },
                  "evidencePolarity": {
                    "type": "string",
                    "enum": [
                      "positive-risk-evidence",
                      "absence-of-support",
                      "contradictory-evidence",
                      "execution-diagnostic",
                      "format-advisory"
