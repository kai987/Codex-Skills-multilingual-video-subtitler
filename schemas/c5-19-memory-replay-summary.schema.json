{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c5-19-memory-replay-summary.schema.json",
  "title": "c5-19-memory-replay-summary",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "c5-19-memory-replay-summary"
    },
    "replayVersion": { "type": "string", "const": "C5.19" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "runKind": { "type": "string", "enum": ["bootstrap", "causal", "frozen"] },
    "networkUsed": { "type": "boolean", "const": false },
    "sourceTaskHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceCueCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "seriesIdentity": {
      "type": "object",
      "properties": {
        "seriesKey": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "normalizedTitle": { "type": "string", "minLength": 1 },
        "year": {
          "anyOf": [
            { "type": "integer", "minimum": 1800, "maximum": 2200 },
            { "type": "null" }
          ]
        },
        "season": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            { "type": "null" }
          ]
        },
        "mediaType": {
          "type": "string",
          "enum": ["series", "movie", "special", "unknown"]
        },
        "identitySource": {
          "type": "string",
          "enum": [
            "subtitle-package-media-identity",
            "explicit-series-task",
            "curated-memory"
          ]
        },
        "identityStatus": {
          "type": "string",
          "enum": ["verified", "provisional", "insufficient"]
        },
        "identityEvidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "memoryScope": {
          "type": "string",
          "enum": ["episode", "season", "series"]
        }
      },
      "required": [
        "seriesKey",
        "title",
        "normalizedTitle",
        "year",
        "season",
        "mediaType",
        "identitySource",
        "identityStatus",
        "identityEvidence",
        "memoryScope"
      ],
      "additionalProperties": false
    },
    "memoryHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactPaths": {
      "type": "object",
      "properties": {
        "memory": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\/)(?![A-Za-z]:[\\\\/])(?!\\\\\\\\).+"
        },
        "observations": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\/)(?![A-Za-z]:[\\\\/])(?!\\\\\\\\).+"
        },
        "delta": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\/)(?![A-Za-z]:[\\\\/])(?!\\\\\\\\).+"
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\/)(?![A-Za-z]:[\\\\/])(?!\\\\\\\\).+"
        },
        "ranking": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\/)(?![A-Za-z]:[\\\\/])(?!\\\\\\\\).+"
        },
        "pronunciationProjection": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\/)(?![A-Za-z]:[\\\\/])(?!\\\\\\\\).+"
        },
        "ctcTargetAudit": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\/)(?![A-Za-z]:[\\\\/])(?!\\\\\\\\).+"
        },
        "ctcObservation": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\/)(?![A-Za-z]:[\\\\/])(?!\\\\\\\\).+"
        },
        "causalValidation": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\/)(?![A-Za-z]:[\\\\/])(?!\\\\\\\\).+"
        },
        "qualityAudit": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\/)(?![A-Za-z]:[\\\\/])(?!\\\\\\\\).+"
        }
      },
      "required": [
        "memory",
        "observations",
        "delta",
        "evidence",
        "ranking",
        "pronunciationProjection",
        "ctcTargetAudit",
        "ctcObservation",
        "causalValidation",
        "qualityAudit"
      ],
      "additionalProperties": false
    },
    "hashes": {
      "type": "object",
      "properties": {
        "canonicalCueHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "canonicalTimingHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "presentationHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "memoryHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "observationSemanticHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "deltaSemanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "evidenceSemanticHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rankingSemanticHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "pronunciationProjectionSemanticHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "ctcTargetAuditSemanticHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "causalValidationSemanticHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "canonicalCueHash",
        "canonicalTimingHash",
        "presentationHash",
        "memoryHash",
        "observationSemanticHash",
        "deltaSemanticHash",
        "evidenceSemanticHash",
        "rankingSemanticHash",
        "pronunciationProjectionSemanticHash",
        "ctcTargetAuditSemanticHash",
        "causalValidationSemanticHash"
      ],
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "propertyNames": { "type": "string" },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "reviewItemCountBefore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reviewItemCountAfter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "finalStatus": { "type": "string", "const": "needs-review" },
    "finalizationMethod": { "type": "string", "const": "none" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "replayVersion",
    "generatedAt",
    "runKind",
    "networkUsed",
    "sourceTaskHash",
    "sourceCueCount",
    "seriesIdentity",
    "memoryHash",
    "artifactPaths",
    "hashes",
    "metrics",
    "reviewItemCountBefore",
    "reviewItemCountAfter",
    "finalStatus",
    "finalizationMethod",
    "semanticHash"
  ],
  "additionalProperties": false
}
