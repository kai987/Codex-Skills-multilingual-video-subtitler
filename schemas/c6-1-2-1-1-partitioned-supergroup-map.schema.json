{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-1-2-1-1-partitioned-supergroup-map.schema.json",
  "title": "c6-1-2-1-1-partitioned-supergroup-map",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "c6-1-2-1-1-partitioned-supergroup-map"
    },
    "policyVersion": {
      "type": "string",
      "const": "c6.1.2.1.1-constrained-monotonic-partition-reachable-evaluation-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "mode": {
      "type": "string",
      "enum": [
        "D0_NO_CUT",
        "D1_CONSERVATIVE_MONOTONIC",
        "D2_RELAXED_DIAGNOSTIC_ONLY"
      ]
    },
    "e2MapHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "inventoryHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidateBlocksHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "machineMappingHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "foldHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "goldTimingHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "edgeLedgerHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "baselineCueOrder": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "goldCueOrder": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "machineGroupIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "machineCueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "machineEventIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "goldCueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "edgeIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "foldId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "frozenFoldIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "machineSourceInterval": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "start": { "type": "number" },
                  "end": { "type": "number" }
                },
                "required": ["start", "end"],
                "additionalProperties": false
              },
              { "type": "null" }
            ]
          },
          "goldSourceInterval": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "start": { "type": "number" },
                  "end": { "type": "number" }
                },
                "required": ["start", "end"],
                "additionalProperties": false
              },
              { "type": "null" }
            ]
          },
          "totalSourceInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number" },
              "end": { "type": "number" }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "machineCoveredRatio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "goldCoveredRatio": { "type": "number", "minimum": 0, "maximum": 1 },
          "machineCueCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "goldCueCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "machineGroupCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "maximumMachineGapSeconds": { "type": "number", "minimum": 0 },
          "maximumGoldGapSeconds": { "type": "number", "minimum": 0 },
          "durationSeconds": { "type": "number", "minimum": 0 },
          "shadowEvaluationEligible": { "type": "boolean" },
          "candidateLabelEligible": { "type": "boolean" },
          "oofTrainingEligible": { "type": "boolean" },
          "candidateEligibleEventIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "candidateAmbiguousEventIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "reasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "partitionBlockId": { "type": "string", "minLength": 1 },
          "parentE2SupergroupId": { "type": "string", "minLength": 1 },
          "machineIndexRange": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": ["start", "end"],
                "additionalProperties": false
              },
              { "type": "null" }
            ]
          },
          "goldIndexRange": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": ["start", "end"],
                "additionalProperties": false
              },
              { "type": "null" }
            ]
          },
          "retainedEdgeIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "cutEdgeIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "minimumNodeRetainedOverlapRatio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "discardedOverlapSeconds": { "type": "number", "minimum": 0 },
          "componentDiscardedOverlapRatio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "structuralStatus": {
            "type": "string",
            "enum": [
              "STRUCTURALLY_VALID",
              "STRUCTURE_INCOMPATIBLE",
              "RESIDUAL_UNPARTITIONED",
              "GOLD_ONLY_UNREACHABLE",
              "MACHINE_ONLY_NO_GOLD_BINDING"
            ]
          },
          "assignmentCategory": {
            "type": "string",
            "enum": [
              "PARTITIONED_EVALUABLE_BLOCK",
              "PARTITIONED_CANDIDATE_LABEL_INELIGIBLE_BLOCK",
              "RESIDUAL_UNPARTITIONED",
              "GOLD_ONLY",
              "MACHINE_ONLY"
            ]
          },
          "nodeRetainedOverlap": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "nodeId": { "type": "string", "minLength": 1 },
                "side": { "type": "string", "enum": ["MACHINE", "GOLD"] },
                "retainedSeconds": { "type": "number", "minimum": 0 },
                "originalSeconds": { "type": "number", "minimum": 0 },
                "ratio": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "required": [
                "nodeId",
                "side",
                "retainedSeconds",
                "originalSeconds",
                "ratio"
              ],
              "additionalProperties": false
            }
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "machineGroupIds",
          "machineCueIds",
          "machineEventIds",
          "goldCueIds",
          "edgeIds",
          "foldId",
          "frozenFoldIds",
          "machineSourceInterval",
          "goldSourceInterval",
          "totalSourceInterval",
          "machineCoveredRatio",
          "goldCoveredRatio",
          "machineCueCount",
          "goldCueCount",
          "machineGroupCount",
          "maximumMachineGapSeconds",
          "maximumGoldGapSeconds",
          "durationSeconds",
          "shadowEvaluationEligible",
          "candidateLabelEligible",
          "oofTrainingEligible",
          "candidateEligibleEventIds",
          "candidateAmbiguousEventIds",
          "reasons",
          "partitionBlockId",
          "parentE2SupergroupId",
          "machineIndexRange",
          "goldIndexRange",
          "retainedEdgeIds",
          "cutEdgeIds",
          "minimumNodeRetainedOverlapRatio",
          "discardedOverlapSeconds",
          "componentDiscardedOverlapRatio",
          "structuralStatus",
          "assignmentCategory",
          "nodeRetainedOverlap",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "parentE2SupergroupId": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": [
              "ALREADY_BOUNDED",
              "FULLY_PARTITIONED",
              "PARTIALLY_PARTITIONED_WITH_RESIDUAL",
              "UNSPLITTABLE_STRONG_BRIDGE",
              "UNSPLITTABLE_COVERAGE",
              "UNSPLITTABLE_CUE_LIMIT",
              "UNSPLITTABLE_DURATION_LIMIT",
              "UNSPLITTABLE_GAP_LIMIT",
              "CROSS_FOLD_BLOCKED",
              "NO_VALID_MONOTONIC_PARTITION",
              "GOLD_ONLY_UNREACHABLE",
              "MACHINE_ONLY_NO_GOLD_BINDING"
            ]
          },
          "partitionBlockIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "residualBlockIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "originalEdgeSeconds": { "type": "number", "minimum": 0 },
          "cutOverlapSeconds": { "type": "number", "minimum": 0 },
          "componentDiscardedOverlapRatio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minimumNodeRetainedOverlapRatio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "objective": {
            "type": "object",
            "properties": {
              "retainedOverlapSeconds": { "type": "number", "minimum": 0 },
              "candidateReachableMachineGroups": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "productionCueCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "interventionReachableGoldCues": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "discardedOverlapSeconds": { "type": "number", "minimum": 0 },
              "residualBilateralNodes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "blockCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "deterministicPathHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "retainedOverlapSeconds",
              "candidateReachableMachineGroups",
              "productionCueCount",
              "interventionReachableGoldCues",
              "discardedOverlapSeconds",
              "residualBilateralNodes",
              "blockCount",
              "deterministicPathHash"
            ],
            "additionalProperties": false
          },
          "visitedStates": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "solver": {
            "type": "string",
            "const": "EXACT_MONOTONE_INTERVAL_DAG_ENUMERATION"
          },
          "optimalityProven": { "type": "boolean", "const": true },
          "reasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "parentE2SupergroupId",
          "status",
          "partitionBlockIds",
          "residualBlockIds",
          "originalEdgeSeconds",
          "cutOverlapSeconds",
          "componentDiscardedOverlapRatio",
          "minimumNodeRetainedOverlapRatio",
          "objective",
          "visitedStates",
          "solver",
          "optimalityProven",
          "reasons"
        ],
        "additionalProperties": false
      }
    },
    "goldTextUsedForPartitionCount": { "type": "number", "const": 0 },
    "profileRematchingCount": { "type": "number", "const": 0 }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "policyVersion",
    "policyHash",
    "semanticHash",
    "mode",
    "e2MapHash",
    "inventoryHash",
    "candidateBlocksHash",
    "machineMappingHash",
    "foldHash",
    "goldTimingHash",
    "edgeLedgerHash",
    "baselineCueOrder",
    "goldCueOrder",
    "blocks",
    "components",
    "goldTextUsedForPartitionCount",
    "profileRematchingCount"
  ],
  "additionalProperties": false
}
