{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/coverage-recovery-plan.schema.json",
  "title": "coverage-recovery-plan",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "inputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "configuration": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["off", "auto", "deep"] },
        "maximumRounds": { "type": "integer", "minimum": 1, "maximum": 2 },
        "maximumWindowSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20
        },
        "ordinaryReviewOnlyDoesNotTriggerAsr": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "mode",
        "maximumRounds",
        "maximumWindowSeconds",
        "ordinaryReviewOnlyDoesNotTriggerAsr"
      ],
      "additionalProperties": false
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "round": { "type": "integer", "minimum": 1, "maximum": 2 },
          "priority": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3", "P4"]
          },
          "interval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "anchorIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "sourceCueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "triggerCodes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "route": {
            "type": "string",
            "enum": [
              "sensitive-vad",
              "extra-sensitive-vad",
              "vad-and-no-vad",
              "no-vad-large-v3",
              "narration-context",
              "lyrics-pipeline",
              "review-only"
            ]
          },
          "shouldRunAsr": { "type": "boolean" },
          "evidence": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "id",
          "round",
          "priority",
          "interval",
          "anchorIds",
          "sourceCueIds",
          "triggerCodes",
          "route",
          "shouldRunAsr",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "unitCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "automaticRequestCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reviewOnlyCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "priorityCounts": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3", "P4"]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "required": ["P0", "P1", "P2", "P3", "P4"]
        }
      },
      "required": [
        "unitCount",
        "automaticRequestCount",
        "reviewOnlyCount",
        "priorityCounts"
      ],
      "additionalProperties": false
    },
    "fallback": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "inputHash",
    "configuration",
    "units",
    "summary",
    "fallback"
  ],
  "additionalProperties": false
}
