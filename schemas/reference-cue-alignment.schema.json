{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/reference-cue-alignment.schema.json",
  "title": "reference-cue-alignment",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "referenceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generatedSubtitleSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "algorithmVersion": { "type": "string", "minLength": 1 },
    "configuration": {
      "default": {
        "boundaryToleranceSeconds": 0.6,
        "semanticSimilarityMethod": "unavailable"
      },
      "type": "object",
      "properties": {
        "boundaryToleranceSeconds": { "type": "number", "minimum": 0 },
        "semanticSimilarityMethod": {
          "type": "string",
          "enum": ["unavailable", "local-model", "external-model"]
        }
      },
      "required": ["boundaryToleranceSeconds", "semanticSimilarityMethod"],
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "mapping": {
            "type": "string",
            "enum": [
              "one-to-one",
              "one-to-many",
              "many-to-one",
              "many-to-many",
              "unmatched-reference",
              "unmatched-generated"
            ]
          },
          "referenceAnchorIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "generatedCueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "interval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "temporalIou": { "type": "number", "minimum": 0, "maximum": 1 },
          "startErrorSeconds": {
            "anyOf": [{ "type": "number" }, { "type": "null" }]
          },
          "endErrorSeconds": {
            "anyOf": [{ "type": "number" }, { "type": "null" }]
          },
          "sceneAgreement": {
            "anyOf": [{ "type": "boolean" }, { "type": "null" }]
          },
          "speechEvidence": {
            "type": "string",
            "enum": ["supported", "unsupported", "unavailable"]
          },
          "semanticSimilarity": {
            "anyOf": [
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "null" }
            ]
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "id",
          "mapping",
          "referenceAnchorIds",
          "generatedCueIds",
          "interval",
          "temporalIou",
          "startErrorSeconds",
          "endErrorSeconds",
          "sceneAgreement",
          "speechEvidence",
          "semanticSimilarity",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "one-to-one",
          "one-to-many",
          "many-to-one",
          "many-to-many",
          "unmatched-reference",
          "unmatched-generated"
        ]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "required": [
        "one-to-one",
        "one-to-many",
        "many-to-one",
        "many-to-many",
        "unmatched-reference",
        "unmatched-generated"
      ]
    },
    "fallback": {
      "default": null,
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "referenceSha256",
    "generatedSubtitleSha256",
    "algorithmVersion",
    "configuration",
    "entries",
    "summary",
    "fallback"
  ],
  "additionalProperties": false
}
