{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-canonical-mutation-proposals.schema.json",
  "title": "machine-canonical-mutation-proposals",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.5-evidence-to-canonical-raw-asr-recovery-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "machine-canonical-mutation-proposals"
    },
    "mode": { "type": "string", "enum": ["off", "observe", "enforce"] },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "proposalId": { "type": "string", "minLength": 1 },
          "eventId": { "type": "string", "minLength": 1 },
          "finalCueIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "proposalType": {
            "type": "string",
            "enum": [
              "TEXT_VARIANT_REPLACE",
              "REASR_TEXT_REPLACE",
              "START_TIME_REFINE",
              "END_TIME_REFINE",
              "BOTH_BOUNDARIES_REFINE",
              "SPLIT_CUE",
              "MERGE_CUE",
              "DROP_HALLUCINATION",
              "NO_OP"
            ]
          },
          "fromVariantId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "toVariantId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "beforeText": { "type": "string" },
          "afterText": { "type": "string" },
          "beforeTiming": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": { "type": "number", "minimum": 0 },
                "end": { "type": "number", "exclusiveMinimum": 0 }
              },
              "required": ["start", "end"],
              "additionalProperties": false
            }
          },
          "afterTiming": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": { "type": "number", "minimum": 0 },
                "end": { "type": "number", "exclusiveMinimum": 0 }
              },
              "required": ["start", "end"],
              "additionalProperties": false
            }
          },
          "evidenceIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "evidenceTier": {
            "type": "string",
            "enum": ["NONE", "WEAK", "MEDIUM", "STRONG"]
          },
          "evidenceDominance": {
            "type": "string",
            "enum": [
              "STRICTLY_STRONGER",
              "NON_DEGRADING",
              "INCOMPARABLE",
              "WEAKER"
            ]
          },
          "lineageVerified": { "type": "boolean" },
          "nonDegradationPassed": { "type": "boolean" },
          "safetyPassed": { "type": "boolean" },
          "applyStatus": {
            "type": "string",
            "enum": [
              "PROPOSED",
              "ACCEPTED",
              "REJECTED",
              "APPLIED",
              "ROLLED_BACK",
              "NO_OP"
            ]
          },
          "rejectionReasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "oracleInfo": {
            "type": "string",
            "const": "evaluation-only-not-runtime-input"
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "proposalId",
          "eventId",
          "finalCueIds",
          "proposalType",
          "fromVariantId",
          "toVariantId",
          "beforeText",
          "afterText",
          "beforeTiming",
          "afterTiming",
          "evidenceIds",
          "evidenceTier",
          "evidenceDominance",
          "lineageVerified",
          "nonDegradationPassed",
          "safetyPassed",
          "applyStatus",
          "rejectionReasons",
          "oracleInfo",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "proposedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "acceptedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rejectedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "noOpCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "textProposalCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "timingProposalCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "structuralObserveOnlyCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "proposedCount",
        "acceptedCount",
        "rejectedCount",
        "noOpCount",
        "textProposalCount",
        "timingProposalCount",
        "structuralObserveOnlyCount"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "mode",
    "proposals",
    "summary",
    "semanticHash"
  ],
  "additionalProperties": false
}
