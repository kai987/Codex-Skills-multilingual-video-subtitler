{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-10-control-regression-evaluation.schema.json",
  "title": "c6-0-1-10-control-regression-evaluation",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.10-cross-model-arbitration-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "c6-0-1-10-control-regression-evaluation"
    },
    "evaluationPhase": {
      "type": "string",
      "const": "post-decision-freeze-gold-isolated"
    },
    "controlEventCount": { "type": "number", "const": 12 },
    "reazonBetterCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "whisperBetterCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "equivalentCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "selectReazonCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "correctSelectReazonCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "wrongSelectReazonCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "avoidedBlindRegressionCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eventId": { "type": "string", "minLength": 1 },
          "blindReazonWouldRegress": {
            "anyOf": [{ "type": "boolean" }, { "type": "null" }]
          },
          "arbitrationDecision": {
            "type": "string",
            "enum": [
              "AGREEMENT_NO_CHANGE",
              "KEEP_CURRENT_WHISPER",
              "SELECT_REAZON",
              "ABSTAIN_REVIEW",
              "BLOCKED_NOT_LOCALIZABLE",
              "BLOCKED_NO_SAFE_SPAN",
              "BLOCKED_REAZON_UNSTABLE",
              "BLOCKED_CONFLICTING_EVIDENCE"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "CORRECT_SWITCH",
              "WRONG_SWITCH",
              "NEUTRAL_SWITCH",
              "AVOIDED_CONTROL_REGRESSION",
              "NO_SWITCH",
              "UNEVALUABLE"
            ]
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "eventId",
          "blindReazonWouldRegress",
          "arbitrationDecision",
          "outcome",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "evaluationPhase",
    "controlEventCount",
    "reazonBetterCount",
    "whisperBetterCount",
    "equivalentCount",
    "selectReazonCount",
    "correctSelectReazonCount",
    "wrongSelectReazonCount",
    "avoidedBlindRegressionCount",
    "events",
    "runtimeGoldInputCount",
    "semanticHash"
  ],
  "additionalProperties": false
}
