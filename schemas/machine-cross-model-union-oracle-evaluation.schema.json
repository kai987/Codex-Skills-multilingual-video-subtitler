{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-cross-model-union-oracle-evaluation.schema.json",
  "title": "machine-cross-model-union-oracle-evaluation",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.9-independent-asr-complementarity-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "machine-cross-model-union-oracle-evaluation"
    },
    "evaluationPhase": {
      "type": "string",
      "const": "post-freeze-gold-isolated"
    },
    "metricDirection": { "type": "string", "const": "LOWER_IS_BETTER" },
    "gainDefinition": {
      "type": "string",
      "const": "whisperOnlyOracleError-minus-unionOracleError"
    },
    "complementarityEvaluationSemanticHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eventId": { "type": "string", "minLength": 1 },
          "whisperOnlyOracleError": {
            "anyOf": [
              { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              { "type": "null" }
            ]
          },
          "unionOracleError": {
            "anyOf": [
              { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              { "type": "null" }
            ]
          },
          "complementarityGain": {
            "anyOf": [
              { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              { "type": "null" }
            ]
          },
          "improved": { "anyOf": [{ "type": "boolean" }, { "type": "null" }] },
          "reazonAddedBestCandidate": {
            "anyOf": [{ "type": "boolean" }, { "type": "null" }]
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "eventId",
          "whisperOnlyOracleError",
          "unionOracleError",
          "complementarityGain",
          "improved",
          "reazonAddedBestCandidate",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "evaluableCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "whisperOnlyOracleError": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unionOracleError": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "absoluteGain": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "relativeGain": { "type": "number", "minimum": 0, "maximum": 1 },
        "improvedEventCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reazonOnlyInformationGainEventCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "complementarityRate": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": [
        "evaluableCount",
        "whisperOnlyOracleError",
        "unionOracleError",
        "absoluteGain",
        "relativeGain",
        "improvedEventCount",
        "reazonOnlyInformationGainEventCount",
        "complementarityRate"
      ],
      "additionalProperties": false
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "evaluationPhase",
    "metricDirection",
    "gainDefinition",
    "complementarityEvaluationSemanticHash",
    "events",
    "summary",
    "runtimeGoldInputCount",
    "semanticHash"
  ],
  "additionalProperties": false
}
