{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-c6-1-2-reranker-decisions.schema.json",
  "title": "machine-c6-1-2-reranker-decisions",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "machine-c6-1-2-reranker-decisions"
    },
    "policyVersion": {
      "type": "string",
      "const": "c6.1.2-top-k-reranking-acoustic-completeness-v1"
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rankingHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "profileId": { "type": "string", "minLength": 1 },
          "eventId": { "type": "string", "minLength": 1 },
          "foldId": { "type": "string", "minLength": 1 },
          "modelHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "currentCandidateId": { "type": "string", "minLength": 1 },
          "ranked": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "candidateId": { "type": "string", "minLength": 1 },
                "score": { "type": "number" },
                "rank": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "current": { "type": "boolean" },
                "gateEligible": { "type": "boolean" },
                "gateReasons": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              },
              "required": [
                "candidateId",
                "score",
                "rank",
                "current",
                "gateEligible",
                "gateReasons"
              ],
              "additionalProperties": false
            }
          },
          "proposedCandidateId": { "type": "string", "minLength": 1 },
          "selectedCandidateId": { "type": "string", "minLength": 1 },
          "marginOverCurrent": { "type": "number" },
          "abstained": { "type": "boolean" },
          "reasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "testLabelUsed": { "type": "boolean", "const": false }
        },
        "required": [
          "profileId",
          "eventId",
          "foldId",
          "modelHash",
          "currentCandidateId",
          "ranked",
          "proposedCandidateId",
          "selectedCandidateId",
          "marginOverCurrent",
          "abstained",
          "reasons",
          "testLabelUsed"
        ],
        "additionalProperties": false
      }
    },
    "productionWriteAuthorized": { "type": "boolean", "const": false }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "policyVersion",
    "semanticHash",
    "rankingHash",
    "rows",
    "productionWriteAuthorized"
  ],
  "additionalProperties": false
}
