{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-14-3-1-baseline-hash-failure-reproduction.schema.json",
  "title": "c6-0-1-14-3-1-baseline-hash-failure-reproduction",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14.3.1-projection-hash-integrity-v1"
    },
    "visibility": { "type": "string", "const": "LOCAL_ONLY" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": {
      "type": "string",
      "const": "c6-0-1-14-3-1-baseline-hash-failure-reproduction"
    },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "sourceWorkspaceAudioRows": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sourceWorkspaceAudioHashesValid": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "strictProjectedAudioRows": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "staleProjectedAudioHashReuseCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "strictProjectedAudioHashesValid": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "playbackRows": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "playbackHashesValid": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "affectedStages": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["A0", "A1", "A2", "A3", "A4", "A5", "A6", "A7"]
      }
    },
    "reproduced": { "type": "boolean" },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "SOURCE_ROW_HASH_INVALID",
              "PROJECTED_ROW_HASH_STALE",
              "PROJECTED_ROW_HASH_MISSING",
              "PROJECTED_ROW_SCHEMA_INVALID",
              "NESTED_ROW_HASH_INVALID",
              "OUTER_HASH_VALID_NESTED_HASH_INVALID",
              "HASH_DOMAIN_NOT_REBOUND",
              "UNKNOWN_HASHABLE_ROW_TYPE"
            ]
          },
          "rowType": {
            "type": "string",
            "enum": [
              "PROJECTION_ARTIFACT",
              "PROJECTION_VARIANT",
              "PHYSICAL_AUDIO_ROW",
              "PLAYBACK_SEGMENT_ROW",
              "REVIEW_TARGET_ROW",
              "REVIEW_REGION_ROW",
              "SAFETY_TARGET_ROW",
              "SELECTABLE_CHILD_UNIT_ROW",
              "TARGET_BUNDLE_ROW",
              "CONTINUITY_LEDGER_ROW",
              "PHASE_A_OBLIGATION_ROW",
              "PLANNER_CERTIFICATE",
              "PROJECTION_REBINDING_LEDGER_ROW",
              "HIERARCHICAL_ATOM_ROW"
            ]
          },
          "rowId": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "pathWithinArtifact": { "type": "string", "minLength": 1 },
          "domain": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "SOURCE_WORKSPACE_AUDIO_ROW",
                  "STRICT_C601143_COVERAGE_AUDIO_PROJECTION_ROW",
                  "STRICT_C601143_COVERAGE_PLAYBACK_PROJECTION_ROW",
                  "C601143_PROJECTION_VARIANT",
                  "C601143_PROJECTION_SET"
                ]
              },
              { "type": "null" }
            ]
          },
          "expectedHash": {
            "anyOf": [
              { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              { "type": "null" }
            ]
          },
          "actualHash": {
            "anyOf": [
              { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              { "type": "null" }
            ]
          }
        },
        "required": [
          "code",
          "rowType",
          "rowId",
          "path",
          "pathWithinArtifact",
          "domain",
          "expectedHash",
          "actualHash"
        ],
        "additionalProperties": false
      }
    },
    "goldReadAttempted": { "type": "boolean", "const": false },
    "inferenceCount": { "type": "number", "const": 0 }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "visibility",
    "semanticHash",
    "artifactType",
    "sourceIdentity",
    "sourceWorkspaceAudioRows",
    "sourceWorkspaceAudioHashesValid",
    "strictProjectedAudioRows",
    "staleProjectedAudioHashReuseCount",
    "strictProjectedAudioHashesValid",
    "playbackRows",
    "playbackHashesValid",
    "affectedStages",
    "reproduced",
    "failures",
    "goldReadAttempted",
    "inferenceCount"
  ],
  "additionalProperties": false
}
