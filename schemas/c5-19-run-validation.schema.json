{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c5-19-run-validation.schema.json",
  "title": "c5-19-run-validation",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": { "type": "string", "const": "c5-19-run-validation" },
    "validationVersion": { "type": "string", "const": "C5.19" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "bootstrapPath": { "type": "string", "minLength": 1 },
    "causalPath": { "type": "string", "minLength": 1 },
    "frozenPath": { "type": "string", "minLength": 1 },
    "checks": {
      "type": "object",
      "propertyNames": { "type": "string" },
      "additionalProperties": { "type": "boolean" }
    },
    "idempotentMerge": { "type": "boolean" },
    "passed": { "type": "boolean" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "validationVersion",
    "generatedAt",
    "bootstrapPath",
    "causalPath",
    "frozenPath",
    "checks",
    "idempotentMerge",
    "passed",
    "semanticHash"
  ],
  "additionalProperties": false
}
