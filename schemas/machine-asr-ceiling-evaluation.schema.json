{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-asr-ceiling-evaluation.schema.json",
  "title": "machine-asr-ceiling-evaluation",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.6-acoustic-risk-span-text-joint-boundary-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "machine-asr-ceiling-evaluation"
    },
    "zone": { "type": "string", "const": "evaluation-only-gold-isolated" },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "errorId": { "type": "string", "minLength": 1 },
          "cueId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "classification": {
            "type": "string",
            "enum": [
              "PIPELINE_DECISION_RECOVERABLE",
              "EXISTING_VARIANT_RECOVERABLE",
              "REASR_RECOVERABLE",
              "CURRENT_WHISPER_CONSISTENTLY_WRONG",
              "ASSOCIATION_REMAINING",
              "SPAN_LINEAGE_BLOCKED",
              "UNKNOWN"
            ]
          },
          "machineCandidateIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "evidenceIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "reasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "errorId",
          "cueId",
          "classification",
          "machineCandidateIds",
          "evidenceIds",
          "reasons",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "materialErrorCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "recoverableByPipeline": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "recoverableByExistingVariant": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "recoverableByReAsr": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "currentWhisperConsistentlyWrong": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "associationRemaining": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "spanLineageBlocked": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unknown": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "aggregatePotential": { "type": "number", "minimum": 0, "maximum": 1 },
        "recommendation": {
          "type": "string",
          "enum": [
            "CONTINUE_PIPELINE_RECOVERY",
            "RECOMMEND_ASR_ENSEMBLE_NEXT",
            "INSUFFICIENT_EVIDENCE"
          ]
        }
      },
      "required": [
        "materialErrorCount",
        "recoverableByPipeline",
        "recoverableByExistingVariant",
        "recoverableByReAsr",
        "currentWhisperConsistentlyWrong",
        "associationRemaining",
        "spanLineageBlocked",
        "unknown",
        "aggregatePotential",
        "recommendation"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "zone",
    "runtimeGoldInputCount",
    "errors",
    "summary",
    "semanticHash"
  ],
  "additionalProperties": false
}
