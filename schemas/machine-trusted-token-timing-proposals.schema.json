{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-trusted-token-timing-proposals.schema.json",
  "title": "machine-trusted-token-timing-proposals",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.5-evidence-to-canonical-raw-asr-recovery-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "machine-trusted-token-timing-proposals"
    },
    "mode": { "type": "string", "enum": ["off", "observe", "enforce"] },
    "paddingPolicy": {
      "type": "object",
      "properties": {
        "policyVersion": {
          "type": "string",
          "const": "c6.0.1.5-fixed-token-padding-v1"
        },
        "startSeconds": { "type": "number", "const": 0.04 },
        "endSeconds": { "type": "number", "const": 0.08 },
        "goldTuned": { "type": "boolean", "const": false }
      },
      "required": ["policyVersion", "startSeconds", "endSeconds", "goldTuned"],
      "additionalProperties": false
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "proposalId": { "type": "string", "minLength": 1 },
          "cueId": { "type": "string", "minLength": 1 },
          "eventId": { "type": "string", "minLength": 1 },
          "trustedTokenIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "lexicalCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
          "beforeInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "tokenSpan": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "start": { "type": "number", "minimum": 0 },
                  "end": { "type": "number", "exclusiveMinimum": 0 }
                },
                "required": ["start", "end"],
                "additionalProperties": false
              },
              { "type": "null" }
            ]
          },
          "proposedInterval": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "start": { "type": "number", "minimum": 0 },
                  "end": { "type": "number", "exclusiveMinimum": 0 }
                },
                "required": ["start", "end"],
                "additionalProperties": false
              },
              { "type": "null" }
            ]
          },
          "padding": {
            "type": "object",
            "properties": {
              "startSeconds": { "type": "number", "minimum": 0 },
              "endSeconds": { "type": "number", "minimum": 0 }
            },
            "required": ["startSeconds", "endSeconds"],
            "additionalProperties": false
          },
          "confidenceClass": {
            "type": "string",
            "enum": ["HIGH", "MEDIUM", "LOW", "UNAVAILABLE"]
          },
          "proposalStatus": {
            "type": "string",
            "enum": [
              "ELIGIBLE",
              "GENERATED",
              "ACCEPTED",
              "REJECTED",
              "APPLIED",
              "UNCHANGED"
            ]
          },
          "blockers": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "proposalId",
          "cueId",
          "eventId",
          "trustedTokenIds",
          "lexicalCoverage",
          "beforeInterval",
          "tokenSpan",
          "proposedInterval",
          "padding",
          "confidenceClass",
          "proposalStatus",
          "blockers",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "timingEligibleCueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "proposalEligibleCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "proposalGeneratedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "proposalAcceptedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "proposalRejectedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mutationAppliedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unchangedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lineageFailedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tokenCoverageFailedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "overlapBlockedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "evidenceApplicationPassed": { "type": "boolean" }
      },
      "required": [
        "timingEligibleCueCount",
        "proposalEligibleCount",
        "proposalGeneratedCount",
        "proposalAcceptedCount",
        "proposalRejectedCount",
        "mutationAppliedCount",
        "unchangedCount",
        "lineageFailedCount",
        "tokenCoverageFailedCount",
        "overlapBlockedCount",
        "evidenceApplicationPassed"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "mode",
    "paddingPolicy",
    "proposals",
    "summary",
    "semanticHash"
  ],
  "additionalProperties": false
}
