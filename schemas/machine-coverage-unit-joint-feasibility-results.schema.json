{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-coverage-unit-joint-feasibility-results.schema.json",
  "title": "machine-coverage-unit-joint-feasibility-results",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14.5-safety-coverage-unit-contract-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "sourceTimebase": {
      "type": "string",
      "const": "SOURCE_GLOBAL_NATIVE_SAMPLES"
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "visibility": { "type": "string", "const": "LOCAL_ONLY" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": {
      "type": "string",
      "const": "machine-coverage-unit-joint-feasibility-results"
    },
    "coverageUnitsHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "unitUtilityHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "realizationCandidatesHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "realizationDominanceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "baselinePlannerHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "coverageUnitId": { "type": "string", "minLength": 1 },
          "contractType": {
            "type": "string",
            "enum": [
              "TARGET_CORE_LOCALIZATION_CONTRACT_V1",
              "MACHINE_ANCHORED_PLAYBACK_AUDIBILITY_CONTRACT_V1"
            ]
          },
          "realizationCandidateIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "forcedConstraint": {
            "type": "string",
            "const": "AT_LEAST_ONE_REALIZATION_FOR_UNIT_CONTRACT"
          },
          "searchMethod": {
            "type": "string",
            "const": "DETERMINISTIC_EXACT_LEXICOGRAPHIC_MILP"
          },
          "exploredStates": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "prunedStates": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "searchComplete": { "type": "boolean" },
          "feasibilityStatus": {
            "type": "string",
            "enum": [
              "JOINTLY_FEASIBLE",
              "INFEASIBLE_PROVEN",
              "SEARCH_INCOMPLETE",
              "NO_REALIZATION_SET",
              "ALREADY_SATISFIED_BY_PRODUCTION_PLAN"
            ]
          },
          "selectedRealizationId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "selectedBundleIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "selectedChildIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "counterfactualRemovedBundleIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "targetSlotCost": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "speechCoreCostSamples": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "predictedAudioCostSamples": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "phaseAObligationsPreserved": { "type": "boolean" },
          "hardConstraintsPassed": { "type": "boolean" },
          "objectiveDelta": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "coverageUnitId",
          "contractType",
          "realizationCandidateIds",
          "forcedConstraint",
          "searchMethod",
          "exploredStates",
          "prunedStates",
          "searchComplete",
          "feasibilityStatus",
          "selectedRealizationId",
          "selectedBundleIds",
          "selectedChildIds",
          "counterfactualRemovedBundleIds",
          "targetSlotCost",
          "speechCoreCostSamples",
          "predictedAudioCostSamples",
          "phaseAObligationsPreserved",
          "hardConstraintsPassed",
          "objectiveDelta",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "totalEligibleUnits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "auditedUnits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "unauditedUnits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "unauditedReasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "jointlyFeasibleCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "infeasibleProvenCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "searchIncompleteCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "noRealizationSetCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "allRequiredAuditsComplete": { "type": "boolean" },
    "individuallyFeasibleUnselectedHighTierChildCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "individuallyFeasibleChildDiagnosticOnly": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "policyHash",
    "sourceIdentity",
    "sourceTimebase",
    "runtimeGoldInputCount",
    "visibility",
    "semanticHash",
    "artifactType",
    "coverageUnitsHash",
    "unitUtilityHash",
    "realizationCandidatesHash",
    "realizationDominanceHash",
    "baselinePlannerHash",
    "rows",
    "totalEligibleUnits",
    "auditedUnits",
    "unauditedUnits",
    "unauditedReasons",
    "jointlyFeasibleCount",
    "infeasibleProvenCount",
    "searchIncompleteCount",
    "noRealizationSetCount",
    "allRequiredAuditsComplete",
    "individuallyFeasibleUnselectedHighTierChildCount",
    "individuallyFeasibleChildDiagnosticOnly"
  ],
  "additionalProperties": false
}
