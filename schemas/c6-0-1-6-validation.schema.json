{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-6-validation.schema.json",
  "title": "c6-0-1-6-validation",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.6-acoustic-risk-span-text-joint-boundary-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": { "type": "string", "const": "c6-0-1-6-validation" },
    "branch": {
      "type": "string",
      "const": "codex/c6-0-1-6-acoustic-risk-span-text-joint-boundary"
    },
    "repositoryCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "goldSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceReadOnlyVerified": { "type": "boolean" },
    "goldReadOnlyVerified": { "type": "boolean" },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "datasetHardcodingFindingCount": { "type": "number", "const": 0 },
    "unsafeFinalizationEscapeCount": { "type": "number", "const": 0 },
    "networkUsed": { "type": "boolean", "const": false },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "evidence": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": ["id", "passed", "evidence"],
        "additionalProperties": false
      }
    },
    "finalABParity": {
      "type": "object",
      "properties": {
        "text": { "type": "boolean" },
        "timing": { "type": "boolean" },
        "presentation": { "type": "boolean" },
        "riskVector": { "type": "boolean" },
        "reAsrPriority": { "type": "boolean" },
        "decoderEvidence": { "type": "boolean" },
        "spanLineage": { "type": "boolean" },
        "repairProposals": { "type": "boolean" },
        "timingProposals": { "type": "boolean" },
        "jointBoundary": { "type": "boolean" },
        "mutation": { "type": "boolean" },
        "shadowOutcome": { "type": "boolean" }
      },
      "required": [
        "text",
        "timing",
        "presentation",
        "riskVector",
        "reAsrPriority",
        "decoderEvidence",
        "spanLineage",
        "repairProposals",
        "timingProposals",
        "jointBoundary",
        "mutation",
        "shadowOutcome"
      ],
      "additionalProperties": false
    },
    "productionStatus": { "type": "string", "const": "needs-review" },
    "finalizationMethod": { "type": "string", "const": "none" },
    "machineReleaseAuthorized": { "type": "boolean", "const": false },
    "engineeringGatePassed": { "type": "boolean" },
    "pipelineQualityMilestonePassed": { "type": "boolean" },
    "strictC602QualityGatePassed": { "type": "boolean" },
    "outcome": {
      "type": "string",
      "enum": [
        "GO_C6_0_2",
        "HOLD_FOR_MORE_PIPELINE_RECOVERY",
        "RECOMMEND_ASR_ENSEMBLE_NEXT"
      ]
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "branch",
    "repositoryCommit",
    "sourceMediaSha256",
    "goldSha256",
    "sourceReadOnlyVerified",
    "goldReadOnlyVerified",
    "runtimeGoldInputCount",
    "datasetHardcodingFindingCount",
    "unsafeFinalizationEscapeCount",
    "networkUsed",
    "checks",
    "finalABParity",
    "productionStatus",
    "finalizationMethod",
    "machineReleaseAuthorized",
    "engineeringGatePassed",
    "pipelineQualityMilestonePassed",
    "strictC602QualityGatePassed",
    "outcome",
    "semanticHash"
  ],
  "additionalProperties": false
}
