{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-lexical-conservation.schema.json",
  "title": "machine-lexical-conservation",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.2-candidate-precision-global-timeline-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "machine-lexical-conservation"
    },
    "mode": { "type": "string", "enum": ["off", "observe", "enforce"] },
    "beforeTextHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "afterTextHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "operationId": { "type": "string", "minLength": 1 },
          "sourceCueIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "outputCueIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "operation": {
            "type": "string",
            "enum": ["preserve", "duplicate-collapse", "reject"]
          },
          "conserved": { "type": "boolean" },
          "lostNormalizedText": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "reasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "operationId",
          "sourceCueIds",
          "outputCueIds",
          "operation",
          "conserved",
          "lostNormalizedText",
          "reasons"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "inputCueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputCueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "duplicateCollapseCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rejectedMutationCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lexicalLossCount": { "type": "number", "const": 0 },
        "sourceCharacters": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "consensusCharacters": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "finalCharacters": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "presentationOnlyMutationCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lexicalMutationCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "truncationCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mergeCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "deletionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "evidenceSupportedMutationCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unsupportedMutationRejectedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "inputCueCount",
        "outputCueCount",
        "duplicateCollapseCount",
        "rejectedMutationCount",
        "lexicalLossCount",
        "sourceCharacters",
        "consensusCharacters",
        "finalCharacters",
        "presentationOnlyMutationCount",
        "lexicalMutationCount",
        "truncationCount",
        "mergeCount",
        "deletionCount",
        "evidenceSupportedMutationCount",
        "unsupportedMutationRejectedCount"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "mode",
    "beforeTextHash",
    "afterTextHash",
    "decisions",
    "summary"
  ],
  "additionalProperties": false
}
