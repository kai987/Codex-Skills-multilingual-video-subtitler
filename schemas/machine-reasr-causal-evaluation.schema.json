{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-reasr-causal-evaluation.schema.json",
  "title": "machine-reasr-causal-evaluation",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.7-fresh-targeted-reasr-asr-ceiling-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "machine-reasr-causal-evaluation"
    },
    "zone": {
      "type": "string",
      "const": "evaluation-only-gold-isolated-post-freeze"
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eventId": { "type": "string", "minLength": 1 },
          "classification": {
            "type": "string",
            "enum": [
              "BEFORE_CORRECT",
              "BEFORE_WRONG_AFTER_IMPROVED",
              "BEFORE_WRONG_AFTER_SAME",
              "BEFORE_WRONG_AFTER_WORSE",
              "BEFORE_WRONG_AFTER_UNSTABLE",
              "UNEVALUABLE"
            ]
          },
          "baselineDistance": {
            "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
          },
          "oldPoolBestDistance": {
            "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
          },
          "freshPoolBestDistance": {
            "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
          },
          "runtimeSelectedDistance": {
            "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
          },
          "baselineGoldError": {
            "anyOf": [{ "type": "boolean" }, { "type": "null" }]
          },
          "poolImproved": {
            "anyOf": [{ "type": "boolean" }, { "type": "null" }]
          },
          "safeReplacementGoldImproved": {
            "anyOf": [{ "type": "boolean" }, { "type": "null" }]
          },
          "evidenceIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "eventId",
          "classification",
          "baselineDistance",
          "oldPoolBestDistance",
          "freshPoolBestDistance",
          "runtimeSelectedDistance",
          "baselineGoldError",
          "poolImproved",
          "safeReplacementGoldImproved",
          "evidenceIds",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "selectedEventCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "evaluableCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "selectedEventGoldErrorHitCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "baselineWrongSelectedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "beforeCorrectCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "improvedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "noImprovementCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "worsenedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unstableCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unevaluableCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "baselineErrorHitRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "recoveryRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "safeReplacementRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "oldPoolOracleQuality": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "freshPoolOracleQuality": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "oracleImprovement": { "type": "number" },
        "selectorRegretBefore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "selectorRegretAfter": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": [
        "selectedEventCount",
        "evaluableCount",
        "selectedEventGoldErrorHitCount",
        "baselineWrongSelectedCount",
        "beforeCorrectCount",
        "improvedCount",
        "noImprovementCount",
        "worsenedCount",
        "unstableCount",
        "unevaluableCount",
        "baselineErrorHitRate",
        "recoveryRate",
        "safeReplacementRate",
        "oldPoolOracleQuality",
        "freshPoolOracleQuality",
        "oracleImprovement",
        "selectorRegretBefore",
        "selectorRegretAfter"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "zone",
    "runtimeGoldInputCount",
    "events",
    "summary",
    "semanticHash"
  ],
  "additionalProperties": false
}
