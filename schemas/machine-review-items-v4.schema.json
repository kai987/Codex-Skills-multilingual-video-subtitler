{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-review-items-v4.schema.json",
  "title": "machine-review-items-v4",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14-missing-localization-playback-integrity-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "artifactType": { "type": "string", "const": "machine-review-items-v4" },
    "previousItemsHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "targetsHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "missingEvidenceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reviewItemId": { "type": "string", "minLength": 1 },
          "eventIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "finalCueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "itemTypes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "TEXT_CROSS_MODEL_DISAGREEMENT",
                    "TEXT_WHISPER_INSTABILITY",
                    "TEXT_REAZON_INSTABILITY",
                    "TEXT_HALLUCINATION_RISK",
                    "TEXT_LOW_ACOUSTIC_SUPPORT",
                    "TEXT_PARTIAL_AGREEMENT",
                    "MISSING_SPEECH_RISK",
                    "TIMING_BOUNDARY_RISK",
                    "TIMING_SEVERE_RISK",
                    "OVERLAP_RISK",
                    "MULTI_SPEAKER_RISK",
                    "LOCALIZATION_RISK",
                    "SPAN_LINEAGE_BLOCKED",
                    "EVIDENCE_CONFLICT",
                    "GENERAL_UNCERTAINTY"
                  ]
                },
                {
                  "type": "string",
                  "enum": [
                    "MISSING_SPEECH_ISLAND_REVIEW",
                    "ORPHAN_SPEECH_REVIEW",
                    "MISSING_LOCAL_ASR_DISAGREEMENT",
                    "MISSING_LOCAL_ASR_EMPTY",
                    "HALLUCINATION_AUDIO_TARGET_REPAIR",
                    "REVIEW_AUDIO_COVERAGE_RISK"
                  ]
                }
              ]
            }
          },
          "sourceInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "coreInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "currentText": {
            "anyOf": [{ "type": "string" }, { "type": "null" }]
          },
          "candidateIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "evidenceIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "reviewReasons": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "WHISPER_REAZON_LEXICAL_CONFLICT",
                "WHISPER_CORE_UNSTABLE",
                "REAZON_CORE_UNSTABLE",
                "WHISPER_HALLUCINATION_SIGNAL",
                "REAZON_HALLUCINATION_SIGNAL",
                "INDEPENDENT_ACOUSTIC_DISAGREEMENT",
                "INDEPENDENT_ACOUSTIC_LOW_MARGIN",
                "DECODER_WEAK",
                "SPEECH_INCOMPLETE",
                "REQUEST_EDGE_RISK",
                "TIMING_EVIDENCE_CONFLICT",
                "OVERLAP_UNRESOLVED",
                "SPEAKER_OVERLAP",
                "LOCALIZATION_AMBIGUOUS",
                "MISSING_DIALOGUE_SUSPECTED",
                "SPAN_LINEAGE_UNAVAILABLE",
                "MACHINE_EVIDENCE_INCOMPLETE"
              ]
            }
          },
          "priorityTier": {
            "type": "string",
            "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
          },
          "priorityScore": { "type": "number", "minimum": 0, "maximum": 100 },
          "displayPriorityScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "priorityVector": {
            "type": "object",
            "properties": {
              "mandatorySafetyClass": {
                "type": "string",
                "enum": [
                  "NONE",
                  "STRONG_HALLUCINATION",
                  "STRONG_MISSING",
                  "STRONG_TIMING",
                  "STRONG_OVERLAP",
                  "STRUCTURAL_CORRUPTION"
                ]
              },
              "positiveEvidenceStrength": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "independentEvidenceFamilyCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "errorTypeSeverity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "crossModelConflictStrength": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "hallucinationStrength": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "missingStrength": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "timingStrength": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "candidateActionability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "localizationQuality": {
                "anyOf": [
                  { "type": "number", "minimum": 0, "maximum": 1 },
                  { "type": "null" }
                ]
              },
              "estimatedReviewCost": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "sourceTime": { "type": "number", "minimum": 0 }
            },
            "required": [
              "mandatorySafetyClass",
              "positiveEvidenceStrength",
              "independentEvidenceFamilyCount",
              "errorTypeSeverity",
              "crossModelConflictStrength",
              "hallucinationStrength",
              "missingStrength",
              "timingStrength",
              "candidateActionability",
              "localizationQuality",
              "estimatedReviewCost",
              "sourceTime"
            ],
            "additionalProperties": false
          },
          "structuredRankKey": {
            "type": "array",
            "items": { "type": "number" }
          },
          "rankPosition": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "requiredLevel": {
            "type": "string",
            "enum": ["REQUIRED", "RECOMMENDED", "INFORMATIONAL"]
          },
          "mandatoryReasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "suggestedActions": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "KEEP_CURRENT",
                "USE_REAZON",
                "USE_WHISPER_ALTERNATE",
                "MANUAL_EDIT",
                "TIMING_EDIT",
                "ADD_NEW_CUE",
                "MARK_FALSE_POSITIVE",
                "UNRESOLVED",
                "WAIVE_REVIEW"
              ]
            }
          },
          "sceneIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "speakerGroupIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "missingClassification": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "SPEECH_GAP_OBSERVED",
                  "MISSING_DIALOGUE_POSSIBLE",
                  "MISSING_DIALOGUE_STRONG",
                  "MISSING_DIALOGUE_CONTRADICTED",
                  "MISSING_DIALOGUE_UNRESOLVED"
                ]
              },
              { "type": "null" }
            ]
          },
          "missingGapIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "independentEvidenceFamilies": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "SPEECH_ACTIVITY",
                "ASR_LEXICAL_CONTENT",
                "CUE_COVERAGE",
                "NEIGHBOR_CONTINUITY",
                "SPEAKER_ACTIVITY",
                "CROSS_MODEL_CONTENT",
                "MUSIC_LYRICS_CONTRADICTION",
                "LOCALIZATION",
                "WHISPER_STABILITY",
                "REAZON_STABILITY",
                "ACOUSTIC_ALIGNMENT",
                "DECODER",
                "TIMING_BOUNDARY",
                "HALLUCINATION",
                "OVERLAP",
                "STRUCTURAL_INTEGRITY"
              ]
            }
          },
          "evidenceCorrelationGroups": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "uncertaintyReasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "legacySemanticHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "reviewTargetIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "sourceIntervals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": { "type": "number", "minimum": 0 },
                "end": { "type": "number", "exclusiveMinimum": 0 }
              },
              "required": ["start", "end"],
              "additionalProperties": false
            }
          },
          "origin": {
            "type": "string",
            "enum": ["MIGRATED_C60113", "SPEECH_ISLAND", "ORPHAN_SPEECH"]
          },
          "speechIslandIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "orphanIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "missingClassificationV3": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "legacyItemIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "canonicalMutationAllowed": { "type": "boolean", "const": false }
        },
        "required": [
          "reviewItemId",
          "eventIds",
          "finalCueIds",
          "itemTypes",
          "sourceInterval",
          "coreInterval",
          "currentText",
          "candidateIds",
          "evidenceIds",
          "reviewReasons",
          "priorityTier",
          "priorityScore",
          "displayPriorityScore",
          "priorityVector",
          "structuredRankKey",
          "rankPosition",
          "requiredLevel",
          "mandatoryReasons",
          "suggestedActions",
          "sceneIds",
          "speakerGroupIds",
          "missingClassification",
          "missingGapIds",
          "independentEvidenceFamilies",
          "evidenceCorrelationGroups",
          "uncertaintyReasons",
          "legacySemanticHash",
          "semanticHash",
          "reviewTargetIds",
          "sourceIntervals",
          "origin",
          "speechIslandIds",
          "orphanIds",
          "missingClassificationV3",
          "legacyItemIds",
          "canonicalMutationAllowed"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "previousItemCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "itemCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "migratedItemCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "createdItemCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "orphanItemCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "requiredItemCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "previousItemsDeleted": { "type": "number", "const": 0 },
        "canonicalTextMutationCount": { "type": "number", "const": 0 },
        "canonicalTimingMutationCount": { "type": "number", "const": 0 }
      },
      "required": [
        "previousItemCount",
        "itemCount",
        "migratedItemCount",
        "createdItemCount",
        "orphanItemCount",
        "requiredItemCount",
        "previousItemsDeleted",
        "canonicalTextMutationCount",
        "canonicalTimingMutationCount"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "policyHash",
    "sourceIdentity",
    "sourceTimebase",
    "runtimeGoldInputCount",
    "artifactType",
    "previousItemsHash",
    "targetsHash",
    "missingEvidenceHash",
    "items",
    "summary",
    "semanticHash"
  ],
  "additionalProperties": false
}
