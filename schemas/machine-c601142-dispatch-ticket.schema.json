{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-c601142-dispatch-ticket.schema.json",
  "title": "machine-c601142-dispatch-ticket",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "machine-c601142-dispatch-ticket"
    },
    "requestId": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "enum": ["DETECTOR", "ASR"] },
    "family": {
      "type": "string",
      "enum": [
        "WEBRTC",
        "SILERO",
        "PYANNOTE",
        "whisper-large-v3",
        "reazonspeech-k2-v2"
      ]
    },
    "planHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "identityHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reservedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "retryAllowed": { "type": "boolean", "const": false },
    "inferenceReserved": { "type": "boolean", "const": true },
    "visibility": { "type": "string", "const": "LOCAL_ONLY" }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "requestId",
    "kind",
    "family",
    "planHash",
    "identityHash",
    "reservedAt",
    "retryAllowed",
    "inferenceReserved",
    "visibility"
  ],
  "additionalProperties": false
}
