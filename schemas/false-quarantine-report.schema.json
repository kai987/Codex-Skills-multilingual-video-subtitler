{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/false-quarantine-report.schema.json",
  "title": "false-quarantine-report",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "referenceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generatedSubtitleSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "configuration": {
      "default": { "referenceIsStrongEvidenceNotAbsoluteTruth": true },
      "type": "object",
      "properties": {
        "referenceIsStrongEvidenceNotAbsoluteTruth": {
          "type": "boolean",
          "const": true
        }
      },
      "required": ["referenceIsStrongEvidenceNotAbsoluteTruth"],
      "additionalProperties": false
    },
    "inspectedLayers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "raw-vad",
          "raw-no-vad",
          "large-v3-refinement",
          "recovery",
          "canonical-rejected",
          "quarantined",
          "final-accepted"
        ]
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "layer": { "type": "string", "minLength": 1 },
          "interval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "cueId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "evaluation": {
            "type": "string",
            "enum": [
              "true-quarantine",
              "false-quarantine",
              "false-acceptance",
              "unresolved"
            ]
          },
          "anchorIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "id",
          "layer",
          "interval",
          "cueId",
          "evaluation",
          "anchorIds",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "true-quarantine",
          "false-quarantine",
          "false-acceptance",
          "unresolved"
        ]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "required": [
        "true-quarantine",
        "false-quarantine",
        "false-acceptance",
        "unresolved"
      ]
    },
    "unavailableLayers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "fallback": {
      "default": null,
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "referenceSha256",
    "generatedSubtitleSha256",
    "configuration",
    "inspectedLayers",
    "entries",
    "summary",
    "unavailableLayers",
    "fallback"
  ],
  "additionalProperties": false
}
