{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-review-audio-manifest-v4.schema.json",
  "title": "machine-review-audio-manifest-v4",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14.1-multiview-speech-inventory-v1"
    },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "sourceTimebase": {
      "type": "string",
      "const": "SOURCE_GLOBAL_NATIVE_SAMPLES"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": {
      "type": "string",
      "const": "machine-review-audio-manifest-v4"
    },
    "regionsHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "compatibilityAudioHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "deliverySubsystemVersion": {
      "type": "string",
      "const": "C6.0.1.12_REVIEW_AUDIO"
    },
    "extractionPolicy": {
      "type": "string",
      "const": "existing-deterministic-pcm16k-source-extraction"
    },
    "audio": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "audioId": { "type": "string", "minLength": 1 },
          "relativePath": { "type": "string", "minLength": 1 },
          "sourceMediaSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sourceIdentity": {
            "type": "object",
            "properties": {
              "sourceMediaSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
              "sampleRate": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "audioStreamIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "audioTimebase": {
                "type": "string",
                "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
              },
              "sourceTimebase": {
                "type": "string",
                "const": "SOURCE_GLOBAL_SECONDS"
              }
            },
            "required": [
              "sourceMediaSha256",
              "durationSeconds",
              "sampleRate",
              "audioStreamIndex",
              "audioTimebase",
              "sourceTimebase"
            ],
            "additionalProperties": false
          },
          "sourceInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "requestedInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "actualSourceInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "requestedSourceInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "sampleRate": { "type": "number", "const": 16000 },
          "channels": { "type": "number", "const": 1 },
          "bitDepth": { "type": "number", "const": 16 },
          "codec": { "type": "string", "const": "pcm_s16le" },
          "frameCount": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "actualDuration": { "type": "number", "exclusiveMinimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "playable": { "type": "boolean", "const": true },
          "hashVerified": { "type": "boolean", "const": true },
          "physicalMetadataVerified": { "type": "boolean", "const": true },
          "coveredReviewTargetIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "regionIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "nativeSourceInterval": {
            "type": "object",
            "properties": {
              "startSample": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "endSample": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["startSample", "endSample"],
            "additionalProperties": false
          }
        },
        "required": [
          "audioId",
          "relativePath",
          "sourceMediaSha256",
          "sourceIdentity",
          "sourceInterval",
          "requestedInterval",
          "sampleRate",
          "channels",
          "bitDepth",
          "codec",
          "frameCount",
          "actualDuration",
          "sha256",
          "playable",
          "hashVerified",
          "physicalMetadataVerified",
          "coveredReviewTargetIds",
          "regionIds",
          "semanticHash",
          "nativeSourceInterval"
        ],
        "additionalProperties": false
      }
    },
    "targetCoverageChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reviewTargetId": { "type": "string", "minLength": 1 },
          "mandatoryForAudio": { "type": "boolean" },
          "audioRequired": { "type": "boolean" },
          "coverageRatio": { "type": "number", "minimum": 0, "maximum": 1 },
          "fullyCovered": { "type": "boolean" }
        },
        "required": [
          "reviewTargetId",
          "mandatoryForAudio",
          "coverageRatio",
          "fullyCovered"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "plannedAudioCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "actualAudioCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "extractionFailureCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "playableCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hashVerifiedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mandatoryTargetCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "coveredMandatoryTargetCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "allTargetCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "coveredTargetCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "targetCoveragePassed": { "type": "boolean" },
        "clipSumSeconds": { "type": "number", "minimum": 0 },
        "networkUsed": { "type": "boolean", "const": false }
      },
      "required": [
        "plannedAudioCount",
        "actualAudioCount",
        "extractionFailureCount",
        "playableCount",
        "hashVerifiedCount",
        "mandatoryTargetCount",
        "coveredMandatoryTargetCount",
        "allTargetCount",
        "coveredTargetCount",
        "targetCoveragePassed",
        "clipSumSeconds",
        "networkUsed"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "sourceIdentity",
    "sourceTimebase",
    "policyHash",
    "runtimeGoldInputCount",
    "semanticHash",
    "artifactType",
    "regionsHash",
    "compatibilityAudioHash",
    "deliverySubsystemVersion",
    "extractionPolicy",
    "audio",
    "targetCoverageChecks",
    "summary"
  ],
  "additionalProperties": false
}
