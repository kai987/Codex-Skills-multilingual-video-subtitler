{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-13-shareable-audit.schema.json",
  "title": "c6-0-1-13-shareable-audit",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.13-region-burden-calibration-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": { "type": "string", "const": "c6-0-1-13-shareable-audit" },
    "status": { "type": "string", "enum": ["PASSED", "FAILED"] },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relativePath": {
            "type": "string",
            "const": "review-burden-summary.json"
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": ["relativePath", "sha256"],
        "additionalProperties": false
      }
    },
    "absolutePathLeakCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "secretCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "goldIdentityLeakCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "brokenRelativeReferenceCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "fullDialoguePayloadCount": { "type": "number", "const": 0 },
    "privateEventPayloadCount": { "type": "number", "const": 0 },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "status",
    "files",
    "absolutePathLeakCount",
    "secretCount",
    "goldIdentityLeakCount",
    "brokenRelativeReferenceCount",
    "fullDialoguePayloadCount",
    "privateEventPayloadCount",
    "semanticHash"
  ],
  "additionalProperties": false
}
