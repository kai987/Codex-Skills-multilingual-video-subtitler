{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-1-input-inventory.schema.json",
  "title": "c6-1-input-inventory",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.1-consensus-investigation-v1"
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": { "type": "string", "const": "c6-1-input-inventory" },
    "canonicalCueCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "canonicalEventCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "historicalRawCandidateCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "historicalDispositionCounts": {
      "type": "object",
      "propertyNames": { "type": "string" },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "inputRowsByArtifact": {
      "type": "object",
      "propertyNames": { "type": "string" },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceDurationSeconds": { "type": "number", "minimum": 0 },
    "newAsrInferenceCount": { "type": "number", "const": 0 },
    "networkUsed": { "type": "boolean", "const": false },
    "runtimeGoldInputCount": { "type": "number", "const": 0 }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "semanticHash",
    "artifactType",
    "canonicalCueCount",
    "canonicalEventCount",
    "historicalRawCandidateCount",
    "historicalDispositionCounts",
    "inputRowsByArtifact",
    "sourceMediaSha256",
    "sourceDurationSeconds",
    "newAsrInferenceCount",
    "networkUsed",
    "runtimeGoldInputCount"
  ],
  "additionalProperties": false
}
