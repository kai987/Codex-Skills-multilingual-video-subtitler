      "const": "c6.0.1.8-core-span-asr-stability-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": { "type": "string", "const": "c6-0-1-8-ablation" },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "V0_C6017_BASELINE",
              "V1_CORE_SPAN",
              "V2_CORE_PROJECTION",
              "V3_COMPARABILITY",
              "V4_STABILITY",
              "V5_LOCAL_GOLD_EVALUATION",
              "V6_OPTIONAL_CORE_FRESH",
              "FINAL_DIAGNOSIS"
            ]
          },
          "outputIdentityHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "machineMutationCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "runtimeGoldInputCount": { "type": "number", "const": 0 },
          "notes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "stage",
          "outputIdentityHash",
          "machineMutationCount",
          "runtimeGoldInputCount",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "baselineMetrics": {
      "type": "object",
      "properties": {
        "cueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "exactCer": { "type": "number", "minimum": 0 },
        "normalizedCer": { "type": "number", "minimum": 0 },
