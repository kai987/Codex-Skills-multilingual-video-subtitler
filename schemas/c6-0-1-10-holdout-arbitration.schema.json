{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-10-holdout-arbitration.schema.json",
  "title": "c6-0-1-10-holdout-arbitration",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.10-cross-model-arbitration-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "c6-0-1-10-holdout-arbitration"
    },
    "policyFreezeSemanticHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "holdoutSelectionSemanticHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "holdoutRuntimeSemanticHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidenceSemanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ledgerSemanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "decisionsFrozenBeforeGold": { "type": "boolean", "const": true },
    "finalSubtitleFrozenBeforeGold": { "type": "boolean", "const": true },
    "summary": {
      "type": "object",
      "properties": {
        "eventCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lexicalDisagreementCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "selectReazonCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "keepWhisperCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "abstainCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "blockedLocalizationCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "blockedSpanCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mutationProposalCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "appliedMutationCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "eventCount",
        "lexicalDisagreementCount",
        "selectReazonCount",
        "keepWhisperCount",
        "abstainCount",
        "blockedLocalizationCount",
        "blockedSpanCount",
        "mutationProposalCount",
        "appliedMutationCount"
      ],
      "additionalProperties": false
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "policyFreezeSemanticHash",
    "holdoutSelectionSemanticHash",
    "holdoutRuntimeSemanticHash",
    "evidenceSemanticHash",
    "ledgerSemanticHash",
    "decisionsFrozenBeforeGold",
    "finalSubtitleFrozenBeforeGold",
    "summary",
    "runtimeGoldInputCount",
    "semanticHash"
  ],
  "additionalProperties": false
}
