{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-14-2-durable-first-gold-read-intent.schema.json",
  "title": "c6-0-1-14-2-durable-first-gold-read-intent",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "c6-0-1-14-2-durable-first-gold-read-intent"
    },
    "visibility": { "type": "string", "const": "LOCAL_ONLY" },
    "firstGoldReadAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "finalAFreezeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "finalBFreezeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "codeSnapshotHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "codeValidationHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "browserAuditHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "writtenAndFsyncedBeforeGoldOpen": { "type": "boolean", "const": true },
    "evaluatorOnly": { "type": "boolean", "const": true },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "visibility",
    "firstGoldReadAt",
    "finalAFreezeHash",
    "finalBFreezeHash",
    "codeSnapshotHash",
    "codeValidationHash",
    "browserAuditHash",
    "writtenAndFsyncedBeforeGoldOpen",
    "evaluatorOnly",
    "runtimeGoldInputCount",
    "semanticHash"
  ],
  "additionalProperties": false
}
