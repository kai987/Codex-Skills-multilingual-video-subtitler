{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-1-2-validation.schema.json",
  "title": "c6-1-2-validation",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": { "type": "string", "const": "c6-1-2-validation" },
    "policyVersion": {
      "type": "string",
      "const": "c6.1.2-top-k-reranking-acoustic-completeness-v1"
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "observed": { "type": "string" },
          "expected": { "type": "string" }
        },
        "required": ["name", "passed", "observed", "expected"],
        "additionalProperties": false
      }
    },
    "passed": { "type": "boolean" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relativePath": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["relativePath", "sha256", "size"],
        "additionalProperties": false
      }
    },
    "fileScope": { "type": "string", "const": "FINAL_A_TREE" },
    "schemaCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "validatedArtifactCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "regressionEvidenceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceCodeAggregateHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "productionParity": { "type": "boolean" },
    "semanticParity": { "type": "boolean" },
    "regressionPassed": { "type": "boolean" },
    "rawGoldRuntimeInputCount": { "type": "number", "const": 0 },
    "networkUsed": { "type": "boolean", "const": false }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "policyVersion",
    "semanticHash",
    "checks",
    "passed",
    "files",
    "fileScope",
    "schemaCount",
    "validatedArtifactCount",
    "regressionEvidenceHash",
    "sourceCodeAggregateHash",
    "productionParity",
    "semanticParity",
    "regressionPassed",
    "rawGoldRuntimeInputCount",
    "networkUsed"
  ],
  "additionalProperties": false
}
