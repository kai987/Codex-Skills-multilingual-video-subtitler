    "policyVersion",
    "visibility",
    "artifactType",
    "policyHash",
    "atomUtilityHash",
    "childUtilityHash",
    "bundleUtilityHash",
    "plannerHash",
    "finalAFreezeHash",
    "finalBFreezeHash",
    "evaluationHash",
    "routeDecisionHash",
    "atomCount",
    "positiveEvidenceAtomCount",
    "positiveEvidenceZeroUtilityCount",
    "eligibleChildCount",
    "eligibleChildZeroUtilityCount",
    "eligibleBundleCount",
    "eligibleOptionalBundleZeroUtilityCount",
