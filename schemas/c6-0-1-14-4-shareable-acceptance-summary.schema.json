    "oldPlanObjectiveVector",
    "newPlanObjectiveVector",
    "forcedInclusionEvaluatedCount",
    "forcedInclusionFeasibleCount",
    "forcedInclusionInfeasibleCount",
    "forcedInclusionSearchIncompleteCount",
    "selectedBundleCount",
    "selectedChildCount",
    "selectedOptionalChildCount",
    "safetyCoreUnionSeconds",
    "fullQueueEpisodeRatio",
    "finalMissingInventoryRatio",
    "finalMissingTargetRatio",
    "finalMissingPhysicalAudioRatio",
    "finalMissingPlaybackAudibleRatio",
    "finalHallucinationPlaybackAudibleRatio",
    "route",
    "productionStatus",
    "finalizationMethod",
    "c602Status",
    "canonicalMutationCount",
    "audioPayloadIncluded",
    "dialoguePayloadIncluded",
    "goldIntervalsIncluded",
