{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-1-2-1-completeness-blocker-diagnosis.schema.json",
  "title": "c6-1-2-1-completeness-blocker-diagnosis",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "c6-1-2-1-completeness-blocker-diagnosis"
    },
    "policyVersion": {
      "type": "string",
      "const": "c6.1.2.1-gold-isolated-supergroup-evaluation-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nonUnknownCompletenessCoverage": {
      "type": "object",
      "properties": {
        "numerator": { "type": "number", "minimum": 0 },
        "denominator": { "type": "number", "minimum": 0 },
        "ratio": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "null" }
          ]
        }
      },
      "required": ["numerator", "denominator", "ratio"],
      "additionalProperties": false
    },
    "candidateSelectionsBlockedByCompleteness": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "retrainedProfileZeroSelectionDueToCompleteness": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "nonGatedProfilePositiveButUnsafeCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "catastrophicCandidatesBlocked": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "safeCandidatesBlocked": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "safeCandidateFalseBlockRate": {
      "type": "object",
      "properties": {
        "numerator": { "type": "number", "minimum": 0 },
        "denominator": { "type": "number", "minimum": 0 },
        "ratio": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "null" }
          ]
        }
      },
      "required": ["numerator", "denominator", "ratio"],
      "additionalProperties": false
    },
    "diagnosticMainBlocker": { "type": "boolean" },
    "coverageQualifiedMainBlocker": { "type": "boolean" },
    "noThresholdChange": { "type": "boolean", "const": true },
    "reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "policyVersion",
    "policyHash",
    "semanticHash",
    "nonUnknownCompletenessCoverage",
    "candidateSelectionsBlockedByCompleteness",
    "retrainedProfileZeroSelectionDueToCompleteness",
    "nonGatedProfilePositiveButUnsafeCount",
    "catastrophicCandidatesBlocked",
    "safeCandidatesBlocked",
    "safeCandidateFalseBlockRate",
    "diagnosticMainBlocker",
    "coverageQualifiedMainBlocker",
    "noThresholdChange",
    "reasons"
  ],
  "additionalProperties": false
}
