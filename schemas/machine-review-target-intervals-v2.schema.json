{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-review-target-intervals-v2.schema.json",
  "title": "machine-review-target-intervals-v2",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14-missing-localization-playback-integrity-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "artifactType": { "type": "string", "const": "review-target-intervals-v2" },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reviewTargetId": { "type": "string", "minLength": 1 },
          "parentReviewItemId": { "type": "string", "minLength": 1 },
          "targetType": {
            "type": "string",
            "enum": [
              "CURRENT_CUE_TEXT_TARGET",
              "CURRENT_CUE_HALLUCINATION_TARGET",
              "MISSING_SPEECH_ISLAND_TARGET",
              "ORPHAN_SPEECH_TARGET",
              "CANDIDATE_SOURCE_TARGET",
              "TIMING_BOUNDARY_TARGET",
              "OVERLAP_COMPONENT_TARGET",
              "MULTI_SPEAKER_TARGET",
              "LOCALIZATION_TARGET"
            ]
          },
          "sourceInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "targetAnchorIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "finalCueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "eventIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "evidenceIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "mandatoryForAudio": { "type": "boolean" },
          "audioRequired": { "type": "boolean" },
          "localizationStatus": {
            "type": "string",
            "enum": ["VERIFIED", "UNRESOLVED"]
          },
          "sourceIdentity": {
            "type": "object",
            "properties": {
              "sourceMediaSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
              "sampleRate": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "audioStreamIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "audioTimebase": {
                "type": "string",
                "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
              },
              "sourceTimebase": {
                "type": "string",
                "const": "SOURCE_GLOBAL_SECONDS"
              }
            },
            "required": [
              "sourceMediaSha256",
              "durationSeconds",
              "sampleRate",
              "audioStreamIndex",
              "audioTimebase",
              "sourceTimebase"
            ],
            "additionalProperties": false
          },
          "reasons": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "reviewTargetId",
          "parentReviewItemId",
          "targetType",
          "sourceInterval",
          "targetAnchorIds",
          "finalCueIds",
          "eventIds",
          "evidenceIds",
          "mandatoryForAudio",
          "localizationStatus",
          "sourceIdentity",
          "reasons",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "unresolvedItems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reviewItemId": { "type": "string", "minLength": 1 },
          "reasons": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": ["reviewItemId", "reasons"],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "targetCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "itemCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unresolvedItemCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "disjointItemCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "coreFallbackCount": { "type": "number", "const": 0 }
      },
      "required": [
        "targetCount",
        "itemCount",
        "unresolvedItemCount",
        "disjointItemCount",
        "coreFallbackCount"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "policyHash",
    "sourceIdentity",
    "sourceTimebase",
    "runtimeGoldInputCount",
    "artifactType",
    "targets",
    "unresolvedItems",
    "summary",
    "semanticHash"
  ],
  "additionalProperties": false
}
