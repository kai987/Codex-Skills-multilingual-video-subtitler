{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-1-read-only-proof.schema.json",
  "title": "c6-1-read-only-proof",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.1-consensus-investigation-v1"
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": { "type": "string", "const": "c6-1-read-only-proof" },
    "sourceBefore": {
      "type": "object",
      "properties": {
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mtimeMs": { "type": "number", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "required": ["size", "mtimeMs", "sha256"],
      "additionalProperties": false
    },
    "sourceAfter": {
      "type": "object",
      "properties": {
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mtimeMs": { "type": "number", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "required": ["size", "mtimeMs", "sha256"],
      "additionalProperties": false
    },
    "goldBefore": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "size": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "mtimeMs": { "type": "number", "minimum": 0 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          },
          "required": ["size", "mtimeMs", "sha256"],
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "goldAfter": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "size": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "mtimeMs": { "type": "number", "minimum": 0 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          },
          "required": ["size", "mtimeMs", "sha256"],
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "sourceUnchanged": { "type": "boolean" },
    "goldUnchanged": { "anyOf": [{ "type": "boolean" }, { "type": "null" }] },
    "machineFreezeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "goldFirstReadAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        { "type": "null" }
      ]
    },
    "frozenAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "semanticHash",
    "artifactType",
    "sourceBefore",
    "sourceAfter",
    "goldBefore",
    "goldAfter",
    "sourceUnchanged",
    "goldUnchanged",
    "machineFreezeHash",
    "goldFirstReadAt",
    "frozenAt"
  ],
  "additionalProperties": false
}
