{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-c6-1-2-top-k-conservation-ledger.schema.json",
  "title": "machine-c6-1-2-top-k-conservation-ledger",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "machine-c6-1-2-top-k-conservation-ledger"
    },
    "policyVersion": {
      "type": "string",
      "const": "c6.1.2-top-k-reranking-acoustic-completeness-v1"
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rankHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "topKHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "string",
            "enum": [
              "T0_H2_TOP4",
              "T1_RAW_MBR_TOP4",
              "T2_H2_RAW_UNION_TOP4",
              "T3_PROVIDER_DIVERSE_CORRELATION_DEDUP_TOP4"
            ]
          },
          "eventId": { "type": "string", "minLength": 1 },
          "candidateId": { "type": "string", "minLength": 1 },
          "reason": {
            "type": "string",
            "enum": [
              "CURRENT",
              "INCLUDED",
              "BELOW_K",
              "NORMALIZED_DUPLICATE",
              "SAME_ACOUSTIC_OBSERVATION",
              "PROVIDER_DIVERSITY_REPLACED",
              "HARD_REJECTED",
              "CORRELATION_DEDUPLICATED",
              "UNKNOWN_IDENTITY_NOT_PROMOTED"
            ]
          }
        },
        "required": ["profile", "eventId", "candidateId", "reason"],
        "additionalProperties": false
      }
    },
    "accountedCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expectedCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "silentDropCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "passed": { "type": "boolean" }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "policyVersion",
    "semanticHash",
    "rankHash",
    "topKHash",
    "rows",
    "accountedCount",
    "expectedCount",
    "silentDropCount",
    "passed"
  ],
  "additionalProperties": false
}
