{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/subtitle-memory-pronunciation-projection.schema.json",
  "title": "subtitle-memory-pronunciation-projection",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "subtitle-memory-pronunciation-projection"
    },
    "projectionVersion": { "type": "string", "const": "C5.19" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "memoryHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "baseCueHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cueId": { "type": "string", "minLength": 1 },
          "canonicalText": { "type": "string", "minLength": 1 },
          "canonicalTextHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "projectedAlignmentText": { "type": "string", "minLength": 1 },
          "spans": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "occurrenceId": { "type": "string", "minLength": 1 },
                "originalStartChar": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "originalEndChar": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "canonicalSurface": { "type": "string", "minLength": 1 },
                "projectedAlias": { "type": "string", "minLength": 1 },
                "entryId": { "type": "string", "minLength": 1 }
              },
              "required": [
                "occurrenceId",
                "originalStartChar",
                "originalEndChar",
                "canonicalSurface",
                "projectedAlias",
                "entryId"
              ],
              "additionalProperties": false
            }
          },
          "canonicalTextChanged": { "type": "boolean", "const": false }
        },
        "required": [
          "cueId",
          "canonicalText",
          "canonicalTextHash",
          "projectedAlignmentText",
          "spans",
          "canonicalTextChanged"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "pronunciationProjectionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "projectedCueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pronunciationProjectionCanonicalMutationCount": {
          "type": "number",
          "const": 0
        }
      },
      "required": [
        "pronunciationProjectionCount",
        "projectedCueCount",
        "pronunciationProjectionCanonicalMutationCount"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "projectionVersion",
    "generatedAt",
    "memoryHash",
    "baseCueHash",
    "cues",
    "summary",
    "semanticHash"
  ],
  "additionalProperties": false
}
