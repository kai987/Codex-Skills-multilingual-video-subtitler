{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/whisper-execution-metrics.schema.json",
  "title": "whisper-execution-metrics",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "requestedMode": {
      "type": "string",
      "enum": ["auto", "persistent", "batch", "process"]
    },
    "executionMode": {
      "type": "string",
      "enum": ["persistent", "batch", "process"]
    },
    "backend": { "type": "string", "enum": ["coreml", "cpu", "mixed"] },
    "asrRequestCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cacheHitCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "workerStartCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "modelLoadCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "initializationSeconds": { "type": "number", "minimum": 0 },
    "modelLoadSeconds": { "type": "number", "minimum": 0 },
    "coreMLWarmupSeconds": { "type": "number", "minimum": 0 },
    "transcriptionSeconds": { "type": "number", "minimum": 0 },
    "totalWorkerSeconds": { "type": "number", "minimum": 0 },
    "fallbackProcessCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requestId": { "type": "string", "minLength": 1 },
          "batchKey": { "type": "string", "minLength": 1 },
          "cacheHit": { "type": "boolean" },
          "mode": {
            "type": "string",
            "enum": ["persistent", "batch", "process"]
          },
          "status": {
            "type": "string",
            "enum": ["succeeded", "failed", "fallback-succeeded"]
          },
          "retryCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "fallbackMode": {
            "anyOf": [
              { "type": "string", "const": "process" },
              { "type": "null" }
            ]
          },
          "durationSeconds": { "type": "number", "minimum": 0 },
          "error": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          }
        },
        "required": [
          "requestId",
          "batchKey",
          "cacheHit",
          "mode",
          "status",
          "retryCount",
          "fallbackMode",
          "durationSeconds",
          "error"
        ],
        "additionalProperties": false
      }
    },
    "workers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "batchKey": { "type": "string", "minLength": 1 },
          "mode": { "type": "string", "enum": ["persistent", "batch"] },
          "backend": { "type": "string", "enum": ["coreml", "cpu"] },
          "requestCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "warmupCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "initializationSeconds": { "type": "number", "minimum": 0 },
          "modelLoadSeconds": { "type": "number", "minimum": 0 },
          "coreMLWarmupSeconds": { "type": "number", "minimum": 0 },
          "transcriptionSeconds": { "type": "number", "minimum": 0 },
          "exitReason": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          }
        },
        "required": [
          "batchKey",
          "mode",
          "backend",
          "requestCount",
          "warmupCount",
          "initializationSeconds",
          "modelLoadSeconds",
          "coreMLWarmupSeconds",
          "transcriptionSeconds",
          "exitReason"
        ],
        "additionalProperties": false
      }
    },
    "fallbackReason": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    }
  },
  "required": [
    "schemaVersion",
    "requestedMode",
    "executionMode",
    "backend",
    "asrRequestCount",
    "cacheHitCount",
    "workerStartCount",
    "modelLoadCount",
    "initializationSeconds",
    "modelLoadSeconds",
    "coreMLWarmupSeconds",
    "transcriptionSeconds",
    "totalWorkerSeconds",
    "fallbackProcessCount",
    "requests",
    "workers",
    "fallbackReason"
  ],
  "additionalProperties": false
}
