{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-missing-safety-reserve-targets-v5.schema.json",
  "title": "machine-missing-safety-reserve-targets-v5",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14.5-safety-coverage-unit-contract-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "sourceTimebase": {
      "type": "string",
      "const": "SOURCE_GLOBAL_NATIVE_SAMPLES"
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "visibility": { "type": "string", "const": "LOCAL_ONLY" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": {
      "type": "string",
      "const": "machine-missing-safety-reserve-targets-v5"
    },
    "sourceSafetyTargetsHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "plannerCertificateHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "contractLedgerHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "targets": {
      "maxItems": 24,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "targetId": { "type": "string", "minLength": 1 },
          "targetKind": {
            "type": "string",
            "enum": ["PHASE_A_OBLIGATION", "OPTIONAL_SPEECH_SAFETY"]
          },
          "coverageUnitIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "realizationId": { "type": "string", "minLength": 1 },
          "contractType": {
            "type": "string",
            "enum": [
              "TARGET_CORE_LOCALIZATION_CONTRACT_V1",
              "MACHINE_ANCHORED_PLAYBACK_AUDIBILITY_CONTRACT_V1"
            ]
          },
          "childUnitIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "bundleIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "atomicTargetCoreIntervals": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "startSample": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "endSample": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["startSample", "endSample"],
              "additionalProperties": false
            }
          },
          "speechCoreUnionSeconds": { "type": "number", "minimum": 0 },
          "reviewEnvelope": {
            "type": "object",
            "properties": {
              "startSample": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "endSample": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["startSample", "endSample"],
            "additionalProperties": false
          },
          "unitCoreCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
          "machineAnchorOverlapSeconds": { "type": "number", "minimum": 0 },
          "machineAnchorCoverageRatio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "predictedUnitPlaybackCoverage": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "phaseAObligationIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "unitUtilityRefs": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          },
          "selectionReason": { "type": "string", "minLength": 1 },
          "sourceIdentity": {
            "type": "object",
            "properties": {
              "sourceMediaSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
              "sampleRate": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "audioStreamIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "audioTimebase": {
                "type": "string",
                "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
              },
              "sourceTimebase": {
                "type": "string",
                "const": "SOURCE_GLOBAL_SECONDS"
              }
            },
            "required": [
              "sourceMediaSha256",
              "durationSeconds",
              "sampleRate",
              "audioStreamIndex",
              "audioTimebase",
              "sourceTimebase"
            ],
            "additionalProperties": false
          },
          "audioRequired": { "type": "boolean", "const": true },
          "requiredLevel": { "type": "string", "const": "RECOMMENDED" },
          "canonicalInsertAllowed": { "type": "boolean", "const": false },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "targetId",
          "targetKind",
          "coverageUnitIds",
          "realizationId",
          "contractType",
          "childUnitIds",
          "bundleIds",
          "atomicTargetCoreIntervals",
          "speechCoreUnionSeconds",
          "reviewEnvelope",
          "unitCoreCoverage",
          "machineAnchorOverlapSeconds",
          "machineAnchorCoverageRatio",
          "predictedUnitPlaybackCoverage",
          "phaseAObligationIds",
          "unitUtilityRefs",
          "selectionReason",
          "sourceIdentity",
          "audioRequired",
          "requiredLevel",
          "canonicalInsertAllowed",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "activeTargetCount": { "type": "integer", "minimum": 0, "maximum": 24 },
    "selectedCoverageUnitCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "speechCoreUnionSeconds": { "type": "number", "minimum": 0, "maximum": 60 },
    "wholeEpisodeCatchAllCount": { "type": "number", "const": 0 },
    "obligationCoverageRatio": { "type": "number", "const": 1 }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "policyHash",
    "sourceIdentity",
    "sourceTimebase",
    "runtimeGoldInputCount",
    "visibility",
    "semanticHash",
    "artifactType",
    "sourceSafetyTargetsHash",
    "plannerCertificateHash",
    "contractLedgerHash",
    "targets",
    "activeTargetCount",
    "selectedCoverageUnitCount",
    "speechCoreUnionSeconds",
    "wholeEpisodeCatchAllCount",
    "obligationCoverageRatio"
  ],
  "additionalProperties": false
}
