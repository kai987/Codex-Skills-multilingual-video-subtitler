{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-14-1-shareable-audit.schema.json",
  "title": "c6-0-1-14-1-shareable-audit",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "c6-0-1-14-1-shareable-audit"
    },
    "summaryByteHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "strictSchemaPassed": { "type": "boolean" },
    "absolutePathLeakCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "secretPatternCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rawDialogueOrAudioFieldCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sourceOrGoldIntervalFieldCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "brokenRelativeReferenceCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "passed": { "type": "boolean" }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "summaryByteHash",
    "strictSchemaPassed",
    "absolutePathLeakCount",
    "secretPatternCount",
    "rawDialogueOrAudioFieldCount",
    "sourceOrGoldIntervalFieldCount",
    "brokenRelativeReferenceCount",
    "passed"
  ],
  "additionalProperties": false
}
