{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-12-machine-review-items.schema.json",
  "title": "c6-0-1-12-machine-review-items",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.12-multi-asr-review-assistance-v2"
    },
    "artifactType": {
      "type": "string",
      "const": "c6-0-1-12-machine-review-items"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reviewItemId": { "type": "string", "minLength": 1 },
          "eventIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "finalCueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "itemTypes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "TEXT_CROSS_MODEL_DISAGREEMENT",
                "TEXT_WHISPER_INSTABILITY",
                "TEXT_REAZON_INSTABILITY",
                "TEXT_HALLUCINATION_RISK",
                "TEXT_LOW_ACOUSTIC_SUPPORT",
                "TEXT_PARTIAL_AGREEMENT",
                "MISSING_SPEECH_RISK",
                "TIMING_BOUNDARY_RISK",
                "TIMING_SEVERE_RISK",
                "OVERLAP_RISK",
                "MULTI_SPEAKER_RISK",
                "LOCALIZATION_RISK",
                "SPAN_LINEAGE_BLOCKED",
                "EVIDENCE_CONFLICT",
                "GENERAL_UNCERTAINTY"
              ]
            }
          },
          "sourceInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "coreInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "currentText": {
            "anyOf": [{ "type": "string" }, { "type": "null" }]
          },
          "candidateIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "evidenceIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "reviewReasons": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "WHISPER_REAZON_LEXICAL_CONFLICT",
                "WHISPER_CORE_UNSTABLE",
                "REAZON_CORE_UNSTABLE",
                "WHISPER_HALLUCINATION_SIGNAL",
                "REAZON_HALLUCINATION_SIGNAL",
                "INDEPENDENT_ACOUSTIC_DISAGREEMENT",
                "INDEPENDENT_ACOUSTIC_LOW_MARGIN",
                "DECODER_WEAK",
                "SPEECH_INCOMPLETE",
                "REQUEST_EDGE_RISK",
                "TIMING_EVIDENCE_CONFLICT",
                "OVERLAP_UNRESOLVED",
                "SPEAKER_OVERLAP",
                "LOCALIZATION_AMBIGUOUS",
                "MISSING_DIALOGUE_SUSPECTED",
                "SPAN_LINEAGE_UNAVAILABLE",
                "MACHINE_EVIDENCE_INCOMPLETE"
              ]
            }
          },
          "priorityTier": {
            "type": "string",
            "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
          },
          "priorityScore": { "type": "number", "minimum": 0, "maximum": 100 },
          "requiredLevel": {
            "type": "string",
            "enum": ["REQUIRED", "RECOMMENDED", "INFORMATIONAL"]
          },
          "suggestedActions": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "KEEP_CURRENT",
                "USE_REAZON",
                "USE_WHISPER_ALTERNATE",
                "MANUAL_EDIT",
                "TIMING_EDIT",
                "ADD_NEW_CUE",
                "MARK_FALSE_POSITIVE",
                "UNRESOLVED",
                "WAIVE_REVIEW"
              ]
            }
          },
          "sceneIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "speakerGroupIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "reviewItemId",
          "eventIds",
          "finalCueIds",
          "itemTypes",
          "sourceInterval",
          "coreInterval",
          "currentText",
          "candidateIds",
          "evidenceIds",
          "reviewReasons",
          "priorityTier",
          "priorityScore",
          "requiredLevel",
          "suggestedActions",
          "sceneIds",
          "speakerGroupIds",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "itemCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "signalCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "multiLabelItemCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "orphanItemCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "requiredItemCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "itemCount",
        "signalCount",
        "multiLabelItemCount",
        "orphanItemCount",
        "requiredItemCount"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "artifactType",
    "policyHash",
    "sourceTimebase",
    "runtimeGoldInputCount",
    "items",
    "summary",
    "semanticHash"
  ],
  "additionalProperties": false
}
