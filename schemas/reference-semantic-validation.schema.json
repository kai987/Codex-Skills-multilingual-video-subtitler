{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/reference-semantic-validation.schema.json",
  "title": "reference-semantic-validation",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "referenceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generatedSubtitleSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mode": { "type": "string", "enum": ["off", "auto", "on"] },
    "configuration": {
      "default": { "requestedMode": "auto" },
      "type": "object",
      "properties": {
        "requestedMode": { "type": "string", "enum": ["off", "auto", "on"] }
      },
      "required": ["requestedMode"],
      "additionalProperties": false
    },
    "method": {
      "type": "string",
      "enum": ["unavailable", "local-model", "external-model"]
    },
    "reason": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "alignmentId": { "type": "string", "minLength": 1 },
          "semanticSimilarity": {
            "anyOf": [
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "null" }
            ]
          },
          "entityAgreement": {
            "anyOf": [{ "type": "boolean" }, { "type": "null" }]
          },
          "numberAgreement": {
            "anyOf": [{ "type": "boolean" }, { "type": "null" }]
          },
          "negationConflict": {
            "anyOf": [{ "type": "boolean" }, { "type": "null" }]
          }
        },
        "required": [
          "alignmentId",
          "semanticSimilarity",
          "entityAgreement",
          "numberAgreement",
          "negationConflict"
        ],
        "additionalProperties": false
      }
    },
    "fallback": {
      "default": null,
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "referenceSha256",
    "generatedSubtitleSha256",
    "mode",
    "configuration",
    "method",
    "reason",
    "results",
    "fallback"
  ],
  "additionalProperties": false
}
