{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-1-2-shareable-audit.schema.json",
  "title": "c6-1-2-shareable-audit",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": { "type": "string", "const": "c6-1-2-shareable-audit" },
    "policyVersion": {
      "type": "string",
      "const": "c6.1.2-top-k-reranking-acoustic-completeness-v1"
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relativePath": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["relativePath", "sha256", "size"],
        "additionalProperties": false
      }
    },
    "checkedFiles": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "absolutePathLeakCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "secretCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rawTextFieldCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "brokenRelativeReferenceCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "passed": { "type": "boolean" },
    "scope": {
      "type": "string",
      "const": "SHAREABLE_SUMMARY_ONLY_NOT_FULL_LOCAL_ARTIFACTS"
    }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "policyVersion",
    "semanticHash",
    "files",
    "checkedFiles",
    "absolutePathLeakCount",
    "secretCount",
    "rawTextFieldCount",
    "brokenRelativeReferenceCount",
    "passed",
    "scope"
  ],
  "additionalProperties": false
}
