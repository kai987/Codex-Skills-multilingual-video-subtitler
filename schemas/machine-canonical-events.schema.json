{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-canonical-events.schema.json",
  "title": "machine-canonical-events",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.3-candidate-association-canonical-assembly-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": { "type": "string", "const": "machine-canonical-events" },
    "mode": { "type": "string", "enum": ["off", "observe", "enforce"] },
    "associationLedgerSemanticHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eventId": { "type": "string", "minLength": 1 },
          "acousticInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "speechRegions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": { "type": "number", "minimum": 0 },
                "end": { "type": "number", "exclusiveMinimum": 0 }
              },
              "required": ["start", "end"],
              "additionalProperties": false
            }
          },
          "familyIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "candidateIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "speakerHypotheses": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "trustedTokenSpan": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "start": { "type": "number", "minimum": 0 },
                  "end": { "type": "number", "exclusiveMinimum": 0 }
                },
                "required": ["start", "end"],
                "additionalProperties": false
              },
              { "type": "null" }
            ]
          },
          "segmentSpan": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "vadSpan": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "start": { "type": "number", "minimum": 0 },
                  "end": { "type": "number", "exclusiveMinimum": 0 }
                },
                "required": ["start", "end"],
                "additionalProperties": false
              },
              { "type": "null" }
            ]
          },
          "eventType": {
            "type": "string",
            "enum": [
              "SINGLE_UTTERANCE",
              "RAPID_TURN",
              "MULTI_SPEAKER_OVERLAP",
              "BACKGROUND_FOREGROUND",
              "CHANT_OR_CROWD",
              "CONTINUATION_CANDIDATE",
              "AMBIGUOUS_EVENT"
            ]
          },
          "ambiguity": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": ["resolved", "review", "quarantined"]
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "NO_COMPATIBLE_CLUSTER",
                    "ASSOCIATION_SCORE_TOO_LOW",
                    "TEMPORAL_CONFLICT",
                    "TEXT_CONFLICT",
                    "ACOUSTIC_EVENT_CONFLICT",
                    "SPEAKER_CONFLICT",
                    "WINDOW_EDGE_ONLY",
                    "BROAD_WINDOW_ONLY",
                    "PREFIX_SHADOWED",
                    "SUFFIX_SHADOWED",
                    "DUPLICATE_EVENT",
                    "CORRELATED_RETRY",
                    "NONCOMPETITIVE_VARIANT",
                    "MISSING_GLOBAL_TIMELINE",
                    "AMBIGUOUS_TIME_BASE",
                    "MULTIPLE_VALID_CLUSTERS",
                    "WEAK_ACOUSTIC_SUPPORT",
                    "HALLUCINATION_RISK",
                    "UNKNOWN"
                  ]
                }
              },
              "validCandidateCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["status", "reasons", "validCandidateCount"],
            "additionalProperties": false
          },
          "representativeCandidateId": { "type": "string", "minLength": 1 },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "eventId",
          "acousticInterval",
          "speechRegions",
          "familyIds",
          "candidateIds",
          "speakerHypotheses",
          "trustedTokenSpan",
          "segmentSpan",
          "vadSpan",
          "eventType",
          "ambiguity",
          "representativeCandidateId",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "eventCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "singleUtteranceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rapidTurnCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "multiSpeakerOverlapCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "backgroundForegroundCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "chantOrCrowdCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "continuationCandidateCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ambiguousEventCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "eventWithoutCandidateCount": { "type": "number", "const": 0 }
      },
      "required": [
        "eventCount",
        "singleUtteranceCount",
        "rapidTurnCount",
        "multiSpeakerOverlapCount",
        "backgroundForegroundCount",
        "chantOrCrowdCount",
        "continuationCandidateCount",
        "ambiguousEventCount",
        "eventWithoutCandidateCount"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "mode",
    "associationLedgerSemanticHash",
    "events",
    "summary",
    "semanticHash"
  ],
  "additionalProperties": false
}
