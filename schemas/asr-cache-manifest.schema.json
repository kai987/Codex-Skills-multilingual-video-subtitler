{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/asr-cache-manifest.schema.json",
  "title": "asr-cache-manifest",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "portableRoot": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "mode": { "type": "string", "enum": ["off", "read", "read-write"] },
    "summary": {
      "type": "object",
      "properties": {
        "requestCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "portableHitCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "taskLocalHitCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "legacyHitCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "migratedEntryCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "missCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rejectedLegacyEntryCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "corruptEntryCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "writtenEntryCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "workerRequestsAvoided": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "workerStartsAvoided": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "modelLoadsAvoided": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "requestCount",
        "portableHitCount",
        "taskLocalHitCount",
        "legacyHitCount",
        "migratedEntryCount",
        "missCount",
        "rejectedLegacyEntryCount",
        "corruptEntryCount",
        "writtenEntryCount",
        "workerRequestsAvoided",
        "modelLoadsAvoided"
      ],
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requestId": { "type": "string", "minLength": 1 },
          "requestType": {
            "type": "string",
            "enum": [
              "baseline",
              "refinement",
              "recovery",
              "lyrics",
              "coverage-recovery",
              "overlap-evidence"
            ]
          },
          "currentKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "legacyKeysTried": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "selectedPath": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "hitType": {
            "type": "string",
            "enum": ["portable", "task-local-v2", "legacy", "miss", "off"]
          },
          "compatibilityChecks": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "migrationStatus": {
            "type": "string",
            "enum": ["not-needed", "migrated", "rejected", "disabled"]
          }
        },
        "required": [
          "requestId",
          "requestType",
          "currentKey",
          "legacyKeysTried",
          "selectedPath",
          "hitType",
          "compatibilityChecks",
          "migrationStatus"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "portableRoot",
    "mode",
    "summary",
    "entries"
  ],
  "additionalProperties": false
}
