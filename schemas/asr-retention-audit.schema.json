{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/asr-retention-audit.schema.json",
  "title": "asr-retention-audit",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.1-machine-quality-recovery-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "mode": { "type": "string", "enum": ["off", "observe", "enforce"] },
    "profile": {
      "type": "string",
      "enum": ["legacy", "diagnostics", "coverage", "timing", "full"]
    },
    "run": {
      "type": "object",
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "repositoryCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "goldRuntimeInputCount": { "type": "number", "const": 0 }
      },
      "required": [
        "runId",
        "repositoryCommit",
        "sourceMediaSha256",
        "goldRuntimeInputCount"
      ],
      "additionalProperties": false
    },
    "artifactType": { "type": "string", "const": "asr-retention-audit" },
    "baseline": {
      "type": "object",
      "properties": {
        "chunkCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rawSegmentCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "canonicalUtteranceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "acceptedCueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "suspectedHallucinationCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "crossUtteranceLoopCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "chunkCount",
        "rawSegmentCount",
        "canonicalUtteranceCount",
        "acceptedCueCount",
        "suspectedHallucinationCount",
        "crossUtteranceLoopCount"
      ],
      "additionalProperties": false
    },
    "candidateRetention": {
      "type": "object",
      "properties": {
        "canonicalUtteranceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "candidateCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "clusterCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "winnerCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "postDeduplicationCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "postFragmentRepairCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "postNormalizationCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "finalIntegrityCandidateCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "finalCueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "canonicalUtteranceCount",
        "candidateCount",
        "clusterCount",
        "winnerCount",
        "postDeduplicationCount",
        "postFragmentRepairCount",
        "postNormalizationCount",
        "finalIntegrityCandidateCount",
        "finalCueCount"
      ],
      "additionalProperties": false
    },
    "promptContamination": {
      "type": "object",
      "properties": {
        "recoveryAttemptCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "baselineCarryPromptCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "refinementContextPromptCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "attemptsWithAdjacentText": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "attemptsWithUnverifiedAdjacentText": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "uniqueAdjacentPromptCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "provisionalMachineTextPromptCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "promptIsolationPassed": { "type": "boolean" },
        "contaminationDetected": { "type": "boolean" }
      },
      "required": [
        "recoveryAttemptCount",
        "baselineCarryPromptCount",
        "refinementContextPromptCount",
        "attemptsWithAdjacentText",
        "attemptsWithUnverifiedAdjacentText",
        "uniqueAdjacentPromptCount",
        "provisionalMachineTextPromptCount",
        "promptIsolationPassed",
        "contaminationDetected"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "mode",
    "profile",
    "run",
    "artifactType",
    "baseline",
    "candidateRetention",
    "promptContamination"
  ],
  "additionalProperties": false
}
