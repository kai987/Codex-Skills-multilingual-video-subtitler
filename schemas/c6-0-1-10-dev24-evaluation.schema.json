{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-10-dev24-evaluation.schema.json",
  "title": "c6-0-1-10-dev24-evaluation",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.10-cross-model-arbitration-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": { "type": "string", "const": "c6-0-1-10-dev24-evaluation" },
    "evaluationPhase": {
      "type": "string",
      "const": "post-decision-freeze-gold-isolated"
    },
    "dev24EventCount": { "type": "number", "const": 24 },
    "targetCount": { "type": "number", "const": 12 },
    "controlCount": { "type": "number", "const": 12 },
    "policyProfilesSemanticHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "machineDecisionFreezeHashes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": ["CONSERVATIVE", "BALANCED", "AGGRESSIVE_SHADOW"]
      },
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "required": ["CONSERVATIVE", "BALANCED", "AGGRESSIVE_SHADOW"]
    },
    "goldIdentityHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "goldTextIncluded": { "type": "boolean", "const": false },
    "profiles": {
      "minItems": 3,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "string",
            "enum": ["CONSERVATIVE", "BALANCED", "AGGRESSIVE_SHADOW"]
          },
          "decisionLedgerSemanticHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "selectReazonCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "keepWhisperCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "abstainCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "blockedCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "evaluableSwitchCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "correctSwitchCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "wrongSwitchCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "neutralSwitchCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "baselineLocalError": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "arbitrationLocalError": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "realizedLocalGain": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "availableOracleGain": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "oracleCaptureRate": {
            "anyOf": [{ "type": "number" }, { "type": "null" }]
          },
          "controlRegressionCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "avoidedBlindRegressionCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "productionEligible": { "type": "boolean" },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "profile",
          "decisionLedgerSemanticHash",
          "selectReazonCount",
          "keepWhisperCount",
          "abstainCount",
          "blockedCount",
          "evaluableSwitchCount",
          "correctSwitchCount",
          "wrongSwitchCount",
          "neutralSwitchCount",
          "baselineLocalError",
          "arbitrationLocalError",
          "realizedLocalGain",
          "availableOracleGain",
          "oracleCaptureRate",
          "controlRegressionCount",
          "avoidedBlindRegressionCount",
          "productionEligible",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "selectedProductionProfile": {
      "type": "string",
      "enum": ["CONSERVATIVE", "BALANCED", "DISABLED"]
    },
    "selectionResult": {
      "type": "string",
      "enum": ["ARBITRATION_PROFILE_SELECTED", "HOLD_ARBITRATION_NOT_SAFE"]
    },
    "selectionReasons": {
      "minItems": 1,
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "evaluationPhase",
    "dev24EventCount",
    "targetCount",
    "controlCount",
    "policyProfilesSemanticHash",
    "machineDecisionFreezeHashes",
    "goldIdentityHash",
    "goldTextIncluded",
    "profiles",
    "selectedProductionProfile",
    "selectionResult",
    "selectionReasons",
    "runtimeGoldInputCount",
    "semanticHash"
  ],
  "additionalProperties": false
}
