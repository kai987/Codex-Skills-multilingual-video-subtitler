{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-quality-recovery-policy.schema.json",
  "title": "machine-quality-recovery-policy",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.1-machine-quality-recovery-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "mode": { "type": "string", "enum": ["off", "observe", "enforce"] },
    "profile": {
      "type": "string",
      "enum": ["legacy", "diagnostics", "coverage", "timing", "full"]
    },
    "run": {
      "type": "object",
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "repositoryCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "goldRuntimeInputCount": { "type": "number", "const": 0 }
      },
      "required": [
        "runId",
        "repositoryCommit",
        "sourceMediaSha256",
        "goldRuntimeInputCount"
      ],
      "additionalProperties": false
    },
    "artifactType": {
      "type": "string",
      "const": "machine-quality-recovery-policy"
    },
    "defaultMode": { "type": "string", "const": "off" },
    "productionStatus": { "type": "string", "const": "needs-review" },
    "finalizationMethod": { "type": "string", "const": "none" },
    "machineOnlyReleaseAuthorized": { "type": "boolean", "const": false },
    "humanDerivedRuntimeInputAllowed": { "type": "boolean", "const": false },
    "strategies": {
      "type": "object",
      "properties": {
        "targetChunkSeconds": {
          "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
        },
        "vadMode": {
          "type": "string",
          "enum": ["off", "on", "evidence-gated"]
        },
        "sceneRouting": { "type": "string" },
        "adjacentPromptPolicy": { "type": "string" },
        "reviewEvidenceRetention": {
          "type": "string",
          "enum": ["strict-quarantine", "needs-review-only"]
        }
      },
      "required": [
        "targetChunkSeconds",
        "vadMode",
        "sceneRouting",
        "adjacentPromptPolicy",
        "reviewEvidenceRetention"
      ],
      "additionalProperties": false
    },
    "milestone": {
      "type": "object",
      "properties": {
        "normalizedCerMaximum": { "type": "number", "minimum": 0 },
        "coverageMinimum": { "type": "number", "minimum": 0, "maximum": 1 },
        "missingDialogueMaximum": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "materialTextDefectMaximum": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "startMaeSecondsMaximum": { "type": "number", "minimum": 0 },
        "endMaeSecondsMaximum": { "type": "number", "minimum": 0 },
        "p95BoundaryErrorSecondsMaximum": { "type": "number", "minimum": 0 },
        "severeTimingDefectMaximum": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hallucinationMaximum": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "normalizedCerMaximum",
        "coverageMinimum",
        "missingDialogueMaximum",
        "materialTextDefectMaximum",
        "startMaeSecondsMaximum",
        "endMaeSecondsMaximum",
        "p95BoundaryErrorSecondsMaximum",
        "severeTimingDefectMaximum",
        "hallucinationMaximum"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "mode",
    "profile",
    "run",
    "artifactType",
    "defaultMode",
    "productionStatus",
    "finalizationMethod",
    "machineOnlyReleaseAuthorized",
    "humanDerivedRuntimeInputAllowed",
    "strategies",
    "milestone"
  ],
  "additionalProperties": false
}
