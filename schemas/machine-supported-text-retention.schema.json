{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-supported-text-retention.schema.json",
  "title": "machine-supported-text-retention",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.3-candidate-association-canonical-assembly-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "machine-supported-text-retention"
    },
    "mode": { "type": "string", "enum": ["off", "observe", "enforce"] },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eventId": { "type": "string", "minLength": 1 },
          "sourceCandidateId": { "type": "string", "minLength": 1 },
          "outputCueId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "sourceNormalizedLength": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "retainedNormalizedLength": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "retentionRatio": { "type": "number", "minimum": 0, "maximum": 1 },
          "strongSupport": { "type": "boolean" },
          "prefixShadowPrevented": { "type": "boolean" },
          "unsupportedDeletion": { "type": "boolean" },
          "reasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "eventId",
          "sourceCandidateId",
          "outputCueId",
          "sourceNormalizedLength",
          "retainedNormalizedLength",
          "retentionRatio",
          "strongSupport",
          "prefixShadowPrevented",
          "unsupportedDeletion",
          "reasons"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "evaluatedEventCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "strongSupportedCandidateCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fullyRetainedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "prefixShadowPreventedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unsupportedStrongTextDeletionCount": { "type": "number", "const": 0 },
        "minimumStrongTextRetentionRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "evaluatedEventCount",
        "strongSupportedCandidateCount",
        "fullyRetainedCount",
        "prefixShadowPreventedCount",
        "unsupportedStrongTextDeletionCount",
        "minimumStrongTextRetentionRatio"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "mode",
    "records",
    "summary",
    "semanticHash"
  ],
  "additionalProperties": false
}
