{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-1-2-1-1-route-decision.schema.json",
  "title": "c6-1-2-1-1-route-decision",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": { "type": "string", "const": "c6-1-2-1-1-route-decision" },
    "policyVersion": {
      "type": "string",
      "const": "c6.1.2.1.1-constrained-monotonic-partition-reachable-evaluation-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "route": {
      "type": "string",
      "enum": [
        "GO_C6_1_3_FROZEN_TOP_K_RERANKER_PROSPECTIVE_SHADOW",
        "GO_C6_1_2_2_ACOUSTIC_COMPLETENESS_CALIBRATION",
        "STOP_EXISTING_CANDIDATE_AUTOMATIC_RERANKING",
        "EVALUATION_PARTITION_UNRECOVERABLE_WITHOUT_UNSAFE_CUTS",
        "C6_1_2_1_1_ENGINEERING_INVALID"
      ]
    },
    "engineeringGate": { "type": "boolean" },
    "evaluationCoverageGate": { "type": "boolean" },
    "partitionBiasGate": { "type": "boolean" },
    "rerankerStrongSupportGate": { "type": "boolean" },
    "safeProfileCandidates": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "selectedSafeProfile": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "descriptiveBestFrozenProfile": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "descriptiveBestRetrainedProfile": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "profileChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "profileId": { "type": "string", "minLength": 1 },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "passed": { "type": "boolean" },
                "observed": { "type": "string" },
                "expected": { "type": "string" }
              },
              "required": ["name", "passed", "observed", "expected"],
              "additionalProperties": false
            }
          },
          "passed": { "type": "boolean" }
        },
        "required": ["profileId", "checks", "passed"],
        "additionalProperties": false
      }
    },
    "reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "c6122": { "type": "string", "enum": ["GO", "HOLD"] },
    "c613": { "type": "string", "enum": ["GO", "HOLD"] },
    "productionStatus": { "type": "string", "const": "needs-review" },
    "finalizationMethod": { "type": "string", "const": "none" },
    "productionMutation": { "type": "number", "const": 0 },
    "primaryMode": { "type": "string", "const": "D1_CONSERVATIVE_MONOTONIC" },
    "relaxedDiagnosticUsedForRoute": { "type": "boolean", "const": false }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "policyVersion",
    "policyHash",
    "semanticHash",
    "route",
    "engineeringGate",
    "evaluationCoverageGate",
    "partitionBiasGate",
    "rerankerStrongSupportGate",
    "safeProfileCandidates",
    "selectedSafeProfile",
    "descriptiveBestFrozenProfile",
    "descriptiveBestRetrainedProfile",
    "profileChecks",
    "reasons",
    "c6122",
    "c613",
    "productionStatus",
    "finalizationMethod",
    "productionMutation",
    "primaryMode",
    "relaxedDiagnosticUsedForRoute"
  ],
  "additionalProperties": false
}
