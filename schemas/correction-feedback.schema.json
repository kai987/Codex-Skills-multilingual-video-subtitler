{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/correction-feedback.schema.json",
  "title": "correction-feedback",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "feedbackType": {
      "type": "string",
      "const": "subtitle-correction-feedback"
    },
    "sourceFingerprintHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "feedbackId": { "type": "string", "minLength": 1 },
          "mediaIdentity": {
            "type": "object",
            "properties": {
              "title": {
                "anyOf": [
                  { "type": "string", "minLength": 1 },
                  { "type": "null" }
                ]
              },
              "season": {
                "anyOf": [
                  {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  { "type": "null" }
                ]
              },
              "episode": {
                "anyOf": [
                  {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  { "type": "null" }
                ]
              },
              "year": {
                "anyOf": [
                  { "type": "integer", "minimum": 1888, "maximum": 2200 },
                  { "type": "null" }
                ]
              }
            },
            "required": ["title", "season", "episode", "year"],
            "additionalProperties": false
          },
          "audioInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "sceneLabel": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "speaker": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "machineText": { "type": "string" },
          "correctedText": { "type": "string" },
          "machineDecision": {
            "type": "object",
            "properties": {
              "decisionId": { "type": "string", "minLength": 1 },
              "targetCueIds": {
                "minItems": 1,
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "action": {
                "type": "string",
                "enum": [
                  "KEEP",
                  "REPLACE",
                  "EXPAND",
                  "SPLIT",
                  "MERGE",
                  "REDISTRIBUTE",
                  "DELETE_HALLUCINATION",
                  "TIMING_ONLY",
                  "REVIEW_ONLY"
                ]
              },
              "currentText": { "type": "string" },
              "proposedText": {
                "anyOf": [{ "type": "string" }, { "type": "null" }]
              },
              "proposedCues": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "start": { "type": "number", "minimum": 0 },
                    "end": { "type": "number", "exclusiveMinimum": 0 },
                    "text": { "type": "string", "minLength": 1 }
                  },
                  "required": ["id", "start", "end", "text"],
                  "additionalProperties": false
                }
              },
              "selectedCandidateId": {
                "anyOf": [
                  { "type": "string", "minLength": 1 },
                  { "type": "null" }
                ]
              },
              "alternativeCandidateIds": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "evidenceIds": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "blockers": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "automaticMutationEligible": { "type": "boolean" },
              "requiresHumanReview": { "type": "boolean" },
              "decisionReasons": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "required": [
              "decisionId",
              "targetCueIds",
              "action",
              "currentText",
              "proposedText",
              "proposedCues",
              "selectedCandidateId",
              "alternativeCandidateIds",
              "evidenceIds",
              "blockers",
              "automaticMutationEligible",
              "requiresHumanReview",
              "decisionReasons"
            ],
            "additionalProperties": false
          },
          "selectedCandidate": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "candidateId": { "type": "string", "minLength": 1 },
                  "targetCueIds": {
                    "minItems": 1,
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "candidateText": { "type": "string", "minLength": 1 },
                  "candidateInterval": {
                    "type": "object",
                    "properties": {
                      "start": { "type": "number", "minimum": 0 },
                      "end": { "type": "number", "exclusiveMinimum": 0 }
                    },
                    "required": ["start", "end"],
                    "additionalProperties": false
                  },
                  "localInterval": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "start": { "type": "number", "minimum": 0 },
                          "end": { "type": "number", "exclusiveMinimum": 0 }
                        },
                        "required": ["start", "end"],
                        "additionalProperties": false
                      },
                      { "type": "null" }
                    ]
                  },
                  "associationType": {
                    "type": "string",
                    "enum": [
                      "EXACT_TARGET",
                      "PROBABLE_TARGET",
                      "BROAD_WINDOW_ASSOCIATION",
                      "AMBIGUOUS_ASSOCIATION",
                      "UNASSOCIATED"
                    ]
                  },
                  "associationScore": {
                    "anyOf": [
                      { "type": "number", "minimum": 0, "maximum": 1 },
                      { "type": "null" }
                    ]
                  },
                  "associationMargin": {
                    "anyOf": [
                      { "type": "number", "minimum": 0, "maximum": 1 },
                      { "type": "null" }
                    ]
                  },
                  "sourceEvidenceIds": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "sourceRequestIds": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "sourceProfileIds": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "independentSupportCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "coverageMetrics": {
                    "type": "object",
                    "properties": {
                      "existingCuePreservationRatio": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "candidateCoverageRatio": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "contentOmissionRatio": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "contentAdditionRatio": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "neighborCueIntrusionRatio": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "localSpeechCoverageRatio": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "coverageMethod": {
                        "type": "string",
                        "const": "heuristic"
                      },
                      "semanticSimilarity": { "type": "null" }
                    },
                    "required": [
                      "existingCuePreservationRatio",
                      "candidateCoverageRatio",
                      "contentOmissionRatio",
                      "contentAdditionRatio",
                      "neighborCueIntrusionRatio",
                      "localSpeechCoverageRatio",
                      "coverageMethod",
                      "semanticSimilarity"
                    ],
                    "additionalProperties": false
                  },
                  "directAcousticSupport": { "type": "boolean" },
                  "partialFragment": { "type": "boolean" },
                  "timingResolved": { "type": "boolean" },
                  "languageIntegrityPassed": { "type": "boolean" },
                  "hallucinationQaPassed": { "type": "boolean" },
                  "repetitionQaPassed": { "type": "boolean" },
                  "presentationQaPassed": { "type": "boolean" },
                  "requestedAction": {
                    "type": "string",
                    "enum": [
                      "KEEP",
                      "REPLACE",
                      "EXPAND",
                      "SPLIT",
                      "MERGE",
                      "REDISTRIBUTE",
                      "DELETE_HALLUCINATION",
                      "TIMING_ONLY",
                      "REVIEW_ONLY"
                    ]
                  },
                  "automaticMutationEligible": { "type": "boolean" },
                  "requiresHumanReview": { "type": "boolean" },
                  "blockers": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  }
                },
                "required": [
                  "candidateId",
                  "targetCueIds",
                  "candidateText",
                  "candidateInterval",
                  "localInterval",
                  "associationType",
                  "associationScore",
                  "associationMargin",
                  "sourceEvidenceIds",
                  "sourceRequestIds",
                  "sourceProfileIds",
                  "independentSupportCount",
                  "coverageMetrics",
                  "directAcousticSupport",
                  "partialFragment",
                  "timingResolved",
                  "languageIntegrityPassed",
                  "hallucinationQaPassed",
                  "repetitionQaPassed",
                  "presentationQaPassed",
                  "requestedAction",
                  "automaticMutationEligible",
                  "requiresHumanReview",
                  "blockers"
                ],
                "additionalProperties": false
              },
              { "type": "null" }
            ]
          },
          "alternativeCandidates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "candidateId": { "type": "string", "minLength": 1 },
                "targetCueIds": {
                  "minItems": 1,
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "candidateText": { "type": "string", "minLength": 1 },
                "candidateInterval": {
                  "type": "object",
                  "properties": {
                    "start": { "type": "number", "minimum": 0 },
                    "end": { "type": "number", "exclusiveMinimum": 0 }
                  },
                  "required": ["start", "end"],
                  "additionalProperties": false
                },
                "localInterval": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "start": { "type": "number", "minimum": 0 },
                        "end": { "type": "number", "exclusiveMinimum": 0 }
                      },
                      "required": ["start", "end"],
                      "additionalProperties": false
                    },
                    { "type": "null" }
                  ]
                },
                "associationType": {
                  "type": "string",
                  "enum": [
                    "EXACT_TARGET",
                    "PROBABLE_TARGET",
                    "BROAD_WINDOW_ASSOCIATION",
                    "AMBIGUOUS_ASSOCIATION",
                    "UNASSOCIATED"
                  ]
                },
                "associationScore": {
                  "anyOf": [
                    { "type": "number", "minimum": 0, "maximum": 1 },
                    { "type": "null" }
                  ]
                },
                "associationMargin": {
                  "anyOf": [
                    { "type": "number", "minimum": 0, "maximum": 1 },
                    { "type": "null" }
                  ]
                },
                "sourceEvidenceIds": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "sourceRequestIds": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "sourceProfileIds": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "independentSupportCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "coverageMetrics": {
                  "type": "object",
                  "properties": {
                    "existingCuePreservationRatio": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "candidateCoverageRatio": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "contentOmissionRatio": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "contentAdditionRatio": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "neighborCueIntrusionRatio": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "localSpeechCoverageRatio": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "coverageMethod": {
                      "type": "string",
                      "const": "heuristic"
                    },
                    "semanticSimilarity": { "type": "null" }
                  },
                  "required": [
                    "existingCuePreservationRatio",
                    "candidateCoverageRatio",
                    "contentOmissionRatio",
                    "contentAdditionRatio",
                    "neighborCueIntrusionRatio",
                    "localSpeechCoverageRatio",
                    "coverageMethod",
                    "semanticSimilarity"
                  ],
                  "additionalProperties": false
                },
                "directAcousticSupport": { "type": "boolean" },
                "partialFragment": { "type": "boolean" },
                "timingResolved": { "type": "boolean" },
                "languageIntegrityPassed": { "type": "boolean" },
                "hallucinationQaPassed": { "type": "boolean" },
                "repetitionQaPassed": { "type": "boolean" },
                "presentationQaPassed": { "type": "boolean" },
                "requestedAction": {
                  "type": "string",
                  "enum": [
                    "KEEP",
                    "REPLACE",
                    "EXPAND",
                    "SPLIT",
                    "MERGE",
                    "REDISTRIBUTE",
                    "DELETE_HALLUCINATION",
                    "TIMING_ONLY",
                    "REVIEW_ONLY"
                  ]
                },
                "automaticMutationEligible": { "type": "boolean" },
                "requiresHumanReview": { "type": "boolean" },
                "blockers": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              },
              "required": [
                "candidateId",
                "targetCueIds",
                "candidateText",
                "candidateInterval",
                "localInterval",
                "associationType",
                "associationScore",
                "associationMargin",
                "sourceEvidenceIds",
                "sourceRequestIds",
                "sourceProfileIds",
                "independentSupportCount",
                "coverageMetrics",
                "directAcousticSupport",
                "partialFragment",
                "timingResolved",
                "languageIntegrityPassed",
                "hallucinationQaPassed",
                "repetitionQaPassed",
                "presentationQaPassed",
                "requestedAction",
                "automaticMutationEligible",
                "requiresHumanReview",
                "blockers"
              ],
              "additionalProperties": false
            }
          },
          "errorTypes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "DIALECT_ERROR",
                "CHARACTER_NAME_ERROR",
                "DOMAIN_TERM_ERROR",
                "KANJI_SELECTION_ERROR",
                "VERB_ENDING_ERROR",
                "PARTICLE_ERROR",
                "MISSING_TEXT",
                "EXTRA_TEXT",
                "HALLUCINATION",
                "FRAGMENT_ERROR",
                "SEGMENTATION_ERROR",
                "TIMING_ERROR",
                "SPEAKER_ERROR",
                "STYLE_ERROR",
                "OTHER"
              ]
            }
          },
          "confirmedReading": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "terminologyHints": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "dialectHints": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "sourceEvidenceIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "reviewerNotes": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          }
        },
        "required": [
          "feedbackId",
          "mediaIdentity",
          "audioInterval",
          "sceneLabel",
          "speaker",
          "machineText",
          "correctedText",
          "machineDecision",
          "selectedCandidate",
          "alternativeCandidates",
          "errorTypes",
          "confirmedReading",
          "terminologyHints",
          "dialectHints",
          "sourceEvidenceIds",
          "reviewerNotes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "feedbackType",
    "sourceFingerprintHash",
    "records"
  ],
  "additionalProperties": false
}
