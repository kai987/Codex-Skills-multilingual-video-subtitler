{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-12-review-audit-record.schema.json",
  "title": "c6-0-1-12-review-audit-record",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "auditId": { "type": "string", "minLength": 1 },
    "operation": { "type": "string", "enum": ["DECISION", "UNDO"] },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "sessionId": { "type": "string", "minLength": 1 },
    "reviewItemId": { "type": "string", "minLength": 1 },
    "previousDecision": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "newDecision": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "undoneRecordId": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "beforeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "afterHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "auditId",
    "operation",
    "timestamp",
    "sessionId",
    "reviewItemId",
    "previousDecision",
    "newDecision",
    "undoneRecordId",
    "beforeHash",
    "afterHash"
  ],
  "additionalProperties": false
}
