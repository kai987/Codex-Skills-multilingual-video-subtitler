{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-14-probe-bounded-failure-audit.schema.json",
  "title": "c6-0-1-14-probe-bounded-failure-audit",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "c6-0-1-14-probe-bounded-failure-audit"
    },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14-missing-localization-playback-integrity-v1"
    },
    "status": {
      "type": "string",
      "const": "BLOCKED_RAW_RESULTS_NOT_PERSISTED"
    },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "selectionHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "freezeSemanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "originalProbeByteSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "originalProbeSemanticHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "completionFailureStatusByteSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "accounting": {
      "type": "object",
      "properties": {
        "selectedTargets": { "type": "integer", "minimum": 0, "maximum": 24 },
        "contextTargets": { "type": "integer", "minimum": 0, "maximum": 8 },
        "plannedRequests": { "type": "integer", "minimum": 0, "maximum": 64 },
        "originalActualFreshInferences": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "supplementalActualFreshInferences": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cumulativeActualFreshInferences": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "remainingAuthorizedInferences": { "type": "number", "const": 0 },
        "originalCacheJsonRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "originalSuccessRawRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "originalExtractionErrorRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "completedCacheJsonRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "supplementalRawResultsLost": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "cumulativeModelLoadCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cumulativeProcessStartCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "perProviderCumulativeActualFreshInferences": {
          "type": "object",
          "properties": {
            "whisper-large-v3": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "reazonspeech-k2-v2": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["whisper-large-v3", "reazonspeech-k2-v2"],
          "additionalProperties": false
        },
        "perProviderCumulativeModelLoadCount": {
          "type": "object",
          "properties": {
            "whisper-large-v3": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "reazonspeech-k2-v2": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["whisper-large-v3", "reazonspeech-k2-v2"],
          "additionalProperties": false
        },
        "perProviderCumulativeProcessStartCount": {
          "type": "object",
          "properties": {
            "whisper-large-v3": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "reazonspeech-k2-v2": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["whisper-large-v3", "reazonspeech-k2-v2"],
          "additionalProperties": false
        },
        "fullMediaInferenceCount": { "type": "number", "const": 0 },
        "canonicalMutationCount": { "type": "number", "const": 0 },
        "sourceMutationCount": { "type": "number", "const": 0 }
      },
      "required": [
        "selectedTargets",
        "contextTargets",
        "plannedRequests",
        "originalActualFreshInferences",
        "supplementalActualFreshInferences",
        "cumulativeActualFreshInferences",
        "remainingAuthorizedInferences",
        "originalCacheJsonRecords",
        "originalSuccessRawRecords",
        "originalExtractionErrorRecords",
        "completedCacheJsonRecords",
        "supplementalRawResultsLost",
        "cumulativeModelLoadCount",
        "cumulativeProcessStartCount",
        "perProviderCumulativeActualFreshInferences",
        "perProviderCumulativeModelLoadCount",
        "perProviderCumulativeProcessStartCount",
        "fullMediaInferenceCount",
        "canonicalMutationCount",
        "sourceMutationCount"
      ],
      "additionalProperties": false
    },
    "repairedAudio": {
      "type": "object",
      "properties": {
        "sourceInterval": {
          "type": "object",
          "properties": {
            "start": { "type": "number", "minimum": 0 },
            "end": { "type": "number", "exclusiveMinimum": 0 }
          },
          "required": ["start", "end"],
          "additionalProperties": false
        },
        "sampleRate": { "type": "number", "const": 16000 },
        "sampleCount": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "channels": { "type": "number", "const": 1 },
        "bitsPerSample": { "type": "number", "const": 16 },
        "audioSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "method": {
          "type": "string",
          "const": "SOURCE_VIDEO_EXACT_SAMPLE_TRIM_NO_PADDING"
        },
        "originalSampleCount": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sourceDecodedPrefixMatchesOriginal": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "sourceInterval",
        "sampleRate",
        "sampleCount",
        "channels",
        "bitsPerSample",
        "audioSha256",
        "method",
        "originalSampleCount",
        "sourceDecodedPrefixMatchesOriginal"
      ],
      "additionalProperties": false
    },
    "unpersistedRequests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requestId": { "type": "string", "minLength": 1 },
          "provider": {
            "type": "string",
            "enum": ["whisper-large-v3", "reazonspeech-k2-v2"]
          },
          "observedProviderStatus": { "type": "string", "const": "SUCCESS" },
          "observedExecution": { "type": "string", "const": "FRESH_INFERENCE" },
          "rawResultStatus": { "type": "string", "const": "NOT_PERSISTED" },
          "lexicalEvidenceAvailable": { "type": "boolean", "const": false }
        },
        "required": [
          "requestId",
          "provider",
          "observedProviderStatus",
          "observedExecution",
          "rawResultStatus",
          "lexicalEvidenceAvailable"
        ],
        "additionalProperties": false
      }
    },
    "failure": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "code": { "type": "string" },
        "path": { "type": "array", "items": { "type": "string" } },
        "keys": { "type": "array", "items": { "type": "string" } },
        "stage": { "type": "string" },
        "cause": { "type": "string" },
        "processExitCode": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "code",
        "path",
        "keys",
        "stage",
        "cause",
        "processExitCode"
      ],
      "additionalProperties": false
    },
    "recoveryInspection": {
      "type": "object",
      "properties": {
        "scope": { "type": "array", "items": { "type": "string" } },
        "findings": { "type": "array", "items": { "type": "string" } },
        "rawRecoveryPossibleFromVerifiedArtifacts": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "scope",
        "findings",
        "rawRecoveryPossibleFromVerifiedArtifacts"
      ],
      "additionalProperties": false
    },
    "replayStatus": {
      "type": "string",
      "const": "NOT_RUN_RAW_RESULTS_MISSING"
    },
    "completionAccepted": { "type": "boolean", "const": false },
    "additionalInferenceForbiddenWithoutExplicitNewAuthorization": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "policyVersion",
    "status",
    "sourceIdentity",
    "sourceTimebase",
    "runtimeGoldInputCount",
    "policyHash",
    "selectionHash",
    "freezeSemanticHash",
    "originalProbeByteSha256",
    "originalProbeSemanticHash",
    "completionFailureStatusByteSha256",
    "accounting",
    "repairedAudio",
    "unpersistedRequests",
    "failure",
    "recoveryInspection",
    "replayStatus",
    "completionAccepted",
    "additionalInferenceForbiddenWithoutExplicitNewAuthorization"
  ],
  "additionalProperties": false
}
