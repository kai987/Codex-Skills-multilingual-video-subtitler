{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-second-asr-stability.schema.json",
  "title": "machine-second-asr-stability",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.9-independent-asr-complementarity-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "machine-second-asr-stability"
    },
    "candidatesSemanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eventId": { "type": "string", "minLength": 1 },
          "diagnosticRole": { "type": "string", "enum": ["TARGET", "CONTROL"] },
          "coreExactCandidateId": { "type": "string", "minLength": 1 },
          "coreContextCandidateId": { "type": "string", "minLength": 1 },
          "stabilityClass": {
            "type": "string",
            "enum": [
              "REAZON_CORE_STABLE",
              "REAZON_CONTEXT_EXTENSION_ONLY",
              "REAZON_LEXICALLY_UNSTABLE",
              "REAZON_HALLUCINATION_UNSTABLE",
              "REAZON_EMPTY_UNSTABLE",
              "UNCOMPARABLE"
            ]
          },
          "exactSimilarity": { "type": "number", "minimum": 0, "maximum": 1 },
          "normalizedSimilarity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "pronunciationSimilarity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "contextExtensionObserved": { "type": "boolean" },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "eventId",
          "diagnosticRole",
          "coreExactCandidateId",
          "coreContextCandidateId",
          "stabilityClass",
          "exactSimilarity",
          "normalizedSimilarity",
          "pronunciationSimilarity",
          "contextExtensionObserved",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "eventCount": { "type": "number", "const": 24 },
        "coreStableCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "contextExtensionOnlyCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lexicallyUnstableCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hallucinationUnstableCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "emptyUnstableCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "uncomparableCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stableRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "runtimeGoldInputCount": { "type": "number", "const": 0 }
      },
      "required": [
        "eventCount",
        "coreStableCount",
        "contextExtensionOnlyCount",
        "lexicallyUnstableCount",
        "hallucinationUnstableCount",
        "emptyUnstableCount",
        "uncomparableCount",
        "stableRate",
        "runtimeGoldInputCount"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "candidatesSemanticHash",
    "events",
    "summary",
    "semanticHash"
  ],
  "additionalProperties": false
}
