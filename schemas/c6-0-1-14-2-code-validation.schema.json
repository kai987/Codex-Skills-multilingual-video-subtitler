{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-14-2-code-validation.schema.json",
  "title": "c6-0-1-14-2-code-validation",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "c6-0-1-14-2-code-validation"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "nodeVersion": { "type": "string", "minLength": 1 },
    "packageManager": { "type": "string", "minLength": 1 },
    "results": {
      "minItems": 12,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "npm-ci",
              "schema-generation",
              "typecheck",
              "lint",
              "format-check",
              "build",
              "unit",
              "non-e2e-unit",
              "e2e",
              "c601142-targeted",
              "cross-version",
              "review-ui"
            ]
          },
          "command": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "exitCode": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "passed": { "type": "boolean" },
          "elapsedSeconds": { "type": "number", "minimum": 0 },
          "logRelativePath": { "type": "string", "minLength": 1 },
          "logSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "testSummary": { "type": "array", "items": { "type": "string" } }
        },
        "required": [
          "id",
          "command",
          "exitCode",
          "passed",
          "elapsedSeconds",
          "logRelativePath",
          "logSha256",
          "testSummary"
        ],
        "additionalProperties": false
      }
    },
    "passed": { "type": "boolean" },
    "realAsrExecutedByValidation": { "type": "boolean", "const": false },
    "goldEvaluationExecutedByValidation": { "type": "boolean", "const": false },
    "rankerTrainingExecutedByValidation": { "type": "boolean", "const": false }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "generatedAt",
    "nodeVersion",
    "packageManager",
    "results",
    "passed",
    "realAsrExecutedByValidation",
    "goldEvaluationExecutedByValidation",
    "rankerTrainingExecutedByValidation"
  ],
  "additionalProperties": false
}
