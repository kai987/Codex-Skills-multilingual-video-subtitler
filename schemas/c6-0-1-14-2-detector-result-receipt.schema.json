{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-14-2-detector-result-receipt.schema.json",
  "title": "c6-0-1-14-2-detector-result-receipt",
  "type": "object",
  "properties": {
    "status": { "type": "string", "const": "SUCCESS" },
    "runId": { "type": "string", "minLength": 1 },
    "result": {
      "type": "object",
      "properties": {
        "rawUnit": { "type": "string", "enum": ["SECONDS", "CENTISECONDS"] },
        "rawIntervals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          }
        },
        "exclusiveRawIntervals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          }
        },
        "inputFrames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sampleRate": { "type": "number", "const": 16000 },
        "device": { "type": "string", "minLength": 1 },
        "frameHopSamples16k": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "frameWindowSamples16k": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "frameOffsetSamples16k": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "scoreKind": {
          "type": "string",
          "enum": ["PROBABILITY", "BINARY_DECISION"]
        },
        "originalChunkScores": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "relativePath": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "shape": {
                  "minItems": 2,
                  "maxItems": 2,
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "chunkStepSamples16k": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "frameHopSamples16k": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "frameWindowSamples16k": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "frameOffsetSamples16k": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "anonymousReduction": {
                  "type": "string",
                  "const": "ONE_MINUS_EMPTY_POWERSET_PROBABILITY"
                },
                "aggregation": {
                  "type": "string",
                  "const": "MEAN_OVERLAP_CELL_PROJECTION_10MS"
                }
              },
              "required": [
                "relativePath",
                "sha256",
                "shape",
                "chunkStepSamples16k",
                "frameHopSamples16k",
                "frameWindowSamples16k",
                "frameOffsetSamples16k",
                "anonymousReduction",
                "aggregation"
              ],
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        },
        "scoreSource": { "type": "string", "minLength": 1 },
        "modelLoadCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "scoreRelativePath": { "type": "string", "minLength": 1 },
        "scoreSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "scoreFrameCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stateIsolation": { "type": "string", "minLength": 1 },
        "speakerIdentityPersisted": { "type": "boolean", "const": false },
        "embeddingPersisted": { "type": "boolean", "const": false },
        "extraModelForwardCount": { "type": "number", "const": 0 }
      },
      "required": [
        "rawUnit",
        "rawIntervals",
        "exclusiveRawIntervals",
        "inputFrames",
        "sampleRate",
        "device",
        "frameHopSamples16k",
        "frameWindowSamples16k",
        "frameOffsetSamples16k",
        "scoreKind",
        "originalChunkScores",
        "scoreSource",
        "modelLoadCount",
        "scoreRelativePath",
        "scoreSha256",
        "scoreFrameCount"
      ],
      "additionalProperties": false
    },
    "inferenceConsumed": { "type": "boolean", "const": true },
    "modelLoadCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "wallClockSeconds": { "type": "number", "minimum": 0 }
  },
  "required": [
    "status",
    "runId",
    "result",
    "inferenceConsumed",
    "modelLoadCount",
    "wallClockSeconds"
  ],
  "additionalProperties": false
}
