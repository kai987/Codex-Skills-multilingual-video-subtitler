{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c4-persistent-worker-verification.schema.json",
  "title": "c4-persistent-worker-verification",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "verificationKind": {
      "type": "string",
      "const": "all-c4-targeted-requests-single-persistent-worker"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "authoritativeCandidateSource": { "type": "boolean", "const": false },
    "note": { "type": "string", "minLength": 1 },
    "sourceResultPath": { "type": "string", "minLength": 1 },
    "requestCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "resultCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "execution": {
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "string", "const": "1.0.0" },
        "requestedMode": {
          "type": "string",
          "enum": ["auto", "persistent", "batch", "process"]
        },
        "executionMode": {
          "type": "string",
          "enum": ["persistent", "batch", "process"]
        },
        "backend": { "type": "string", "enum": ["coreml", "cpu", "mixed"] },
        "asrRequestCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cacheHitCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "workerStartCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "modelLoadCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "initializationSeconds": { "type": "number", "minimum": 0 },
        "modelLoadSeconds": { "type": "number", "minimum": 0 },
        "coreMLWarmupSeconds": { "type": "number", "minimum": 0 },
        "transcriptionSeconds": { "type": "number", "minimum": 0 },
        "totalWorkerSeconds": { "type": "number", "minimum": 0 },
        "fallbackProcessCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "requests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "requestId": { "type": "string", "minLength": 1 },
              "batchKey": { "type": "string", "minLength": 1 },
              "cacheHit": { "type": "boolean" },
              "mode": {
                "type": "string",
                "enum": ["persistent", "batch", "process"]
              },
              "status": {
                "type": "string",
                "enum": ["succeeded", "failed", "fallback-succeeded"]
              },
              "retryCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "fallbackMode": {
                "anyOf": [
                  { "type": "string", "const": "process" },
                  { "type": "null" }
                ]
              },
              "durationSeconds": { "type": "number", "minimum": 0 },
              "error": {
                "anyOf": [
                  { "type": "string", "minLength": 1 },
                  { "type": "null" }
                ]
              }
            },
            "required": [
              "requestId",
              "batchKey",
              "cacheHit",
              "mode",
              "status",
              "retryCount",
              "fallbackMode",
              "durationSeconds",
              "error"
            ],
            "additionalProperties": false
          }
        },
        "workers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "batchKey": { "type": "string", "minLength": 1 },
              "mode": { "type": "string", "enum": ["persistent", "batch"] },
              "backend": { "type": "string", "enum": ["coreml", "cpu"] },
              "requestCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "warmupCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "initializationSeconds": { "type": "number", "minimum": 0 },
              "modelLoadSeconds": { "type": "number", "minimum": 0 },
              "coreMLWarmupSeconds": { "type": "number", "minimum": 0 },
              "transcriptionSeconds": { "type": "number", "minimum": 0 },
              "exitReason": {
                "anyOf": [
                  { "type": "string", "minLength": 1 },
                  { "type": "null" }
                ]
              }
            },
            "required": [
              "batchKey",
              "mode",
              "backend",
              "requestCount",
              "warmupCount",
              "initializationSeconds",
              "modelLoadSeconds",
              "coreMLWarmupSeconds",
              "transcriptionSeconds",
              "exitReason"
            ],
            "additionalProperties": false
          }
        },
        "fallbackReason": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        }
      },
      "required": [
        "schemaVersion",
        "requestedMode",
        "executionMode",
        "backend",
        "asrRequestCount",
        "cacheHitCount",
        "workerStartCount",
        "modelLoadCount",
        "initializationSeconds",
        "modelLoadSeconds",
        "coreMLWarmupSeconds",
        "transcriptionSeconds",
        "totalWorkerSeconds",
        "fallbackProcessCount",
        "requests",
        "workers",
        "fallbackReason"
      ],
      "additionalProperties": false
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "round": { "type": "integer", "minimum": 1, "maximum": 2 },
          "unitId": { "type": "string", "minLength": 1 },
          "requestId": { "type": "string", "minLength": 1 },
          "duration": { "type": "number", "exclusiveMinimum": 0 },
          "segmentCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "textSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "round",
          "unitId",
          "requestId",
          "duration",
          "segmentCount",
          "textSha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "verificationKind",
    "generatedAt",
    "authoritativeCandidateSource",
    "note",
    "sourceResultPath",
    "requestCount",
    "resultCount",
    "execution",
    "results"
  ],
  "additionalProperties": false
}
