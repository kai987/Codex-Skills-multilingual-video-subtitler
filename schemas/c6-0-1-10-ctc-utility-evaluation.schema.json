{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-10-ctc-utility-evaluation.schema.json",
  "title": "c6-0-1-10-ctc-utility-evaluation",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.10-cross-model-arbitration-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "c6-0-1-10-ctc-utility-evaluation"
    },
    "evaluationPhase": {
      "type": "string",
      "const": "post-final-freeze-gold-isolated"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eventId": { "type": "string", "minLength": 1 },
          "outcome": {
            "type": "string",
            "enum": [
              "CTC_FAVORS_WHISPER",
              "CTC_FAVORS_REAZON",
              "CTC_AMBIGUOUS",
              "CTC_UNSCORABLE"
            ]
          },
          "preferenceCorrect": {
            "anyOf": [{ "type": "boolean" }, { "type": "null" }]
          },
          "usefulContradiction": { "type": "boolean" },
          "harmfulContradiction": { "type": "boolean" },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "eventId",
          "outcome",
          "preferenceCorrect",
          "usefulContradiction",
          "harmfulContradiction",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "correctSupportCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "wrongSupportCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "usefulContradictionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "harmfulContradictionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ambiguousOrUnscorableCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "correctSupportCount",
        "wrongSupportCount",
        "usefulContradictionCount",
        "harmfulContradictionCount",
        "ambiguousOrUnscorableCount"
      ],
      "additionalProperties": false
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "evaluationPhase",
    "events",
    "summary",
    "runtimeGoldInputCount",
    "semanticHash"
  ],
  "additionalProperties": false
}
