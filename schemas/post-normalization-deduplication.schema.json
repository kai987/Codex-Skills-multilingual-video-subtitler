{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/post-normalization-deduplication.schema.json",
  "title": "post-normalization-deduplication",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "inputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stage": {
      "type": "string",
      "enum": ["pre-normalization", "post-normalization"]
    },
    "inputWinnerCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "outputWinnerCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": [
              "exact",
              "normalized-exact",
              "punctuation-only-difference",
              "spacing-only-difference",
              "same-source",
              "same-reference-anchor",
              "same-recovery-unit",
              "near-duplicate",
              "prefix-duplicate",
              "suffix-duplicate",
              "kana-kanji-equivalent",
              "normalized-form-equivalent",
              "trusted-reference-original-lyrics"
            ]
          },
          "keptCueId": { "type": "string", "minLength": 1 },
          "removedCueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "timingDonorCueId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "reasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "id",
          "kind",
          "keptCueId",
          "removedCueIds",
          "timingDonorCueId",
          "reasons"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "removedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "prefixDuplicateCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "timingDonorCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["removedCount", "prefixDuplicateCount", "timingDonorCount"],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "inputHash",
    "stage",
    "inputWinnerCount",
    "outputWinnerCount",
    "records",
    "summary"
  ],
  "additionalProperties": false
}
