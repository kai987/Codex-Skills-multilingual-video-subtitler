{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/atomic-hypothesis-clusters.schema.json",
  "title": "atomic-hypothesis-clusters",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "inputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "configuration": {
      "type": "object",
      "properties": {
        "method": { "type": "string", "const": "constrained-medoid" },
        "maximumBoundaryDistanceSeconds": { "type": "number", "minimum": 0 },
        "minimumTemporalOverlapRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maximumAtomicSpanSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "majorityCompatibilityRatio": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1
        },
        "sharedReferenceUnitAloneConnectsCandidates": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "method",
        "maximumBoundaryDistanceSeconds",
        "minimumTemporalOverlapRatio",
        "maximumAtomicSpanSeconds",
        "majorityCompatibilityRatio",
        "sharedReferenceUnitAloneConnectsCandidates"
      ],
      "additionalProperties": false
    },
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "interval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "candidateCueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "medoidCueId": { "type": "string", "minLength": 1 },
          "referenceAnchorIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "referenceUnitIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "sourceRequestIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "clusterReason": {
            "type": "string",
            "enum": [
              "singleton",
              "temporal-medoid",
              "reference-anchor",
              "near-duplicate-text",
              "mixed"
            ]
          },
          "sourceLegacyClusterIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "id",
          "interval",
          "candidateCueIds",
          "medoidCueId",
          "referenceAnchorIds",
          "referenceUnitIds",
          "sourceRequestIds",
          "clusterReason",
          "sourceLegacyClusterIds",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "candidateCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "atomicClusterCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "singletonClusterCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "splitLegacyClusterCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "candidateCount",
        "atomicClusterCount",
        "singletonClusterCount",
        "splitLegacyClusterCount"
      ],
      "additionalProperties": false
    },
    "fallback": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "inputHash",
    "configuration",
    "clusters",
    "summary",
    "fallback"
  ],
  "additionalProperties": false
}
