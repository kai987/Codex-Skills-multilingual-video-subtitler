{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-utility-aware-final-planner-certificate.schema.json",
  "title": "machine-utility-aware-final-planner-certificate",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14.4-machine-evidence-utility-selection-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "sourceTimebase": {
      "type": "string",
      "const": "SOURCE_GLOBAL_NATIVE_SAMPLES"
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "visibility": { "type": "string", "const": "LOCAL_ONLY" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": {
      "type": "string",
      "const": "machine-utility-aware-final-planner-certificate"
    },
    "plannerVersion": {
      "type": "string",
      "const": "DETERMINISTIC_UTILITY_NATIVE_SET_COVER_BNB_V2"
    },
    "sourcePlannerHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "utilityPolicyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "atomUtilityHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "childUtilityHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "bundleUtilityHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "optionalCoverageLedgerHash": {
      "anyOf": [
        { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        { "type": "null" }
      ]
    },
    "obligationsHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidatesHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "dominanceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidateCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "candidateCountAfterPruning": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "hardConstraintCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "obligationCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "exploredStateCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "prunedStateCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "searchStateLimit": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "searchComplete": { "type": "boolean" },
    "feasibilityStatus": {
      "type": "string",
      "enum": ["FEASIBLE", "INFEASIBLE_PROVEN", "SEARCH_INCOMPLETE"]
    },
    "oldPlanFeasible": { "type": "boolean" },
    "oldPlanObjectiveVector": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    },
    "finalObjectiveVector": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    },
    "objectiveNonDegradation": { "type": "boolean" },
    "selectedBundleIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "selectedChildIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "selectedOptionalChildIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "selectedTierCounts": {
      "type": "object",
      "properties": {
        "TIER_5_VERIFIED_MULTI_FAMILY_SPEECH": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "TIER_4_VERIFIED_INDEPENDENT_EXCLUSIVE_SPEECH": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "TIER_3_VERIFIED_SINGLE_FAMILY_SPEECH": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "TIER_2_MASKED_OR_SUBTHRESHOLD_SPEECH": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "TIER_1_AUDIT_ONLY_SPEECH_CANDIDATE": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "TIER_0_INELIGIBLE_OR_CONTRADICTED": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "TIER_5_VERIFIED_MULTI_FAMILY_SPEECH",
        "TIER_4_VERIFIED_INDEPENDENT_EXCLUSIVE_SPEECH",
        "TIER_3_VERIFIED_SINGLE_FAMILY_SPEECH",
        "TIER_2_MASKED_OR_SUBTHRESHOLD_SPEECH",
        "TIER_1_AUDIT_ONLY_SPEECH_CANDIDATE",
        "TIER_0_INELIGIBLE_OR_CONTRADICTED"
      ],
      "additionalProperties": false
    },
    "activeBundleCount": { "type": "integer", "minimum": 0, "maximum": 24 },
    "coreUnionSeconds": { "type": "number", "minimum": 0, "maximum": 60 },
    "predictedFullQueueSeconds": { "type": "number", "minimum": 0 },
    "predictedFullQueueEpisodeRatio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "obligationCoverageRatio": { "type": "number", "const": 1 },
    "droppedObligationCount": { "type": "number", "const": 0 },
    "deterministicTieBreakHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "admissibleBoundMethod": {
      "type": "string",
      "const": "SUFFIX_COMPONENTWISE_UTILITY_UPPER_BOUND"
    },
    "feasibilityWitnessVerified": { "type": "boolean" },
    "hardConstraintResults": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" }
        },
        "required": ["name", "passed"],
        "additionalProperties": false
      }
    },
    "diagnosticReasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "policyHash",
    "sourceIdentity",
    "sourceTimebase",
    "runtimeGoldInputCount",
    "visibility",
    "semanticHash",
    "artifactType",
    "plannerVersion",
    "sourcePlannerHash",
    "utilityPolicyHash",
    "atomUtilityHash",
    "childUtilityHash",
    "bundleUtilityHash",
    "optionalCoverageLedgerHash",
    "obligationsHash",
    "candidatesHash",
    "dominanceHash",
    "candidateCount",
    "candidateCountAfterPruning",
    "hardConstraintCount",
    "obligationCount",
    "exploredStateCount",
    "prunedStateCount",
    "searchStateLimit",
    "searchComplete",
    "feasibilityStatus",
    "oldPlanFeasible",
    "oldPlanObjectiveVector",
    "finalObjectiveVector",
    "objectiveNonDegradation",
    "selectedBundleIds",
    "selectedChildIds",
    "selectedOptionalChildIds",
    "selectedTierCounts",
    "activeBundleCount",
    "coreUnionSeconds",
    "predictedFullQueueSeconds",
    "predictedFullQueueEpisodeRatio",
    "obligationCoverageRatio",
    "droppedObligationCount",
    "deterministicTieBreakHash",
    "admissibleBoundMethod",
    "feasibilityWitnessVerified",
    "hardConstraintResults",
    "diagnosticReasons"
  ],
  "additionalProperties": false
}
