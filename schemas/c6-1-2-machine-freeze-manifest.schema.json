{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-1-2-machine-freeze-manifest.schema.json",
  "title": "c6-1-2-machine-freeze-manifest",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "c6-1-2-machine-freeze-manifest"
    },
    "policyVersion": {
      "type": "string",
      "const": "c6.1.2-top-k-reranking-acoustic-completeness-v1"
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "frozenAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relativePath": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["relativePath", "sha256", "size"],
        "additionalProperties": false
      }
    },
    "codeFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relativePath": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["relativePath", "sha256", "size"],
        "additionalProperties": false
      }
    },
    "machineAggregateHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "codeAggregateHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceIdentity": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "productionTextHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "productionTimingHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "goldRead": { "type": "boolean", "const": false },
    "oofShadowsFrozenBeforeGold": { "type": "boolean", "const": false },
    "modelProfilesFrozenBeforeGold": { "type": "boolean", "const": true },
    "inputOrderParity": { "type": "boolean" }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "policyVersion",
    "semanticHash",
    "frozenAt",
    "files",
    "codeFiles",
    "machineAggregateHash",
    "codeAggregateHash",
    "policyHash",
    "sourceIdentity",
    "productionTextHash",
    "productionTimingHash",
    "goldRead",
    "oofShadowsFrozenBeforeGold",
    "modelProfilesFrozenBeforeGold",
    "inputOrderParity"
  ],
  "additionalProperties": false
}
