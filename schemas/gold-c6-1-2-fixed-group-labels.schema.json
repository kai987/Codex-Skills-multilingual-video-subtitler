{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/gold-c6-1-2-fixed-group-labels.schema.json",
  "title": "gold-c6-1-2-fixed-group-labels",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "gold-c6-1-2-fixed-group-labels"
    },
    "policyVersion": {
      "type": "string",
      "const": "c6.1.2-top-k-reranking-acoustic-completeness-v1"
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evaluationOnly": { "type": "boolean", "const": true },
    "privacy": { "type": "string", "const": "LOCAL_ONLY" },
    "machineFreezeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "mappingHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "goldIdentityHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "goldBindingHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "goldFirstReadAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "groupId": { "type": "string", "minLength": 1 },
          "goldCueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "status": {
            "type": "string",
            "enum": [
              "FIXED_ONE_TO_ONE",
              "FIXED_ONE_TO_MANY",
              "FIXED_MANY_TO_ONE",
              "FIXED_MANY_TO_MANY",
              "AMBIGUOUS",
              "NO_MAPPING",
              "STRUCTURE_INCOMPATIBLE"
            ]
          },
          "reasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "machineCoveredRatio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "goldCoveredRatio": { "type": "number", "minimum": 0, "maximum": 1 },
          "baselineExactError": {
            "anyOf": [
              { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              { "type": "null" }
            ]
          },
          "baselineNormalizedError": {
            "anyOf": [
              { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              { "type": "null" }
            ]
          },
          "goldCharacterCount": {
            "anyOf": [
              { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              { "type": "null" }
            ]
          },
          "baselineMaterial": {
            "anyOf": [
              { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              { "type": "null" }
            ]
          }
        },
        "required": [
          "groupId",
          "goldCueIds",
          "status",
          "reasons",
          "machineCoveredRatio",
          "goldCoveredRatio",
          "baselineExactError",
          "baselineNormalizedError",
          "goldCharacterCount",
          "baselineMaterial"
        ],
        "additionalProperties": false
      }
    },
    "unmappedGoldCueIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "profileRematchingCount": { "type": "number", "const": 0 }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "policyVersion",
    "semanticHash",
    "evaluationOnly",
    "privacy",
    "machineFreezeHash",
    "mappingHash",
    "goldIdentityHash",
    "goldBindingHash",
    "goldFirstReadAt",
    "rows",
    "unmappedGoldCueIds",
    "profileRematchingCount"
  ],
  "additionalProperties": false
}
