{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/subtitle-finalization-report.schema.json",
  "title": "subtitle-finalization-report",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "reportType": { "type": "string", "const": "subtitle-finalization-report" },
    "finalizationVersion": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "enum": ["auto", "review-fallback", "human"] },
    "status": {
      "type": "string",
      "enum": [
        "machine-draft",
        "auto-validated",
        "human-validated",
        "mixed-validated",
        "needs-review",
        "rejected"
      ]
    },
    "finalizationMethod": {
      "type": "string",
      "enum": ["none", "automatic", "human", "mixed"]
    },
    "baseSubtitlePackageHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "baseCueHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "inputEvidenceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "outputCueHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "outputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "humanReviewedBaseline": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "authority": {
              "type": "string",
              "const": "user-confirmed-human-review"
            },
            "sourceFileName": { "type": "string", "minLength": 1 },
            "sourceFileSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "sourceFileSize": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "format": { "type": "string", "const": "ass" },
            "cueCount": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "cueHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "timestampNormalizationCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "effectivePackagePath": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!\\/)(?![A-Za-z]:[\\\\/]).+"
            },
            "sourceReadOnlyVerified": { "type": "boolean" }
          },
          "required": [
            "authority",
            "sourceFileName",
            "sourceFileSha256",
            "sourceFileSize",
            "format",
            "cueCount",
            "cueHash",
            "timestampNormalizationCount",
            "effectivePackagePath",
            "sourceReadOnlyVerified"
          ],
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "thresholds": {
      "type": "object",
      "properties": {
        "minimumAssociationScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimumAssociationMargin": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimumIndependentSupport": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "minimumExistingCuePreservation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimumCandidateCoverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maximumContentOmission": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maximumContentAddition": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maximumNeighborCueIntrusion": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimumLocalSpeechCoverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "minimumAssociationScore",
        "minimumAssociationMargin",
        "minimumIndependentSupport",
        "minimumExistingCuePreservation",
        "minimumCandidateCoverage",
        "maximumContentOmission",
        "maximumContentAddition",
        "maximumNeighborCueIntrusion",
        "minimumLocalSpeechCoverage"
      ],
      "additionalProperties": false
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "decisionId": { "type": "string", "minLength": 1 },
          "targetCueIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "action": {
            "type": "string",
            "enum": [
              "KEEP",
              "REPLACE",
              "EXPAND",
              "SPLIT",
              "MERGE",
              "REDISTRIBUTE",
              "DELETE_HALLUCINATION",
              "TIMING_ONLY",
              "REVIEW_ONLY"
            ]
          },
          "currentText": { "type": "string" },
          "proposedText": {
            "anyOf": [{ "type": "string" }, { "type": "null" }]
          },
          "proposedCues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "start": { "type": "number", "minimum": 0 },
                "end": { "type": "number", "exclusiveMinimum": 0 },
                "text": { "type": "string", "minLength": 1 }
              },
              "required": ["id", "start", "end", "text"],
              "additionalProperties": false
            }
          },
          "selectedCandidateId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "alternativeCandidateIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "evidenceIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "blockers": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "automaticMutationEligible": { "type": "boolean" },
          "requiresHumanReview": { "type": "boolean" },
          "decisionReasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "decisionId",
          "targetCueIds",
          "action",
          "currentText",
          "proposedText",
          "proposedCues",
          "selectedCandidateId",
          "alternativeCandidateIds",
          "evidenceIds",
          "blockers",
          "automaticMutationEligible",
          "requiresHumanReview",
          "decisionReasons"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "findingId": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["blocking", "warning"] },
          "code": { "type": "string", "minLength": 1 },
          "cueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "message": { "type": "string", "minLength": 1 }
        },
        "required": ["findingId", "severity", "code", "cueIds", "message"],
        "additionalProperties": false
      }
    },
