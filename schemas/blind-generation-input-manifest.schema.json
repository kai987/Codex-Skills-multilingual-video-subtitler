{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/blind-generation-input-manifest.schema.json",
  "title": "blind-generation-input-manifest",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "blind-generation-input-manifest"
    },
    "manifestVersion": {
      "type": "string",
      "const": "c6.0.1-blind-generation-input-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "generationRunId": { "type": "string", "minLength": 1 },
    "benchmarkStatus": {
      "type": "string",
      "const": "development-known-runtime-blind"
    },
    "sourceVideo": {
      "type": "object",
      "properties": {
        "fileName": { "type": "string", "minLength": 1 },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "required": ["fileName", "size", "sha256"],
      "additionalProperties": false
    },
    "repositoryCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "allowedGenericResources": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "genericModelSnapshots": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "modelName": { "type": "string", "minLength": 1 },
          "fileName": { "type": "string", "minLength": 1 },
          "snapshotSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "genericResource": { "type": "boolean", "const": true }
        },
        "required": [
          "modelName",
          "fileName",
          "snapshotSha256",
          "size",
          "genericResource"
        ],
        "additionalProperties": false
      }
    },
    "runtimeIdentities": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "runtimeId": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "executableFileName": { "type": "string", "minLength": 1 },
          "device": { "type": "string", "minLength": 1 },
          "genericResource": { "type": "boolean", "const": true }
        },
        "required": [
          "runtimeId",
          "name",
          "version",
          "executableFileName",
          "device",
          "genericResource"
        ],
        "additionalProperties": false
      }
    },
    "machineMemoryInitialState": {
      "type": "object",
      "properties": {
        "storeId": { "type": "string", "minLength": 1 },
        "entryCount": { "type": "number", "const": 0 },
        "storeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "humanDerived": { "type": "boolean", "const": false }
      },
      "required": ["storeId", "entryCount", "storeHash", "humanDerived"],
      "additionalProperties": false
    },
    "importedMediaCaches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "artifactType": { "type": "string", "minLength": 1 },
          "provenance": { "type": "string", "const": "machine-only-verified" },
          "artifactHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": ["path", "artifactType", "provenance", "artifactHash"],
        "additionalProperties": false
      }
    },
    "humanArtifacts": {
      "minItems": 9,
      "maxItems": 9,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifactClass": {
            "type": "string",
            "enum": [
              "human-subtitle",
              "human-canonical",
              "human-timing",
              "human-memory",
              "human-alignment",
              "human-ctc",
              "human-correction-feedback",
              "human-authority",
              "human-protected-final"
            ]
          },
          "used": { "type": "boolean", "const": false },
          "inputCount": { "type": "number", "const": 0 }
        },
        "required": ["artifactClass", "used", "inputCount"],
        "additionalProperties": false
      }
    },
    "generationArguments": {
      "minItems": 1,
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "environmentSummary": {
      "type": "object",
      "properties": {
        "networkPolicy": { "type": "string", "const": "off" },
        "networkUsed": { "type": "boolean", "const": false },
        "onlineSubtitleSearchUsed": { "type": "boolean", "const": false },
        "cloudProviderConfigured": { "type": "boolean", "const": false },
        "guidanceMode": { "type": "string", "const": "reference-free" },
        "mediaCacheMode": {
          "type": "string",
          "enum": ["fresh-isolated", "verified-machine-only"]
        },
        "machineMemoryMode": { "type": "string", "const": "fresh-empty" }
      },
      "required": [
        "networkPolicy",
        "networkUsed",
        "onlineSubtitleSearchUsed",
        "cloudProviderConfigured",
        "guidanceMode",
        "mediaCacheMode",
        "machineMemoryMode"
      ],
      "additionalProperties": false
    },
    "inputSemanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "manifestVersion",
    "generatedAt",
    "generationRunId",
    "benchmarkStatus",
    "sourceVideo",
    "repositoryCommit",
    "allowedGenericResources",
    "genericModelSnapshots",
    "runtimeIdentities",
    "machineMemoryInitialState",
    "importedMediaCaches",
    "humanArtifacts",
    "generationArguments",
    "environmentSummary",
    "inputSemanticHash"
  ],
  "additionalProperties": false
}
