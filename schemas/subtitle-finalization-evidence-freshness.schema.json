{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/subtitle-finalization-evidence-freshness.schema.json",
  "title": "subtitle-finalization-evidence-freshness",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "subtitle-finalization-evidence-freshness"
    },
    "freshnessVersion": {
      "type": "string",
      "const": "c6.0-evidence-freshness-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "baseCueHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "baseTimingHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "freshnessId": { "type": "string", "minLength": 1 },
          "code": { "type": "string", "minLength": 1 },
          "cueId": { "type": "string", "minLength": 1 },
          "componentId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "originalEvidenceRef": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!\\/)(?![A-Za-z]:[\\\\/])(?!\\\\\\\\).+"
          },
          "originalEvidenceHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "laterEvidenceRef": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!\\/)(?![A-Za-z]:[\\\\/])(?!\\\\\\\\).+"
          },
          "laterEvidenceHash": {
            "anyOf": [
              { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              { "type": "null" }
            ]
          },
          "canonicalCueHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "canonicalTimingHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "semanticSubject": { "type": "string", "minLength": 1 },
          "originalMeaning": { "type": "string", "minLength": 1 },
          "laterMeaning": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "cueIdentityMatched": { "type": "boolean" },
          "canonicalHashMatched": { "type": "boolean" },
          "timingHashMatched": { "type": "boolean" },
          "semanticSubjectMatched": { "type": "boolean" },
          "lineageCompatible": { "type": "boolean" },
          "canonicalTextChanged": { "type": "boolean" },
          "canonicalTimingChanged": { "type": "boolean" },
          "freshnessStatus": {
            "type": "string",
            "enum": [
              "current",
              "superseded",
              "missing-later-evidence",
              "cue-mismatch",
              "hash-mismatch",
              "subject-mismatch",
              "canonical-changed",
              "timing-changed",
              "lineage-mismatch"
            ]
          },
          "supersededByEvidenceIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "reasonCodes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "freshnessId",
          "code",
          "cueId",
          "componentId",
          "originalEvidenceRef",
          "originalEvidenceHash",
          "laterEvidenceRef",
          "laterEvidenceHash",
          "canonicalCueHash",
          "canonicalTimingHash",
          "semanticSubject",
          "originalMeaning",
          "laterMeaning",
          "cueIdentityMatched",
          "canonicalHashMatched",
          "timingHashMatched",
          "semanticSubjectMatched",
          "lineageCompatible",
          "canonicalTextChanged",
          "canonicalTimingChanged",
          "freshnessStatus",
          "supersededByEvidenceIds",
          "reasonCodes"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "assessedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "currentCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "supersededCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "assessedCount",
        "currentCount",
        "supersededCount",
        "failedCount"
      ],
      "additionalProperties": false
    },
    "integrityPassed": { "type": "boolean" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "freshnessVersion",
    "generatedAt",
    "policyHash",
    "baseCueHash",
    "baseTimingHash",
    "entries",
    "summary",
    "integrityPassed",
    "semanticHash"
  ],
  "additionalProperties": false
}
