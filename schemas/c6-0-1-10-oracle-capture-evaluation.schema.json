      "type": "string",
      "const": "c6.0.1.10-cross-model-arbitration-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "c6-0-1-10-oracle-capture-evaluation"
    },
    "evaluationPhase": {
      "type": "string",
      "const": "post-final-freeze-gold-isolated"
    },
    "machineFreezeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "goldIdentityHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "metricDirection": { "type": "string", "const": "LOWER_IS_BETTER" },
    "dev24": {
      "type": "object",
      "properties": {
        "evaluableSwitchCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "correctSwitchCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "wrongSwitchCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "neutralSwitchCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "avoidedRegressionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "availableOracleGain": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "realizedArbitrationGain": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "oracleCaptureRate": {
          "anyOf": [{ "type": "number" }, { "type": "null" }]
        },
        "arbitrationPrecision": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "null" }
          ]
        },
        "arbitrationHarmRate": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "null" }
          ]
        }
      },
      "required": [
        "evaluableSwitchCount",
        "correctSwitchCount",
        "wrongSwitchCount",
        "neutralSwitchCount",
        "avoidedRegressionCount",
        "availableOracleGain",
        "realizedArbitrationGain",
        "oracleCaptureRate",
        "arbitrationPrecision",
        "arbitrationHarmRate"
