{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-review-target-bundle-candidates-v1.schema.json",
  "title": "machine-review-target-bundle-candidates-v1",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14.3-cross-stage-monotonic-safety-selection-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "sourceTimebase": {
      "type": "string",
      "const": "SOURCE_GLOBAL_NATIVE_SAMPLES"
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "visibility": { "type": "string", "const": "LOCAL_ONLY" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": {
      "type": "string",
      "const": "machine-review-target-bundle-candidates-v1"
    },
    "childrenHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "obligationsHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "immutableAudioIntervals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "startSample": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "endSample": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["startSample", "endSample"],
        "additionalProperties": false
      }
    },
    "baselineUniqueAudioSeconds": { "type": "number", "minimum": 0 },
    "generationMethod": {
      "type": "string",
      "const": "LOCAL_CONTIGUOUS_AND_OBLIGATION_SUBSET_WINDOWS"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "bundleId": { "type": "string", "minLength": 1 },
          "childUnitIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "parentClusterIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "obligationIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "atomicNativeIntervals": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "startSample": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "endSample": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["startSample", "endSample"],
              "additionalProperties": false
            }
          },
          "atomicSourceIntervals": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": { "type": "number", "minimum": 0 },
                "end": { "type": "number", "exclusiveMinimum": 0 }
              },
              "required": ["start", "end"],
              "additionalProperties": false
            }
          },
          "nativeIntervalUnion": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "startSample": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "endSample": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["startSample", "endSample"],
              "additionalProperties": false
            }
          },
          "reviewEnvelope": {
            "type": "object",
            "properties": {
              "startSample": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "endSample": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["startSample", "endSample"],
            "additionalProperties": false
          },
          "coreUnionSeconds": { "type": "number", "minimum": 0 },
          "internalSilenceSeconds": { "type": "number", "minimum": 0 },
          "internalGapIntervals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "startSample": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "endSample": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["startSample", "endSample"],
              "additionalProperties": false
            }
          },
          "cueCoveredGapIntervals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "startSample": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "endSample": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["startSample", "endSample"],
              "additionalProperties": false
            }
          },
          "detectorFamilies": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "SILERO",
                "PYANNOTE",
                "WEBRTC",
                "LEGACY_FINGERPRINT",
                "EXISTING_VERIFIED",
                "LOCALIZED_LEXICAL"
              ]
            }
          },
          "evidenceStrata": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "MULTI_DETECTOR",
                "PYANNOTE_EXCLUSIVE",
                "SILERO_EXCLUSIVE",
                "WEBRTC_EXCLUSIVE",
                "LEGACY_FINGERPRINT_EXCLUSIVE",
                "MULTI_VIEW_SAME_DETECTOR",
                "EXISTING_VERIFIED",
                "MASKED_SUBTHRESHOLD",
                "AUDIT_ONLY"
              ]
            }
          },
          "timelineBins": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "sceneIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "evidenceIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "strongContradiction": { "type": "boolean" },
          "machinePriority": { "type": "number" },
          "independentSupportedNativeIntervals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "startSample": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "endSample": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["startSample", "endSample"],
              "additionalProperties": false
            }
          },
          "targetSlotCost": { "type": "number", "const": 1 },
          "incrementalFullQueueAudioSeconds": {
            "type": "number",
            "minimum": 0
          },
          "predictedAudioIntervals": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "startSample": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "endSample": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["startSample", "endSample"],
              "additionalProperties": false
            }
          },
          "sourceIdentity": {
            "type": "object",
            "properties": {
              "sourceMediaSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
              "sampleRate": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "audioStreamIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "audioTimebase": {
                "type": "string",
                "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
              },
              "sourceTimebase": {
                "type": "string",
                "const": "SOURCE_GLOBAL_SECONDS"
              }
            },
            "required": [
              "sourceMediaSha256",
              "durationSeconds",
              "sampleRate",
              "audioStreamIndex",
              "audioTimebase",
              "sourceTimebase"
            ],
            "additionalProperties": false
          },
          "verifiedTimebase": { "type": "boolean" },
          "eligible": { "type": "boolean" },
          "rejectionReasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "bundleId",
          "childUnitIds",
          "parentClusterIds",
          "obligationIds",
          "atomicNativeIntervals",
          "atomicSourceIntervals",
          "nativeIntervalUnion",
          "reviewEnvelope",
          "coreUnionSeconds",
          "internalSilenceSeconds",
          "internalGapIntervals",
          "cueCoveredGapIntervals",
          "detectorFamilies",
          "evidenceStrata",
          "timelineBins",
          "sceneIds",
          "evidenceIds",
          "strongContradiction",
          "machinePriority",
          "independentSupportedNativeIntervals",
          "targetSlotCost",
          "incrementalFullQueueAudioSeconds",
          "predictedAudioIntervals",
          "sourceIdentity",
          "verifiedTimebase",
          "eligible",
          "rejectionReasons",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "candidateCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "multiChildBundleCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "eligibleCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cueCoveredInternalGapBundleCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rejectedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maximumEnvelopeSeconds": { "type": "number", "minimum": 0 },
        "wholeEpisodeCatchAllCount": { "type": "number", "const": 0 }
      },
      "required": [
        "candidateCount",
        "multiChildBundleCount",
        "eligibleCount",
        "cueCoveredInternalGapBundleCount",
        "rejectedCount",
        "maximumEnvelopeSeconds",
        "wholeEpisodeCatchAllCount"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "policyHash",
    "sourceIdentity",
    "sourceTimebase",
    "runtimeGoldInputCount",
    "visibility",
    "semanticHash",
    "artifactType",
    "childrenHash",
    "obligationsHash",
    "immutableAudioIntervals",
    "baselineUniqueAudioSeconds",
    "generationMethod",
    "candidates",
    "summary"
  ],
  "additionalProperties": false
}
