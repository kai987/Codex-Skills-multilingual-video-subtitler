{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/discovered-speech-anchors.schema.json",
  "title": "discovered-speech-anchors",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "sourceAudioSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "discoveryVersion": { "type": "string", "minLength": 1 },
    "configuration": {
      "default": { "highConfidenceThreshold": 0.75 },
      "type": "object",
      "properties": {
        "highConfidenceThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": ["highConfidenceThreshold"],
      "additionalProperties": false
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "interval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "vad",
                "extra-sensitive-vad",
                "vocal-detector",
                "scene-analysis",
                "no-vad-probe",
                "token-timestamps",
                "lyrics-detector"
              ]
            }
          },
          "speechProbability": { "type": "number", "minimum": 0, "maximum": 1 },
          "vocalProbability": { "type": "number", "minimum": 0, "maximum": 1 },
          "expectedContent": {
            "type": "string",
            "enum": ["dialogue", "singing", "uncertain"]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "id",
          "interval",
          "sources",
          "speechProbability",
          "vocalProbability",
          "expectedContent",
          "confidence",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dialogue": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "singing": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "uncertain": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "highConfidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "total",
        "dialogue",
        "singing",
        "uncertain",
        "highConfidence"
      ],
      "additionalProperties": false
    },
    "fallback": {
      "default": null,
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "sourceAudioSha256",
    "discoveryVersion",
    "configuration",
    "anchors",
    "summary",
    "fallback"
  ],
  "additionalProperties": false
}
