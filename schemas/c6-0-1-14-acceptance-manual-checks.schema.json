{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-14-acceptance-manual-checks.schema.json",
  "title": "c6-0-1-14-acceptance-manual-checks",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "c6-0-1-14-acceptance-manual-checks"
    },
    "codeValidationByteSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "datasetSpecificHardcoding": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["PASS", "FAIL", "NOT_CHECKED"] },
        "method": {
          "type": "string",
          "enum": [
            "EXPLICIT_MANUAL_CODE_REVIEW",
            "STATIC_AUDIT",
            "NOT_PERFORMED"
          ]
        },
        "evidenceSha256": {
          "anyOf": [
            { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            { "type": "null" }
          ]
        }
      },
      "required": ["status", "method", "evidenceSha256"],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "codeValidationByteSha256",
    "datasetSpecificHardcoding"
  ],
  "additionalProperties": false
}
