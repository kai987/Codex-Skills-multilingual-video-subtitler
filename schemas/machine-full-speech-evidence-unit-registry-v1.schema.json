{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-full-speech-evidence-unit-registry-v1.schema.json",
  "title": "machine-full-speech-evidence-unit-registry-v1",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14.5.1-full-unit-registry-review-binding-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "sourceTimebase": {
      "type": "string",
      "const": "SOURCE_GLOBAL_NATIVE_SAMPLES"
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "visibility": { "type": "string", "const": "LOCAL_ONLY" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": {
      "type": "string",
      "const": "machine-full-speech-evidence-unit-registry-v1"
    },
    "inventoryHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "hierarchyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "planningUnitsHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "boundaryPolicyVersion": { "type": "string", "minLength": 1 },
    "coverageStatePartitionVersion": { "type": "string", "minLength": 1 },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fullCoverageUnitId": { "type": "string", "minLength": 1 },
          "legacyPlanningCoverageUnitIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "sourceIdentity": {
            "type": "object",
            "properties": {
              "sourceMediaSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
              "sampleRate": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "audioStreamIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "audioTimebase": {
                "type": "string",
                "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
              },
              "sourceTimebase": {
                "type": "string",
                "const": "SOURCE_GLOBAL_SECONDS"
              }
            },
            "required": [
              "sourceMediaSha256",
              "durationSeconds",
              "sampleRate",
              "audioStreamIndex",
              "audioTimebase",
              "sourceTimebase"
            ],
            "additionalProperties": false
          },
          "atomicNativeIntervals": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "startSample": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "endSample": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["startSample", "endSample"],
              "additionalProperties": false
            }
          },
          "atomicSourceIntervals": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": { "type": "number", "minimum": 0 },
                "end": { "type": "number", "exclusiveMinimum": 0 }
              },
              "required": ["start", "end"],
              "additionalProperties": false
            }
          },
          "coreUnionSamples": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "coreUnionSeconds": { "type": "number", "exclusiveMinimum": 0 },
          "envelopeInterval": {
            "type": "object",
            "properties": {
              "startSample": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "endSample": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["startSample", "endSample"],
            "additionalProperties": false
          },
          "internalSilenceIntervals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "startSample": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "endSample": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["startSample", "endSample"],
              "additionalProperties": false
            }
          },
          "detectorFamilies": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "independentEvidenceFamilies": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "evidenceStrata": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "evidenceObservationIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "evidenceAtomIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "parentClusterIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "childUnitIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "cueCoverageRatio": { "type": "number", "minimum": 0, "maximum": 1 },
          "immutableTargetCoverageRatio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "existingReviewTargetCoverageRatio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "existingPlaybackCoverageRatio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "safetyPlanningCoverageRatio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "coverageStates": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "CUE_COVERED",
                "IMMUTABLE_REVIEW_TARGET_COVERED",
                "EXISTING_REVIEW_TARGET_COVERED",
                "SAFETY_PLANNING_SELECTED",
                "SAFETY_PLANNING_UNSELECTED",
                "PARTIALLY_COVERED",
                "UNCOVERED_SPEECH",
                "MULTI_STATE_ATOMIC_PARTITION"
              ]
            }
          },
          "planningEligibility": { "type": "boolean" },
          "verifiedTimebase": { "type": "boolean", "const": true },
          "strongContradiction": { "type": "boolean", "const": false },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "fullCoverageUnitId",
          "legacyPlanningCoverageUnitIds",
          "sourceIdentity",
          "atomicNativeIntervals",
          "atomicSourceIntervals",
          "coreUnionSamples",
          "coreUnionSeconds",
          "envelopeInterval",
          "internalSilenceIntervals",
          "detectorFamilies",
          "independentEvidenceFamilies",
          "evidenceStrata",
          "evidenceObservationIds",
          "evidenceAtomIds",
          "parentClusterIds",
          "childUnitIds",
          "cueCoverageRatio",
          "immutableTargetCoverageRatio",
          "existingReviewTargetCoverageRatio",
          "existingPlaybackCoverageRatio",
          "safetyPlanningCoverageRatio",
          "coverageStates",
          "planningEligibility",
          "verifiedTimebase",
          "strongContradiction",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "fullRegistryUnitCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "fullRegistryAtomicIntervalCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "registeredVerifiedSpeechUnionSamples": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "registeredVerifiedSpeechUnionSeconds": { "type": "number", "minimum": 0 },
    "upstreamVerifiedSpeechUnionSamples": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "upstreamVerifiedSpeechUnionSeconds": { "type": "number", "minimum": 0 },
    "unregisteredVerifiedSpeechSamples": { "type": "number", "const": 0 },
    "registeredVerifiedSpeechCoverageRatio": { "type": "number", "const": 1 },
    "cueCoveredUnitCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "immutableTargetCoveredUnitCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "existingReviewTargetCoveredUnitCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "uncoveredPlanningUnitCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "partiallyCoveredUnitCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sourceOrdered": { "type": "boolean", "const": true },
    "sourceIdentityConsistent": { "type": "boolean", "const": true },
    "complete": { "type": "boolean", "const": true }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "policyHash",
    "sourceIdentity",
    "sourceTimebase",
    "runtimeGoldInputCount",
    "visibility",
    "semanticHash",
    "artifactType",
    "inventoryHash",
    "hierarchyHash",
    "planningUnitsHash",
    "boundaryPolicyVersion",
    "coverageStatePartitionVersion",
    "units",
    "fullRegistryUnitCount",
    "fullRegistryAtomicIntervalCount",
    "registeredVerifiedSpeechUnionSamples",
    "registeredVerifiedSpeechUnionSeconds",
    "upstreamVerifiedSpeechUnionSamples",
    "upstreamVerifiedSpeechUnionSeconds",
    "unregisteredVerifiedSpeechSamples",
    "registeredVerifiedSpeechCoverageRatio",
    "cueCoveredUnitCount",
    "immutableTargetCoveredUnitCount",
    "existingReviewTargetCoveredUnitCount",
    "uncoveredPlanningUnitCount",
    "partiallyCoveredUnitCount",
    "sourceOrdered",
    "sourceIdentityConsistent",
    "complete"
  ],
  "additionalProperties": false
}
