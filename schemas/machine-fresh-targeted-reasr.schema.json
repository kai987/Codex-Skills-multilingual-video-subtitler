{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-fresh-targeted-reasr.schema.json",
  "title": "machine-fresh-targeted-reasr",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.7-fresh-targeted-reasr-asr-ceiling-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "machine-fresh-targeted-reasr"
    },
    "mode": { "type": "string", "enum": ["off", "observe", "enforce"] },
    "generationKind": {
      "type": "string",
      "enum": ["FRESH_INFERENCE", "FROZEN_EXACT_CACHE_REPLAY"]
    },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sourceSampleRate": { "type": "number", "const": 16000 },
        "sourceTotalSamples": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "readOnly": { "type": "boolean", "const": true }
      },
      "required": [
        "sourceMediaSha256",
        "sourceSampleRate",
        "sourceTotalSamples",
        "readOnly"
      ],
      "additionalProperties": false
    },
    "selectedEvents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eventId": { "type": "string", "minLength": 1 },
          "candidateId": { "type": "string", "minLength": 1 },
          "sourceGlobalInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "selectionEvidenceIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "eventId",
          "candidateId",
          "sourceGlobalInterval",
          "selectionEvidenceIds",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requestId": { "type": "string", "minLength": 1 },
          "requestFamilyId": { "type": "string", "minLength": 1 },
          "eventId": { "type": "string", "minLength": 1 },
          "windowType": {
            "type": "string",
            "enum": ["near-exact", "small-context", "expanded-context"]
          },
          "sourceGlobalSampleInterval": {
            "type": "object",
            "properties": {
              "startSample": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "endSample": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["startSample", "endSample"],
            "additionalProperties": false
          },
          "sourceGlobalInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "extractionIdentity": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "requestIdentity": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "audioSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "sampleCount": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "sampleRate": { "type": "number", "const": 16000 },
          "prompt": { "type": "null" },
          "promptPresent": { "type": "boolean", "const": false },
          "candidateTextPromptLeakCount": { "type": "number", "const": 0 },
          "humanMemoryPromptLeakCount": { "type": "number", "const": 0 },
          "runtimeGoldInputCount": { "type": "number", "const": 0 },
          "cacheNamespace": {
            "type": "string",
            "const": "c6-0-1-7-fresh-targeted-reasr-v1"
          },
          "cacheHit": { "type": "boolean" },
          "inferenceExecuted": { "type": "boolean" },
          "modelLoadCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "processStartCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "transcriptionSeconds": { "type": "number", "minimum": 0 },
          "responseText": { "type": "string" },
          "decoderEvidence": {
            "type": "object",
            "properties": {
              "averageLogProbability": {
                "anyOf": [{ "type": "number" }, { "type": "null" }]
              },
              "noSpeechProbability": {
                "anyOf": [
                  { "type": "number", "minimum": 0, "maximum": 1 },
                  { "type": "null" }
                ]
              },
              "compressionRatio": {
                "anyOf": [
                  { "type": "number", "minimum": 0 },
                  { "type": "null" }
                ]
              },
              "temperature": {
                "anyOf": [
                  { "type": "number", "minimum": 0 },
                  { "type": "null" }
                ]
              },
              "fallbackCount": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  { "type": "null" }
                ]
              },
              "tokenTimestampAvailable": { "type": "boolean" },
              "decoderSegmentCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            },
            "required": [
              "averageLogProbability",
              "noSpeechProbability",
              "compressionRatio",
              "temperature",
              "fallbackCount",
              "tokenTimestampAvailable",
              "decoderSegmentCount",
              "semanticHash"
            ],
            "additionalProperties": false
          },
          "tokens": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tokenId": { "type": "string", "minLength": 1 },
                "text": { "type": "string" },
                "probability": { "type": "number", "minimum": 0, "maximum": 1 },
                "special": { "type": "boolean" },
                "requestLocalInterval": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "start": { "type": "number", "minimum": 0 },
                        "end": { "type": "number", "exclusiveMinimum": 0 }
                      },
                      "required": ["start", "end"],
                      "additionalProperties": false
                    },
                    { "type": "null" }
                  ]
                },
                "sourceGlobalInterval": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "start": { "type": "number", "minimum": 0 },
                        "end": { "type": "number", "exclusiveMinimum": 0 }
                      },
                      "required": ["start", "end"],
                      "additionalProperties": false
                    },
                    { "type": "null" }
                  ]
                },
                "mappingVerified": { "type": "boolean" },
                "semanticHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "tokenId",
                "text",
                "probability",
                "special",
                "requestLocalInterval",
                "sourceGlobalInterval",
                "mappingVerified",
                "semanticHash"
              ],
              "additionalProperties": false
            }
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "requestId",
          "requestFamilyId",
          "eventId",
          "windowType",
          "sourceGlobalSampleInterval",
          "sourceGlobalInterval",
          "extractionIdentity",
          "requestIdentity",
          "audioSha256",
          "sampleCount",
          "sampleRate",
          "prompt",
          "promptPresent",
          "candidateTextPromptLeakCount",
          "humanMemoryPromptLeakCount",
          "runtimeGoldInputCount",
          "cacheNamespace",
          "cacheHit",
          "inferenceExecuted",
          "modelLoadCount",
          "processStartCount",
          "transcriptionSeconds",
          "responseText",
          "decoderEvidence",
          "tokens",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidateId": { "type": "string", "minLength": 1 },
          "eventId": { "type": "string", "minLength": 1 },
          "requestIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "text": { "type": "string", "minLength": 1 },
          "textHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "normalizedTextHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sourceGlobalInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "decoderEvidence": {
            "type": "object",
            "properties": {
              "averageLogProbability": {
                "anyOf": [{ "type": "number" }, { "type": "null" }]
              },
              "noSpeechProbability": {
                "anyOf": [
                  { "type": "number", "minimum": 0, "maximum": 1 },
                  { "type": "null" }
                ]
              },
              "compressionRatio": {
                "anyOf": [
                  { "type": "number", "minimum": 0 },
                  { "type": "null" }
                ]
              },
              "temperature": {
                "anyOf": [
                  { "type": "number", "minimum": 0 },
                  { "type": "null" }
                ]
              },
              "fallbackCount": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  { "type": "null" }
                ]
              },
              "tokenTimestampAvailable": { "type": "boolean" },
              "decoderSegmentCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            },
            "required": [
              "averageLogProbability",
              "noSpeechProbability",
              "compressionRatio",
              "temperature",
              "fallbackCount",
              "tokenTimestampAvailable",
              "decoderSegmentCount",
              "semanticHash"
            ],
            "additionalProperties": false
          },
          "tokenEvidenceIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "globalTokenMappingVerified": { "type": "boolean" },
          "ctcEvidence": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": ["SCORABLE", "UNSCORABLE", "UNAVAILABLE"]
              },
              "score": {
                "anyOf": [
                  { "type": "number", "minimum": 0, "maximum": 1 },
                  { "type": "null" }
                ]
              },
              "evidenceId": {
                "anyOf": [
                  { "type": "string", "minLength": 1 },
                  { "type": "null" }
                ]
              },
              "runtimeIdentityHash": {
                "anyOf": [
                  { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  { "type": "null" }
                ]
              },
              "modelSnapshotHash": {
                "anyOf": [
                  { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  { "type": "null" }
                ]
              },
              "edgePinned": {
                "anyOf": [{ "type": "boolean" }, { "type": "null" }]
              }
            },
            "required": [
              "status",
              "score",
              "evidenceId",
              "runtimeIdentityHash",
              "modelSnapshotHash",
              "edgePinned"
            ],
            "additionalProperties": false
          },
          "requestEdgeEvidence": {
            "type": "object",
            "properties": {
              "severity": {
                "type": "string",
                "enum": ["NONE", "WEAK", "STRONG", "UNKNOWN"]
              },
              "evidenceIds": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "required": ["severity", "evidenceIds"],
            "additionalProperties": false
          },
          "pronunciationProjection": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": ["PROJECTED", "UNSCORABLE"]
              },
              "projectionTextHash": {
                "anyOf": [
                  { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  { "type": "null" }
                ]
              },
              "unresolvedUnits": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "required": ["status", "projectionTextHash", "unresolvedUnits"],
            "additionalProperties": false
          },
          "independentLineageIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "correlatedLineageIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "windowSupportCount": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "evidenceComplete": { "type": "boolean" },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "candidateId",
          "eventId",
          "requestIds",
          "text",
          "textHash",
          "normalizedTextHash",
          "sourceGlobalInterval",
          "decoderEvidence",
          "tokenEvidenceIds",
          "globalTokenMappingVerified",
          "ctcEvidence",
          "requestEdgeEvidence",
          "pronunciationProjection",
          "independentLineageIds",
          "correlatedLineageIds",
          "windowSupportCount",
          "evidenceComplete",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "stableWindowFamilies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "unstableWindowFamilies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "inferenceRuntime": {
      "type": "object",
      "properties": {
        "runtimeType": { "type": "string", "const": "whisper.cpp-mvl" },
        "whisperCppVersion": { "type": "string", "minLength": 1 },
        "runtimeBinarySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "runtimePatchSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "modelSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "modelBasename": { "type": "string", "minLength": 1 },
        "device": { "type": "string", "enum": ["metal", "cpu"] },
        "persistentWorker": { "type": "boolean", "const": true },
        "requestStateIsolation": { "type": "string", "const": "require-safe" }
      },
      "required": [
        "runtimeType",
        "whisperCppVersion",
        "runtimeBinarySha256",
        "runtimePatchSha256",
        "modelSha256",
        "modelBasename",
        "device",
        "persistentWorker",
        "requestStateIsolation"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "selectedEventCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "plannedRequestCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "actualRequestCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "extractionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "uniqueAudioShaCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cacheHitCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "freshInferenceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "modelLoadCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "processStartCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "transcriptionSeconds": { "type": "number", "minimum": 0 },
        "freshCandidateCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "evidenceCompleteCandidateCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "evidenceIncompleteCandidateCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "promptIsolationPassed": { "type": "boolean" },
        "candidateTextPromptLeakCount": { "type": "number", "const": 0 },
        "humanMemoryLeakCount": { "type": "number", "const": 0 },
        "runtimeGoldInputCount": { "type": "number", "const": 0 },
        "networkUsed": { "type": "boolean", "const": false },
        "freshReasrValidationPassed": { "type": "boolean" }
      },
      "required": [
        "selectedEventCount",
        "plannedRequestCount",
        "actualRequestCount",
        "extractionCount",
        "uniqueAudioShaCount",
        "cacheHitCount",
        "freshInferenceCount",
        "modelLoadCount",
        "processStartCount",
        "transcriptionSeconds",
        "freshCandidateCount",
        "evidenceCompleteCandidateCount",
        "evidenceIncompleteCandidateCount",
        "promptIsolationPassed",
        "candidateTextPromptLeakCount",
        "humanMemoryLeakCount",
        "runtimeGoldInputCount",
        "networkUsed",
        "freshReasrValidationPassed"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "mode",
    "generationKind",
    "sourceIdentity",
    "selectedEvents",
    "requests",
    "candidates",
    "stableWindowFamilies",
    "unstableWindowFamilies",
    "inferenceRuntime",
    "summary",
    "semanticHash"
  ],
  "additionalProperties": false
}
