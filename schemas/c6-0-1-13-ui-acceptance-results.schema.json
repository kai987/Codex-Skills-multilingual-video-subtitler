{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-13-ui-acceptance-results.schema.json",
  "title": "c6-0-1-13-ui-acceptance-results",
  "type": "object",
  "properties": {
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "checkId": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["PASSED", "FAILED", "NOT_RUN"]
          },
          "evidence": { "type": "string" }
        },
        "required": ["checkId", "status", "evidence"],
        "additionalProperties": false
      }
    },
    "instrumentationTestStatus": {
      "type": "string",
      "enum": ["PASSED", "FAILED", "NOT_RUN"]
    },
    "datasetSpecificHardcodingCount": {
      "anyOf": [
        { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        { "type": "null" }
      ]
    }
  },
  "required": ["checks", "instrumentationTestStatus"],
  "additionalProperties": false
}
