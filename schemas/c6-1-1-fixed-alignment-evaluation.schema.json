{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-1-1-fixed-alignment-evaluation.schema.json",
  "title": "c6-1-1-fixed-alignment-evaluation",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.1.1-fixed-alignment-selective-existing-mbr-v1"
    },
    "evaluationOnly": { "type": "boolean", "const": true },
    "privacy": { "type": "string", "const": "LOCAL_ONLY" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": {
      "type": "string",
      "const": "c6-1-1-fixed-alignment-evaluation"
    },
    "evaluationMethod": { "type": "string", "const": "FIXED_GROUP_EVALUATION" },
    "errorUnit": {
      "type": "string",
      "const": "GRAPHEME_EDIT_COUNT_UNIQUE_CUE_GROUP"
    },
    "profileId": { "type": "string", "minLength": 1 },
    "fixedMapHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "mappingSemanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "baselineCueHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "shadowCueHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "invariance": {
      "type": "object",
      "properties": {
        "cueIdSetParity": { "type": "boolean" },
        "cueOrderParity": { "type": "boolean" },
        "timingParity": { "type": "boolean" },
        "groupStructureParity": { "type": "boolean" },
        "baselineIdentityParity": { "type": "boolean" },
        "goldIdentityParity": { "type": "boolean" },
        "mappingIntegrityParity": { "type": "boolean" },
        "eligible": { "type": "boolean" },
        "reasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": [
        "cueIdSetParity",
        "cueOrderParity",
        "timingParity",
        "groupStructureParity",
        "baselineIdentityParity",
        "goldIdentityParity",
        "mappingIntegrityParity",
        "eligible",
        "reasons"
      ],
      "additionalProperties": false
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "groupId": { "type": "string", "minLength": 1 },
          "eventIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "cueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "goldCueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "mappingStatus": {
            "type": "string",
            "enum": [
              "FIXED_ONE_TO_ONE",
              "FIXED_ONE_TO_MANY",
              "FIXED_MANY_TO_ONE",
              "FIXED_MANY_TO_MANY",
              "AMBIGUOUS_BASELINE_MAPPING",
              "NO_BASELINE_MAPPING",
              "STRUCTURE_INCOMPATIBLE"
            ]
          },
          "changed": { "type": "boolean" },
          "baselineTextHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "shadowTextHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "baselineExactError": {
            "anyOf": [
              { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              { "type": "null" }
            ]
          },
          "baselineNormalizedError": {
            "anyOf": [
              { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              { "type": "null" }
            ]
          },
          "shadowExactError": {
            "anyOf": [
              { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              { "type": "null" }
            ]
          },
          "shadowNormalizedError": {
            "anyOf": [
              { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              { "type": "null" }
            ]
          },
          "goldExactGraphemeCount": {
            "anyOf": [
              { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              { "type": "null" }
            ]
          },
          "goldNormalizedGraphemeCount": {
            "anyOf": [
              { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              { "type": "null" }
            ]
          },
          "exactGain": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              { "type": "null" }
            ]
          },
          "normalizedGain": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              { "type": "null" }
            ]
          },
          "outcome": {
            "type": "string",
            "enum": ["IMPROVED", "REGRESSED", "NEUTRAL", "UNEVALUABLE"]
          },
          "reasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "groupId",
          "eventIds",
          "cueIds",
          "goldCueIds",
          "mappingStatus",
          "changed",
          "baselineTextHash",
          "shadowTextHash",
          "baselineExactError",
          "baselineNormalizedError",
          "shadowExactError",
          "shadowNormalizedError",
          "goldExactGraphemeCount",
          "goldNormalizedGraphemeCount",
          "exactGain",
          "normalizedGain",
          "outcome",
          "reasons",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "totalCueGroups": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "changedCueGroups": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stableMappedGroups": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ambiguousGroups": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unmappedGroups": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "structureIncompatibleGroups": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fixedMappedChangedGroupCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "evaluableGroups": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "improvedGroups": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "regressedGroups": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "neutralGroups": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unevaluableGroups": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fixedEvaluationCoverage": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "null" }
          ]
        },
        "changedGroupCoverage": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "null" }
          ]
        },
        "baselineExactError": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "baselineNormalizedError": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "shadowExactError": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "shadowNormalizedError": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "exactGain": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "normalizedGain": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "goldExactGraphemeCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "goldNormalizedGraphemeCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "baselineExactCer": {
          "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
        },
        "baselineNormalizedCer": {
          "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
        },
        "shadowExactCer": {
          "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
        },
        "shadowNormalizedCer": {
          "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
        }
      },
      "required": [
        "totalCueGroups",
        "changedCueGroups",
        "stableMappedGroups",
        "ambiguousGroups",
        "unmappedGroups",
        "structureIncompatibleGroups",
        "fixedMappedChangedGroupCount",
        "evaluableGroups",
        "improvedGroups",
        "regressedGroups",
        "neutralGroups",
        "unevaluableGroups",
        "fixedEvaluationCoverage",
        "changedGroupCoverage",
        "baselineExactError",
        "baselineNormalizedError",
        "shadowExactError",
        "shadowNormalizedError",
        "exactGain",
        "normalizedGain",
        "goldExactGraphemeCount",
        "goldNormalizedGraphemeCount",
        "baselineExactCer",
        "baselineNormalizedCer",
        "shadowExactCer",
        "shadowNormalizedCer"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "evaluationOnly",
    "privacy",
    "semanticHash",
    "artifactType",
    "evaluationMethod",
    "errorUnit",
    "profileId",
    "fixedMapHash",
    "mappingSemanticHash",
    "baselineCueHash",
    "shadowCueHash",
    "invariance",
    "groups",
    "summary"
  ],
  "additionalProperties": false
}
