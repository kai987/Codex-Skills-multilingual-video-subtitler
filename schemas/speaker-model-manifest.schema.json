{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/speaker-model-manifest.schema.json",
  "title": "speaker-model-manifest",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": { "type": "string", "const": "speaker-model-manifest" },
    "modelVersion": { "type": "string", "const": "C5.18" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "backend": { "type": "string", "const": "pyannote-community-1" },
    "modelRepo": {
      "type": "string",
      "const": "pyannote/speaker-diarization-community-1"
    },
    "requestedRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "resolvedRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "snapshotDirectory": { "type": "string", "minLength": 1 },
    "modelSnapshotHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "modelFiles": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relativePath": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!\\/)(?![A-Za-z]:[\\\\/])(?!\\\\\\\\).+"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": ["relativePath", "size", "sha256"],
        "additionalProperties": false
      }
    },
    "dependencyModelSnapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "modelRepo": { "type": "string", "minLength": 1 },
          "modelRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "snapshotSubdirectory": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!\\/)(?![A-Za-z]:[\\\\/])(?!\\\\\\\\).+"
          },
          "modelSnapshotHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "files": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "relativePath": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!\\/)(?![A-Za-z]:[\\\\/])(?!\\\\\\\\).+"
                },
                "size": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              },
              "required": ["relativePath", "size", "sha256"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "modelRepo",
          "modelRevision",
          "snapshotSubdirectory",
          "modelSnapshotHash",
          "files"
        ],
        "additionalProperties": false
      }
    },
    "license": { "type": "string", "const": "cc-by-4.0" },
    "citations": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" }
        },
        "required": ["title", "url"],
        "additionalProperties": false
      }
    },
    "networkUsedDuringPreparation": { "type": "boolean" },
    "hfTokenEnvName": { "type": "string", "minLength": 1 },
    "hfTokenStored": { "type": "boolean", "const": false }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "modelVersion",
    "generatedAt",
    "backend",
    "modelRepo",
    "requestedRevision",
    "resolvedRevision",
    "snapshotDirectory",
    "modelSnapshotHash",
    "modelFiles",
    "dependencyModelSnapshots",
    "license",
    "citations",
    "networkUsedDuringPreparation",
    "hfTokenEnvName",
    "hfTokenStored"
  ],
  "additionalProperties": false
}
