{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-speech-safety-coverage-units-v1.schema.json",
  "title": "machine-speech-safety-coverage-units-v1",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14.5-safety-coverage-unit-contract-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "sourceTimebase": {
      "type": "string",
      "const": "SOURCE_GLOBAL_NATIVE_SAMPLES"
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "visibility": { "type": "string", "const": "LOCAL_ONLY" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": {
      "type": "string",
      "const": "machine-speech-safety-coverage-units-v1"
    },
    "hierarchyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "obligationsHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "boundaryPolicyVersion": { "type": "string", "minLength": 1 },
    "mergeGapSamples": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "coverageUnitId": { "type": "string", "minLength": 1 },
          "sourceIdentity": {
            "type": "object",
            "properties": {
              "sourceMediaSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
              "sampleRate": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "audioStreamIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "audioTimebase": {
                "type": "string",
                "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
              },
              "sourceTimebase": {
                "type": "string",
                "const": "SOURCE_GLOBAL_SECONDS"
              }
            },
            "required": [
              "sourceMediaSha256",
              "durationSeconds",
              "sampleRate",
              "audioStreamIndex",
              "audioTimebase",
              "sourceTimebase"
            ],
            "additionalProperties": false
          },
          "atomicNativeIntervals": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "startSample": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "endSample": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["startSample", "endSample"],
              "additionalProperties": false
            }
          },
          "atomicSourceIntervals": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": { "type": "number", "minimum": 0 },
                "end": { "type": "number", "exclusiveMinimum": 0 }
              },
              "required": ["start", "end"],
              "additionalProperties": false
            }
          },
          "coreUnionSamples": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "coreUnionSeconds": { "type": "number", "exclusiveMinimum": 0 },
          "envelopeInterval": {
            "type": "object",
            "properties": {
              "startSample": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "endSample": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["startSample", "endSample"],
            "additionalProperties": false
          },
          "envelopeSeconds": { "type": "number", "exclusiveMinimum": 0 },
          "internalSilenceIntervals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "startSample": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "endSample": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["startSample", "endSample"],
              "additionalProperties": false
            }
          },
          "evidenceAtomIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "childUnitIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "parentClusterIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "detectorFamilies": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "SILERO",
                "PYANNOTE",
                "WEBRTC",
                "LEGACY_FINGERPRINT",
                "EXISTING_VERIFIED",
                "LOCALIZED_LEXICAL"
              ]
            }
          },
          "independentEvidenceFamilies": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "evidenceStrata": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "MULTI_DETECTOR",
                "PYANNOTE_EXCLUSIVE",
                "SILERO_EXCLUSIVE",
                "WEBRTC_EXCLUSIVE",
                "LEGACY_FINGERPRINT_EXCLUSIVE",
                "MULTI_VIEW_SAME_DETECTOR",
                "EXISTING_VERIFIED",
                "MASKED_SUBTHRESHOLD",
                "AUDIT_ONLY"
              ]
            }
          },
          "distinctPcmViewIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "posteriorSummary": {
            "type": "object",
            "properties": {
              "maximum": { "type": "number", "minimum": 0, "maximum": 1 },
              "weightedMean": { "type": "number", "minimum": 0, "maximum": 1 },
              "coveredUnionRatio": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "webRtcBinarySupport": { "type": "boolean" }
            },
            "required": [
              "maximum",
              "weightedMean",
              "coveredUnionRatio",
              "webRtcBinarySupport"
            ],
            "additionalProperties": false
          },
          "phaseAObligationIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "timelineBins": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "sceneIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "candidateIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "strongContradiction": { "type": "boolean" },
          "verifiedTimebase": { "type": "boolean" },
          "existingTargetCoverage": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "existingPlaybackCoverage": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "segmentationFingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "coverageUnitId",
          "sourceIdentity",
          "atomicNativeIntervals",
          "atomicSourceIntervals",
          "coreUnionSamples",
          "coreUnionSeconds",
          "envelopeInterval",
          "envelopeSeconds",
          "internalSilenceIntervals",
          "evidenceAtomIds",
          "childUnitIds",
          "parentClusterIds",
          "detectorFamilies",
          "independentEvidenceFamilies",
          "evidenceStrata",
          "distinctPcmViewIds",
          "posteriorSummary",
          "phaseAObligationIds",
          "timelineBins",
          "sceneIds",
          "candidateIds",
          "strongContradiction",
          "verifiedTimebase",
          "existingTargetCoverage",
          "existingPlaybackCoverage",
          "segmentationFingerprint",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "coverageUnitCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "eligibleCoverageUnitCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sourceOrdered": { "type": "boolean", "const": true },
    "intervalIntegrityPassed": { "type": "boolean", "const": true },
    "sourceIdentityConsistent": { "type": "boolean", "const": true },
    "childPartitionIndependent": { "type": "boolean", "const": true }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "policyHash",
    "sourceIdentity",
    "sourceTimebase",
    "runtimeGoldInputCount",
    "visibility",
    "semanticHash",
    "artifactType",
    "hierarchyHash",
    "obligationsHash",
    "boundaryPolicyVersion",
    "mergeGapSamples",
    "units",
    "coverageUnitCount",
    "eligibleCoverageUnitCount",
    "sourceOrdered",
    "intervalIntegrityPassed",
    "sourceIdentityConsistent",
    "childPartitionIndependent"
  ],
  "additionalProperties": false
}
