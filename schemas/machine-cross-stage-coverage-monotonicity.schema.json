{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-cross-stage-coverage-monotonicity.schema.json",
  "title": "machine-cross-stage-coverage-monotonicity",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14.3-cross-stage-monotonic-safety-selection-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "sourceTimebase": {
      "type": "string",
      "const": "SOURCE_GLOBAL_NATIVE_SAMPLES"
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "visibility": { "type": "string", "const": "LOCAL_ONLY" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": {
      "type": "string",
      "const": "machine-cross-stage-coverage-monotonicity"
    },
    "obligationsHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "finalSelectionHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "obligationCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "obligationNativeSamples": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "finalCoveredNativeSamples": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "uncoveredNativeSamples": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "obligationCoverageRatio": { "type": "number", "minimum": 0, "maximum": 1 },
    "exactTargetRetainedCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "equivalentChildTargetCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "equivalentBundleReplacementCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "supersetCoreCoverageCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "droppedObligationCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "regressedObligationIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "uncoveredNativeIntervals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "startSample": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "endSample": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["startSample", "endSample"],
        "additionalProperties": false
      }
    },
    "roundingCorrectionsApplied": { "type": "number", "const": 0 },
    "monotonicityPassed": { "type": "boolean" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "policyHash",
    "sourceIdentity",
    "sourceTimebase",
    "runtimeGoldInputCount",
    "visibility",
    "semanticHash",
    "artifactType",
    "obligationsHash",
    "finalSelectionHash",
    "obligationCount",
    "obligationNativeSamples",
    "finalCoveredNativeSamples",
    "uncoveredNativeSamples",
    "obligationCoverageRatio",
    "exactTargetRetainedCount",
    "equivalentChildTargetCount",
    "equivalentBundleReplacementCount",
    "supersetCoreCoverageCount",
    "droppedObligationCount",
    "regressedObligationIds",
    "uncoveredNativeIntervals",
    "roundingCorrectionsApplied",
    "monotonicityPassed"
  ],
  "additionalProperties": false
}
