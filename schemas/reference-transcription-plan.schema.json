{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/reference-transcription-plan.schema.json",
  "title": "reference-transcription-plan",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "input": {
      "type": "object",
      "properties": {
        "referencePath": { "type": "string", "minLength": 1 },
        "referenceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "referenceLanguage": {
          "type": "string",
          "enum": ["zh", "zh-Hans", "zh-Hant", "ja", "en", "mixed", "und"]
        },
        "mediaDurationSeconds": { "type": "number", "exclusiveMinimum": 0 }
      },
      "required": [
        "referencePath",
        "referenceSha256",
        "referenceLanguage",
        "mediaDurationSeconds"
      ],
      "additionalProperties": false
    },
    "guidanceMode": { "type": "string", "const": "reference-guided" },
    "configuration": {
      "default": {
        "maximumUnitSeconds": 25,
        "contextSeconds": 1.5,
        "maximumUnitSecondsByContent": {
          "dialogue": 10,
          "narration": 16,
          "lyrics": 25
        },
        "denseAnchorLimit": 4
      },
      "type": "object",
      "properties": {
        "maximumUnitSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 30
        },
        "contextSeconds": { "type": "number", "minimum": 0, "maximum": 2 },
        "maximumUnitSecondsByContent": {
          "default": { "dialogue": 10, "narration": 16, "lyrics": 25 },
          "type": "object",
          "properties": {
            "dialogue": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 30
            },
            "narration": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 30
            },
            "lyrics": { "type": "number", "exclusiveMinimum": 0, "maximum": 30 }
          },
          "required": ["dialogue", "narration", "lyrics"],
          "additionalProperties": false
        },
        "denseAnchorLimit": {
          "default": 4,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "maximumUnitSeconds",
        "contextSeconds",
        "maximumUnitSecondsByContent",
        "denseAnchorLimit"
      ],
      "additionalProperties": false
    },
    "maximumUnitSeconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 30
    },
    "contextSeconds": { "type": "number", "minimum": 0, "maximum": 2 },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "anchorIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "targetInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "extractionInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "expectedCueCount": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "unitSizingPolicy": {
            "default": "normal-dialogue",
            "type": "string",
            "enum": [
              "dense-dialogue",
              "normal-dialogue",
              "narration",
              "noisy-dialogue",
              "singing"
            ]
          },
          "anchorCount": {
            "default": 1,
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "anchorDensity": { "default": 0, "type": "number", "minimum": 0 },
          "targetDurationSeconds": {
            "default": 1,
            "type": "number",
            "exclusiveMinimum": 0
          },
          "contextSeconds": {
            "default": 1.5,
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "sceneId": { "type": "string", "minLength": 1 },
          "sceneLabel": {
            "type": "string",
            "enum": [
              "clean-dialogue",
              "quiet-dialogue",
              "noisy-dialogue",
              "singing",
              "non-speech",
              "unknown"
            ]
          },
          "strategy": {
            "type": "string",
            "enum": [
              "reference-vad",
              "reference-extra-sensitive-vad",
              "reference-vad-plus-no-vad",
              "reference-lyrics",
              "reference-original-text"
            ]
          },
          "reasons": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "referenceTextUsedAsTargetPrompt": {
            "type": "boolean",
            "const": false
          }
        },
        "required": [
          "id",
          "anchorIds",
          "targetInterval",
          "extractionInterval",
          "expectedCueCount",
          "unitSizingPolicy",
          "anchorCount",
          "anchorDensity",
          "targetDurationSeconds",
          "contextSeconds",
          "strategy",
          "reasons",
          "referenceTextUsedAsTargetPrompt"
        ],
        "additionalProperties": false
      }
    },
    "referenceTextUsedAsTargetPrompt": { "type": "boolean", "const": false },
    "fallback": {
      "default": null,
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "input",
    "guidanceMode",
    "configuration",
    "maximumUnitSeconds",
    "contextSeconds",
    "units",
    "referenceTextUsedAsTargetPrompt",
    "fallback"
  ],
  "additionalProperties": false
}
