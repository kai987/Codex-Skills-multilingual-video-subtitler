{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-core-asr-stability.schema.json",
  "title": "machine-core-asr-stability",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.8-core-span-asr-stability-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": { "type": "string", "const": "machine-core-asr-stability" },
    "mode": { "type": "string", "enum": ["off", "observe"] },
    "comparabilitySemanticHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "speakerEvidencePolicy": {
      "type": "string",
      "const": "machine-evidence-only"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eventId": { "type": "string", "minLength": 1 },
          "coreSpanId": { "type": "string", "minLength": 1 },
          "candidateIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "projectedTexts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "candidateId": { "type": "string", "minLength": 1 },
                "text": { "type": "string" },
                "normalizedTextHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": ["candidateId", "text", "normalizedTextHash"],
              "additionalProperties": false
            }
          },
          "fullTexts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "candidateId": { "type": "string", "minLength": 1 },
                "text": { "type": "string" },
                "normalizedTextHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": ["candidateId", "text", "normalizedTextHash"],
              "additionalProperties": false
            }
          },
          "stabilityClass": {
            "type": "string",
            "enum": [
              "CORE_TEXT_CONSISTENT",
              "CONTEXT_ONLY_DIFFERENCE",
              "LEXICAL_CORE_DISAGREEMENT",
              "HALLUCINATION_DISAGREEMENT",
              "ADJACENT_UTTERANCE_CONTAMINATION",
              "SPEAKER_CONTENT_MIX",
              "PARTIAL_CORE_AGREEMENT",
              "UNLOCALIZABLE",
              "UNEVALUABLE"
            ]
          },
          "class": {
            "type": "string",
            "enum": [
              "CORE_TEXT_CONSISTENT",
              "CONTEXT_ONLY_DIFFERENCE",
              "LEXICAL_CORE_DISAGREEMENT",
              "HALLUCINATION_DISAGREEMENT",
              "ADJACENT_UTTERANCE_CONTAMINATION",
              "SPEAKER_CONTENT_MIX",
              "PARTIAL_CORE_AGREEMENT",
              "UNLOCALIZABLE",
              "UNEVALUABLE"
            ]
          },
          "lexicalAgreement": { "type": "number", "minimum": 0, "maximum": 1 },
          "pronunciationAgreement": {
            "anyOf": [
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "null" }
            ]
          },
          "localizationCoverage": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "comparableCandidateIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "distinctCoreTextHashes": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          },
          "stableCoreTextHash": {
            "anyOf": [
              { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              { "type": "null" }
            ]
          },
          "contextDifferenceObserved": { "type": "boolean" },
          "adjacentContaminationObserved": { "type": "boolean" },
          "machineSpeakerMixObserved": { "type": "boolean" },
          "hallucinationEvidenceObserved": { "type": "boolean" },
          "supportingEvidenceIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "blockers": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "eventId",
          "coreSpanId",
          "candidateIds",
          "projectedTexts",
          "fullTexts",
          "stabilityClass",
          "class",
          "lexicalAgreement",
          "pronunciationAgreement",
          "localizationCoverage",
          "comparableCandidateIds",
          "distinctCoreTextHashes",
          "stableCoreTextHash",
          "contextDifferenceObserved",
          "adjacentContaminationObserved",
          "machineSpeakerMixObserved",
          "hallucinationEvidenceObserved",
          "supportingEvidenceIds",
          "blockers",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "eventCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "classCounts": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "CORE_TEXT_CONSISTENT",
              "CONTEXT_ONLY_DIFFERENCE",
              "LEXICAL_CORE_DISAGREEMENT",
              "HALLUCINATION_DISAGREEMENT",
              "ADJACENT_UTTERANCE_CONTAMINATION",
              "SPEAKER_CONTENT_MIX",
              "PARTIAL_CORE_AGREEMENT",
              "UNLOCALIZABLE",
              "UNEVALUABLE"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "required": [
            "CORE_TEXT_CONSISTENT",
            "CONTEXT_ONLY_DIFFERENCE",
            "LEXICAL_CORE_DISAGREEMENT",
            "HALLUCINATION_DISAGREEMENT",
            "ADJACENT_UTTERANCE_CONTAMINATION",
            "SPEAKER_CONTENT_MIX",
            "PARTIAL_CORE_AGREEMENT",
            "UNLOCALIZABLE",
            "UNEVALUABLE"
          ]
        },
        "stableEventCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lexicalInstabilityCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hallucinationInstabilityCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "localizationBlockedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "runtimeGoldInputCount": { "type": "number", "const": 0 }
      },
      "required": [
        "eventCount",
        "classCounts",
        "stableEventCount",
        "lexicalInstabilityCount",
        "hallucinationInstabilityCount",
        "localizationBlockedCount",
        "runtimeGoldInputCount"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "mode",
    "comparabilitySemanticHash",
    "speakerEvidencePolicy",
    "events",
    "summary",
    "semanticHash"
  ],
  "additionalProperties": false
}
