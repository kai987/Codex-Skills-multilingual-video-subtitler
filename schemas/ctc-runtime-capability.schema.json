{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/ctc-runtime-capability.schema.json",
  "title": "ctc-runtime-capability",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": { "type": "string", "const": "ctc-runtime-capability" },
    "runtimeVersion": { "type": "string", "const": "C5.18.1" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "runtimeIdentityHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "backend": { "type": "string", "const": "reazon-wav2vec2-ctc" },
    "runtimeLockHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "modelRepo": {
      "type": "string",
      "const": "reazon-research/japanese-wav2vec2-large-rs35kh"
    },
    "modelRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "modelSnapshotHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "modelFileCount": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "modelFiles": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relativePath": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!\\/)(?![A-Za-z]:[\\\\/])(?!\\\\\\\\).+"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": ["relativePath", "size", "sha256"],
        "additionalProperties": false
      }
    },
    "license": { "type": "string", "const": "Apache-2.0" },
    "citations": {
      "minItems": 1,
      "type": "array",
      "items": { "type": "string", "format": "uri" }
    },
    "architecture": { "type": "string", "const": "Wav2Vec2ForCTC" },
    "processorClass": { "type": "string", "minLength": 1 },
    "modelClass": { "type": "string", "const": "Wav2Vec2ForCTC" },
    "tokenizerClass": { "type": "string", "minLength": 1 },
    "tokenizerVocabularyHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "tokenizerVocabularySize": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "blankTokenId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "padTokenId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "unknownTokenId": {
      "anyOf": [
        { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        { "type": "null" }
      ]
    },
    "pythonVersion": { "type": "string", "minLength": 1 },
    "torchVersion": { "type": "string", "minLength": 1 },
    "transformersVersion": { "type": "string", "minLength": 1 },
    "huggingfaceHubVersion": { "type": "string", "minLength": 1 },
    "safetensorsVersion": { "type": "string", "minLength": 1 },
    "numpyVersion": { "type": "string", "minLength": 1 },
    "soundfileVersion": { "type": "string", "minLength": 1 },
    "frameMapping": {
      "type": "object",
      "properties": {
        "sampleRate": { "type": "number", "const": 16000 },
        "convKernel": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "convStride": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "totalStrideSamples": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "receptiveFieldSamples": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "frameCountFormula": {
          "type": "string",
          "const": "iterated-valid-convolution-v1"
        },
        "frameIntervalPolicy": {
          "type": "string",
          "const": "receptive-field-clipped-v1"
        }
      },
      "required": [
        "sampleRate",
        "convKernel",
        "convStride",
        "totalStrideSamples",
        "receptiveFieldSamples",
        "frameCountFormula",
        "frameIntervalPolicy"
      ],
      "additionalProperties": false
    },
    "sampleRate": { "type": "number", "const": 16000 },
    "ctcAlignmentAlgorithm": {
      "type": "string",
      "const": "mvl-ctc-viterbi-v1"
    },
    "viterbiPolicy": { "type": "string", "const": "mvl-ctc-viterbi-v1" },
    "scoreCalibrationStatus": {
      "type": "string",
      "const": "uncalibrated-ctc-score"
    },
    "torchaudioForcedAlignUsed": { "type": "boolean", "const": false },
    "deviceRequested": { "type": "string", "enum": ["auto", "mps", "cpu"] },
    "deviceUsed": { "type": "string", "enum": ["mps", "cpu"] },
    "fallback": {
      "type": "object",
      "properties": {
        "applied": { "type": "boolean" },
        "from": {
          "anyOf": [{ "type": "string", "const": "mps" }, { "type": "null" }]
        },
        "to": {
          "anyOf": [{ "type": "string", "const": "cpu" }, { "type": "null" }]
        },
        "reason": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        }
      },
      "required": ["applied", "from", "to", "reason"],
      "additionalProperties": false
    },
    "mpsAvailable": { "type": "boolean" },
    "cpuProbePassed": { "type": "boolean" },
    "mpsProbePassed": { "anyOf": [{ "type": "boolean" }, { "type": "null" }] },
    "cpuMpsTokenPathParity": {
      "anyOf": [{ "type": "boolean" }, { "type": "null" }]
    },
    "cpuMpsMaximumBoundaryDeltaSeconds": {
      "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
    },
    "finiteOutputVerified": { "type": "boolean" },
    "frameCountVerified": { "type": "boolean" },
    "targetEncodable": { "type": "boolean" },
    "networkUsedDuringInference": { "type": "boolean", "const": false },
    "runtimePath": { "type": "null" },
    "modelCachePath": { "type": "null" },
    "shareable": { "type": "boolean", "const": true },
    "validationPassed": { "type": "boolean" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "runtimeVersion",
    "generatedAt",
    "runtimeIdentityHash",
    "backend",
    "runtimeLockHash",
    "modelRepo",
    "modelRevision",
    "modelSnapshotHash",
    "modelFileCount",
    "modelFiles",
    "license",
    "citations",
    "architecture",
    "processorClass",
    "modelClass",
    "tokenizerClass",
    "tokenizerVocabularyHash",
    "tokenizerVocabularySize",
    "blankTokenId",
    "padTokenId",
    "unknownTokenId",
    "pythonVersion",
    "torchVersion",
    "transformersVersion",
    "huggingfaceHubVersion",
    "safetensorsVersion",
    "numpyVersion",
    "soundfileVersion",
    "frameMapping",
    "sampleRate",
    "ctcAlignmentAlgorithm",
    "viterbiPolicy",
    "scoreCalibrationStatus",
    "torchaudioForcedAlignUsed",
    "deviceRequested",
    "deviceUsed",
    "fallback",
    "mpsAvailable",
    "cpuProbePassed",
    "mpsProbePassed",
    "cpuMpsTokenPathParity",
    "cpuMpsMaximumBoundaryDeltaSeconds",
    "finiteOutputVerified",
    "frameCountVerified",
    "targetEncodable",
    "networkUsedDuringInference",
    "runtimePath",
    "modelCachePath",
    "shareable",
    "validationPassed",
    "semanticHash"
  ],
  "additionalProperties": false
}
