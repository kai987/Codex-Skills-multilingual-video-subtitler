{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-1-2-report-data.schema.json",
  "title": "c6-1-2-report-data",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": { "type": "string", "const": "c6-1-2-report-data" },
    "policyVersion": {
      "type": "string",
      "const": "c6.1.2-top-k-reranking-acoustic-completeness-v1"
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "validationHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "regressionHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "machineFreezeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rawGoldRead": { "type": "boolean", "const": false },
    "candidateTextReadForReport": { "type": "boolean", "const": false },
    "reportEntries": {
      "minItems": 153,
      "maxItems": 153,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "title": { "type": "string", "minLength": 1 },
          "value": { "type": "string" }
        },
        "required": ["index", "title", "value"],
        "additionalProperties": false
      }
    },
    "replyEntries": {
      "minItems": 150,
      "maxItems": 150,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "title": { "type": "string", "minLength": 1 },
          "value": { "type": "string" }
        },
        "required": ["index", "title", "value"],
        "additionalProperties": false
      }
    },
    "questions": {
      "minItems": 20,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "title": { "type": "string", "minLength": 1 },
          "value": { "type": "string" }
        },
        "required": ["index", "title", "value"],
        "additionalProperties": false
      }
    },
    "codeCommit": { "type": "string", "minLength": 1 },
    "acceptanceCommit": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "policyVersion",
    "semanticHash",
    "validationHash",
    "regressionHash",
    "machineFreezeHash",
    "rawGoldRead",
    "candidateTextReadForReport",
    "reportEntries",
    "replyEntries",
    "questions",
    "codeCommit",
    "acceptanceCommit"
  ],
  "additionalProperties": false
}
