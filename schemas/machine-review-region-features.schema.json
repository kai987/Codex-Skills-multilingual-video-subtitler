{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-review-region-features.schema.json",
  "title": "machine-review-region-features",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.13-region-burden-calibration-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "machine-review-region-features"
    },
    "featureSchemaVersion": {
      "type": "string",
      "const": "c60113-structural-features-v1"
    },
    "featureNames": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "missingSeverity",
          "hallucinationStrength",
          "timingStrength",
          "crossModelConflictStrength",
          "whisperInstability",
          "reazonInstability",
          "acousticMargin",
          "acousticScorability",
          "speechCompleteness",
          "requestEdgeRisk",
          "localizationQuality",
          "independentFamilyCount",
          "correlatedEvidenceCount",
          "affectedCueCount",
          "affectedEventCount",
          "candidateActionableCount",
          "orphanCount",
          "coreDurationSeconds",
          "contextDurationSeconds",
          "chronologicalIncrementalAudioSeconds",
          "neighborContextOverlapSeconds",
          "sceneCount",
          "speakerGroupCount",
          "positiveEvidenceStrength"
        ]
      }
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "goldInputCount": { "type": "number", "const": 0 },
    "rawTextFeatureCount": { "type": "number", "const": 0 },
    "identityPredictorCount": { "type": "number", "const": 0 },
    "absoluteTimePredictorCount": { "type": "number", "const": 0 },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "regionId": { "type": "string", "minLength": 1 },
          "itemIds": { "type": "array", "items": { "type": "string" } },
          "sourceInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "contextInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "sceneIds": { "type": "array", "items": { "type": "string" } },
          "speakerGroupIds": { "type": "array", "items": { "type": "string" } },
          "mandatory": { "type": "boolean" },
          "legacyItemPriority": { "type": "number" },
          "legacyRegionPriority": { "type": "number" },
          "missingCalibratedPriority": { "type": "number" },
          "deterministicRiskUtility": { "type": "number", "minimum": 0 },
          "crossModelDisagreement": { "type": "boolean" },
          "selectorEvidence": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "regionId": { "type": "string", "minLength": 1 },
                  "itemIds": {
                    "minItems": 1,
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "sourceInterval": {
                    "type": "object",
                    "properties": {
                      "start": { "type": "number", "minimum": 0 },
                      "end": { "type": "number", "exclusiveMinimum": 0 }
                    },
                    "required": ["start", "end"],
                    "additionalProperties": false
                  },
                  "contextInterval": {
                    "type": "object",
                    "properties": {
                      "start": { "type": "number", "minimum": 0 },
                      "end": { "type": "number", "exclusiveMinimum": 0 }
                    },
                    "required": ["start", "end"],
                    "additionalProperties": false
                  },
                  "itemRiskSummary": {
                    "type": "object",
                    "properties": {
                      "uniqueAffectedCueCount": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "uniqueEventCount": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "independentRiskGroupCount": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "mandatoryItemCount": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "missingClassifications": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "SPEECH_GAP_OBSERVED",
                            "MISSING_DIALOGUE_POSSIBLE",
                            "MISSING_DIALOGUE_STRONG",
                            "MISSING_DIALOGUE_CONTRADICTED",
                            "MISSING_DIALOGUE_UNRESOLVED"
                          ]
                        }
                      }
                    },
                    "required": [
                      "uniqueAffectedCueCount",
                      "uniqueEventCount",
                      "independentRiskGroupCount",
                      "mandatoryItemCount",
                      "missingClassifications"
                    ],
                    "additionalProperties": false
                  },
                  "independentEvidenceFamilies": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "SPEECH_ACTIVITY",
                        "ASR_LEXICAL_CONTENT",
                        "CUE_COVERAGE",
                        "NEIGHBOR_CONTINUITY",
                        "SPEAKER_ACTIVITY",
                        "CROSS_MODEL_CONTENT",
                        "MUSIC_LYRICS_CONTRADICTION",
                        "LOCALIZATION",
                        "WHISPER_STABILITY",
                        "REAZON_STABILITY",
                        "ACOUSTIC_ALIGNMENT",
                        "DECODER",
                        "TIMING_BOUNDARY",
                        "HALLUCINATION",
                        "OVERLAP",
                        "STRUCTURAL_INTEGRITY"
                      ]
                    }
                  },
                  "mandatoryReasons": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "candidateActionableCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "estimatedUniqueAudioSeconds": {
                    "type": "number",
                    "minimum": 0
                  },
                  "priorityVector": {
                    "type": "object",
                    "properties": {
                      "mandatorySafetyClass": {
                        "type": "string",
                        "enum": [
                          "NONE",
                          "STRONG_HALLUCINATION",
                          "STRONG_MISSING",
                          "STRONG_TIMING",
                          "STRONG_OVERLAP",
                          "STRUCTURAL_CORRUPTION"
                        ]
                      },
                      "positiveEvidenceStrength": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "independentEvidenceFamilyCount": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "errorTypeSeverity": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "crossModelConflictStrength": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "hallucinationStrength": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "missingStrength": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "timingStrength": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "candidateActionability": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "localizationQuality": {
                        "anyOf": [
                          { "type": "number", "minimum": 0, "maximum": 1 },
                          { "type": "null" }
                        ]
                      },
                      "estimatedReviewCost": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "sourceTime": { "type": "number", "minimum": 0 }
                    },
                    "required": [
                      "mandatorySafetyClass",
                      "positiveEvidenceStrength",
                      "independentEvidenceFamilyCount",
                      "errorTypeSeverity",
                      "crossModelConflictStrength",
                      "hallucinationStrength",
                      "missingStrength",
                      "timingStrength",
                      "candidateActionability",
                      "localizationQuality",
                      "estimatedReviewCost",
                      "sourceTime"
                    ],
                    "additionalProperties": false
                  },
                  "rankScore": { "type": "number", "minimum": 0 },
                  "rankPosition": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "riskCoverageKeys": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "actionableCoverageKeys": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "semanticHash": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "regionId",
                  "itemIds",
                  "sourceInterval",
                  "contextInterval",
                  "itemRiskSummary",
                  "independentEvidenceFamilies",
                  "mandatoryReasons",
                  "candidateActionableCount",
                  "estimatedUniqueAudioSeconds",
                  "priorityVector",
                  "rankScore",
                  "rankPosition",
                  "riskCoverageKeys",
                  "actionableCoverageKeys",
                  "semanticHash"
                ],
                "additionalProperties": false
              },
              { "type": "null" }
            ]
          },
          "values": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "missingSeverity",
                "hallucinationStrength",
                "timingStrength",
                "crossModelConflictStrength",
                "whisperInstability",
                "reazonInstability",
                "acousticMargin",
                "acousticScorability",
                "speechCompleteness",
                "requestEdgeRisk",
                "localizationQuality",
                "independentFamilyCount",
                "correlatedEvidenceCount",
                "affectedCueCount",
                "affectedEventCount",
                "candidateActionableCount",
                "orphanCount",
                "coreDurationSeconds",
                "contextDurationSeconds",
                "chronologicalIncrementalAudioSeconds",
                "neighborContextOverlapSeconds",
                "sceneCount",
                "speakerGroupCount",
                "positiveEvidenceStrength"
              ]
            },
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "const": "OBSERVED" },
                    "value": { "type": "number" }
                  },
                  "required": ["status", "value"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "const": "UNKNOWN" },
                    "value": { "type": "null" }
                  },
                  "required": ["status", "value"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "const": "UNAVAILABLE" },
                    "value": { "type": "null" }
                  },
                  "required": ["status", "value"],
                  "additionalProperties": false
                }
              ]
            },
            "required": [
              "missingSeverity",
              "hallucinationStrength",
              "timingStrength",
              "crossModelConflictStrength",
              "whisperInstability",
              "reazonInstability",
              "acousticMargin",
              "acousticScorability",
              "speechCompleteness",
              "requestEdgeRisk",
              "localizationQuality",
              "independentFamilyCount",
              "correlatedEvidenceCount",
              "affectedCueCount",
              "affectedEventCount",
              "candidateActionableCount",
              "orphanCount",
              "coreDurationSeconds",
              "contextDurationSeconds",
              "chronologicalIncrementalAudioSeconds",
              "neighborContextOverlapSeconds",
              "sceneCount",
              "speakerGroupCount",
              "positiveEvidenceStrength"
            ]
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "regionId",
          "itemIds",
          "sourceInterval",
          "contextInterval",
          "sceneIds",
          "speakerGroupIds",
          "mandatory",
          "legacyItemPriority",
          "legacyRegionPriority",
          "missingCalibratedPriority",
          "deterministicRiskUtility",
          "crossModelDisagreement",
          "selectorEvidence",
          "values",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "featureSchemaVersion",
    "featureNames",
    "policyHash",
    "goldInputCount",
    "rawTextFeatureCount",
    "identityPredictorCount",
    "absoluteTimePredictorCount",
    "regions",
    "semanticHash"
  ],
  "additionalProperties": false
}
