{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/speaker-evidence-runtime-capability.schema.json",
  "title": "speaker-evidence-runtime-capability",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "speaker-evidence-runtime-capability"
    },
    "runtimeVersion": { "type": "string", "const": "C5.18" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "backend": { "type": "string", "const": "pyannote-community-1" },
    "pythonVersion": { "type": "string", "minLength": 1 },
    "pyannoteAudioVersion": { "type": "string", "minLength": 1 },
    "torchVersion": { "type": "string", "minLength": 1 },
    "torchaudioVersion": { "type": "string", "minLength": 1 },
    "huggingfaceHubVersion": { "type": "string", "minLength": 1 },
    "numpyVersion": { "type": "string", "minLength": 1 },
    "scipyVersion": { "type": "string", "minLength": 1 },
    "soundfileVersion": { "type": "string", "minLength": 1 },
    "runtimeExplicitSpecSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dependencySpecSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "runtimeIdentityHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "modelRepo": {
      "type": "string",
      "const": "pyannote/speaker-diarization-community-1"
    },
    "modelRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "modelSnapshotHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "modelFiles": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relativePath": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!\\/)(?![A-Za-z]:[\\\\/])(?!\\\\\\\\).+"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": ["relativePath", "size", "sha256"],
        "additionalProperties": false
      }
    },
    "license": { "type": "string", "const": "cc-by-4.0" },
    "citations": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" }
        },
        "required": ["title", "url"],
        "additionalProperties": false
      }
    },
    "dependencyModelSnapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "modelRepo": { "type": "string", "minLength": 1 },
          "modelRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "snapshotSubdirectory": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!\\/)(?![A-Za-z]:[\\\\/])(?!\\\\\\\\).+"
          },
          "modelSnapshotHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "files": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "relativePath": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!\\/)(?![A-Za-z]:[\\\\/])(?!\\\\\\\\).+"
                },
                "size": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              },
              "required": ["relativePath", "size", "sha256"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "modelRepo",
          "modelRevision",
          "snapshotSubdirectory",
          "modelSnapshotHash",
          "files"
        ],
        "additionalProperties": false
      }
    },
    "standardDiarizationAvailable": { "type": "boolean" },
    "exclusiveDiarizationAvailable": { "type": "boolean" },
    "overlapTrackAvailable": { "type": "boolean" },
    "segmentationConfidenceAvailable": { "type": "boolean" },
    "speakerConfidenceAvailable": { "type": "boolean" },
    "confidenceStatus": {
      "type": "string",
      "enum": ["available", "unavailable"]
    },
    "deviceRequested": { "type": "string", "enum": ["auto", "mps", "cpu"] },
    "deviceUsed": { "type": "string", "enum": ["mps", "cpu"] },
    "fallback": {
      "type": "object",
      "properties": {
        "applied": { "type": "boolean" },
        "from": {
          "anyOf": [{ "type": "string", "const": "mps" }, { "type": "null" }]
        },
        "to": {
          "anyOf": [{ "type": "string", "const": "cpu" }, { "type": "null" }]
        },
        "reason": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        }
      },
      "required": ["applied", "from", "to", "reason"],
      "additionalProperties": false
    },
    "mpsAvailable": { "type": "boolean" },
    "allPipelineModulesOnDevice": { "type": "boolean" },
    "finiteOutputVerified": { "type": "boolean" },
    "mpsCpuSemanticComparable": {
      "anyOf": [{ "type": "boolean" }, { "type": "null" }]
    },
    "networkUsedDuringPreparation": { "type": "boolean" },
    "networkUsedDuringInference": { "type": "boolean", "const": false },
    "hfTokenStored": { "type": "boolean", "const": false },
    "runtimePath": { "type": "null" },
    "modelCachePath": { "type": "null" },
    "shareable": { "type": "boolean", "const": true },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "runtimeVersion",
    "generatedAt",
    "backend",
    "pythonVersion",
    "pyannoteAudioVersion",
    "torchVersion",
    "torchaudioVersion",
    "huggingfaceHubVersion",
    "numpyVersion",
    "scipyVersion",
    "soundfileVersion",
    "runtimeExplicitSpecSha256",
    "dependencySpecSha256",
    "runtimeIdentityHash",
    "modelRepo",
    "modelRevision",
    "modelSnapshotHash",
    "modelFiles",
    "license",
    "citations",
    "dependencyModelSnapshots",
    "standardDiarizationAvailable",
    "exclusiveDiarizationAvailable",
    "overlapTrackAvailable",
    "segmentationConfidenceAvailable",
    "speakerConfidenceAvailable",
    "confidenceStatus",
    "deviceRequested",
    "deviceUsed",
    "fallback",
    "mpsAvailable",
    "allPipelineModulesOnDevice",
    "finiteOutputVerified",
    "mpsCpuSemanticComparable",
    "networkUsedDuringPreparation",
    "networkUsedDuringInference",
    "hfTokenStored",
    "runtimePath",
    "modelCachePath",
    "shareable",
    "semanticHash"
  ],
  "additionalProperties": false
}
