{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-1-2-1-1-oversized-component-inventory.schema.json",
  "title": "c6-1-2-1-1-oversized-component-inventory",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "c6-1-2-1-1-oversized-component-inventory"
    },
    "policyVersion": {
      "type": "string",
      "const": "c6.1.2.1.1-constrained-monotonic-partition-reachable-evaluation-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "e2MapHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "edgeLedgerHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "goldTimingHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "parentE2SupergroupId": { "type": "string", "minLength": 1 },
          "machineGroupIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "machineCueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "goldCueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "edgeIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "bilateral": { "type": "boolean" },
          "alreadyBounded": { "type": "boolean" },
          "attempted": { "type": "boolean" },
          "oversized": { "type": "boolean" },
          "pureLowCoverage": { "type": "boolean" },
          "durationSeconds": { "type": "number", "minimum": 0 },
          "machineCueCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "goldCueCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "frozenFoldIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "reasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "parentE2SupergroupId",
          "machineGroupIds",
          "machineCueIds",
          "goldCueIds",
          "edgeIds",
          "bilateral",
          "alreadyBounded",
          "attempted",
          "oversized",
          "pureLowCoverage",
          "durationSeconds",
          "machineCueCount",
          "goldCueCount",
          "frozenFoldIds",
          "reasons",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "e2Edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "edgeId": { "type": "string", "minLength": 1 },
          "machineGroupId": { "type": "string", "minLength": 1 },
          "machineCueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "goldCueId": { "type": "string", "minLength": 1 },
          "overlapStart": { "type": "number" },
          "overlapEnd": { "type": "number" },
          "overlapSeconds": { "type": "number", "exclusiveMinimum": 0 },
          "overlapIntervals": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": { "type": "number" },
                "end": { "type": "number" }
              },
              "required": ["start", "end"],
              "additionalProperties": false
            }
          },
          "machineIntersectionRatio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "goldIntersectionRatio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "edgeType": {
            "type": "string",
            "const": "STRICT_POSITIVE_TEMPORAL_OVERLAP"
          },
          "goldTextUsed": { "type": "boolean", "const": false },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "edgeId",
          "machineGroupId",
          "machineCueIds",
          "goldCueId",
          "overlapStart",
          "overlapEnd",
          "overlapSeconds",
          "overlapIntervals",
          "machineIntersectionRatio",
          "goldIntersectionRatio",
          "edgeType",
          "goldTextUsed",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "reasonCounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reason": { "type": "string", "minLength": 1 },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["reason", "count"],
        "additionalProperties": false
      }
    },
    "goldTextUsedForPartitionCount": { "type": "number", "const": 0 }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "policyVersion",
    "policyHash",
    "semanticHash",
    "e2MapHash",
    "edgeLedgerHash",
    "goldTimingHash",
    "rows",
    "e2Edges",
    "reasonCounts",
    "goldTextUsedForPartitionCount"
  ],
  "additionalProperties": false
}
