{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-8-route-decision.schema.json",
  "title": "c6-0-1-8-route-decision",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.8-core-span-asr-stability-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": { "type": "string", "const": "c6-0-1-8-route-decision" },
    "decision": {
      "type": "string",
      "enum": [
        "CONTINUE_FINAL_PIPELINE_APPLICATION",
        "RECOMMEND_SECOND_ASR_ENSEMBLE",
        "MIXED_PIPELINE_AND_ASR",
        "INSUFFICIENT_LOCAL_COMPARABILITY",
        "GO_C6_0_2"
      ]
    },
    "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
    "recommendation": {
      "type": "string",
      "enum": [
        "STOP_SINGLE_WHISPER_RULE_EXPANSION",
        "ONE_SMALL_FINAL_PIPELINE_APPLICATION",
        "RESOLVE_MINIMAL_LOCALIZATION_BLOCKER",
        "ADVANCE_TO_C6_0_2"
      ]
    },
    "supportingCounts": {
      "type": "object",
      "properties": {
        "evaluableEventCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "coreComparableEventCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pipelineLimitedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "asrLimitedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "localizationBlockedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "referenceBlockedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "oracleImprovedEventCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "evaluableEventCount",
        "coreComparableEventCount",
        "pipelineLimitedCount",
        "asrLimitedCount",
        "localizationBlockedCount",
        "referenceBlockedCount",
        "oracleImprovedEventCount"
      ],
      "additionalProperties": false
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "strictC602QualityGatePassed": { "type": "boolean" },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "releaseAuthorized": { "type": "boolean", "const": false },
    "productionStatus": { "type": "string", "const": "needs-review" },
    "finalizationMethod": { "type": "string", "const": "none" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "decision",
    "confidence",
    "recommendation",
    "supportingCounts",
    "blockers",
    "strictC602QualityGatePassed",
    "runtimeGoldInputCount",
    "releaseAuthorized",
    "productionStatus",
    "finalizationMethod",
    "semanticHash"
  ],
  "additionalProperties": false
}
