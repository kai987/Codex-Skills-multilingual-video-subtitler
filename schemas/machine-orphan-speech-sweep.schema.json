{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-orphan-speech-sweep.schema.json",
  "title": "machine-orphan-speech-sweep",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14-missing-localization-playback-integrity-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "artifactType": { "type": "string", "const": "orphan-speech-sweep" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "orphanId": { "type": "string", "minLength": 1 },
          "sourceIslandId": { "type": "string", "minLength": 1 },
          "sourceInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "classification": {
            "type": "string",
            "enum": [
              "ORPHAN_SPEECH_OBSERVED",
              "ORPHAN_LEXICAL_POSSIBLE",
              "ORPHAN_MULTI_SOURCE_CONFIRMED",
              "COVERED_BY_CUE",
              "COVERED_BY_TARGET",
              "NON_SPEECH_CONTRADICTED",
              "UNVERIFIED"
            ]
          },
          "evidenceIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "rootLineageIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "correlationGroups": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "independentSourceCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "lexicalEvidenceIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "reliableLocalizedLexical": { "type": "boolean" },
          "speechPositive": { "type": "boolean" },
          "strongContradiction": { "type": "boolean" },
          "durationStatus": {
            "type": "string",
            "enum": ["BOUNDED", "TOO_SHORT", "TOO_LONG"]
          },
          "cueCoveredRatio": { "type": "number", "minimum": 0, "maximum": 1 },
          "targetCoveredRatio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "coveredByCueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "coveredByTargetIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "reasons": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "orphanId",
          "sourceIslandId",
          "sourceInterval",
          "classification",
          "evidenceIds",
          "rootLineageIds",
          "correlationGroups",
          "independentSourceCount",
          "lexicalEvidenceIds",
          "reliableLocalizedLexical",
          "speechPositive",
          "strongContradiction",
          "durationStatus",
          "cueCoveredRatio",
          "targetCoveredRatio",
          "coveredByCueIds",
          "coveredByTargetIds",
          "reasons",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "entryCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "orphanCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "coveredByCueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "coveredByTargetCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "contradictedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unverifiedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fullMediaAsrRequestCount": { "type": "number", "const": 0 }
      },
      "required": [
        "entryCount",
        "orphanCount",
        "coveredByCueCount",
        "coveredByTargetCount",
        "contradictedCount",
        "unverifiedCount",
        "fullMediaAsrRequestCount"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "policyHash",
    "sourceIdentity",
    "sourceTimebase",
    "runtimeGoldInputCount",
    "artifactType",
    "entries",
    "summary",
    "semanticHash"
  ],
  "additionalProperties": false
}
