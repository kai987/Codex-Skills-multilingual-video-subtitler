{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-target-bundle-dominance-ledger.schema.json",
  "title": "machine-target-bundle-dominance-ledger",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14.3-cross-stage-monotonic-safety-selection-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "sourceTimebase": {
      "type": "string",
      "const": "SOURCE_GLOBAL_NATIVE_SAMPLES"
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "visibility": { "type": "string", "const": "LOCAL_ONLY" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": {
      "type": "string",
      "const": "machine-target-bundle-dominance-ledger"
    },
    "candidatesHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "retainedBundleIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dominatedBundleId": { "type": "string", "minLength": 1 },
          "dominatingBundleId": { "type": "string", "minLength": 1 },
          "reason": {
            "type": "string",
            "const": "SAME_OR_SUPERSET_CORE_NO_GREATER_COST_NO_LESS_DIVERSITY"
          },
          "comparisonHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "dominatedBundleId",
          "dominatingBundleId",
          "reason",
          "comparisonHash"
        ],
        "additionalProperties": false
      }
    },
    "dominatedBundleCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "policyHash",
    "sourceIdentity",
    "sourceTimebase",
    "runtimeGoldInputCount",
    "visibility",
    "semanticHash",
    "artifactType",
    "candidatesHash",
    "retainedBundleIds",
    "entries",
    "dominatedBundleCount"
  ],
  "additionalProperties": false
}
