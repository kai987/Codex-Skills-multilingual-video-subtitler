{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-raw-asr-event-recovery.schema.json",
  "title": "machine-raw-asr-event-recovery",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.5-evidence-to-canonical-raw-asr-recovery-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "machine-raw-asr-event-recovery"
    },
    "mode": { "type": "string", "enum": ["off", "observe", "enforce"] },
    "maximumRequestsPerEvent": { "type": "number", "const": 3 },
    "episodeRequestBudget": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eventId": { "type": "string", "minLength": 1 },
          "triggerReasons": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "requestIds": {
            "maxItems": 3,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "requestFamilyIds": {
            "maxItems": 3,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "sourceGlobalVerified": { "type": "boolean" },
          "candidateTextPromptUsed": { "type": "boolean", "const": false },
          "requestsExecuted": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "cacheHitCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "inferenceCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "modelLoadCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "newCandidateIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "evaluatedCandidateIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "selectedCandidateId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "eventId",
          "triggerReasons",
          "requestIds",
          "requestFamilyIds",
          "sourceGlobalVerified",
          "candidateTextPromptUsed",
          "requestsExecuted",
          "cacheHitCount",
          "inferenceCount",
          "modelLoadCount",
          "newCandidateIds",
          "evaluatedCandidateIds",
          "selectedCandidateId",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "suspiciousSingleVariantCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "triggeredSingleVariantCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "multiVariantTriggeredCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "requestCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cacheHitCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inferenceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "modelLoadCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "workerStartCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "newCandidateCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "improvedPoolRuntimeProxyCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "replacedByReAsrCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unresolvedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "suspiciousSingleVariantCount",
        "triggeredSingleVariantCount",
        "multiVariantTriggeredCount",
        "requestCount",
        "cacheHitCount",
        "inferenceCount",
        "modelLoadCount",
        "workerStartCount",
        "newCandidateCount",
        "improvedPoolRuntimeProxyCount",
        "replacedByReAsrCount",
        "unresolvedCount"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "mode",
    "maximumRequestsPerEvent",
    "episodeRequestBudget",
    "events",
    "summary",
    "semanticHash"
  ],
  "additionalProperties": false
}
