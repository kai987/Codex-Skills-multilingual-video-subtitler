{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-candidate-pool-sufficiency.schema.json",
  "title": "machine-candidate-pool-sufficiency",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.4-vad-timebase-acoustic-text-variant-reasr-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "machine-candidate-pool-sufficiency"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eventId": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["SUFFICIENT", "AMBIGUOUS", "INSUFFICIENT", "UNKNOWN"]
          },
          "signals": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ALL_CTC_COVERAGE_LOW",
                "TRUSTED_TOKEN_CONFLICT",
                "HIGH_EDGE_TRUNCATION",
                "INDEPENDENT_WINDOW_DISAGREEMENT",
                "NO_FULL_SPEECH_SPAN_COVERAGE",
                "UNSTABLE_REASR_OUTPUT",
                "CLEAR_ACOUSTIC_WINNER",
                "SINGLE_VARIANT_NO_INDEPENDENT_SUPPORT"
              ]
            }
          },
          "reasons": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": ["eventId", "status", "signals", "reasons", "semanticHash"],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "eventCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sufficientCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ambiguousCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "insufficientCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unknownCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "eventCount",
        "sufficientCount",
        "ambiguousCount",
        "insufficientCount",
        "unknownCount"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "events",
    "summary",
    "semanticHash"
  ],
  "additionalProperties": false
}
