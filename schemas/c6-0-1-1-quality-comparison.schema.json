{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-1-quality-comparison.schema.json",
  "title": "c6-0-1-1-quality-comparison",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.1-machine-quality-recovery-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "c6-0-1-1-quality-comparison"
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "runId": { "type": "string" },
          "profile": {
            "type": "string",
            "enum": ["legacy", "diagnostics", "coverage", "timing", "full"]
          },
          "metrics": {
            "type": "object",
            "properties": {
              "cueCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "normalizedCer": { "type": "number", "minimum": 0 },
              "speechCoverage": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "missingDialogueCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "materialTextDefectCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "severeTimingDefectCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "startMaeSeconds": { "type": "number", "minimum": 0 },
              "endMaeSeconds": { "type": "number", "minimum": 0 },
              "p95BoundaryErrorSeconds": { "type": "number", "minimum": 0 },
              "hallucinationCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "p1DefectCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "cueCount",
              "normalizedCer",
              "speechCoverage",
              "missingDialogueCount",
              "materialTextDefectCount",
              "severeTimingDefectCount",
              "startMaeSeconds",
              "endMaeSeconds",
              "p95BoundaryErrorSeconds",
              "hallucinationCount",
              "p1DefectCount"
            ],
            "additionalProperties": false
          },
          "runtimeGoldInputCount": { "type": "number", "const": 0 },
          "machineArtifactHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "runId",
          "profile",
          "metrics",
          "runtimeGoldInputCount",
          "machineArtifactHash"
        ],
        "additionalProperties": false
      }
    },
    "deterministicRanking": { "type": "array", "items": { "type": "string" } },
    "selectedRunId": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "selectionReasons": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "runs",
    "deterministicRanking",
    "selectedRunId",
    "selectionReasons"
  ],
  "additionalProperties": false
}
