{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/gold-c6-1-2-1-evaluation-character-counts.schema.json",
  "title": "gold-c6-1-2-1-evaluation-character-counts",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "gold-c6-1-2-1-evaluation-character-counts"
    },
    "policyVersion": {
      "type": "string",
      "const": "c6.1.2.1-gold-isolated-supergroup-evaluation-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "supergroupMapHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "goldByteHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "goldCueId": { "type": "string", "minLength": 1 },
          "exactGraphemes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "normalizedGraphemes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["goldCueId", "exactGraphemes", "normalizedGraphemes"],
        "additionalProperties": false
      }
    },
    "rawGoldTextIncluded": { "type": "boolean", "const": false },
    "groupingInput": { "type": "boolean", "const": false }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "policyVersion",
    "policyHash",
    "semanticHash",
    "supergroupMapHash",
    "goldByteHash",
    "rows",
    "rawGoldTextIncluded",
    "groupingInput"
  ],
  "additionalProperties": false
}
