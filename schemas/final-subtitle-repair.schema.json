{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/final-subtitle-repair.schema.json",
  "title": "final-subtitle-repair",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "inputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "outputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "repairs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "findingCode": {
            "type": "string",
            "enum": [
              "CROSS_CUE_EXACT_DUPLICATE",
              "CROSS_CUE_SENTENCE_LOOP",
              "CROSS_CUE_LONG_PHRASE_LOOP",
              "SUBTITLE_OVERLAP",
              "UNSUPPORTED_LONG_CUE"
            ]
          },
          "strategy": {
            "type": "string",
            "enum": [
              "overlap-deduplicated",
              "overlap-alternative-selected",
              "overlap-trimmed",
              "overlap-merged",
              "long-cue-split",
              "supported-long-cue",
              "loop-boundary-trimmed",
              "loop-duplicate-block-removed",
              "unresolved"
            ]
          },
          "sourceCueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "outputCueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "beforeInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "afterIntervals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": { "type": "number", "minimum": 0 },
                "end": { "type": "number", "exclusiveMinimum": 0 }
              },
              "required": ["start", "end"],
              "additionalProperties": false
            }
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "result": {
            "type": "string",
            "enum": ["repaired", "supported", "unresolved"]
          }
        },
        "required": [
          "id",
          "findingCode",
          "strategy",
          "sourceCueIds",
          "outputCueIds",
          "beforeInterval",
          "afterIntervals",
          "evidence",
          "result"
        ],
        "additionalProperties": false
      }
    },
    "supportedLongCueIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "summary": {
      "type": "object",
      "properties": {
        "overlapFindingCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "overlapDeduplicatedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "overlapTrimmedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "overlapMergedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "overlapUnresolvedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "longCueSplitCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "supportedLongCueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "loopBoundaryTrimCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "loopDuplicateBlockRemovedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "restoredCueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "quarantinedAfterRepairCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "overlapFindingCount",
        "overlapDeduplicatedCount",
        "overlapTrimmedCount",
        "overlapMergedCount",
        "overlapUnresolvedCount",
        "longCueSplitCount",
        "supportedLongCueCount",
        "loopBoundaryTrimCount",
        "loopDuplicateBlockRemovedCount",
        "restoredCueCount",
        "quarantinedAfterRepairCount"
      ],
      "additionalProperties": false
    },
    "fallback": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "inputHash",
    "outputHash",
    "repairs",
    "supportedLongCueIds",
    "summary",
    "fallback"
  ],
  "additionalProperties": false
}
