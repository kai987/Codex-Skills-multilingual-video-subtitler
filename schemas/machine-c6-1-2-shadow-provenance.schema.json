{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-c6-1-2-shadow-provenance.schema.json",
  "title": "machine-c6-1-2-shadow-provenance",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "machine-c6-1-2-shadow-provenance"
    },
    "policyVersion": {
      "type": "string",
      "const": "c6.1.2-top-k-reranking-acoustic-completeness-v1"
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "universeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "profileId": { "type": "string", "minLength": 1 },
          "eventId": { "type": "string", "minLength": 1 },
          "candidateId": { "type": "string", "minLength": 1 },
          "candidateTextHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "provenanceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "originalWholeCandidate": { "type": "boolean", "const": true }
        },
        "required": [
          "profileId",
          "eventId",
          "candidateId",
          "candidateTextHash",
          "provenanceHash",
          "originalWholeCandidate"
        ],
        "additionalProperties": false
      }
    },
    "novelCandidateCount": { "type": "number", "const": 0 }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "policyVersion",
    "semanticHash",
    "universeHash",
    "rows",
    "novelCandidateCount"
  ],
  "additionalProperties": false
}
