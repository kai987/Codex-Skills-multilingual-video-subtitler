{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-12-machine-review-audio-manifest.schema.json",
  "title": "c6-0-1-12-machine-review-audio-manifest",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.12-multi-asr-review-assistance-v2"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "c6-0-1-12-review-audio-manifest"
    },
    "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "extractionPolicy": {
      "type": "string",
      "const": "region-core-plus-two-second-context-pcm-s16le-16khz-mono-v1"
    },
    "ffmpegIdentity": { "type": "string", "minLength": 1 },
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "regionId": { "type": "string", "minLength": 1 },
          "itemIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "relativePath": { "type": "string", "minLength": 1 },
          "requestedInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "extractedInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "coreInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "coreOffsetSeconds": { "type": "number", "minimum": 0 },
          "coreDurationSeconds": { "type": "number", "exclusiveMinimum": 0 },
          "actualDurationSeconds": { "type": "number", "exclusiveMinimum": 0 },
          "sampleRate": { "type": "number", "const": 16000 },
          "channelCount": { "type": "number", "const": 1 },
          "bitsPerSample": { "type": "number", "const": 16 },
          "frameCount": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "playable": { "type": "boolean", "const": true },
          "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "regionId",
          "itemIds",
          "relativePath",
          "requestedInterval",
          "extractedInterval",
          "coreInterval",
          "coreOffsetSeconds",
          "coreDurationSeconds",
          "actualDurationSeconds",
          "sampleRate",
          "channelCount",
          "bitsPerSample",
          "frameCount",
          "sha256",
          "playable",
          "sourceMediaSha256"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "regionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "generatedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "playableCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failedCount": { "type": "number", "const": 0 },
        "totalAudioSeconds": { "type": "number", "minimum": 0 },
        "asrInferenceCount": { "type": "number", "const": 0 },
        "networkUsed": { "type": "boolean", "const": false }
      },
      "required": [
        "regionCount",
        "generatedCount",
        "playableCount",
        "failedCount",
        "totalAudioSeconds",
        "asrInferenceCount",
        "networkUsed"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "sourceMediaSha256",
    "extractionPolicy",
    "ffmpegIdentity",
    "clips",
    "summary",
    "semanticHash"
  ],
  "additionalProperties": false
}
