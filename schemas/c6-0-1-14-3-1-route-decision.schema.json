{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-14-3-1-route-decision.schema.json",
  "title": "c6-0-1-14-3-1-route-decision",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14.3.1-projection-hash-integrity-v1"
    },
    "visibility": { "type": "string", "const": "LOCAL_ONLY" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": {
      "type": "string",
      "const": "c6-0-1-14-3-1-route-decision"
    },
    "primaryDecision": {
      "type": "string",
      "enum": [
        "GO_C6_0_1_15_REGION_RANKER_RECALIBRATION",
        "HOLD_FOR_PROJECTION_HASH_INTEGRITY_REPAIR",
        "HOLD_FOR_NESTED_SEMANTIC_INTEGRITY_REPAIR",
        "HOLD_FOR_EVALUATION_INTEGRITY_REPAIR",
        "HOLD_FOR_HIERARCHICAL_TARGET_SELECTION_REPAIR",
        "HOLD_FOR_REVIEW_AUDIO_COVERAGE_REPAIR",
        "HOLD_FOR_ENGINEERING_REPAIR"
      ]
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "projectionHashIntegrityPassed": { "type": "boolean" },
    "nestedSemanticIntegrityPassed": { "type": "boolean" },
    "evaluationIntegrityPassed": { "type": "boolean" },
    "engineeringPassed": { "type": "boolean" },
    "plannerPassed": { "type": "boolean" },
    "finalTargetCoveragePassed": { "type": "boolean" },
    "reviewAudioCoveragePassed": { "type": "boolean" },
    "playbackCoveragePassed": { "type": "boolean" },
    "missingPlaybackAudible": {
      "type": "object",
      "properties": {
        "covered": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["covered", "total"],
      "additionalProperties": false
    },
    "hallucinationPlaybackAudible": {
      "type": "object",
      "properties": {
        "covered": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["covered", "total"],
      "additionalProperties": false
    },
    "inferenceCount": { "type": "number", "const": 0 },
    "modelLoadCount": { "type": "number", "const": 0 },
    "providerProcessStartCount": { "type": "number", "const": 0 },
    "canonicalTextMutationCount": { "type": "number", "const": 0 },
    "canonicalTimingMutationCount": { "type": "number", "const": 0 },
    "productionStatus": { "type": "string", "const": "needs-review" },
    "finalizationMethod": { "type": "string", "const": "none" },
    "c602Status": { "type": "string", "const": "HOLD" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "visibility",
    "semanticHash",
    "artifactType",
    "primaryDecision",
    "blockers",
    "projectionHashIntegrityPassed",
    "nestedSemanticIntegrityPassed",
    "evaluationIntegrityPassed",
    "engineeringPassed",
    "plannerPassed",
    "finalTargetCoveragePassed",
    "reviewAudioCoveragePassed",
    "playbackCoveragePassed",
    "missingPlaybackAudible",
    "hallucinationPlaybackAudible",
    "inferenceCount",
    "modelLoadCount",
    "providerProcessStartCount",
    "canonicalTextMutationCount",
    "canonicalTimingMutationCount",
    "productionStatus",
    "finalizationMethod",
    "c602Status"
  ],
  "additionalProperties": false
}
