{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-1-2-1-1-evaluator-sensitivity.schema.json",
  "title": "c6-1-2-1-1-evaluator-sensitivity",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "c6-1-2-1-1-evaluator-sensitivity"
    },
    "policyVersion": {
      "type": "string",
      "const": "c6.1.2.1.1-constrained-monotonic-partition-reachable-evaluation-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evaluator": {
            "type": "string",
            "enum": ["E0", "E1", "E2", "E3", "E4"]
          },
          "profileId": { "type": "string", "minLength": 1 },
          "track": { "type": "string", "minLength": 1 },
          "changedUnits": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "improved": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "regressed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "neutral": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "unknown": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "normalizedJointGain": {
            "anyOf": [{ "type": "number" }, { "type": "null" }]
          },
          "materialDelta": {
            "anyOf": [{ "type": "number" }, { "type": "null" }]
          },
          "catastrophic": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "folds": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "foldId": { "type": "string", "minLength": 1 },
                "changed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "evaluated": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "improved": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "regressed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "neutral": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "unknown": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "normalizedJointGain": {
                  "anyOf": [{ "type": "number" }, { "type": "null" }]
                }
              },
              "required": [
                "foldId",
                "changed",
                "evaluated",
                "improved",
                "regressed",
                "neutral",
                "unknown",
                "normalizedJointGain"
              ],
              "additionalProperties": false
            }
          },
          "diagnosticOnly": { "type": "boolean" }
        },
        "required": [
          "evaluator",
          "profileId",
          "track",
          "changedUnits",
          "improved",
          "regressed",
          "neutral",
          "unknown",
          "normalizedJointGain",
          "materialDelta",
          "catastrophic",
          "folds",
          "diagnosticOnly"
        ],
        "additionalProperties": false
      }
    },
    "coverageRows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evaluator": {
            "type": "string",
            "enum": ["E0", "E1", "E2", "E3", "E4"]
          },
          "machineGroupCoverage": {
            "type": "object",
            "properties": {
              "numerator": { "type": "number", "minimum": 0 },
              "denominator": { "type": "number", "minimum": 0 },
              "ratio": {
                "anyOf": [
                  { "type": "number", "minimum": 0, "maximum": 1 },
                  { "type": "null" }
                ]
              }
            },
            "required": ["numerator", "denominator", "ratio"],
            "additionalProperties": false
          },
          "productionCueCoverage": {
            "type": "object",
            "properties": {
              "numerator": { "type": "number", "minimum": 0 },
              "denominator": { "type": "number", "minimum": 0 },
              "ratio": {
                "anyOf": [
                  { "type": "number", "minimum": 0, "maximum": 1 },
                  { "type": "null" }
                ]
              }
            },
            "required": ["numerator", "denominator", "ratio"],
            "additionalProperties": false
          },
          "globalGoldCoverage": {
            "type": "object",
            "properties": {
              "numerator": { "type": "number", "minimum": 0 },
              "denominator": { "type": "number", "minimum": 0 },
              "ratio": {
                "anyOf": [
                  { "type": "number", "minimum": 0, "maximum": 1 },
                  { "type": "null" }
                ]
              }
            },
            "required": ["numerator", "denominator", "ratio"],
            "additionalProperties": false
          },
          "reachableGoldCoverage": {
            "type": "object",
            "properties": {
              "numerator": { "type": "number", "minimum": 0 },
              "denominator": { "type": "number", "minimum": 0 },
              "ratio": {
                "anyOf": [
                  { "type": "number", "minimum": 0, "maximum": 1 },
                  { "type": "null" }
                ]
              }
            },
            "required": ["numerator", "denominator", "ratio"],
            "additionalProperties": false
          },
          "candidateEventLabelCoverage": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "numerator": { "type": "number", "minimum": 0 },
                  "denominator": { "type": "number", "minimum": 0 },
                  "ratio": {
                    "anyOf": [
                      { "type": "number", "minimum": 0, "maximum": 1 },
                      { "type": "null" }
                    ]
                  }
                },
                "required": ["numerator", "denominator", "ratio"],
                "additionalProperties": false
              },
              { "type": "null" }
            ]
          },
          "topKCandidateLabelCoverage": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "numerator": { "type": "number", "minimum": 0 },
                  "denominator": { "type": "number", "minimum": 0 },
                  "ratio": {
                    "anyOf": [
                      { "type": "number", "minimum": 0, "maximum": 1 },
                      { "type": "null" }
                    ]
                  }
                },
                "required": ["numerator", "denominator", "ratio"],
                "additionalProperties": false
              },
              { "type": "null" }
            ]
          }
        },
        "required": [
          "evaluator",
          "machineGroupCoverage",
          "productionCueCoverage",
          "globalGoldCoverage",
          "reachableGoldCoverage",
          "candidateEventLabelCoverage",
          "topKCandidateLabelCoverage"
        ],
        "additionalProperties": false
      }
    },
    "primaryEvaluator": { "type": "string", "const": "E3" }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "policyVersion",
    "policyHash",
    "semanticHash",
    "rows",
    "coverageRows",
    "primaryEvaluator"
  ],
  "additionalProperties": false
}
