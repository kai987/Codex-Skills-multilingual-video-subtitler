{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-c6-0-1-14-2-detector-plan.schema.json",
  "title": "machine-c6-0-1-14-2-detector-plan",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14.2-safety-selection-detector-ceiling-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "sourceTimebase": {
      "type": "string",
      "const": "SOURCE_GLOBAL_NATIVE_SAMPLES"
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "visibility": { "type": "string", "const": "LOCAL_ONLY" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": {
      "type": "string",
      "const": "machine-c6-0-1-14-2-detector-plan"
    },
    "phaseAHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "audioViewsHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "viewAuditHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "independentRuntimeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "frozenAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "jobs": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "runId": { "type": "string", "minLength": 1 },
          "cacheKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "family": {
            "type": "string",
            "enum": ["SILERO", "PYANNOTE", "WEBRTC"]
          },
          "viewId": { "type": "string", "minLength": 1 },
          "viewRole": {
            "type": "string",
            "enum": [
              "NATIVE_MONO",
              "LEFT",
              "RIGHT",
              "CENTER_OR_MID",
              "VOICE_BAND_CENTER",
              "DIALOGUE_COMPRESSED_MID_V2",
              "PREEMPHASIS_VOICE_BAND_V1",
              "LIGHT_DENOISED_CENTER_V1"
            ]
          },
          "pcmSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "audioSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "frameCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "timeMapping": {
            "type": "object",
            "properties": {
              "sourceStartSample": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "sourceSampleRate": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "outputSampleRate": { "type": "number", "const": 16000 },
              "numerator": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "denominator": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "outputStartSample": { "type": "number", "const": 0 },
              "mappingStatus": {
                "type": "string",
                "const": "VERIFIED_INTEGER_RATIONAL"
              },
              "measuredImpulsePeakDelaySamples": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "syntheticValidationHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "sourceStartSample",
              "sourceSampleRate",
              "outputSampleRate",
              "numerator",
              "denominator",
              "outputStartSample",
              "mappingStatus",
              "measuredImpulsePeakDelaySamples",
              "syntheticValidationHash"
            ],
            "additionalProperties": false
          },
          "runtime": {
            "type": "object",
            "properties": {
              "detectorFamily": {
                "type": "string",
                "enum": ["SILERO", "PYANNOTE", "WEBRTC"]
              },
              "modelId": { "type": "string", "minLength": 1 },
              "modelSnapshotHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "runtimeIdentityHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "workerSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "binarySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "device": { "type": "string", "enum": ["cpu", "mps", "metal"] },
              "offline": { "type": "boolean", "const": true },
              "modelDownloadCount": { "type": "number", "const": 0 },
              "versions": {
                "type": "object",
                "propertyNames": { "type": "string", "minLength": 1 },
                "additionalProperties": { "type": "string", "minLength": 1 }
              },
              "implementationHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "posteriorCapture": {
                "type": "string",
                "enum": [
                  "SILERO_VAD_PROBS",
                  "PYANNOTE_PRE_CONVERSION_POWERSET_ANONYMOUS",
                  "WEBRTC_BINARY_DECISIONS"
                ]
              }
            },
            "required": [
              "detectorFamily",
              "modelId",
              "modelSnapshotHash",
              "runtimeIdentityHash",
              "workerSha256",
              "binarySha256",
              "device",
              "offline",
              "modelDownloadCount",
              "versions",
              "implementationHash",
              "posteriorCapture"
            ],
            "additionalProperties": false
          },
          "profileId": { "type": "string", "minLength": 1 },
          "mainThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
          "auditThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
          "profileHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "runId",
          "cacheKey",
          "family",
          "viewId",
          "viewRole",
          "pcmSha256",
          "audioSha256",
          "frameCount",
          "timeMapping",
          "runtime",
          "profileId",
          "mainThreshold",
          "auditThreshold",
          "profileHash"
        ],
        "additionalProperties": false
      }
    },
    "skippedViews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "NATIVE_MONO",
              "LEFT",
              "RIGHT",
              "CENTER_OR_MID",
              "VOICE_BAND_CENTER",
              "DIALOGUE_COMPRESSED_MID_V2",
              "PREEMPHASIS_VOICE_BAND_V1",
              "LIGHT_DENOISED_CENTER_V1"
            ]
          },
          "family": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "required": ["role", "family", "reason"],
        "additionalProperties": false
      }
    },
    "scorePolicyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "runtimeUnavailable": { "type": "boolean" },
    "maximumRuns": { "type": "number", "const": 8 },
    "maximumWebrtc": { "type": "number", "const": 4 },
    "maximumSilero": { "type": "number", "const": 2 },
    "maximumPyannote": { "type": "number", "const": 2 },
    "automaticRetryAllowed": { "type": "boolean", "const": false },
    "backfillAllowed": { "type": "boolean", "const": false },
    "goldBlind": { "type": "boolean", "const": true }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "policyHash",
    "sourceIdentity",
    "sourceTimebase",
    "runtimeGoldInputCount",
    "visibility",
    "semanticHash",
    "artifactType",
    "phaseAHash",
    "audioViewsHash",
    "viewAuditHash",
    "independentRuntimeHash",
    "frozenAt",
    "jobs",
    "skippedViews",
    "scorePolicyHash",
    "runtimeUnavailable",
    "maximumRuns",
    "maximumWebrtc",
    "maximumSilero",
    "maximumPyannote",
    "automaticRetryAllowed",
    "backfillAllowed",
    "goldBlind"
  ],
  "additionalProperties": false
}
