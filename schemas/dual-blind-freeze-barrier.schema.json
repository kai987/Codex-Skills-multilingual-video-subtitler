{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/dual-blind-freeze-barrier.schema.json",
  "title": "dual-blind-freeze-barrier",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": { "type": "string", "const": "dual-blind-freeze-barrier" },
    "barrierVersion": {
      "type": "string",
      "const": "c6.0.1-dual-freeze-barrier-v1"
    },
    "acceptanceId": { "type": "string", "minLength": 1 },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "runAPath": { "type": "string", "minLength": 1 },
    "runBPath": { "type": "string", "minLength": 1 },
    "runAFreezeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "runBFreezeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "runAInputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "runBInputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "runtimeIdentityParity": { "type": "boolean" },
    "configurationParity": { "type": "boolean" },
    "distinctOutputDirectories": { "type": "boolean" },
    "distinctMediaCaches": { "type": "boolean" },
    "distinctMachineMemoryStores": { "type": "boolean" },
    "bothFrozenBeforeGold": { "type": "boolean" },
    "goldReadAuthorized": { "type": "boolean" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "barrierVersion",
    "acceptanceId",
    "createdAt",
    "runAPath",
    "runBPath",
    "runAFreezeHash",
    "runBFreezeHash",
    "runAInputHash",
    "runBInputHash",
    "runtimeIdentityParity",
    "configurationParity",
    "distinctOutputDirectories",
    "distinctMediaCaches",
    "distinctMachineMemoryStores",
    "bothFrozenBeforeGold",
    "goldReadAuthorized",
    "semanticHash"
  ],
  "additionalProperties": false
}
