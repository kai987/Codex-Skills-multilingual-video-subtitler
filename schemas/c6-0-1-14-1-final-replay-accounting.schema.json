{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-14-1-final-replay-accounting.schema.json",
  "title": "c6-0-1-14-1-final-replay-accounting",
  "type": "object",
  "properties": {
    "mode": { "type": "string", "const": "EXACT_CACHE_ONLY" },
    "detector": {
      "type": "object",
      "properties": {
        "plannedRuns": { "type": "integer", "minimum": 0, "maximum": 12 },
        "sileroRuns": { "type": "integer", "minimum": 0, "maximum": 10 },
        "pyannoteRuns": { "type": "integer", "minimum": 0, "maximum": 2 },
        "inferenceCount": { "type": "integer", "minimum": 0, "maximum": 12 },
        "cacheHits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cacheMisses": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "modelLoadCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "providerProcessStartCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fullMediaAsrCount": { "type": "number", "const": 0 },
        "retryCount": { "type": "number", "const": 0 }
      },
      "required": [
        "plannedRuns",
        "sileroRuns",
        "pyannoteRuns",
        "inferenceCount",
        "cacheHits",
        "cacheMisses",
        "modelLoadCount",
        "providerProcessStartCount",
        "fullMediaAsrCount",
        "retryCount"
      ],
      "additionalProperties": false
    },
    "asr": {
      "type": "object",
      "properties": {
        "inferenceCount": { "type": "integer", "minimum": 0, "maximum": 32 },
        "exactCount": { "type": "integer", "minimum": 0, "maximum": 24 },
        "contextCount": { "type": "integer", "minimum": 0, "maximum": 8 },
        "cacheHits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cacheMisses": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "modelLoadCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "providerProcessStartCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "resultPersistedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hiddenRetryCount": { "type": "number", "const": 0 },
        "fullMediaAsrCount": { "type": "number", "const": 0 }
      },
      "required": [
        "inferenceCount",
        "exactCount",
        "contextCount",
        "cacheHits",
        "cacheMisses",
        "modelLoadCount",
        "providerProcessStartCount",
        "resultPersistedCount",
        "failedCount",
        "hiddenRetryCount",
        "fullMediaAsrCount"
      ],
      "additionalProperties": false
    },
    "inferenceCount": { "type": "number", "const": 0 },
    "modelLoadCount": { "type": "number", "const": 0 },
    "providerProcessStartCount": { "type": "number", "const": 0 },
    "machineEvidenceSemanticHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "mode",
    "detector",
    "asr",
    "inferenceCount",
    "modelLoadCount",
    "providerProcessStartCount",
    "machineEvidenceSemanticHash"
  ],
  "additionalProperties": false
}
