      "properties": {
        "schemaVersion": { "type": "string", "const": "1.0.0" },
        "strategy": { "type": "string", "const": "hybrid-vad" },
        "basePass": {
          "type": "object",
          "properties": {
            "adapter": { "type": "string", "const": "whisper-cpp" },
            "model": { "type": "string", "minLength": 1 },
            "vadProfile": { "type": "string", "const": "sensitive-v2" },
            "timestampStrategy": { "type": "string", "const": "segment" }
          },
          "required": ["adapter", "model", "vadProfile", "timestampStrategy"],
          "additionalProperties": false
        },
        "replacements": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 },
              "purpose": {
                "type": "string",
                "enum": ["opening-dialogue", "prologue-music-dialogue"]
              },
              "adapter": { "type": "string", "const": "whisper-cpp" },
              "model": { "type": "string", "minLength": 1 },
              "vadEnabled": { "type": "boolean", "const": false }
            },
            "required": [
              "start",
              "end",
              "purpose",
              "adapter",
              "model",
              "vadEnabled"
            ],
            "additionalProperties": false
          }
        },
        "corrections": {
          "type": "object",
          "properties": {
            "relativePath": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!\\/)(?![A-Za-z]:[\\\\/]).+"
            },
            "appliedCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["relativePath", "appliedCount"],
          "additionalProperties": false
        },
        "music": {
          "type": "object",
          "properties": {
            "start": { "type": "number", "minimum": 0 },
            "end": { "type": "number", "exclusiveMinimum": 0 },
            "label": { "type": "string", "minLength": 1 },
            "source": {
              "type": "string",
              "const": "local-audio-and-authoritative-identification"
            }
          },
          "required": ["start", "end", "label", "source"],
          "additionalProperties": false
        },
        "thought": {
          "type": "object",
          "properties": {
            "start": { "type": "number", "minimum": 0 },
            "end": { "type": "number", "exclusiveMinimum": 0 },
            "style": { "type": "string", "const": "thought" }
          },
          "required": ["start", "end", "style"],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "strategy",
        "basePass",
        "replacements",
        "corrections",
        "music",
        "thought"
      ],
      "additionalProperties": false
    },
