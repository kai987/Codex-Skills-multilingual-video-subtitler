{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-whole-media-speech-activity-sweeps.schema.json",
  "title": "machine-whole-media-speech-activity-sweeps",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14.1-multiview-speech-inventory-v1"
    },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "sourceTimebase": {
      "type": "string",
      "const": "SOURCE_GLOBAL_NATIVE_SAMPLES"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": {
      "type": "string",
      "const": "machine-whole-media-speech-activity-sweeps"
    },
    "mode": { "type": "string", "enum": ["FRESH", "EXACT_CACHE_ONLY"] },
    "viewsHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "planHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "runs": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "runId": { "type": "string", "minLength": 1 },
          "viewId": { "type": "string", "minLength": 1 },
          "pcmSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "profileId": { "type": "string", "minLength": 1 },
          "runtime": {
            "type": "object",
            "properties": {
              "detectorFamily": {
                "type": "string",
                "enum": ["SILERO", "PYANNOTE"]
              },
              "modelId": { "type": "string", "minLength": 1 },
              "modelSnapshotHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "runtimeIdentityHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "workerSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "binarySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "device": { "type": "string", "enum": ["cpu", "mps", "metal"] },
              "offline": { "type": "boolean", "const": true },
              "modelDownloadCount": { "type": "number", "const": 0 },
              "versions": {
                "type": "object",
                "propertyNames": { "type": "string", "minLength": 1 },
                "additionalProperties": { "type": "string", "minLength": 1 }
              }
            },
            "required": [
              "detectorFamily",
              "modelId",
              "modelSnapshotHash",
              "runtimeIdentityHash",
              "workerSha256",
              "binarySha256",
              "device",
              "offline",
              "modelDownloadCount",
              "versions"
            ],
            "additionalProperties": false
          },
          "cacheKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "rawUnit": { "type": "string", "enum": ["CENTISECONDS", "SECONDS"] },
          "rawIntervals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": { "type": "number", "minimum": 0 },
                "end": { "type": "number", "exclusiveMinimum": 0 }
              },
              "required": ["start", "end"],
              "additionalProperties": false
            }
          },
          "exclusiveRawIntervals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": { "type": "number", "minimum": 0 },
                "end": { "type": "number", "exclusiveMinimum": 0 }
              },
              "required": ["start", "end"],
              "additionalProperties": false
            }
          },
          "nativeIntervals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "startSample": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "endSample": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["startSample", "endSample"],
              "additionalProperties": false
            }
          },
          "inferenceConsumed": { "type": "boolean" },
          "resultPersisted": { "type": "boolean" },
          "status": {
            "type": "string",
            "enum": [
              "SUCCESS",
              "DETECTOR_RUNTIME_UNAVAILABLE",
              "FAILED",
              "INFERENCE_CONSUMED_RESULT_NOT_PERSISTED"
            ]
          },
          "modelLoadDelta": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "providerProcessDelta": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "errorCode": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "rawResultHash": {
            "anyOf": [
              { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              { "type": "null" }
            ]
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "runId",
          "viewId",
          "pcmSha256",
          "profileId",
          "runtime",
          "cacheKey",
          "rawUnit",
          "rawIntervals",
          "exclusiveRawIntervals",
          "nativeIntervals",
          "inferenceConsumed",
          "resultPersisted",
          "status",
          "modelLoadDelta",
          "providerProcessDelta",
          "errorCode",
          "rawResultHash",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "accounting": {
      "type": "object",
      "properties": {
        "plannedRuns": { "type": "integer", "minimum": 0, "maximum": 12 },
        "sileroRuns": { "type": "integer", "minimum": 0, "maximum": 10 },
        "pyannoteRuns": { "type": "integer", "minimum": 0, "maximum": 2 },
        "inferenceCount": { "type": "integer", "minimum": 0, "maximum": 12 },
        "cacheHits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cacheMisses": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "modelLoadCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "providerProcessStartCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fullMediaAsrCount": { "type": "number", "const": 0 },
        "retryCount": { "type": "number", "const": 0 }
      },
      "required": [
        "plannedRuns",
        "sileroRuns",
        "pyannoteRuns",
        "inferenceCount",
        "cacheHits",
        "cacheMisses",
        "modelLoadCount",
        "providerProcessStartCount",
        "fullMediaAsrCount",
        "retryCount"
      ],
      "additionalProperties": false
    },
    "evidenceSemanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "sourceIdentity",
    "sourceTimebase",
    "policyHash",
    "runtimeGoldInputCount",
    "semanticHash",
    "artifactType",
    "mode",
    "viewsHash",
    "planHash",
    "runs",
    "accounting",
    "evidenceSemanticHash"
  ],
  "additionalProperties": false
}
