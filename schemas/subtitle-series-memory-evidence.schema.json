{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/subtitle-series-memory-evidence.schema.json",
  "title": "subtitle-series-memory-evidence",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "subtitle-series-memory-evidence"
    },
    "evidenceVersion": { "type": "string", "const": "C5.19" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "seriesKey": { "type": "string", "minLength": 1 },
    "memoryHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "baseCueHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cueId": { "type": "string", "minLength": 1 },
          "canonicalTextHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "matchedEntryIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "matchCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "appliedAs": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ranking-prior",
                "pronunciation-projection",
                "display-only"
              ]
            }
          },
          "canonicalTextChanged": { "type": "boolean", "const": false }
        },
        "required": [
          "cueId",
          "canonicalTextHash",
          "matchedEntryIds",
          "matchCount",
          "appliedAs",
          "canonicalTextChanged"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "matchedCueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "matchedEntryCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "globalReplacementCount": { "type": "number", "const": 0 },
        "canonicalTextMutationCount": { "type": "number", "const": 0 },
        "crossSeriesMemoryLeakCount": { "type": "number", "const": 0 }
      },
      "required": [
        "matchedCueCount",
        "matchedEntryCount",
        "globalReplacementCount",
        "canonicalTextMutationCount",
        "crossSeriesMemoryLeakCount"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "evidenceVersion",
    "generatedAt",
    "seriesKey",
    "memoryHash",
    "baseCueHash",
    "cues",
    "summary",
    "semanticHash"
  ],
  "additionalProperties": false
}
