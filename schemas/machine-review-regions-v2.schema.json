{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-review-regions-v2.schema.json",
  "title": "machine-review-regions-v2",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.13-region-burden-calibration-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "artifactType": {
      "type": "string",
      "const": "c6-0-1-13-machine-review-regions-v2"
    },
    "itemsHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceDurationSeconds": { "type": "number", "exclusiveMinimum": 0 },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "regionId": { "type": "string", "minLength": 1 },
          "reviewItemIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "eventIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "finalCueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "sourceInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "contextInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "contextStart": { "type": "number", "minimum": 0 },
          "contextEnd": { "type": "number", "exclusiveMinimum": 0 },
          "coreIntervals": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "reviewItemId": { "type": "string", "minLength": 1 },
                "start": { "type": "number", "minimum": 0 },
                "end": { "type": "number", "exclusiveMinimum": 0 }
              },
              "required": ["reviewItemId", "start", "end"],
              "additionalProperties": false
            }
          },
          "maxPriority": {
            "type": "object",
            "properties": {
              "tier": {
                "type": "string",
                "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
              },
              "score": { "type": "number", "minimum": 0, "maximum": 100 }
            },
            "required": ["tier", "score"],
            "additionalProperties": false
          },
          "aggregateReasons": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "WHISPER_REAZON_LEXICAL_CONFLICT",
                "WHISPER_CORE_UNSTABLE",
                "REAZON_CORE_UNSTABLE",
                "WHISPER_HALLUCINATION_SIGNAL",
                "REAZON_HALLUCINATION_SIGNAL",
                "INDEPENDENT_ACOUSTIC_DISAGREEMENT",
                "INDEPENDENT_ACOUSTIC_LOW_MARGIN",
                "DECODER_WEAK",
                "SPEECH_INCOMPLETE",
                "REQUEST_EDGE_RISK",
                "TIMING_EVIDENCE_CONFLICT",
                "OVERLAP_UNRESOLVED",
                "SPEAKER_OVERLAP",
                "LOCALIZATION_AMBIGUOUS",
                "MISSING_DIALOGUE_SUSPECTED",
                "SPAN_LINEAGE_UNAVAILABLE",
                "MACHINE_EVIDENCE_INCOMPLETE"
              ]
            }
          },
          "itemTypes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "TEXT_CROSS_MODEL_DISAGREEMENT",
                "TEXT_WHISPER_INSTABILITY",
                "TEXT_REAZON_INSTABILITY",
                "TEXT_HALLUCINATION_RISK",
                "TEXT_LOW_ACOUSTIC_SUPPORT",
                "TEXT_PARTIAL_AGREEMENT",
                "MISSING_SPEECH_RISK",
                "TIMING_BOUNDARY_RISK",
                "TIMING_SEVERE_RISK",
                "OVERLAP_RISK",
                "MULTI_SPEAKER_RISK",
                "LOCALIZATION_RISK",
                "SPAN_LINEAGE_BLOCKED",
                "EVIDENCE_CONFLICT",
                "GENERAL_UNCERTAINTY"
              ]
            }
          },
          "requiredLevel": {
            "type": "string",
            "enum": ["REQUIRED", "RECOMMENDED", "INFORMATIONAL"]
          },
          "mandatoryReasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "independentEvidenceFamilies": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "SPEECH_ACTIVITY",
                "ASR_LEXICAL_CONTENT",
                "CUE_COVERAGE",
                "NEIGHBOR_CONTINUITY",
                "SPEAKER_ACTIVITY",
                "CROSS_MODEL_CONTENT",
                "MUSIC_LYRICS_CONTRADICTION",
                "LOCALIZATION",
                "WHISPER_STABILITY",
                "REAZON_STABILITY",
                "ACOUSTIC_ALIGNMENT",
                "DECODER",
                "TIMING_BOUNDARY",
                "HALLUCINATION",
                "OVERLAP",
                "STRUCTURAL_INTEGRITY"
              ]
            }
          },
          "sceneIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "speakerGroupIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "mergeReasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "regionId",
          "reviewItemIds",
          "eventIds",
          "finalCueIds",
          "sourceInterval",
          "contextInterval",
          "contextStart",
          "contextEnd",
          "coreIntervals",
          "maxPriority",
          "aggregateReasons",
          "itemTypes",
          "requiredLevel",
          "mandatoryReasons",
          "independentEvidenceFamilies",
          "sceneIds",
          "speakerGroupIds",
          "mergeReasons",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "itemCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "regionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "requiredRegionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "clipSumSeconds": { "type": "number", "minimum": 0 },
        "uniqueUnionSeconds": { "type": "number", "minimum": 0 },
        "duplicateContextSeconds": { "type": "number", "minimum": 0 }
      },
      "required": [
        "itemCount",
        "regionCount",
        "requiredRegionCount",
        "clipSumSeconds",
        "uniqueUnionSeconds",
        "duplicateContextSeconds"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "policyHash",
    "sourceTimebase",
    "runtimeGoldInputCount",
    "artifactType",
    "itemsHash",
    "sourceDurationSeconds",
    "regions",
    "summary",
    "semanticHash"
  ],
  "additionalProperties": false
}
