{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/reference-classification-review.schema.json",
  "title": "reference-classification-review",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "referenceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "configuration": {
      "type": "object",
      "properties": {
        "reviewThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "lowConfidenceExpectedSpeechDisabled": {
          "type": "boolean",
          "const": true
        }
      },
      "required": ["reviewThreshold", "lowConfidenceExpectedSpeechDisabled"],
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cueId": { "type": "string", "minLength": 1 },
          "originalKind": {
            "type": "string",
            "enum": [
              "dialogue",
              "narration",
              "lyrics-original",
              "lyrics-romanization",
              "lyrics-translation",
              "on-screen-text",
              "character-introduction",
              "credit",
              "translator-note",
              "sound-description",
              "unknown"
            ]
          },
          "refinedKind": {
            "type": "string",
            "enum": [
              "dialogue",
              "narration",
              "lyrics-original",
              "lyrics-romanization",
              "lyrics-translation",
              "on-screen-text",
              "character-introduction",
              "credit",
              "translator-note",
              "sound-description",
              "unknown"
            ]
          },
          "originalConfidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "refinedConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "expectedSpeech": { "type": "boolean" },
          "expectedSinging": { "type": "boolean" },
          "reviewRequired": { "type": "boolean" },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "cueId",
          "originalKind",
          "refinedKind",
          "originalConfidence",
          "refinedConfidence",
          "expectedSpeech",
          "expectedSinging",
          "reviewRequired",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "rawCueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reclassifiedCueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dialogueToCreditCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dialogueToCharacterIntroductionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dialogueToOnScreenTextCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dialogueToUnknownCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "originalRecallDenominatorCueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "refinedRecallDenominatorCueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reviewRequiredCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "rawCueCount",
        "reclassifiedCueCount",
        "dialogueToCreditCount",
        "dialogueToCharacterIntroductionCount",
        "dialogueToOnScreenTextCount",
        "dialogueToUnknownCount",
        "originalRecallDenominatorCueCount",
        "refinedRecallDenominatorCueCount",
        "reviewRequiredCount"
      ],
      "additionalProperties": false
    },
    "fallback": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "referenceSha256",
    "configuration",
    "entries",
    "summary",
    "fallback"
  ],
  "additionalProperties": false
}
