{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-1-2-1-label-stability-audit.schema.json",
  "title": "c6-1-2-1-label-stability-audit",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "c6-1-2-1-label-stability-audit"
    },
    "policyVersion": {
      "type": "string",
      "const": "c6.1.2.1-gold-isolated-supergroup-evaluation-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "oldEvaluableCandidateLabels": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "newEvaluableCandidateLabels": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "newlyRecoveredCandidateLabels": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "previouslyEvaluableNowLost": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "stillUnevaluableCandidateLabels": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "commonEvaluableCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "exactLabelAgreementCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "gainDirectionAgreementCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "exactGainDirectionAgreementCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "catastrophicAgreementCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "disagreementCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "disagreementRows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidateId": { "type": "string", "minLength": 1 },
          "eventId": { "type": "string", "minLength": 1 },
          "oldGroupId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "supergroupId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "oldClass": { "type": "string", "minLength": 1 },
          "newClass": { "type": "string", "minLength": 1 },
          "oldGain": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
          "newGain": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
          "oldExactGain": {
            "anyOf": [{ "type": "number" }, { "type": "null" }]
          },
          "newExactGain": {
            "anyOf": [{ "type": "number" }, { "type": "null" }]
          },
          "reason": { "type": "string", "minLength": 1 }
        },
        "required": [
          "candidateId",
          "eventId",
          "oldGroupId",
          "supergroupId",
          "oldClass",
          "newClass",
          "oldGain",
          "newGain",
          "oldExactGain",
          "newExactGain",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "policyVersion",
    "policyHash",
    "semanticHash",
    "oldEvaluableCandidateLabels",
    "newEvaluableCandidateLabels",
    "newlyRecoveredCandidateLabels",
    "previouslyEvaluableNowLost",
    "stillUnevaluableCandidateLabels",
    "commonEvaluableCount",
    "exactLabelAgreementCount",
    "gainDirectionAgreementCount",
    "exactGainDirectionAgreementCount",
    "catastrophicAgreementCount",
    "disagreementCount",
    "disagreementRows"
  ],
  "additionalProperties": false
}
