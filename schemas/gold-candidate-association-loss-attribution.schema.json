{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/gold-candidate-association-loss-attribution.schema.json",
  "title": "gold-candidate-association-loss-attribution",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.3-candidate-association-canonical-assembly-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "gold-candidate-association-loss-attribution"
    },
    "evaluationPhase": { "type": "string", "const": "post-hoc-gold-isolated" },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "goldIdentityHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "associationLedgerSemanticHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidateId": { "type": "string", "minLength": 1 },
          "disposition": {
            "type": "string",
            "enum": [
              "ASSIGNED",
              "QUARANTINED",
              "SUPERSEDED",
              "DUPLICATE",
              "AMBIGUOUS",
              "REJECTED"
            ]
          },
          "primaryReason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "NO_COMPATIBLE_CLUSTER",
                  "ASSOCIATION_SCORE_TOO_LOW",
                  "TEMPORAL_CONFLICT",
                  "TEXT_CONFLICT",
                  "ACOUSTIC_EVENT_CONFLICT",
                  "SPEAKER_CONFLICT",
                  "WINDOW_EDGE_ONLY",
                  "BROAD_WINDOW_ONLY",
                  "PREFIX_SHADOWED",
                  "SUFFIX_SHADOWED",
                  "DUPLICATE_EVENT",
                  "CORRELATED_RETRY",
                  "NONCOMPETITIVE_VARIANT",
                  "MISSING_GLOBAL_TIMELINE",
                  "AMBIGUOUS_TIME_BASE",
                  "MULTIPLE_VALID_CLUSTERS",
                  "WEAK_ACOUSTIC_SUPPORT",
                  "HALLUCINATION_RISK",
                  "UNKNOWN"
                ]
              },
              { "type": "null" }
            ]
          },
          "matchedGoldCueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "temporalIou": { "type": "number", "minimum": 0, "maximum": 1 },
          "normalizedTextSimilarity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "attribution": {
            "type": "string",
            "enum": [
              "NO_GOLD_LOSS",
              "ASSOCIATION_LOSS",
              "TEXT_VARIANT_LOSS",
              "TIMELINE_LOSS",
              "DOWNSTREAM_ASSEMBLY_LOSS",
              "UNATTRIBUTED"
            ]
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "candidateId",
          "disposition",
          "primaryReason",
          "matchedGoldCueIds",
          "temporalIou",
          "normalizedTextSimilarity",
          "attribution",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "evaluatedCandidateCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "associationLossCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "textVariantLossCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "timelineLossCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "downstreamAssemblyLossCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unattributedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "evaluatedCandidateCount",
        "associationLossCount",
        "textVariantLossCount",
        "timelineLossCount",
        "downstreamAssemblyLossCount",
        "unattributedCount"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "evaluationPhase",
    "runtimeGoldInputCount",
    "goldIdentityHash",
    "associationLedgerSemanticHash",
    "records",
    "summary",
    "semanticHash"
  ],
  "additionalProperties": false
}
