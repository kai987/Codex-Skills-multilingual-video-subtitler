{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-1-2-1-supergroup-freeze.schema.json",
  "title": "c6-1-2-1-supergroup-freeze",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": { "type": "string", "const": "c6-1-2-1-supergroup-freeze" },
    "policyVersion": {
      "type": "string",
      "const": "c6.1.2.1-gold-isolated-supergroup-evaluation-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "supergroupFrozenAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "baselineFreezeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timingBarrierHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "supergroupMapHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "edgeLedgerHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "primaryEvaluator": {
      "type": "string",
      "const": "E2_FROZEN_MACHINE_GROUP_GOLD_TIMING_SUPERGROUP"
    },
    "frozenFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relativePath": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": ["relativePath", "sha256"],
        "additionalProperties": false
      }
    },
    "rawGoldTextReadCount": { "type": "number", "const": 0 }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "policyVersion",
    "policyHash",
    "semanticHash",
    "supergroupFrozenAt",
    "baselineFreezeHash",
    "timingBarrierHash",
    "supergroupMapHash",
    "edgeLedgerHash",
    "primaryEvaluator",
    "frozenFiles",
    "rawGoldTextReadCount"
  ],
  "additionalProperties": false
}
