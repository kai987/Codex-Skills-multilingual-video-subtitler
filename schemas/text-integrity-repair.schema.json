{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/text-integrity-repair.schema.json",
  "title": "text-integrity-repair",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "inputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "outputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "configuration": {
      "type": "object",
      "properties": {
        "maximumRepairRounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "characterRatioTimingAllowed": { "type": "boolean", "const": false }
      },
      "required": ["maximumRepairRounds", "characterRatioTimingAllowed"],
      "additionalProperties": false
    },
    "rounds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "round": { "type": "integer", "minimum": 1, "maximum": 2 },
          "inputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "outputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "candidateFindingCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "repairAttemptCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "successfulRepairCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "round",
          "inputHash",
          "outputHash",
          "candidateFindingCount",
          "repairAttemptCount",
          "successfulRepairCount"
        ],
        "additionalProperties": false
      }
    },
    "repairs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "round": { "type": "integer", "minimum": 1, "maximum": 2 },
          "sourceFindingCodes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "FINAL_SINGLE_CHARACTER_FRAGMENT",
                "FINAL_EXTREME_SHORT_DURATION",
                "FINAL_INCOMPLETE_MORPHEME",
                "FINAL_INCOMPLETE_CLAUSE",
                "FINAL_TEXT_BOUNDARY_BREAK",
                "FINAL_COMPETING_HYPOTHESES",
                "FINAL_NEAR_DUPLICATE_SEMANTIC_CUE",
                "FINAL_UNSUPPORTED_CONTENT_WORD",
                "FINAL_INVALID_JAPANESE_FRAGMENT",
                "FINAL_LYRICS_HALLUCINATION",
                "FINAL_LYRICS_INCOMPLETE_LINE",
                "FINAL_REFERENCE_SEMANTIC_CONFLICT",
                "FINAL_VISUAL_LINE_WORD_BREAK",
                "SEGMENTATION_UNRESOLVED"
              ]
            }
          },
          "sourceCueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "sourceClusterIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "repairStrategy": {
            "type": "string",
            "enum": [
              "runner-up-text-donor",
              "deduplicated-text-donor",
              "merge-previous",
              "merge-next",
              "merge-three-way",
              "restore-pre-segmentation",
              "expand-duration"
            ]
          },
          "beforeText": { "type": "string" },
          "afterText": { "type": "string", "minLength": 1 },
          "beforeInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "afterInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "textDonorCueId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "timingDonorCueId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "originalWinnerCueId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "winnerScore": {
            "anyOf": [
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "null" }
            ]
          },
          "textDonorScore": {
            "anyOf": [
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "null" }
            ]
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "result": {
            "type": "string",
            "enum": ["repaired", "rejected", "still-hard-blocked"]
          }
        },
        "required": [
          "id",
          "round",
          "sourceFindingCodes",
          "sourceCueIds",
          "sourceClusterIds",
          "repairStrategy",
          "beforeText",
          "afterText",
          "beforeInterval",
          "afterInterval",
          "textDonorCueId",
          "timingDonorCueId",
          "originalWinnerCueId",
          "winnerScore",
          "textDonorScore",
          "evidence",
          "result"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "candidateFindingCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "repairAttemptCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "successfulRepairCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failedRepairCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "restoredCueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "replacedByRunnerUpCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "restoredPreSegmentationCueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mergedWithPreviousCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mergedWithNextCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "threeWayMergeCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "durationExpansionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stillHardBlockedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "candidateFindingCount",
        "repairAttemptCount",
        "successfulRepairCount",
        "failedRepairCount",
        "restoredCueCount",
        "replacedByRunnerUpCount",
        "restoredPreSegmentationCueCount",
        "mergedWithPreviousCount",
        "mergedWithNextCount",
        "threeWayMergeCount",
        "durationExpansionCount",
        "stillHardBlockedCount"
      ],
      "additionalProperties": false
    },
    "fallback": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "inputHash",
    "outputHash",
    "configuration",
    "rounds",
    "repairs",
    "summary",
    "fallback"
  ],
  "additionalProperties": false
}
