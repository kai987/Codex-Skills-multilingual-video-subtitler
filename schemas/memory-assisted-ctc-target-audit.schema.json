{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/memory-assisted-ctc-target-audit.schema.json",
  "title": "memory-assisted-ctc-target-audit",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "memory-assisted-ctc-target-audit"
    },
    "auditVersion": { "type": "string", "const": "C5.19" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "ctcRuntimeIdentityHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ctcModelSnapshotHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cueId": { "type": "string", "minLength": 1 },
          "beforeEncodable": { "type": "boolean" },
          "afterProjectionEncodable": { "type": "boolean" },
          "beforeUnknownCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "afterUnknownCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "projectionUsed": { "type": "boolean" },
          "memoryEntryIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "canonicalTextChanged": { "type": "boolean", "const": false }
        },
        "required": [
          "cueId",
          "beforeEncodable",
          "afterProjectionEncodable",
          "beforeUnknownCount",
          "afterUnknownCount",
          "projectionUsed",
          "memoryEntryIds",
          "canonicalTextChanged"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "previousEncodableCueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "memoryAssistedEncodableCueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "previousUnencodableCueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "previousUnencodableCueRescuedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pronunciationProjectionCanonicalMutationCount": {
          "type": "number",
          "const": 0
        }
      },
      "required": [
        "previousEncodableCueCount",
        "memoryAssistedEncodableCueCount",
        "previousUnencodableCueCount",
        "previousUnencodableCueRescuedCount",
        "pronunciationProjectionCanonicalMutationCount"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "auditVersion",
    "generatedAt",
    "ctcRuntimeIdentityHash",
    "ctcModelSnapshotHash",
    "cues",
    "summary",
    "semanticHash"
  ],
  "additionalProperties": false
}
