{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-14-1-policy.schema.json",
  "title": "c6-0-1-14-1-policy",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14.1-multiview-speech-inventory-v1"
    },
    "profiles": {
      "minItems": 2,
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "profileId": { "type": "string", "minLength": 1 },
          "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
          "minSpeechMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "minSilenceMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "maxSpeechSeconds": { "type": "number", "exclusiveMinimum": 0 },
          "speechPadMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "samplesOverlap": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "required": [
          "profileId",
          "threshold",
          "minSpeechMs",
          "minSilenceMs",
          "maxSpeechSeconds",
          "speechPadMs",
          "samplesOverlap"
        ],
        "additionalProperties": false
      }
    },
    "maxViews": { "type": "number", "const": 5 },
    "maxDetectorRuns": { "type": "number", "const": 12 },
    "maxSileroRuns": { "type": "number", "const": 10 },
    "maxPyannoteRuns": { "type": "number", "const": 2 },
    "maxAsrRequests": { "type": "number", "const": 32 },
    "maxAsrTargets": { "type": "number", "const": 12 },
    "maxContextTargets": { "type": "number", "const": 4 },
    "maxSafetyTargets": { "type": "number", "const": 24 },
    "maxSafetyUnionSeconds": { "type": "number", "const": 60 },
    "maxTargetSeconds": { "type": "number", "const": 12 },
    "maxFingerprintClips": { "type": "number", "const": 256 },
    "maxFingerprintSeconds": { "type": "number", "const": 900 },
    "fingerprint": {
      "type": "object",
      "properties": {
        "minimumClipSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "minimumRms": { "type": "number", "exclusiveMinimum": 0 },
        "minimumNormalizedCorrelation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimumScoreMargin": { "type": "number", "minimum": 0, "maximum": 1 },
        "maximumNormalizedResidual": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "secondPeakExclusionSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maximumSpectralPeakRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maximumLagOneCorrelation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "minimumClipSeconds",
        "minimumRms",
        "minimumNormalizedCorrelation",
        "minimumScoreMargin",
        "maximumNormalizedResidual",
        "secondPeakExclusionSeconds",
        "maximumSpectralPeakRatio",
        "maximumLagOneCorrelation"
      ],
      "additionalProperties": false
    },
    "fusion": {
      "type": "object",
      "properties": {
        "minimumIslandSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "splitMaximumSeconds": { "type": "number", "const": 12 },
        "sameFamilyMergeGapSeconds": { "type": "number", "const": 0 },
        "minimumIndependentOverlapSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "timeDiversityBinSeconds": { "type": "number", "exclusiveMinimum": 0 }
      },
      "required": [
        "minimumIslandSeconds",
        "splitMaximumSeconds",
        "sameFamilyMergeGapSeconds",
        "minimumIndependentOverlapSeconds",
        "timeDiversityBinSeconds"
      ],
      "additionalProperties": false
    },
    "asr": {
      "type": "object",
      "properties": {
        "exactGuardSeconds": { "type": "number", "minimum": 0 },
        "contextSeconds": { "type": "number", "minimum": 0 },
        "prompt": { "type": "string", "const": "" },
        "vadEnabled": { "type": "boolean", "const": false },
        "retryCount": { "type": "number", "const": 0 },
        "providers": {
          "type": "array",
          "prefixItems": [
            { "type": "string", "const": "whisper-large-v3" },
            { "type": "string", "const": "reazonspeech-k2-v2" }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "exactGuardSeconds",
        "contextSeconds",
        "prompt",
        "vadEnabled",
        "retryCount",
        "providers"
      ],
      "additionalProperties": false
    },
    "fullMediaAsrAllowed": { "type": "boolean", "const": false },
    "modelDownloadAllowed": { "type": "boolean", "const": false },
    "automaticCanonicalMutationAllowed": { "type": "boolean", "const": false },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "profiles",
    "maxViews",
    "maxDetectorRuns",
    "maxSileroRuns",
    "maxPyannoteRuns",
    "maxAsrRequests",
    "maxAsrTargets",
    "maxContextTargets",
    "maxSafetyTargets",
    "maxSafetyUnionSeconds",
    "maxTargetSeconds",
    "maxFingerprintClips",
    "maxFingerprintSeconds",
    "fingerprint",
    "fusion",
    "asr",
    "fullMediaAsrAllowed",
    "modelDownloadAllowed",
    "automaticCanonicalMutationAllowed",
    "semanticHash"
  ],
  "additionalProperties": false
}
