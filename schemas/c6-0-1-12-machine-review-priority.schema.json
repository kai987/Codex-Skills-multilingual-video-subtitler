{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-12-machine-review-priority.schema.json",
  "title": "c6-0-1-12-machine-review-priority",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.12-multi-asr-review-assistance-v2"
    },
    "artifactType": {
      "type": "string",
      "const": "c6-0-1-12-machine-review-priority"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reviewItemId": { "type": "string", "minLength": 1 },
          "sourceStart": { "type": "number", "minimum": 0 },
          "itemTypes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "TEXT_CROSS_MODEL_DISAGREEMENT",
                "TEXT_WHISPER_INSTABILITY",
                "TEXT_REAZON_INSTABILITY",
                "TEXT_HALLUCINATION_RISK",
                "TEXT_LOW_ACOUSTIC_SUPPORT",
                "TEXT_PARTIAL_AGREEMENT",
                "MISSING_SPEECH_RISK",
                "TIMING_BOUNDARY_RISK",
                "TIMING_SEVERE_RISK",
                "OVERLAP_RISK",
                "MULTI_SPEAKER_RISK",
                "LOCALIZATION_RISK",
                "SPAN_LINEAGE_BLOCKED",
                "EVIDENCE_CONFLICT",
                "GENERAL_UNCERTAINTY"
              ]
            }
          },
          "reviewReasons": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "WHISPER_REAZON_LEXICAL_CONFLICT",
                "WHISPER_CORE_UNSTABLE",
                "REAZON_CORE_UNSTABLE",
                "WHISPER_HALLUCINATION_SIGNAL",
                "REAZON_HALLUCINATION_SIGNAL",
                "INDEPENDENT_ACOUSTIC_DISAGREEMENT",
                "INDEPENDENT_ACOUSTIC_LOW_MARGIN",
                "DECODER_WEAK",
                "SPEECH_INCOMPLETE",
                "REQUEST_EDGE_RISK",
                "TIMING_EVIDENCE_CONFLICT",
                "OVERLAP_UNRESOLVED",
                "SPEAKER_OVERLAP",
                "LOCALIZATION_AMBIGUOUS",
                "MISSING_DIALOGUE_SUSPECTED",
                "SPAN_LINEAGE_UNAVAILABLE",
                "MACHINE_EVIDENCE_INCOMPLETE"
              ]
            }
          },
          "priorityTier": {
            "type": "string",
            "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
          },
          "priorityScore": { "type": "number", "minimum": 0, "maximum": 100 },
          "requiredLevel": {
            "type": "string",
            "enum": ["REQUIRED", "RECOMMENDED", "INFORMATIONAL"]
          },
          "scoreComponents": {
            "type": "object",
            "properties": {
              "taxonomyRisk": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "multiLabelBoost": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "compoundRiskBoost": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "evidenceBreadthBoost": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": [
              "taxonomyRisk",
              "multiLabelBoost",
              "compoundRiskBoost",
              "evidenceBreadthBoost"
            ],
            "additionalProperties": false
          },
          "explanationCodes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "reviewItemId",
          "sourceStart",
          "itemTypes",
          "reviewReasons",
          "priorityTier",
          "priorityScore",
          "requiredLevel",
          "scoreComponents",
          "explanationCodes",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "artifactType",
    "policyHash",
    "entries",
    "semanticHash"
  ],
  "additionalProperties": false
}
