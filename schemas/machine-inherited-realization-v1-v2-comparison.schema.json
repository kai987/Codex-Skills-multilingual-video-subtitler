{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-inherited-realization-v1-v2-comparison.schema.json",
  "title": "machine-inherited-realization-v1-v2-comparison",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14.5.2-product-scorability-playback-realization-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "sourceTimebase": {
      "type": "string",
      "const": "SOURCE_GLOBAL_NATIVE_SAMPLES"
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "visibility": { "type": "string", "const": "LOCAL_ONLY" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": {
      "type": "string",
      "const": "machine-inherited-realization-v1-v2-comparison"
    },
    "v1Hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "v2Hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidateCountV1": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "acceptedCountV1": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "candidateCountV2": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "acceptedCountV2": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "newlyAcceptedCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "noLongerAcceptedCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "retainedAcceptedCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "changedEnvelopeSemanticCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "changedPlaybackSegmentSetCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "geometryMutationCount": { "type": "number", "const": 0 },
    "rejectionReasonDelta": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "policyHash",
    "sourceIdentity",
    "sourceTimebase",
    "runtimeGoldInputCount",
    "visibility",
    "semanticHash",
    "artifactType",
    "v1Hash",
    "v2Hash",
    "candidateCountV1",
    "acceptedCountV1",
    "candidateCountV2",
    "acceptedCountV2",
    "newlyAcceptedCount",
    "noLongerAcceptedCount",
    "retainedAcceptedCount",
    "changedEnvelopeSemanticCount",
    "changedPlaybackSegmentSetCount",
    "geometryMutationCount",
    "rejectionReasonDelta"
  ],
  "additionalProperties": false
}
