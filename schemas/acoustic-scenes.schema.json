{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/acoustic-scenes.schema.json",
  "title": "acoustic-scenes",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "status": { "type": "string", "enum": ["completed", "failed"] },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "analysisVersion": { "type": "string", "minLength": 1 },
    "config": {
      "type": "object",
      "properties": {
        "sceneWindowSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sceneHopSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sceneMinimumDurationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sceneConfidenceThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "nonSpeechSkipConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "sceneWindowSeconds",
        "sceneHopSeconds",
        "sceneMinimumDurationSeconds",
        "sceneConfidenceThreshold",
        "nonSpeechSkipConfidence"
      ],
      "additionalProperties": false
    },
    "failure": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "interval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "label": {
            "type": "string",
            "enum": [
              "clean-dialogue",
              "quiet-dialogue",
              "noisy-dialogue",
              "singing",
              "non-speech",
              "unknown"
            ]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "probabilities": {
            "type": "object",
            "properties": {
              "speech": { "type": "number", "minimum": 0, "maximum": 1 },
              "vocal": { "type": "number", "minimum": 0, "maximum": 1 },
              "music": { "type": "number", "minimum": 0, "maximum": 1 },
              "drums": { "type": "number", "minimum": 0, "maximum": 1 },
              "crowd": { "type": "number", "minimum": 0, "maximum": 1 },
              "overlap": { "type": "number", "minimum": 0, "maximum": 1 },
              "silence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "required": [
              "speech",
              "vocal",
              "music",
              "drums",
              "crowd",
              "overlap",
              "silence"
            ],
            "additionalProperties": false
          },
          "sourceWindowIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "boundarySource": {
            "type": "string",
            "enum": ["window-hop", "hysteresis", "minimum-duration-absorption"]
          },
          "routingDecision": {
            "type": "object",
            "properties": {
              "strategy": {
                "type": "string",
                "enum": [
                  "vad-only",
                  "extra-sensitive-vad",
                  "vad-plus-no-vad",
                  "lyrics-no-vad",
                  "observe-only",
                  "skip-dialogue-asr",
                  "conservative-default"
                ]
              },
              "useVad": { "type": "boolean" },
              "useExtraSensitiveVad": { "type": "boolean" },
              "useNoVad": { "type": "boolean" },
              "useLyricsMode": { "type": "boolean" },
              "requireIndependentConsensus": { "type": "boolean" },
              "requireLargeV3RefinementOnConflict": { "type": "boolean" },
              "requireHumanReviewOnUnresolved": { "type": "boolean" },
              "reasons": {
                "minItems": 1,
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "required": [
              "strategy",
              "useVad",
              "useExtraSensitiveVad",
              "useNoVad",
              "useLyricsMode",
              "requireIndependentConsensus",
              "requireLargeV3RefinementOnConflict",
              "requireHumanReviewOnUnresolved",
              "reasons"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "interval",
          "label",
          "confidence",
          "probabilities",
          "sourceWindowIds",
          "evidence",
          "boundarySource",
          "routingDecision"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "generatedAt",
    "analysisVersion",
    "config",
    "failure",
    "scenes"
  ],
  "additionalProperties": false
}
