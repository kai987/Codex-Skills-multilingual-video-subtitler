{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c5-17-1-fresh-cache-observe-validation.schema.json",
  "title": "c5-17-1-fresh-cache-observe-validation",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "c5-17-1-fresh-cache-observe-validation"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "freshTask": { "type": "string", "minLength": 1 },
    "observeTask": { "type": "string", "minLength": 1 },
    "cacheReplayTask": { "type": "string", "minLength": 1 },
    "freshAttemptCount": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "freshMfaProcessCount": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "cacheHitCount": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "cacheReplayMfaProcessCount": { "type": "number", "const": 0 },
    "observeTimingMutationCount": { "type": "number", "const": 0 },
    "alignmentHashMatches": { "type": "boolean", "const": true },
    "componentDecisionHashMatches": { "type": "boolean", "const": true },
    "mutationHashMatches": { "type": "boolean", "const": true },
    "outputCueHashMatches": { "type": "boolean", "const": true },
    "shareableAuditPassed": { "type": "boolean", "const": true },
    "sourceVideoUnchanged": { "type": "boolean", "const": true },
    "humanSubtitleUnchanged": { "type": "boolean", "const": true }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "generatedAt",
    "freshTask",
    "observeTask",
    "cacheReplayTask",
    "freshAttemptCount",
    "freshMfaProcessCount",
    "cacheHitCount",
    "cacheReplayMfaProcessCount",
    "observeTimingMutationCount",
    "alignmentHashMatches",
    "componentDecisionHashMatches",
    "mutationHashMatches",
    "outputCueHashMatches",
    "shareableAuditPassed",
    "sourceVideoUnchanged",
    "humanSubtitleUnchanged"
  ],
  "additionalProperties": false
}
