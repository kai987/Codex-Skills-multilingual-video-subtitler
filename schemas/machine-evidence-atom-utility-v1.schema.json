{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-evidence-atom-utility-v1.schema.json",
  "title": "machine-evidence-atom-utility-v1",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14.4-machine-evidence-utility-selection-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "sourceTimebase": {
      "type": "string",
      "const": "SOURCE_GLOBAL_NATIVE_SAMPLES"
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "visibility": { "type": "string", "const": "LOCAL_ONLY" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": {
      "type": "string",
      "const": "machine-evidence-atom-utility-v1"
    },
    "hierarchyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "lexicalArtifactHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "atomId": { "type": "string", "minLength": 1 },
          "sourceAtomHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "verifiedTimebase": { "type": "boolean" },
          "eligibleEvidence": { "type": "boolean" },
          "strongContradiction": { "type": "boolean" },
          "detectorFamilies": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "SILERO",
                "PYANNOTE",
                "WEBRTC",
                "LEGACY_FINGERPRINT",
                "EXISTING_VERIFIED",
                "LOCALIZED_LEXICAL"
              ]
            }
          },
          "independentEvidenceFamilies": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "evidenceStrata": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "MULTI_DETECTOR",
                "PYANNOTE_EXCLUSIVE",
                "SILERO_EXCLUSIVE",
                "WEBRTC_EXCLUSIVE",
                "LEGACY_FINGERPRINT_EXCLUSIVE",
                "MULTI_VIEW_SAME_DETECTOR",
                "EXISTING_VERIFIED",
                "MASKED_SUBTHRESHOLD",
                "AUDIT_ONLY"
              ]
            }
          },
          "distinctPcmViewCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "posteriorSupportClass": {
            "type": "string",
            "enum": [
              "POSTERIOR_UNAVAILABLE",
              "POSTERIOR_LOW",
              "POSTERIOR_MEDIUM",
              "POSTERIOR_HIGH"
            ]
          },
          "uncoveredCoverageClass": {
            "type": "string",
            "enum": [
              "FULLY_PROTECTED",
              "PARTIALLY_UNCOVERED",
              "FULLY_UNCOVERED"
            ]
          },
          "durationBucket": {
            "type": "string",
            "enum": [
              "LT_020",
              "FROM_020_TO_050",
              "FROM_050_TO_100",
              "FROM_100_TO_200",
              "FROM_200_TO_400",
              "GTE_400_CAPPED"
            ]
          },
          "detectorExclusiveNovelty": { "type": "boolean" },
          "textCandidateAvailability": { "type": "boolean" },
          "textCandidateClass": {
            "type": "string",
            "enum": [
              "NO_LOCALIZED_TEXT_CANDIDATE",
              "SINGLE_PROVIDER_LOCALIZED",
              "MULTI_PROVIDER_DISAGREEMENT",
              "PRONUNCIATION_AGREEMENT",
              "CROSS_MODEL_LOCALIZED_AGREEMENT"
            ]
          },
          "textCandidateProviderCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "speechEvidenceTier": {
            "type": "string",
            "enum": [
              "TIER_5_VERIFIED_MULTI_FAMILY_SPEECH",
              "TIER_4_VERIFIED_INDEPENDENT_EXCLUSIVE_SPEECH",
              "TIER_3_VERIFIED_SINGLE_FAMILY_SPEECH",
              "TIER_2_MASKED_OR_SUBTHRESHOLD_SPEECH",
              "TIER_1_AUDIT_ONLY_SPEECH_CANDIDATE",
              "TIER_0_INELIGIBLE_OR_CONTRADICTED"
            ]
          },
          "speechEvidenceUtilityVector": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "textCandidateUtilityVector": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "reviewSafetyUtilityVector": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "utilityEligibility": { "type": "boolean" },
          "utilityReasons": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "featureHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "atomId",
          "sourceAtomHash",
          "verifiedTimebase",
          "eligibleEvidence",
          "strongContradiction",
          "detectorFamilies",
          "independentEvidenceFamilies",
          "evidenceStrata",
          "distinctPcmViewCount",
          "posteriorSupportClass",
          "uncoveredCoverageClass",
          "durationBucket",
          "detectorExclusiveNovelty",
          "textCandidateAvailability",
          "textCandidateClass",
          "textCandidateProviderCount",
          "speechEvidenceTier",
          "speechEvidenceUtilityVector",
          "textCandidateUtilityVector",
          "reviewSafetyUtilityVector",
          "utilityEligibility",
          "utilityReasons",
          "featureHash",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "rowCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveEvidenceAtomCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nonzeroSpeechUtilityCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveEvidenceZeroUtilityCount": { "type": "number", "const": 0 },
    "tierCounts": {
      "type": "object",
      "properties": {
        "TIER_5_VERIFIED_MULTI_FAMILY_SPEECH": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "TIER_4_VERIFIED_INDEPENDENT_EXCLUSIVE_SPEECH": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "TIER_3_VERIFIED_SINGLE_FAMILY_SPEECH": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "TIER_2_MASKED_OR_SUBTHRESHOLD_SPEECH": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "TIER_1_AUDIT_ONLY_SPEECH_CANDIDATE": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "TIER_0_INELIGIBLE_OR_CONTRADICTED": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "TIER_5_VERIFIED_MULTI_FAMILY_SPEECH",
        "TIER_4_VERIFIED_INDEPENDENT_EXCLUSIVE_SPEECH",
        "TIER_3_VERIFIED_SINGLE_FAMILY_SPEECH",
        "TIER_2_MASKED_OR_SUBTHRESHOLD_SPEECH",
        "TIER_1_AUDIT_ONLY_SPEECH_CANDIDATE",
        "TIER_0_INELIGIBLE_OR_CONTRADICTED"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "policyHash",
    "sourceIdentity",
    "sourceTimebase",
    "runtimeGoldInputCount",
    "visibility",
    "semanticHash",
    "artifactType",
    "hierarchyHash",
    "lexicalArtifactHash",
    "rows",
    "rowCount",
    "positiveEvidenceAtomCount",
    "nonzeroSpeechUtilityCount",
    "positiveEvidenceZeroUtilityCount",
    "tierCounts"
  ],
  "additionalProperties": false
}
