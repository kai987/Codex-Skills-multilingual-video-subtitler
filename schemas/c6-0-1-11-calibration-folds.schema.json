{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-11-calibration-folds.schema.json",
  "title": "c6-0-1-11-calibration-folds",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.11-paired-evidence-independent-discriminator-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "c6-0-1-11-calibration-folds"
    },
    "corpusSemanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "groupingPolicy": {
      "type": "string",
      "const": "overlap-components-then-contiguous-time-blocks-v1"
    },
    "foldCount": { "type": "number", "const": 5 },
    "constructedBeforeLabels": { "type": "boolean", "const": true },
    "randomSplitUsed": { "type": "boolean", "const": false },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eventId": { "type": "string", "minLength": 1 },
          "audioGroupId": { "type": "string", "minLength": 1 },
          "fold": { "type": "integer", "minimum": 1, "maximum": 5 },
          "timeBlockStart": { "type": "number", "minimum": 0 },
          "timeBlockEnd": { "type": "number", "exclusiveMinimum": 0 },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "eventId",
          "audioGroupId",
          "fold",
          "timeBlockStart",
          "timeBlockEnd",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "corpusSemanticHash",
    "groupingPolicy",
    "foldCount",
    "constructedBeforeLabels",
    "randomSplitUsed",
    "assignments",
    "semanticHash"
  ],
  "additionalProperties": false
}
