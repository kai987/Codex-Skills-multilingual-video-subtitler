{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-whisper-core-stability-evaluation.schema.json",
  "title": "machine-whisper-core-stability-evaluation",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.8-core-span-asr-stability-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "machine-whisper-core-stability-evaluation"
    },
    "evaluationPhase": {
      "type": "string",
      "const": "post-freeze-gold-isolated"
    },
    "machineFreezeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "goldLocalEvaluationSemanticHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eventId": { "type": "string", "minLength": 1 },
          "diagnosis": {
            "type": "string",
            "enum": [
              "PIPELINE_CORRECT_CANDIDATE_EXISTS",
              "CONTEXT_DIFFERENCE_ONLY",
              "ASR_CORE_STABLE_CORRECT",
              "ASR_CORE_STABLE_WRONG",
              "ASR_CORE_LEXICALLY_UNSTABLE",
              "ASR_HALLUCINATION_UNSTABLE",
              "CANDIDATE_APPLICATION_BLOCKED",
              "LOCALIZATION_BLOCKED",
              "REFERENCE_ALIGNMENT_BLOCKED",
              "UNEVALUABLE"
            ]
          },
          "stabilityClass": {
            "type": "string",
            "enum": [
              "CORE_TEXT_CONSISTENT",
              "CONTEXT_ONLY_DIFFERENCE",
              "LEXICAL_CORE_DISAGREEMENT",
              "HALLUCINATION_DISAGREEMENT",
              "ADJACENT_UTTERANCE_CONTAMINATION",
              "SPEAKER_CONTENT_MIX",
              "PARTIAL_CORE_AGREEMENT",
              "UNLOCALIZABLE",
              "UNEVALUABLE"
            ]
          },
          "localEvaluationStatus": {
            "type": "string",
            "enum": [
              "EVALUABLE_EXACT_LOCAL",
              "EVALUABLE_MONOTONIC_LOCAL",
              "EVALUABLE_WITH_AMBIGUITY",
              "UNEVALUABLE_INSUFFICIENT_REFERENCE",
              "UNEVALUABLE_OVERLAP",
              "UNEVALUABLE_MAPPING_CONFLICT"
            ]
          },
          "currentFinalError": {
            "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
          },
          "bestExistingCoreError": {
            "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
          },
          "bestFreshCoreError": {
            "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
          },
          "bestCandidateId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "supportingEvidenceIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "eventId",
          "diagnosis",
          "stabilityClass",
          "localEvaluationStatus",
          "currentFinalError",
          "bestExistingCoreError",
          "bestFreshCoreError",
          "bestCandidateId",
          "supportingEvidenceIds",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "eventCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "evaluableEventCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "diagnosisCounts": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "PIPELINE_CORRECT_CANDIDATE_EXISTS",
              "CONTEXT_DIFFERENCE_ONLY",
              "ASR_CORE_STABLE_CORRECT",
              "ASR_CORE_STABLE_WRONG",
              "ASR_CORE_LEXICALLY_UNSTABLE",
              "ASR_HALLUCINATION_UNSTABLE",
              "CANDIDATE_APPLICATION_BLOCKED",
              "LOCALIZATION_BLOCKED",
              "REFERENCE_ALIGNMENT_BLOCKED",
              "UNEVALUABLE"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "required": [
            "PIPELINE_CORRECT_CANDIDATE_EXISTS",
            "CONTEXT_DIFFERENCE_ONLY",
            "ASR_CORE_STABLE_CORRECT",
            "ASR_CORE_STABLE_WRONG",
            "ASR_CORE_LEXICALLY_UNSTABLE",
            "ASR_HALLUCINATION_UNSTABLE",
            "CANDIDATE_APPLICATION_BLOCKED",
            "LOCALIZATION_BLOCKED",
            "REFERENCE_ALIGNMENT_BLOCKED",
            "UNEVALUABLE"
          ]
        },
        "pipelineLimitedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "asrLimitedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "localizationBlockedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "referenceBlockedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "eventCount",
        "evaluableEventCount",
        "diagnosisCounts",
        "pipelineLimitedCount",
        "asrLimitedCount",
        "localizationBlockedCount",
        "referenceBlockedCount"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "evaluationPhase",
    "machineFreezeHash",
    "goldLocalEvaluationSemanticHash",
    "runtimeGoldInputCount",
    "events",
    "summary",
    "semanticHash"
  ],
  "additionalProperties": false
}
