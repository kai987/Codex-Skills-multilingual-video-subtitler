{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-overlap-event-classification.schema.json",
  "title": "machine-overlap-event-classification",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.2-candidate-precision-global-timeline-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "machine-overlap-event-classification"
    },
    "mode": { "type": "string", "enum": ["off", "observe", "enforce"] },
    "pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pairId": { "type": "string", "minLength": 1 },
          "leftCueId": { "type": "string", "minLength": 1 },
          "rightCueId": { "type": "string", "minLength": 1 },
          "interval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "overlapSeconds": { "type": "number", "exclusiveMinimum": 0 },
          "classification": {
            "type": "string",
            "enum": [
              "DUPLICATE_EVENT_OVERLAP",
              "POSSIBLE_MULTI_SPEAKER",
              "RAPID_TURN_PADDING",
              "TIMELINE_CONFLICT",
              "UNKNOWN_OVERLAP"
            ]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "automaticallyResolved": { "type": "boolean" },
          "reasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "pairId",
          "leftCueId",
          "rightCueId",
          "interval",
          "overlapSeconds",
          "classification",
          "confidence",
          "automaticallyResolved",
          "reasons"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "overlapPairCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "duplicatePairCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "boundaryCollisionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "concurrentSpeechCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unknownCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "automaticallyResolvedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "overlapPairCount",
        "duplicatePairCount",
        "boundaryCollisionCount",
        "concurrentSpeechCount",
        "unknownCount",
        "automaticallyResolvedCount"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "mode",
    "pairs",
    "summary",
    "semanticHash"
  ],
  "additionalProperties": false
}
