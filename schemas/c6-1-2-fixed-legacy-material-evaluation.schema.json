{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-1-2-fixed-legacy-material-evaluation.schema.json",
  "title": "c6-1-2-fixed-legacy-material-evaluation",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "c6-1-2-fixed-legacy-material-evaluation"
    },
    "policyVersion": {
      "type": "string",
      "const": "c6.1.2-top-k-reranking-acoustic-completeness-v1"
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evaluationOnly": { "type": "boolean", "const": true },
    "privacy": { "type": "string", "const": "LOCAL_ONLY" },
    "machineFreezeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "alignmentFrozenOnce": { "type": "boolean", "const": true },
    "baselineAlignmentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "baselineMaterialErrors": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "baselineExpectedParity": { "type": "boolean" },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "profileId": { "type": "string", "minLength": 1 },
          "materialErrors": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "materialDelta": { "type": "number" },
          "fixedMatching": { "type": "boolean", "const": true }
        },
        "required": [
          "profileId",
          "materialErrors",
          "materialDelta",
          "fixedMatching"
        ],
        "additionalProperties": false
      }
    },
    "legacyOnlyNotTrainingLabels": { "type": "boolean", "const": true }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "policyVersion",
    "semanticHash",
    "evaluationOnly",
    "privacy",
    "machineFreezeHash",
    "alignmentFrozenOnce",
    "baselineAlignmentHash",
    "baselineMaterialErrors",
    "baselineExpectedParity",
    "profiles",
    "legacyOnlyNotTrainingLabels"
  ],
  "additionalProperties": false
}
