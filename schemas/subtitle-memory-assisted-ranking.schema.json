{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/subtitle-memory-assisted-ranking.schema.json",
  "title": "subtitle-memory-assisted-ranking",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "subtitle-memory-assisted-ranking"
    },
    "rankingVersion": { "type": "string", "const": "C5.19" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "memoryHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evaluationMode": {
      "type": "string",
      "enum": ["bootstrap", "causal", "frozen"]
    },
    "scoreCalibrationStatus": {
      "type": "string",
      "const": "rule-based-memory-prior"
    },
    "memoryTieBreakMargin": { "type": "number", "minimum": 0, "maximum": 1 },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cueId": { "type": "string", "minLength": 1 },
          "memoryHashBefore": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "baseWinnerCandidateId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "memoryWinnerCandidateId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "humanCanonical": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "baseWinnerMatchesCanonical": {
            "anyOf": [{ "type": "boolean" }, { "type": "null" }]
          },
          "memoryWinnerMatchesCanonical": {
            "anyOf": [{ "type": "boolean" }, { "type": "null" }]
          },
          "baseRanking": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "candidateId": { "type": "string", "minLength": 1 },
                "text": { "type": "string", "minLength": 1 },
                "associationClass": {
                  "type": "string",
                  "enum": [
                    "EXACT_TARGET",
                    "PROBABLE_TARGET",
                    "BROAD_WINDOW",
                    "AMBIGUOUS",
                    "UNASSOCIATED",
                    "UNKNOWN"
                  ]
                },
                "baseScore": { "type": "number", "minimum": 0, "maximum": 1 },
                "memoryScore": { "type": "number", "minimum": 0, "maximum": 1 },
                "adjustedOrder": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "memoryEntryIds": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              },
              "required": [
                "candidateId",
                "text",
                "associationClass",
                "baseScore",
                "memoryScore",
                "adjustedOrder",
                "memoryEntryIds"
              ],
              "additionalProperties": false
            }
          },
          "memoryEvidence": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "memoryEvidenceIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "memoryAdjustedRanking": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "candidateId": { "type": "string", "minLength": 1 },
                "text": { "type": "string", "minLength": 1 },
                "associationClass": {
                  "type": "string",
                  "enum": [
                    "EXACT_TARGET",
                    "PROBABLE_TARGET",
                    "BROAD_WINDOW",
                    "AMBIGUOUS",
                    "UNASSOCIATED",
                    "UNKNOWN"
                  ]
                },
                "baseScore": { "type": "number", "minimum": 0, "maximum": 1 },
                "memoryScore": { "type": "number", "minimum": 0, "maximum": 1 },
                "adjustedOrder": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "memoryEntryIds": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              },
              "required": [
                "candidateId",
                "text",
                "associationClass",
                "baseScore",
                "memoryScore",
                "adjustedOrder",
                "memoryEntryIds"
              ],
              "additionalProperties": false
            }
          },
          "rankingReason": { "type": "string", "minLength": 1 },
          "rankingChanged": { "type": "boolean" },
          "corrected": { "type": "boolean" },
          "regression": { "type": "boolean" },
          "memoryCorrectedRanking": { "type": "boolean" },
          "memoryRegressedRanking": { "type": "boolean" },
          "associationPromotionCount": { "type": "number", "const": 0 },
          "fabricatedCandidateCount": { "type": "number", "const": 0 },
          "acousticOverrideViolationCount": { "type": "number", "const": 0 }
        },
        "required": [
          "cueId",
          "memoryHashBefore",
          "baseWinnerCandidateId",
          "memoryWinnerCandidateId",
          "humanCanonical",
          "baseWinnerMatchesCanonical",
          "memoryWinnerMatchesCanonical",
          "baseRanking",
          "memoryEvidence",
          "memoryEvidenceIds",
          "memoryAdjustedRanking",
          "rankingReason",
          "rankingChanged",
          "corrected",
          "regression",
          "memoryCorrectedRanking",
          "memoryRegressedRanking",
          "associationPromotionCount",
          "fabricatedCandidateCount",
          "acousticOverrideViolationCount"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "memoryRankingEvaluatedCueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "memoryRankingChangedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "memoryRankingCorrectedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "memoryRankingRegressionCount": { "type": "number", "const": 0 },
        "memoryFabricatedAutoCandidateCount": { "type": "number", "const": 0 },
        "memoryAcousticOverrideViolationCount": { "type": "number", "const": 0 }
      },
      "required": [
        "memoryRankingEvaluatedCueCount",
        "memoryRankingChangedCount",
        "memoryRankingCorrectedCount",
        "memoryRankingRegressionCount",
        "memoryFabricatedAutoCandidateCount",
        "memoryAcousticOverrideViolationCount"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "rankingVersion",
    "generatedAt",
    "memoryHash",
    "evaluationMode",
    "scoreCalibrationStatus",
    "memoryTieBreakMargin",
    "decisions",
    "summary",
    "semanticHash"
  ],
  "additionalProperties": false
}
