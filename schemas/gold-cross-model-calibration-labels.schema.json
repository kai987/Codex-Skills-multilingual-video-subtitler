{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/gold-cross-model-calibration-labels.schema.json",
  "title": "gold-cross-model-calibration-labels",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.11-paired-evidence-independent-discriminator-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "gold-cross-model-calibration-labels"
    },
    "datasetRole": { "type": "string", "const": "CALIBRATION_DATASET" },
    "featureFreezeSemanticHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "foldFreezeSemanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "goldIdentityHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "fullGoldTextIncluded": { "type": "boolean", "const": false },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eventId": { "type": "string", "minLength": 1 },
          "label": {
            "type": "string",
            "enum": [
              "REAZON_BETTER",
              "WHISPER_BETTER",
              "EQUIVALENT",
              "UNEVALUABLE"
            ]
          },
          "whisperLocalError": {
            "anyOf": [
              { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              { "type": "null" }
            ]
          },
          "reazonLocalError": {
            "anyOf": [
              { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              { "type": "null" }
            ]
          },
          "localErrorDelta": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              { "type": "null" }
            ]
          },
          "evaluationEvidenceIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "eventId",
          "label",
          "whisperLocalError",
          "reazonLocalError",
          "localErrorDelta",
          "evaluationEvidenceIds",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "reazonBetterCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "whisperBetterCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "equivalentCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unevaluableCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "availableOracleGain": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "reazonBetterCount",
        "whisperBetterCount",
        "equivalentCount",
        "unevaluableCount",
        "availableOracleGain"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "datasetRole",
    "featureFreezeSemanticHash",
    "foldFreezeSemanticHash",
    "goldIdentityHash",
    "fullGoldTextIncluded",
    "events",
    "summary",
    "semanticHash"
  ],
  "additionalProperties": false
}
