{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-coverage-unit-realization-dominance-ledger.schema.json",
  "title": "machine-coverage-unit-realization-dominance-ledger",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14.5-safety-coverage-unit-contract-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "sourceTimebase": {
      "type": "string",
      "const": "SOURCE_GLOBAL_NATIVE_SAMPLES"
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "visibility": { "type": "string", "const": "LOCAL_ONLY" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": {
      "type": "string",
      "const": "machine-coverage-unit-realization-dominance-ledger"
    },
    "realizationCandidatesHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "retainedRealizationIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "dominatedRealizationIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "dominatedBy": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "candidateCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "retainedCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "dominatedCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "strictCostDominanceOnly": { "type": "boolean", "const": true }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "policyHash",
    "sourceIdentity",
    "sourceTimebase",
    "runtimeGoldInputCount",
    "visibility",
    "semanticHash",
    "artifactType",
    "realizationCandidatesHash",
    "retainedRealizationIds",
    "dominatedRealizationIds",
    "dominatedBy",
    "candidateCount",
    "retainedCount",
    "dominatedCount",
    "strictCostDominanceOnly"
  ],
  "additionalProperties": false
}
