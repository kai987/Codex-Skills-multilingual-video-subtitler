{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-14-probe-budget-exception.schema.json",
  "title": "c6-0-1-14-probe-budget-exception",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "c6-0-1-14-probe-budget-exception"
    },
    "authorizationId": { "type": "string", "minLength": 1 },
    "authorizationHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authorizedBy": { "type": "string", "const": "USER_EXPLICIT" },
    "authorizedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "sourceIdentityHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "selectionHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "originalProbeByteHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "lossAuditByteHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "previousConsumedInferences": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "previousPersistedSuccessCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "previousLostRawResultCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maxAdditionalInferences": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 2
    },
    "maxCumulativeInferences": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 66
    },
    "affectedRequestIds": {
      "minItems": 1,
      "maxItems": 2,
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "authorizationId",
    "authorizationHash",
    "authorizedBy",
    "authorizedAt",
    "sourceIdentityHash",
    "policyHash",
    "selectionHash",
    "originalProbeByteHash",
    "lossAuditByteHash",
    "previousConsumedInferences",
    "previousPersistedSuccessCount",
    "previousLostRawResultCount",
    "maxAdditionalInferences",
    "maxCumulativeInferences",
    "affectedRequestIds",
    "semanticHash"
  ],
  "additionalProperties": false
}
