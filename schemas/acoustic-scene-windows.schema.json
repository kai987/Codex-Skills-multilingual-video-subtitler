{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/acoustic-scene-windows.schema.json",
  "title": "acoustic-scene-windows",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "status": { "type": "string", "enum": ["completed", "failed"] },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "analysisVersion": { "type": "string", "minLength": 1 },
    "classifier": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["heuristic", "local-model"] }
      },
      "required": ["id", "version", "kind"],
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "properties": {
        "sceneWindowSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sceneHopSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sceneMinimumDurationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sceneConfidenceThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "nonSpeechSkipConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "sceneWindowSeconds",
        "sceneHopSeconds",
        "sceneMinimumDurationSeconds",
        "sceneConfidenceThreshold",
        "nonSpeechSkipConfidence"
      ],
      "additionalProperties": false
    },
    "sourceAudio": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "sampleRate": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "channels": { "type": "number", "const": 1 },
            "durationSeconds": { "type": "number", "minimum": 0 }
          },
          "required": ["sha256", "sampleRate", "channels", "durationSeconds"],
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "cache": {
      "type": "object",
      "properties": {
        "key": {
          "anyOf": [
            { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            { "type": "null" }
          ]
        },
        "hit": { "type": "boolean" }
      },
      "required": ["key", "hit"],
      "additionalProperties": false
    },
    "failure": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "interval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "probabilities": {
            "type": "object",
            "properties": {
              "speech": { "type": "number", "minimum": 0, "maximum": 1 },
              "vocal": { "type": "number", "minimum": 0, "maximum": 1 },
              "music": { "type": "number", "minimum": 0, "maximum": 1 },
              "drums": { "type": "number", "minimum": 0, "maximum": 1 },
              "crowd": { "type": "number", "minimum": 0, "maximum": 1 },
              "overlap": { "type": "number", "minimum": 0, "maximum": 1 },
              "silence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "required": [
              "speech",
              "vocal",
              "music",
              "drums",
              "crowd",
              "overlap",
              "silence"
            ],
            "additionalProperties": false
          },
          "features": {
            "type": "object",
            "properties": {
              "rmsDb": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
              "snrDb": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
              "spectralFlatness": {
                "anyOf": [
                  { "type": "number", "minimum": 0, "maximum": 1 },
                  { "type": "null" }
                ]
              },
              "spectralFlux": {
                "anyOf": [
                  { "type": "number", "minimum": 0, "maximum": 1 },
                  { "type": "null" }
                ]
              },
              "zeroCrossingRate": {
                "anyOf": [
                  { "type": "number", "minimum": 0, "maximum": 1 },
                  { "type": "null" }
                ]
              },
              "speechActivityRatio": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "silenceRatio": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "required": [
              "rmsDb",
              "snrDb",
              "spectralFlatness",
              "spectralFlux",
              "zeroCrossingRate",
              "speechActivityRatio",
              "silenceRatio"
            ],
            "additionalProperties": false
          },
          "proposedLabel": {
            "type": "string",
            "enum": [
              "clean-dialogue",
              "quiet-dialogue",
              "noisy-dialogue",
              "singing",
              "non-speech",
              "unknown"
            ]
          },
          "smoothedLabel": {
            "type": "string",
            "enum": [
              "clean-dialogue",
              "quiet-dialogue",
              "noisy-dialogue",
              "singing",
              "non-speech",
              "unknown"
            ]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "id",
          "interval",
          "probabilities",
          "features",
          "proposedLabel",
          "smoothedLabel",
          "confidence",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "generatedAt",
    "analysisVersion",
    "classifier",
    "config",
    "sourceAudio",
    "cache",
    "failure",
    "windows"
  ],
  "additionalProperties": false
}
