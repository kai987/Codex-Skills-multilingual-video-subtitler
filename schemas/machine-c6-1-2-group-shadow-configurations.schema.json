{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-c6-1-2-group-shadow-configurations.schema.json",
  "title": "machine-c6-1-2-group-shadow-configurations",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "machine-c6-1-2-group-shadow-configurations"
    },
    "policyVersion": {
      "type": "string",
      "const": "c6.1.2-top-k-reranking-acoustic-completeness-v1"
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rankingsHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "mappingHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "profileId": { "type": "string", "minLength": 1 },
          "foldId": { "type": "string", "minLength": 1 },
          "groupId": { "type": "string", "minLength": 1 },
          "configurationId": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": [
              "CURRENT_ALL",
              "SINGLE_EVENT",
              "TOP1_COMBINED",
              "BOUNDED_BEAM"
            ]
          },
          "selections": {
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "eventId": { "type": "string", "minLength": 1 },
                "candidateId": { "type": "string", "minLength": 1 }
              },
              "required": ["eventId", "candidateId"],
              "additionalProperties": false
            }
          },
          "aggregateScore": { "type": "number" },
          "baselineScore": { "type": "number" },
          "eligible": { "type": "boolean" },
          "reasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "outputTextHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "outputTimingHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "profileId",
          "foldId",
          "groupId",
          "configurationId",
          "kind",
          "selections",
          "aggregateScore",
          "baselineScore",
          "eligible",
          "reasons",
          "outputTextHash",
          "outputTimingHash"
        ],
        "additionalProperties": false
      }
    },
    "maximumPerGroupProfile": { "type": "number", "const": 16 },
    "maximumChangedEvents": { "type": "number", "const": 2 },
    "goldUsed": { "type": "boolean", "const": false }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "policyVersion",
    "semanticHash",
    "rankingsHash",
    "mappingHash",
    "rows",
    "maximumPerGroupProfile",
    "maximumChangedEvents",
    "goldUsed"
  ],
  "additionalProperties": false
}
