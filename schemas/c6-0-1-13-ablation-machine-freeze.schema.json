{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-13-ablation-machine-freeze.schema.json",
  "title": "c6-0-1-13-ablation-machine-freeze",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.13-region-burden-calibration-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "c6-0-1-13-ablation-machine-freeze"
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string",
            "enum": ["A0", "A1", "A2", "A3", "A4", "A5", "A6", "A7"]
          },
          "description": { "type": "string" },
          "artifactHashes": {
            "type": "object",
            "propertyNames": { "type": "string" },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "featuresHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "foldsHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "itemCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "regionCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "requiredItemCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "requiredRegionCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "scoreDiagnostics": {
            "type": "object",
            "properties": {
              "maximumScore": { "type": "number" },
              "maximumScoreCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "largestTieGroup": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "uniqueScoreCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "entropyBits": { "type": "number", "minimum": 0 },
              "distribution": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "score": { "type": "number" },
                    "count": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["score", "count"],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "maximumScore",
              "maximumScoreCount",
              "largestTieGroup",
              "uniqueScoreCount",
              "entropyBits",
              "distribution"
            ],
            "additionalProperties": false
          },
          "uniqueAudioSeconds": { "type": "number", "minimum": 0 },
          "requiredUniqueAudioSeconds": { "type": "number", "minimum": 0 },
          "stageMeaning": {
            "type": "string",
            "enum": [
              "MACHINE_VARIANT",
              "OOF_EVALUATION_OVER_FROZEN_MACHINE_FEATURES",
              "FUTURE_RANKER_WORKSPACE_OVER_FROZEN_MACHINE_FEATURES"
            ]
          }
        },
        "required": [
          "stage",
          "description",
          "artifactHashes",
          "featuresHash",
          "foldsHash",
          "itemCount",
          "regionCount",
          "requiredItemCount",
          "requiredRegionCount",
          "scoreDiagnostics",
          "uniqueAudioSeconds",
          "requiredUniqueAudioSeconds",
          "stageMeaning"
        ],
        "additionalProperties": false
      }
    },
    "frozenBeforeLabels": { "type": "boolean", "const": true },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "stages",
    "frozenBeforeLabels",
    "runtimeGoldInputCount",
    "semanticHash"
  ],
  "additionalProperties": false
}
