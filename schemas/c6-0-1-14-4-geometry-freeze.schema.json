{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-14-4-geometry-freeze.schema.json",
  "title": "c6-0-1-14-4-geometry-freeze",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14.4-machine-evidence-utility-selection-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "sourceTimebase": {
      "type": "string",
      "const": "SOURCE_GLOBAL_NATIVE_SAMPLES"
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "visibility": { "type": "string", "const": "LOCAL_ONLY" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": {
      "type": "string",
      "const": "c6-0-1-14-4-geometry-freeze"
    },
    "inventoryHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidatesHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "obligationsHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "hierarchyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "bundlesHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "dominanceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "immutableTargetsHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceWorkspaceAudioHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourcePlaybackHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "subtitleFileHashes": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "geometryMutationCount": { "type": "number", "const": 0 },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "goldReadAttempted": { "type": "boolean", "const": false }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "policyHash",
    "sourceIdentity",
    "sourceTimebase",
    "runtimeGoldInputCount",
    "visibility",
    "semanticHash",
    "artifactType",
    "inventoryHash",
    "candidatesHash",
    "obligationsHash",
    "hierarchyHash",
    "bundlesHash",
    "dominanceHash",
    "immutableTargetsHash",
    "sourceWorkspaceAudioHash",
    "sourcePlaybackHash",
    "subtitleFileHashes",
    "geometryMutationCount",
    "capturedAt",
    "goldReadAttempted"
  ],
  "additionalProperties": false
}
