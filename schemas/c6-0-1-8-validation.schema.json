{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-8-validation.schema.json",
  "title": "c6-0-1-8-validation",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.8-core-span-asr-stability-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": { "type": "string", "const": "c6-0-1-8-validation" },
    "branch": {
      "type": "string",
      "const": "codex/c6-0-1-8-core-span-asr-stability"
    },
    "repositoryCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "goldSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceReadOnlyVerified": { "type": "boolean" },
    "goldReadOnlyVerified": { "type": "boolean" },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "datasetHardcodingFindingCount": { "type": "number", "const": 0 },
    "unsafeFinalizationEscapeCount": { "type": "number", "const": 0 },
    "networkUsed": { "type": "boolean", "const": false },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "evidence": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": ["id", "passed", "evidence"],
        "additionalProperties": false
      }
    },
    "finalABParity": {
      "type": "object",
      "properties": {
        "text": { "type": "boolean" },
        "timing": { "type": "boolean" },
        "presentation": { "type": "boolean" },
        "coreSpan": { "type": "boolean" },
        "coreProjection": { "type": "boolean" },
        "comparability": { "type": "boolean" },
        "stability": { "type": "boolean" },
        "localGoldEvaluation": { "type": "boolean" },
        "oracle": { "type": "boolean" },
        "routeDecision": { "type": "boolean" }
      },
      "required": [
        "text",
        "timing",
        "presentation",
        "coreSpan",
        "coreProjection",
        "comparability",
        "stability",
        "localGoldEvaluation",
        "oracle",
        "routeDecision"
      ],
      "additionalProperties": false
    },
    "canonicalHashes": {
      "type": "object",
      "properties": {
        "baselineText": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "finalAText": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "finalBText": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "baselineTiming": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "finalATiming": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "finalBTiming": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "baselinePresentation": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "finalAPresentation": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "finalBPresentation": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "required": [
        "baselineText",
        "finalAText",
        "finalBText",
        "baselineTiming",
        "finalATiming",
        "finalBTiming",
        "baselinePresentation",
        "finalAPresentation",
        "finalBPresentation"
      ],
      "additionalProperties": false
    },
    "productionStatus": { "type": "string", "const": "needs-review" },
    "finalizationMethod": { "type": "string", "const": "none" },
    "machineReleaseAuthorized": { "type": "boolean", "const": false },
    "c6018EngineeringPassed": { "type": "boolean" },
    "localizedComparabilityPassed": { "type": "boolean" },
    "coreStabilityDiagnosticPassed": { "type": "boolean" },
    "goldIsolationPassed": { "type": "boolean" },
    "strictC602QualityGatePassed": { "type": "boolean" },
    "routeDecision": {
      "type": "string",
      "enum": [
        "CONTINUE_FINAL_PIPELINE_APPLICATION",
        "RECOMMEND_SECOND_ASR_ENSEMBLE",
        "MIXED_PIPELINE_AND_ASR",
        "INSUFFICIENT_LOCAL_COMPARABILITY",
        "GO_C6_0_2"
      ]
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "branch",
    "repositoryCommit",
    "sourceMediaSha256",
    "goldSha256",
    "sourceReadOnlyVerified",
    "goldReadOnlyVerified",
    "runtimeGoldInputCount",
    "datasetHardcodingFindingCount",
    "unsafeFinalizationEscapeCount",
    "networkUsed",
    "checks",
    "finalABParity",
    "canonicalHashes",
    "productionStatus",
    "finalizationMethod",
    "machineReleaseAuthorized",
    "c6018EngineeringPassed",
    "localizedComparabilityPassed",
    "coreStabilityDiagnosticPassed",
    "goldIsolationPassed",
    "strictC602QualityGatePassed",
    "routeDecision",
    "semanticHash"
  ],
  "additionalProperties": false
}
