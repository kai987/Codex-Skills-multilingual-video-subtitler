{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-14-pre-probe-freeze.schema.json",
  "title": "c6-0-1-14-pre-probe-freeze",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": { "type": "string", "const": "c6-0-1-14-pre-probe-freeze" },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "selectionHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "policyByteHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "selectionByteHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "frozenAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "policyHash",
    "selectionHash",
    "policyByteHash",
    "selectionByteHash",
    "sourceIdentity",
    "runtimeGoldInputCount",
    "frozenAt",
    "semanticHash"
  ],
  "additionalProperties": false
}
