{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-c6-0-1-14-2-asr-probe-selection.schema.json",
  "title": "machine-c6-0-1-14-2-asr-probe-selection",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14.2-safety-selection-detector-ceiling-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "sourceTimebase": {
      "type": "string",
      "const": "SOURCE_GLOBAL_NATIVE_SAMPLES"
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "visibility": { "type": "string", "const": "LOCAL_ONLY" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": {
      "type": "string",
      "const": "machine-c6-0-1-14-2-asr-probe-selection"
    },
    "safetyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "previousAsrEvidenceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "targets": {
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "probeTargetId": { "type": "string", "minLength": 1 },
          "clusterTargetId": { "type": "string", "minLength": 1 },
          "clusterId": { "type": "string", "minLength": 1 },
          "nativeInterval": {
            "type": "object",
            "properties": {
              "startSample": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "endSample": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["startSample", "endSample"],
            "additionalProperties": false
          },
          "sourceInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "targetCoreUnion": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "startSample": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "endSample": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["startSample", "endSample"],
              "additionalProperties": false
            }
          },
          "evidenceStrata": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "MULTI_DETECTOR",
                "PYANNOTE_EXCLUSIVE",
                "SILERO_EXCLUSIVE",
                "WEBRTC_EXCLUSIVE",
                "LEGACY_FINGERPRINT_EXCLUSIVE",
                "MULTI_VIEW_SAME_DETECTOR",
                "EXISTING_VERIFIED",
                "MASKED_SUBTHRESHOLD",
                "AUDIT_ONLY"
              ]
            }
          },
          "selectionReasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "contextPreselected": { "type": "boolean" },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "probeTargetId",
          "clusterTargetId",
          "clusterId",
          "nativeInterval",
          "sourceInterval",
          "targetCoreUnion",
          "evidenceStrata",
          "selectionReasons",
          "contextPreselected",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "contextEligibleTargetIds": {
      "maxItems": 2,
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "maximumAuthorizedRequests": {
      "type": "integer",
      "minimum": 0,
      "maximum": 12
    },
    "selectionFrozenAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "targetBackfillAllowed": { "type": "boolean", "const": false },
    "goldBlind": { "type": "boolean", "const": true },
    "repeatedPreviousRequestCount": { "type": "number", "const": 0 },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "clusterTargetId": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "required": ["clusterTargetId", "reason"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "policyHash",
    "sourceIdentity",
    "sourceTimebase",
    "runtimeGoldInputCount",
    "visibility",
    "semanticHash",
    "artifactType",
    "safetyHash",
    "previousAsrEvidenceHash",
    "targets",
    "contextEligibleTargetIds",
    "maximumAuthorizedRequests",
    "selectionFrozenAt",
    "targetBackfillAllowed",
    "goldBlind",
    "repeatedPreviousRequestCount",
    "rejected"
  ],
  "additionalProperties": false
}
