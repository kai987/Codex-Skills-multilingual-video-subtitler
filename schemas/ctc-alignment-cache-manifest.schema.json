{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/ctc-alignment-cache-manifest.schema.json",
  "title": "ctc-alignment-cache-manifest",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "ctc-alignment-cache-manifest"
    },
    "cacheVersion": { "type": "string", "const": "C5.18.1" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "mode": { "type": "string", "enum": ["off", "read", "read-write"] },
    "cacheRootShareableName": { "type": "string", "minLength": 1 },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "attemptId": { "type": "string", "minLength": 1 },
          "cueId": { "type": "string", "minLength": 1 },
          "componentId": { "type": "string", "minLength": 1 },
          "windowType": { "type": "string", "enum": ["narrow", "expanded"] },
          "cacheKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "cacheHit": { "type": "boolean" },
          "audioSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "entrySemanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "attemptId",
          "cueId",
          "componentId",
          "windowType",
          "cacheKey",
          "cacheHit",
          "audioSha256",
          "entrySemanticHash"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "requestCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hitCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "missCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "writeCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inferenceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "modelLoadCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "requestCount",
        "hitCount",
        "missCount",
        "writeCount",
        "inferenceCount",
        "modelLoadCount"
      ],
      "additionalProperties": false
    },
    "cacheIdentityHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "cacheVersion",
    "generatedAt",
    "mode",
    "cacheRootShareableName",
    "requests",
    "summary",
    "cacheIdentityHash",
    "semanticHash"
  ],
  "additionalProperties": false
}
