              "minimum": 0,
              "maximum": 9007199254740991
            },
            "largestTieGroup": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "uniqueScoreCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "entropyBits": { "type": "number", "minimum": 0 },
