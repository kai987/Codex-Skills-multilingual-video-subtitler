        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "required": ["path", "sha256"],
      "additionalProperties": false
    },
    "reviewPackageRef": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\/)(?![A-Za-z]:[\\\\/])(?!\\\\\\\\).+"
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
