              "type": "object",
              "properties": {
                "turnId": { "type": "string", "minLength": 1 },
                "speakerId": { "type": "string", "minLength": 1 },
                "startLocal": { "type": "number", "minimum": 0 },
                "endLocal": { "type": "number", "exclusiveMinimum": 0 },
