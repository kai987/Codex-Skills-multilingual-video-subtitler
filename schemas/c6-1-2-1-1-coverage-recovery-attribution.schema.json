{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-1-2-1-1-coverage-recovery-attribution.schema.json",
  "title": "c6-1-2-1-1-coverage-recovery-attribution",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "c6-1-2-1-1-coverage-recovery-attribution"
    },
    "policyVersion": {
      "type": "string",
      "const": "c6.1.2.1.1-constrained-monotonic-partition-reachable-evaluation-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "parentE2SupergroupId": { "type": "string", "minLength": 1 },
          "reasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "status": {
            "type": "string",
            "enum": [
              "ALREADY_BOUNDED",
              "FULLY_PARTITIONED",
              "PARTIALLY_PARTITIONED_WITH_RESIDUAL",
              "UNSPLITTABLE_STRONG_BRIDGE",
              "UNSPLITTABLE_COVERAGE",
              "UNSPLITTABLE_CUE_LIMIT",
              "UNSPLITTABLE_DURATION_LIMIT",
              "UNSPLITTABLE_GAP_LIMIT",
              "CROSS_FOLD_BLOCKED",
              "NO_VALID_MONOTONIC_PARTITION",
              "GOLD_ONLY_UNREACHABLE",
              "MACHINE_ONLY_NO_GOLD_BINDING"
            ]
          },
          "recoveredMachineGroupIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "recoveredProductionCueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "recoveredGoldCueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "newlyEvaluableCandidateIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "directionChangedCandidateIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "parentE2SupergroupId",
          "reasons",
          "status",
          "recoveredMachineGroupIds",
          "recoveredProductionCueIds",
          "recoveredGoldCueIds",
          "newlyEvaluableCandidateIds",
          "directionChangedCandidateIds"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "policyVersion",
    "policyHash",
    "semanticHash",
    "rows"
  ],
  "additionalProperties": false
}
