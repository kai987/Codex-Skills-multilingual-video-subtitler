{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-timing-evidence.schema.json",
  "title": "machine-timing-evidence",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.1-machine-quality-recovery-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "mode": { "type": "string", "enum": ["off", "observe", "enforce"] },
    "profile": {
      "type": "string",
      "enum": ["legacy", "diagnostics", "coverage", "timing", "full"]
    },
    "run": {
      "type": "object",
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "repositoryCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "goldRuntimeInputCount": { "type": "number", "const": 0 }
      },
      "required": [
        "runId",
        "repositoryCommit",
        "sourceMediaSha256",
        "goldRuntimeInputCount"
      ],
      "additionalProperties": false
    },
    "artifactType": { "type": "string", "const": "machine-timing-evidence" },
    "timestampStrategy": { "type": "string" },
    "targetChunkSeconds": {
      "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
    },
    "vadEnabled": { "type": "boolean" },
    "rawVadEvidenceAvailable": { "type": "boolean" },
    "mappedTokenEvidenceAvailable": { "type": "boolean" },
    "stockVadTimelineTrusted": { "type": "boolean" },
    "timingEvidenceApplied": { "type": "boolean" },
    "timingMutationCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reasons": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "mode",
    "profile",
    "run",
    "artifactType",
    "timestampStrategy",
    "targetChunkSeconds",
    "vadEnabled",
    "rawVadEvidenceAvailable",
    "mappedTokenEvidenceAvailable",
    "stockVadTimelineTrusted",
    "timingEvidenceApplied",
    "timingMutationCount",
    "reasons"
  ],
  "additionalProperties": false
}
