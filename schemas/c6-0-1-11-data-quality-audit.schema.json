{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-11-data-quality-audit.schema.json",
  "title": "c6-0-1-11-data-quality-audit",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.11-paired-evidence-independent-discriminator-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "c6-0-1-11-data-quality-audit"
    },
    "corpusSemanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "featureSemanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "foldSemanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "duplicateEventCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "overlappingAudioAcrossTrainTestCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rawTextFeatureCount": { "type": "number", "const": 0 },
    "datasetSpecificFeatureCount": { "type": "number", "const": 0 },
    "goldFeatureCount": { "type": "number", "const": 0 },
    "fullDataPreprocessingLeakCount": { "type": "number", "const": 0 },
    "foldConstructionLabelInputCount": { "type": "number", "const": 0 },
    "passed": { "type": "boolean" },
    "failures": { "type": "array", "items": { "type": "string" } },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "corpusSemanticHash",
    "featureSemanticHash",
    "foldSemanticHash",
    "duplicateEventCount",
    "overlappingAudioAcrossTrainTestCount",
    "rawTextFeatureCount",
    "datasetSpecificFeatureCount",
    "goldFeatureCount",
    "fullDataPreprocessingLeakCount",
    "foldConstructionLabelInputCount",
    "passed",
    "failures",
    "semanticHash"
  ],
  "additionalProperties": false
}
