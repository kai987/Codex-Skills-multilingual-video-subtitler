{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/top-score-resolution.schema.json",
  "title": "top-score-resolution",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "inputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "configuration": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "const": "top-score" },
        "scoreGapReviewThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "deterministicTieBreakOrder": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": [
        "mode",
        "scoreGapReviewThreshold",
        "deterministicTieBreakOrder"
      ],
      "additionalProperties": false
    },
    "resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "clusterId": { "type": "string", "minLength": 1 },
          "candidateCueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "winnerCueId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "winnerScore": {
            "anyOf": [
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "null" }
            ]
          },
          "runnerUpCueId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "runnerUpScore": {
            "anyOf": [
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "null" }
            ]
          },
          "scoreGap": {
            "anyOf": [
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "null" }
            ]
          },
          "rejectedCueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "hardBlockReasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "reviewRecommended": { "type": "boolean" },
          "reviewReasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "tieBreakApplied": { "type": "boolean" },
          "tieBreakReasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "clusterId",
          "candidateCueIds",
          "winnerCueId",
          "winnerScore",
          "runnerUpCueId",
          "runnerUpScore",
          "scoreGap",
          "rejectedCueIds",
          "hardBlockReasons",
          "reviewRecommended",
          "reviewReasons",
          "tieBreakApplied",
          "tieBreakReasons"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "atomicClusterCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "winnerCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "noWinnerCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lowScoreGapWinnerCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reviewRecommendedWinnerCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "atomicClusterCount",
        "winnerCount",
        "noWinnerCount",
        "lowScoreGapWinnerCount",
        "reviewRecommendedWinnerCount"
      ],
      "additionalProperties": false
    },
    "fallback": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "inputHash",
    "configuration",
    "resolutions",
    "summary",
    "fallback"
  ],
  "additionalProperties": false
}
