{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-review-safety-contract-policy-v1.schema.json",
  "title": "machine-review-safety-contract-policy-v1",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14.5-safety-coverage-unit-contract-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "sourceTimebase": {
      "type": "string",
      "const": "SOURCE_GLOBAL_NATIVE_SAMPLES"
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "visibility": { "type": "string", "const": "LOCAL_ONLY" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": {
      "type": "string",
      "const": "machine-review-safety-contract-policy-v1"
    },
    "productGoContract": {
      "type": "string",
      "const": "MACHINE_ANCHORED_PLAYBACK_AUDIBILITY_CONTRACT_V1"
    },
    "contracts": {
      "minItems": 2,
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "contractType": {
            "type": "string",
            "enum": [
              "TARGET_CORE_LOCALIZATION_CONTRACT_V1",
              "MACHINE_ANCHORED_PLAYBACK_AUDIBILITY_CONTRACT_V1"
            ]
          },
          "role": {
            "type": "string",
            "enum": ["PRODUCT_GO", "LOCALIZATION_DIAGNOSTIC"]
          },
          "goldCoverageThreshold": { "type": "number", "const": 0.8 },
          "unitCoverageThreshold": {
            "anyOf": [
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "null" }
            ]
          },
          "anchorMinimumOverlapSeconds": {
            "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
          },
          "anchorMinimumUnitCoverageRatio": {
            "anyOf": [
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "null" }
            ]
          },
          "maximumReviewEnvelopeSeconds": {
            "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
          },
          "maximumOneSideContextSeconds": {
            "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
          }
        },
        "required": [
          "contractType",
          "role",
          "goldCoverageThreshold",
          "unitCoverageThreshold",
          "anchorMinimumOverlapSeconds",
          "anchorMinimumUnitCoverageRatio",
          "maximumReviewEnvelopeSeconds",
          "maximumOneSideContextSeconds"
        ],
        "additionalProperties": false
      }
    },
    "frozenPreGold": { "type": "boolean", "const": true },
    "machineOnlyReleaseAuthorized": { "type": "boolean", "const": false },
    "thresholdChangeAllowedPostFreeze": { "type": "boolean", "const": false },
    "wholeEpisodeCatchAllAllowed": { "type": "boolean", "const": false }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "policyHash",
    "sourceIdentity",
    "sourceTimebase",
    "runtimeGoldInputCount",
    "visibility",
    "semanticHash",
    "artifactType",
    "productGoContract",
    "contracts",
    "frozenPreGold",
    "machineOnlyReleaseAuthorized",
    "thresholdChangeAllowedPostFreeze",
    "wholeEpisodeCatchAllAllowed"
  ],
  "additionalProperties": false
}
