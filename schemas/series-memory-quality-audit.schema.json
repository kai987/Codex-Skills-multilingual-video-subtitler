{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/series-memory-quality-audit.schema.json",
  "title": "series-memory-quality-audit",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "series-memory-quality-audit"
    },
    "auditVersion": { "type": "string", "const": "C5.19" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "memoryHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sampledEntries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entryId": { "type": "string", "minLength": 1 },
          "canonicalSurface": { "type": "string", "minLength": 1 },
          "entryType": {
            "type": "string",
            "enum": [
              "proper-noun",
              "person-name",
              "place-name",
              "organization-name",
              "title-name",
              "terminology",
              "regional-term",
              "domain-term",
              "dialect-form",
              "fixed-expression",
              "pronunciation-only",
              "orthographic-variant",
              "correction-pair"
            ]
          },
          "reading": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "occurrenceCount": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "trustLevel": {
            "type": "string",
            "enum": [
              "human-corrected",
              "human-reviewed",
              "validated-series",
              "repeated-verified",
              "single-observation",
              "candidate-only"
            ]
          },
          "sourceTypes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "human-reviewed-canonical",
                "human-correction",
                "validated-final-canonical",
                "reference-consensus",
                "sudachi-dictionary",
                "mfa-dictionary",
                "g2p",
                "ctc-projection",
                "asr-candidate",
                "manual-memory-entry"
              ]
            }
          },
          "likelyCommonWord": { "type": "boolean" },
          "unresolvedType": { "type": "boolean" }
        },
        "required": [
          "entryId",
          "canonicalSurface",
          "entryType",
          "reading",
          "occurrenceCount",
          "trustLevel",
          "sourceTypes",
          "likelyCommonWord",
          "unresolvedType"
        ],
        "additionalProperties": false
      }
    },
    "sampledEntryCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "likelyCommonWordCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "unresolvedTypeCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "conflictCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "manualReviewSuggestedCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "qualityPassed": { "type": "boolean" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "auditVersion",
    "generatedAt",
    "memoryHash",
    "sampledEntries",
    "sampledEntryCount",
    "likelyCommonWordCount",
    "unresolvedTypeCount",
    "conflictCount",
    "manualReviewSuggestedCount",
    "qualityPassed",
    "semanticHash"
  ],
  "additionalProperties": false
}
