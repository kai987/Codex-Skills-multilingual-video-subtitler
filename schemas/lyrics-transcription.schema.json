{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/lyrics-transcription.schema.json",
  "title": "lyrics-transcription",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "maximumWindowSeconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 30
    },
    "summary": {
      "type": "object",
      "properties": {
        "detectedSongRegions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lyricsAcceptedRegions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "missingLyricsRegions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "musicCueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lyricsAsrRequests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cacheHits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "detectedSongRegions",
        "lyricsAcceptedRegions",
        "missingLyricsRegions",
        "musicCueCount",
        "lyricsAsrRequests",
        "cacheHits"
      ],
      "additionalProperties": false
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "region": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "interval": {
                "type": "object",
                "properties": {
                  "start": { "type": "number", "minimum": 0 },
                  "end": { "type": "number", "exclusiveMinimum": 0 }
                },
                "required": ["start", "end"],
                "additionalProperties": false
              },
              "type": {
                "type": "string",
                "enum": [
                  "dialogue",
                  "singing",
                  "music-with-possible-vocals",
                  "instrumental",
                  "unknown"
                ]
              },
              "vocalEvidence": { "type": "boolean" },
              "vocalEvidenceConfidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "reasons": {
                "minItems": 1,
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "sourceRecoveryUnitIds": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "sourceSceneIds": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "required": [
              "id",
              "interval",
              "type",
              "vocalEvidence",
              "vocalEvidenceConfidence",
              "reasons"
            ],
            "additionalProperties": false
          },
          "attempts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "profile": {
                  "type": "string",
                  "enum": [
                    "phrase-window-15",
                    "context-window-25",
                    "offset-window-20"
                  ]
                },
                "interval": {
                  "type": "object",
                  "properties": {
                    "start": { "type": "number", "minimum": 0 },
                    "end": { "type": "number", "exclusiveMinimum": 0 }
                  },
                  "required": ["start", "end"],
                  "additionalProperties": false
                },
                "asrRequestId": { "type": "string", "minLength": 1 },
                "model": { "type": "string", "minLength": 1 },
                "coreML": { "type": "boolean" },
                "vadEnabled": { "type": "boolean", "const": false },
                "promptMode": { "type": "string", "const": "prompt-free" },
                "cacheKey": { "type": "string", "minLength": 1 },
                "cacheHit": { "type": "boolean" },
                "text": { "type": "string" },
                "canonicalCues": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "string", "minLength": 1 },
                      "start": { "type": "number", "minimum": 0 },
                      "end": { "type": "number", "exclusiveMinimum": 0 },
                      "text": { "type": "string", "minLength": 1 },
                      "language": {
                        "type": "string",
                        "enum": [
                          "zh",
                          "zh-Hans",
                          "zh-Hant",
                          "ja",
                          "en",
                          "mixed",
                          "und"
                        ]
                      },
                      "style": { "type": "string", "const": "music" }
                    },
                    "required": ["id", "start", "end", "text", "language"],
                    "additionalProperties": {}
                  }
                },
                "quality": {
                  "type": "object",
                  "properties": {
                    "validity": {
                      "type": "string",
                      "enum": [
                        "valid",
                        "weak",
                        "invalid-hallucination",
                        "invalid-empty",
                        "invalid-timing",
                        "invalid-language"
                      ]
                    },
                    "qualityScore": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "hardReject": { "type": "boolean" },
                    "repetitionHallucination": { "type": "boolean" },
                    "signals": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "EXACT_SENTENCE_LOOP",
                          "EXTREME_REPETITION_RATIO",
                          "LONG_PHRASE_LOOP",
                          "CONSECUTIVE_DUPLICATE_SEGMENTS",
                          "PROMPT_ECHO_LOOP",
                          "LOW_UNIQUE_CONTENT_RATIO",
                          "EMPTY_TEXT",
                          "INVALID_INTERVAL",
                          "OVERMERGED_TIMING",
                          "LANGUAGE_MISMATCH",
                          "LOW_DECODER_CONFIDENCE"
                        ]
                      }
                    },
                    "metrics": {
                      "type": "object",
                      "properties": {
                        "normalizedCharacters": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "sentenceCount": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "uniqueSentenceRatio": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "repeatedTextRatio": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "exactSentenceMaxRun": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "longestRepeatedPhraseCharacters": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "consecutiveDuplicateSegments": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "promptEchoCount": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "normalizedCharacters",
                        "sentenceCount",
                        "uniqueSentenceRatio",
                        "repeatedTextRatio",
                        "exactSentenceMaxRun",
                        "longestRepeatedPhraseCharacters",
                        "consecutiveDuplicateSegments",
                        "promptEchoCount"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "validity",
                    "qualityScore",
                    "hardReject",
                    "repetitionHallucination",
                    "signals",
                    "metrics"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "profile",
                "interval",
                "asrRequestId",
                "model",
                "coreML",
                "vadEnabled",
                "promptMode",
                "cacheKey",
                "cacheHit",
                "text",
                "canonicalCues",
                "quality"
              ],
              "additionalProperties": false
            }
          },
          "decision": {
            "type": "string",
            "enum": ["lyrics-accepted", "missing-lyrics"]
          },
          "acceptedMusicCues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "start": { "type": "number", "minimum": 0 },
                "end": { "type": "number", "exclusiveMinimum": 0 },
                "text": { "type": "string", "minLength": 1 },
                "language": {
                  "type": "string",
                  "enum": [
                    "zh",
                    "zh-Hans",
                    "zh-Hant",
                    "ja",
                    "en",
                    "mixed",
                    "und"
                  ]
                },
                "style": { "type": "string", "const": "music" }
              },
              "required": ["id", "start", "end", "text", "language"],
              "additionalProperties": {}
            }
          },
          "supportedCueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "independentSupportProfiles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "phrase-window-15",
                "context-window-25",
                "offset-window-20"
              ]
            }
          },
          "reasons": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "region",
          "attempts",
          "decision",
          "acceptedMusicCues",
          "supportedCueIds",
          "independentSupportProfiles",
          "reasons"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "maximumWindowSeconds",
    "summary",
    "regions"
  ],
  "additionalProperties": false
}
