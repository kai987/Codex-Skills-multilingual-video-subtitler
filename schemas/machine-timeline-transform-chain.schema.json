{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-timeline-transform-chain.schema.json",
  "title": "machine-timeline-transform-chain",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.3-candidate-association-canonical-assembly-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "machine-timeline-transform-chain"
    },
    "mode": { "type": "string", "enum": ["off", "observe", "enforce"] },
    "requestContractSemanticHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "chains": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requestId": { "type": "string", "minLength": 1 },
          "parentRequestId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "requestedInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "extractedInterval": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "vadEnabled": { "type": "boolean" },
          "transforms": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "transformId": { "type": "string", "minLength": 1 },
                "from": {
                  "type": "string",
                  "enum": [
                    "source-media",
                    "vad-local",
                    "parent-request-local",
                    "clip-local",
                    "decoder-local",
                    "global-media"
                  ]
                },
                "to": {
                  "type": "string",
                  "enum": [
                    "source-media",
                    "vad-local",
                    "parent-request-local",
                    "clip-local",
                    "decoder-local",
                    "global-media"
                  ]
                },
                "scale": { "type": "number", "exclusiveMinimum": 0 },
                "offsetSeconds": { "type": "number" },
                "verified": { "type": "boolean" },
                "evidence": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              },
              "required": [
                "transformId",
                "from",
                "to",
                "scale",
                "offsetSeconds",
                "verified",
                "evidence"
              ],
              "additionalProperties": false
            }
          },
          "composedScale": { "type": "number", "exclusiveMinimum": 0 },
          "composedOffsetSeconds": {
            "anyOf": [{ "type": "number" }, { "type": "null" }]
          },
          "status": {
            "type": "string",
            "enum": ["VERIFIED", "QUARANTINED", "UNAVAILABLE"]
          },
          "failureReason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "NO_COMPATIBLE_CLUSTER",
                  "ASSOCIATION_SCORE_TOO_LOW",
                  "TEMPORAL_CONFLICT",
                  "TEXT_CONFLICT",
                  "ACOUSTIC_EVENT_CONFLICT",
                  "SPEAKER_CONFLICT",
                  "WINDOW_EDGE_ONLY",
                  "BROAD_WINDOW_ONLY",
                  "PREFIX_SHADOWED",
                  "SUFFIX_SHADOWED",
                  "DUPLICATE_EVENT",
                  "CORRELATED_RETRY",
                  "NONCOMPETITIVE_VARIANT",
                  "MISSING_GLOBAL_TIMELINE",
                  "AMBIGUOUS_TIME_BASE",
                  "MULTIPLE_VALID_CLUSTERS",
                  "WEAK_ACOUSTIC_SUPPORT",
                  "HALLUCINATION_RISK",
                  "UNKNOWN"
                ]
              },
              { "type": "null" }
            ]
          },
          "tokenCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "requestMappedTokenCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "associationPendingTokenCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "rejectedTokenCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "requestId",
          "parentRequestId",
          "requestedInterval",
          "extractedInterval",
          "vadEnabled",
          "transforms",
          "composedScale",
          "composedOffsetSeconds",
          "status",
          "failureReason",
          "tokenCount",
          "requestMappedTokenCount",
          "associationPendingTokenCount",
          "rejectedTokenCount",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "requestCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "verifiedRequestCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "quarantinedRequestCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unavailableRequestCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tokenCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "requestMappedTokenCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "associationPendingTokenCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rejectedTokenCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unverifiedOffsetAppliedCount": { "type": "number", "const": 0 }
      },
      "required": [
        "requestCount",
        "verifiedRequestCount",
        "quarantinedRequestCount",
        "unavailableRequestCount",
        "tokenCount",
        "requestMappedTokenCount",
        "associationPendingTokenCount",
        "rejectedTokenCount",
        "unverifiedOffsetAppliedCount"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "mode",
    "requestContractSemanticHash",
    "chains",
    "summary",
    "semanticHash"
  ],
  "additionalProperties": false
}
