{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/review-action-validation-report.schema.json",
  "title": "review-action-validation-report",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "review-action-validation-report"
    },
    "validationVersion": { "type": "string", "const": "C5.18-PHASE0" },
    "policyVersion": {
      "type": "string",
      "const": "c5.18-review-action-semantics-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "mode": { "type": "string", "enum": ["off", "observe", "enforce"] },
    "reviewPackageHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reviewVersion": { "type": "string", "minLength": 1 },
    "itemCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "resolutionCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "allowedActionValidationCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "invalidActionCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "quarantinedSavedActionCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "shortcutBypassCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "downloadBlockedCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "preFixReproduction": {
      "type": "object",
      "properties": {
        "invalidAcceptShortcutGeneratedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "invalidResolutionDownloadAllowedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "shortcutActionBypassedAllowedActionsCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "invalidAcceptShortcutGeneratedCount",
        "invalidResolutionDownloadAllowedCount",
        "shortcutActionBypassedAllowedActionsCount"
      ],
      "additionalProperties": false
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "reviewId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "action": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "KEEP",
                  "ACCEPT_SUGGESTION",
                  "EDIT_TEXT",
                  "REJECT_SUGGESTION",
                  "SPLIT_CUE",
                  "MERGE_CUES",
                  "EDIT_TIMING",
                  "DELETE_CUE",
                  "MARK_UNRESOLVED"
                ]
              },
              { "type": "null" }
            ]
          },
          "field": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "message": { "type": "string", "minLength": 1 }
        },
        "required": ["code", "reviewId", "action", "field", "message"],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "invalidAcceptShortcutGeneratedCount": { "type": "number", "const": 0 },
        "invalidResolutionDownloadAllowedCount": {
          "type": "number",
          "const": 0
        },
        "shortcutActionBypassedAllowedActionsCount": {
          "type": "number",
          "const": 0
        },
        "noCandidateShortcutResolutionDelta": { "type": "number", "const": 0 },
        "coreBrowserPolicyHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "validationPassed": { "type": "boolean" }
      },
      "required": [
        "invalidAcceptShortcutGeneratedCount",
        "invalidResolutionDownloadAllowedCount",
        "shortcutActionBypassedAllowedActionsCount",
        "noCandidateShortcutResolutionDelta",
        "coreBrowserPolicyHash",
        "validationPassed"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "validationVersion",
    "policyVersion",
    "generatedAt",
    "mode",
    "reviewPackageHash",
    "reviewVersion",
    "itemCount",
    "resolutionCount",
    "allowedActionValidationCount",
    "invalidActionCount",
    "quarantinedSavedActionCount",
    "shortcutBypassCount",
    "downloadBlockedCount",
    "preFixReproduction",
    "errors",
    "summary",
    "semanticHash"
  ],
  "additionalProperties": false
}
