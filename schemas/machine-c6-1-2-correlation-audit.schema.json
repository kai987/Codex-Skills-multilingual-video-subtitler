{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-c6-1-2-correlation-audit.schema.json",
  "title": "machine-c6-1-2-correlation-audit",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "machine-c6-1-2-correlation-audit"
    },
    "policyVersion": {
      "type": "string",
      "const": "c6.1.2-top-k-reranking-acoustic-completeness-v1"
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "identityHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reconciliationHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "total": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "verified": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "provisional": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "unknown": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "coverage": {
      "anyOf": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "null" }
      ]
    },
    "verifiedCoverage": {
      "anyOf": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "null" }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "policyVersion",
    "semanticHash",
    "identityHash",
    "reconciliationHash",
    "total",
    "verified",
    "provisional",
    "unknown",
    "coverage",
    "verifiedCoverage"
  ],
  "additionalProperties": false
}
