{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-11-cv-results.schema.json",
  "title": "c6-0-1-11-cv-results",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.11-paired-evidence-independent-discriminator-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": { "type": "string", "const": "c6-0-1-11-cv-results" },
    "modelId": {
      "type": "string",
      "enum": ["M0", "M1", "M2", "M3", "M4", "M5"]
    },
    "modelType": { "type": "string", "const": "L2_LOGISTIC_REGRESSION" },
    "featureSet": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "nestedThresholdCalibration": { "type": "boolean", "const": true },
    "outerTestLabelsUsedForThreshold": { "type": "boolean", "const": false },
    "foldResults": {
      "minItems": 5,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fold": { "type": "integer", "minimum": 1, "maximum": 5 },
          "trainCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "testCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "threshold": { "type": "number" },
          "metrics": {
            "type": "object",
            "properties": {
              "selectedCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "correctCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "wrongCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "neutralCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "precision": {
                "anyOf": [
                  { "type": "number", "minimum": 0, "maximum": 1 },
                  { "type": "null" }
                ]
              },
              "harmRate": { "type": "number", "minimum": 0, "maximum": 1 },
              "selectiveCoverage": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "realizedGain": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "availableOracleGain": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "oracleCaptureRate": {
                "anyOf": [{ "type": "number" }, { "type": "null" }]
              }
            },
            "required": [
              "selectedCount",
              "correctCount",
              "wrongCount",
              "neutralCount",
              "precision",
              "harmRate",
              "selectiveCoverage",
              "realizedGain",
              "availableOracleGain",
              "oracleCaptureRate"
            ],
            "additionalProperties": false
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "fold",
          "trainCount",
          "testCount",
          "threshold",
          "metrics",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "aggregate": {
      "type": "object",
      "properties": {
        "selectedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "correctCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "wrongCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "neutralCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "precision": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "null" }
          ]
        },
        "harmRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "selectiveCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "realizedGain": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "availableOracleGain": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "oracleCaptureRate": {
          "anyOf": [{ "type": "number" }, { "type": "null" }]
        },
        "precisionWilsonLower": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "null" }
          ]
        },
        "precisionWilsonUpper": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "null" }
          ]
        },
        "negativeGainFoldCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "zeroHarmFoldCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "selectedCount",
        "correctCount",
        "wrongCount",
        "neutralCount",
        "precision",
        "harmRate",
        "selectiveCoverage",
        "realizedGain",
        "availableOracleGain",
        "oracleCaptureRate",
        "precisionWilsonLower",
        "precisionWilsonUpper",
        "negativeGainFoldCount",
        "zeroHarmFoldCount"
      ],
      "additionalProperties": false
    },
    "coefficients": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": { "type": "number" }
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "modelId",
    "modelType",
    "featureSet",
    "nestedThresholdCalibration",
    "outerTestLabelsUsedForThreshold",
    "foldResults",
    "aggregate",
    "coefficients",
    "semanticHash"
  ],
  "additionalProperties": false
}
