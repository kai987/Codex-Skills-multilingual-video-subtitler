{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-1-13-review-ranker-folds.schema.json",
  "title": "c6-0-1-13-review-ranker-folds",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.13-region-burden-calibration-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "c6-0-1-13-review-ranker-folds"
    },
    "machineFeaturesHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "frozenBeforeLabels": { "type": "boolean", "const": true },
    "construction": {
      "type": "string",
      "const": "CONTIGUOUS_AUDIO_CONNECTED_GROUPS_V1"
    },
    "neighborhoodSeconds": { "type": "number", "minimum": 0 },
    "requestedFoldCount": { "type": "number", "const": 5 },
    "actualFoldCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reason": { "type": "string" },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "groupId": { "type": "string" },
          "regionIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string" }
          },
          "timelineRange": {
            "type": "object",
            "properties": {
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          },
          "audioIntervalUnion": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": { "type": "number", "minimum": 0 },
                "end": { "type": "number", "exclusiveMinimum": 0 }
              },
              "required": ["start", "end"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "groupId",
          "regionIds",
          "timelineRange",
          "audioIntervalUnion"
        ],
        "additionalProperties": false
      }
    },
    "folds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "foldId": { "type": "string" },
          "regionIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string" }
          },
          "groupIds": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string" }
          },
          "timelineRanges": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": { "type": "number", "minimum": 0 },
                "end": { "type": "number", "exclusiveMinimum": 0 }
              },
              "required": ["start", "end"],
              "additionalProperties": false
            }
          },
          "audioIntervalUnion": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": { "type": "number", "minimum": 0 },
                "end": { "type": "number", "exclusiveMinimum": 0 }
              },
              "required": ["start", "end"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "foldId",
          "regionIds",
          "groupIds",
          "timelineRanges",
          "audioIntervalUnion"
        ],
        "additionalProperties": false
      }
    },
    "crossFoldAudioOverlapCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "machineFeaturesHash",
    "frozenBeforeLabels",
    "construction",
    "neighborhoodSeconds",
    "requestedFoldCount",
    "actualFoldCount",
    "reason",
    "groups",
    "folds",
    "crossFoldAudioOverlapCount",
    "semanticHash"
  ],
  "additionalProperties": false
}
