{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-0-blocker-root-cause-graph.schema.json",
  "title": "c6-0-blocker-root-cause-graph",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "investigationVersion": { "type": "string", "const": "C6.0" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "sourceSnapshot": {
      "type": "object",
      "properties": {
        "sourceTaskName": { "type": "string", "minLength": 1 },
        "sourceTaskHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "canonicalCueHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "timingHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "outputCueHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sourceStatus": { "type": "string", "const": "needs-review" },
        "sourceFinalizationMethod": { "type": "string", "const": "none" },
        "sourceReviewItemCount": { "type": "number", "const": 7 },
        "sourceFinalArtifactPresent": { "type": "boolean", "const": false },
        "causalReplayParity": { "type": "boolean" },
        "frozenReplayParity": { "type": "boolean" }
      },
      "required": [
        "sourceTaskName",
        "sourceTaskHash",
        "canonicalCueHash",
        "timingHash",
        "outputCueHash",
        "sourceStatus",
        "sourceFinalizationMethod",
        "sourceReviewItemCount",
        "sourceFinalArtifactPresent",
        "causalReplayParity",
        "frozenReplayParity"
      ],
      "additionalProperties": false
    },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": {
      "type": "string",
      "const": "c6-0-blocker-root-cause-graph"
    },
    "nodes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nodeId": { "type": "string", "minLength": 1 },
          "nodeType": {
            "type": "string",
            "enum": ["root-risk-family", "blocker-code", "evidence-state"]
          },
          "label": { "type": "string", "minLength": 1 }
        },
        "required": ["nodeId", "nodeType", "label"],
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "relation": {
            "type": "string",
            "enum": ["causes", "manifests-as", "guards", "supersedes"]
          }
        },
        "required": ["from", "to", "relation"],
        "additionalProperties": false
      }
    },
    "rootRiskFamilies": {
      "minItems": 1,
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "graphAcyclic": { "type": "boolean", "const": true },
    "rawObservedBlockerCodeCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "deduplicatedRootRiskFamilyCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "investigationVersion",
    "generatedAt",
    "sourceSnapshot",
    "semanticHash",
    "artifactType",
    "nodes",
    "edges",
    "rootRiskFamilies",
    "graphAcyclic",
    "rawObservedBlockerCodeCount",
    "deduplicatedRootRiskFamilyCount"
  ],
  "additionalProperties": false
}
