{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/c6-1-2-1-1-gold-timing-barrier.schema.json",
  "title": "c6-1-2-1-1-gold-timing-barrier",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "artifactType": {
      "type": "string",
      "const": "c6-1-2-1-1-gold-timing-barrier"
    },
    "policyVersion": {
      "type": "string",
      "const": "c6.1.2.1.1-constrained-monotonic-partition-reachable-evaluation-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "machineFrozenAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "goldTimingFirstReadAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "baselineFreezeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "goldTimingHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "goldByteHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "goldFile": {
      "type": "object",
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "semanticHash": {
          "anyOf": [
            { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            { "type": "null" }
          ]
        },
        "mtimeMs": { "type": "number" },
        "inode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "role",
        "path",
        "bytes",
        "sha256",
        "semanticHash",
        "mtimeMs",
        "inode"
      ],
      "additionalProperties": false
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "start": { "type": "number" },
          "end": { "type": "number" }
        },
        "required": ["id", "start", "end"],
        "additionalProperties": false
      }
    },
    "rawGoldTextReadCount": { "type": "number", "const": 0 },
    "parser": {
      "type": "string",
      "const": "ASS_PREFIX_ONLY_NO_DIALOGUE_TEXT_DECODE"
    }
  },
  "required": [
    "schemaVersion",
    "artifactType",
    "policyVersion",
    "policyHash",
    "semanticHash",
    "machineFrozenAt",
    "goldTimingFirstReadAt",
    "baselineFreezeHash",
    "goldTimingHash",
    "goldByteHash",
    "goldFile",
    "rows",
    "rawGoldTextReadCount",
    "parser"
  ],
  "additionalProperties": false
}
