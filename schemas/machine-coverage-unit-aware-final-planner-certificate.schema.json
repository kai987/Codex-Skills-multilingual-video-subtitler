{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-coverage-unit-aware-final-planner-certificate.schema.json",
  "title": "machine-coverage-unit-aware-final-planner-certificate",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.14.5-safety-coverage-unit-contract-v1"
    },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceIdentity": {
      "type": "object",
      "properties": {
        "sourceMediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "audioStreamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioTimebase": {
          "type": "string",
          "pattern": "^[1-9]\\d*\\/[1-9]\\d*$"
        },
        "sourceTimebase": { "type": "string", "const": "SOURCE_GLOBAL_SECONDS" }
      },
      "required": [
        "sourceMediaSha256",
        "durationSeconds",
        "sampleRate",
        "audioStreamIndex",
        "audioTimebase",
        "sourceTimebase"
      ],
      "additionalProperties": false
    },
    "sourceTimebase": {
      "type": "string",
      "const": "SOURCE_GLOBAL_NATIVE_SAMPLES"
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "visibility": { "type": "string", "const": "LOCAL_ONLY" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": {
      "type": "string",
      "const": "machine-coverage-unit-aware-final-planner-certificate"
    },
    "plannerVersion": {
      "type": "string",
      "const": "DETERMINISTIC_UNIT_REALIZATION_COVER_MILP_V1"
    },
    "productGoContract": {
      "type": "string",
      "const": "MACHINE_ANCHORED_PLAYBACK_AUDIBILITY_CONTRACT_V1"
    },
    "unitPolicyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "contractPolicyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "coverageUnitsHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "unitUtilityHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "realizationCandidatesHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "realizationDominanceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "obligationsHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidatesHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "coverageUnitCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "realizationCandidateCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "candidateCountAfterPruning": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "hardConstraintCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "obligationCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "exploredStates": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "prunedStates": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "searchStateLimit": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "searchComplete": { "type": "boolean" },
    "feasibilityStatus": {
      "type": "string",
      "enum": ["FEASIBLE", "INFEASIBLE_PROVEN", "SEARCH_INCOMPLETE"]
    },
    "oldPlanFeasible": { "type": "boolean" },
    "oldPlanObjectiveVector": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    },
    "finalObjectiveVector": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    },
    "objectiveNonDegradation": { "type": "boolean" },
    "unitCoverageByTier": {
      "type": "object",
      "properties": {
        "UNIT_TIER_5_MULTI_FAMILY_VERIFIED": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "UNIT_TIER_4_INDEPENDENT_EXCLUSIVE_VERIFIED": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "UNIT_TIER_3_SINGLE_FAMILY_VERIFIED": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "UNIT_TIER_2_MASKED_OR_SUBTHRESHOLD": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "UNIT_TIER_1_AUDIT_ONLY": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "UNIT_TIER_0_INELIGIBLE_OR_CONTRADICTED": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "UNIT_TIER_5_MULTI_FAMILY_VERIFIED",
        "UNIT_TIER_4_INDEPENDENT_EXCLUSIVE_VERIFIED",
        "UNIT_TIER_3_SINGLE_FAMILY_VERIFIED",
        "UNIT_TIER_2_MASKED_OR_SUBTHRESHOLD",
        "UNIT_TIER_1_AUDIT_ONLY",
        "UNIT_TIER_0_INELIGIBLE_OR_CONTRADICTED"
      ],
      "additionalProperties": false
    },
    "selectedCoverageUnitIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "selectedRealizationIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "selectedBundleIds": {
      "maxItems": 24,
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "selectedChildIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "activeBundleCount": { "type": "integer", "minimum": 0, "maximum": 24 },
    "speechCoreUnionSeconds": { "type": "number", "minimum": 0, "maximum": 60 },
    "predictedFullQueueSeconds": { "type": "number", "minimum": 0 },
    "predictedFullQueueEpisodeRatio": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.95
    },
    "phaseAObligationCoverage": { "type": "number", "const": 1 },
    "phaseARegressionCount": { "type": "number", "const": 0 },
    "deterministicTieBreakHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "admissibleBoundMethod": {
      "type": "string",
      "const": "LEXICOGRAPHIC_MILP_OPTIMALITY_WITH_BNB_FALLBACK_BOUND"
    },
    "hardConstraintResults": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" }
        },
        "required": ["name", "passed"],
        "additionalProperties": false
      }
    },
    "diagnosticReasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "policyHash",
    "sourceIdentity",
    "sourceTimebase",
    "runtimeGoldInputCount",
    "visibility",
    "semanticHash",
    "artifactType",
    "plannerVersion",
    "productGoContract",
    "unitPolicyHash",
    "contractPolicyHash",
    "coverageUnitsHash",
    "unitUtilityHash",
    "realizationCandidatesHash",
    "realizationDominanceHash",
    "obligationsHash",
    "candidatesHash",
    "coverageUnitCount",
    "realizationCandidateCount",
    "candidateCountAfterPruning",
    "hardConstraintCount",
    "obligationCount",
    "exploredStates",
    "prunedStates",
    "searchStateLimit",
    "searchComplete",
    "feasibilityStatus",
    "oldPlanFeasible",
    "oldPlanObjectiveVector",
    "finalObjectiveVector",
    "objectiveNonDegradation",
    "unitCoverageByTier",
    "selectedCoverageUnitIds",
    "selectedRealizationIds",
    "selectedBundleIds",
    "selectedChildIds",
    "activeBundleCount",
    "speechCoreUnionSeconds",
    "predictedFullQueueSeconds",
    "predictedFullQueueEpisodeRatio",
    "phaseAObligationCoverage",
    "phaseARegressionCount",
    "deterministicTieBreakHash",
    "admissibleBoundMethod",
    "hardConstraintResults",
    "diagnosticReasons"
  ],
  "additionalProperties": false
}
