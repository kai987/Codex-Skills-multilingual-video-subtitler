{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/anchor-text-coverage.schema.json",
  "title": "anchor-text-coverage",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "inputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "referenceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generatedSubtitleSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "configuration": {
      "type": "object",
      "properties": {
        "minimumTemporalCoverageRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "verifiedRequiresIndependentEvidence": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "minimumTemporalCoverageRatio",
        "verifiedRequiresIndependentEvidence"
      ],
      "additionalProperties": false
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "anchorId": { "type": "string", "minLength": 1 },
          "generatedCueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "level": {
            "type": "string",
            "enum": [
              "temporal-covered",
              "valid-text-covered",
              "verified-text-covered",
              "active-review",
              "uncovered"
            ]
          },
          "temporalCoverage": { "type": "boolean" },
          "validTextCoverage": { "type": "boolean" },
          "verifiedTextCoverage": { "type": "boolean" },
          "textValidity": {
            "type": "string",
            "enum": [
              "valid",
              "fragment",
              "incomplete",
              "competing",
              "semantic-conflict",
              "lyrics-hallucination",
              "unsupported",
              "unresolved"
            ]
          },
          "supportingEvidence": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "blockingFindingIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "activeReview": { "type": "boolean" }
        },
        "required": [
          "anchorId",
          "generatedCueIds",
          "level",
          "temporalCoverage",
          "validTextCoverage",
          "verifiedTextCoverage",
          "textValidity",
          "supportingEvidence",
          "blockingFindingIds",
          "activeReview"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "expectedAnchors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "temporalCovered": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "validTextCovered": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "verifiedTextCovered": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "activeReview": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "uncovered": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dialogue": {
          "type": "object",
          "properties": {
            "temporalRecall": {
              "anyOf": [
                { "type": "number", "minimum": 0, "maximum": 1 },
                { "type": "null" }
              ]
            },
            "validTextRecall": {
              "anyOf": [
                { "type": "number", "minimum": 0, "maximum": 1 },
                { "type": "null" }
              ]
            },
            "verifiedTextRecall": {
              "anyOf": [
                { "type": "number", "minimum": 0, "maximum": 1 },
                { "type": "null" }
              ]
            }
          },
          "required": [
            "temporalRecall",
            "validTextRecall",
            "verifiedTextRecall"
          ],
          "additionalProperties": false
        },
        "narration": {
          "type": "object",
          "properties": {
            "temporalRecall": {
              "anyOf": [
                { "type": "number", "minimum": 0, "maximum": 1 },
                { "type": "null" }
              ]
            },
            "validTextRecall": {
              "anyOf": [
                { "type": "number", "minimum": 0, "maximum": 1 },
                { "type": "null" }
              ]
            },
            "verifiedTextRecall": {
              "anyOf": [
                { "type": "number", "minimum": 0, "maximum": 1 },
                { "type": "null" }
              ]
            }
          },
          "required": [
            "temporalRecall",
            "validTextRecall",
            "verifiedTextRecall"
          ],
          "additionalProperties": false
        },
        "lyrics": {
          "type": "object",
          "properties": {
            "temporalRecall": {
              "anyOf": [
                { "type": "number", "minimum": 0, "maximum": 1 },
                { "type": "null" }
              ]
            },
            "validTextRecall": {
              "anyOf": [
                { "type": "number", "minimum": 0, "maximum": 1 },
                { "type": "null" }
              ]
            },
            "verifiedTextRecall": {
              "anyOf": [
                { "type": "number", "minimum": 0, "maximum": 1 },
                { "type": "null" }
              ]
            }
          },
          "required": [
            "temporalRecall",
            "validTextRecall",
            "verifiedTextRecall"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "expectedAnchors",
        "temporalCovered",
        "validTextCovered",
        "verifiedTextCovered",
        "activeReview",
        "uncovered",
        "dialogue",
        "narration",
        "lyrics"
      ],
      "additionalProperties": false
    },
    "fallback": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "inputHash",
    "referenceSha256",
    "generatedSubtitleSha256",
    "configuration",
    "anchors",
    "summary",
    "fallback"
  ],
  "additionalProperties": false
}
