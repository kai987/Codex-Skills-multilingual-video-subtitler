{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-cross-model-discriminator-features.schema.json",
  "title": "machine-cross-model-discriminator-features",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.11-paired-evidence-independent-discriminator-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "machine-cross-model-discriminator-features"
    },
    "corpusSemanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "pairedWhisperSemanticHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "independentDiscriminatorSemanticHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "featureSchemaHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "featureNames": {
      "minItems": 1,
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "featuresFrozenBeforeGold": { "type": "boolean", "const": true },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eventId": { "type": "string", "minLength": 1 },
          "audioGroupId": { "type": "string", "minLength": 1 },
          "featureValues": {
            "type": "object",
            "propertyNames": { "type": "string", "minLength": 1 },
            "additionalProperties": {
              "anyOf": [{ "type": "number" }, { "type": "null" }]
            }
          },
          "missingIndicators": {
            "type": "object",
            "propertyNames": { "type": "string", "minLength": 1 },
            "additionalProperties": { "type": "boolean" }
          },
          "metadata": {
            "type": "object",
            "properties": {
              "coreStart": { "type": "number", "minimum": 0 },
              "coreEnd": { "type": "number", "exclusiveMinimum": 0 },
              "mutationSafetyEligible": { "type": "boolean" },
              "spanLineageStatus": { "type": "string", "minLength": 1 }
            },
            "required": [
              "coreStart",
              "coreEnd",
              "mutationSafetyEligible",
              "spanLineageStatus"
            ],
            "additionalProperties": false
          },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "eventId",
          "audioGroupId",
          "featureValues",
          "missingIndicators",
          "metadata",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "audit": {
      "type": "object",
      "properties": {
        "rawTextFeatureCount": { "type": "number", "const": 0 },
        "datasetSpecificFeatureCount": { "type": "number", "const": 0 },
        "eventIdSemanticFeatureCount": { "type": "number", "const": 0 },
        "goldFeatureCount": { "type": "number", "const": 0 },
        "fullDataImputationCount": { "type": "number", "const": 0 },
        "fullDataStandardizationCount": { "type": "number", "const": 0 }
      },
      "required": [
        "rawTextFeatureCount",
        "datasetSpecificFeatureCount",
        "eventIdSemanticFeatureCount",
        "goldFeatureCount",
        "fullDataImputationCount",
        "fullDataStandardizationCount"
      ],
      "additionalProperties": false
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "corpusSemanticHash",
    "pairedWhisperSemanticHash",
    "independentDiscriminatorSemanticHash",
    "featureSchemaHash",
    "featureNames",
    "featuresFrozenBeforeGold",
    "events",
    "audit",
    "runtimeGoldInputCount",
    "semanticHash"
  ],
  "additionalProperties": false
}
