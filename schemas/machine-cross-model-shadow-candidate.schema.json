{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-cross-model-shadow-candidate.schema.json",
  "title": "machine-cross-model-shadow-candidate",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.9-independent-asr-complementarity-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "machine-cross-model-shadow-candidate"
    },
    "comparisonSemanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ctcArbitrationSemanticHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "winnerSelectionPolicyImplemented": { "type": "boolean", "const": false },
    "productionMutationAllowed": { "type": "boolean", "const": false },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eventId": { "type": "string", "minLength": 1 },
          "agreementClass": {
            "type": "string",
            "enum": [
              "EXACT_AGREEMENT",
              "NORMALIZED_AGREEMENT",
              "PRONUNCIATION_AGREEMENT",
              "ORTHOGRAPHY_ONLY_DIFFERENCE",
              "LEXICAL_DISAGREEMENT",
              "WHISPER_HALLUCINATION_RISK",
              "REAZON_HALLUCINATION_RISK",
              "BOTH_LOW_SUPPORT",
              "REAZON_EMPTY",
              "WHISPER_EMPTY",
              "UNCOMPARABLE"
            ]
          },
          "ctcOutcome": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "CTC_FAVORS_WHISPER",
                  "CTC_FAVORS_REAZON",
                  "CTC_AMBIGUOUS",
                  "CTC_UNSCORABLE"
                ]
              },
              { "type": "null" }
            ]
          },
          "ambiguityRetained": { "type": "boolean" },
          "candidateWinnerId": { "type": "null" },
          "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": [
          "eventId",
          "agreementClass",
          "ctcOutcome",
          "ambiguityRetained",
          "candidateWinnerId",
          "semanticHash"
        ],
        "additionalProperties": false
      }
    },
    "runtimeGoldInputCount": { "type": "number", "const": 0 },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "comparisonSemanticHash",
    "ctcArbitrationSemanticHash",
    "winnerSelectionPolicyImplemented",
    "productionMutationAllowed",
    "events",
    "runtimeGoldInputCount",
    "semanticHash"
  ],
  "additionalProperties": false
}
