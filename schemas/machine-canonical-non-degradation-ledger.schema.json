{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/machine-canonical-non-degradation-ledger.schema.json",
  "title": "machine-canonical-non-degradation-ledger",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "policyVersion": {
      "type": "string",
      "const": "c6.0.1.3-candidate-association-canonical-assembly-v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "artifactType": {
      "type": "string",
      "const": "machine-canonical-non-degradation-ledger"
    },
    "mode": { "type": "string", "enum": ["off", "observe", "enforce"] },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eventId": { "type": "string", "minLength": 1 },
          "operationId": { "type": "string", "minLength": 1 },
          "operation": {
            "type": "string",
            "enum": [
              "PRESERVE",
              "TEXT_REPLACE",
              "TIMING_REPLACE",
              "DROP",
              "MERGE",
              "TRUNCATE",
              "TIME_EXPAND"
            ]
          },
          "proposed": { "type": "boolean" },
          "accepted": { "type": "boolean" },
          "strongTextRetentionPassed": { "type": "boolean" },
          "intervalRetentionPassed": { "type": "boolean" },
          "trustedTokenBoundaryRetentionPassed": { "type": "boolean" },
          "eventCoveragePassed": { "type": "boolean" },
          "unsupportedDeletion": { "type": "boolean" },
          "unsupportedMerge": { "type": "boolean" },
          "unsupportedTimeExpansion": { "type": "boolean" },
          "reasons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "eventId",
          "operationId",
          "operation",
          "proposed",
          "accepted",
          "strongTextRetentionPassed",
          "intervalRetentionPassed",
          "trustedTokenBoundaryRetentionPassed",
          "eventCoveragePassed",
          "unsupportedDeletion",
          "unsupportedMerge",
          "unsupportedTimeExpansion",
          "reasons"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "evaluatedOperationCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "acceptedMutationCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rejectedMutationCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unsupportedStrongTextDeletionCount": { "type": "number", "const": 0 },
        "unsupportedMergeCount": { "type": "number", "const": 0 },
        "unsupportedTimeExpansionCount": { "type": "number", "const": 0 },
        "eventCoverageRegressionCount": { "type": "number", "const": 0 },
        "runtimeNonDegradationPassed": { "type": "boolean", "const": true }
      },
      "required": [
        "evaluatedOperationCount",
        "acceptedMutationCount",
        "rejectedMutationCount",
        "unsupportedStrongTextDeletionCount",
        "unsupportedMergeCount",
        "unsupportedTimeExpansionCount",
        "eventCoverageRegressionCount",
        "runtimeNonDegradationPassed"
      ],
      "additionalProperties": false
    },
    "beforeTextHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "afterTextHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "beforeTimingHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "afterTimingHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "semanticHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "generatedAt",
    "artifactType",
    "mode",
    "records",
    "summary",
    "beforeTextHash",
    "afterTextHash",
    "beforeTimingHash",
    "afterTimingHash",
    "semanticHash"
  ],
  "additionalProperties": false
}
